/**app.wxss 全局样式**/
page {
  background: #f6f7f9;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.btn-primary {
  background: #2b6cf6;
  color: #fff;
  border-radius: 999rpx;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #bbb;
  padding: 120rpx 0;
  font-size: 26rpx;
}

/* 金色月桂穗枝（hugeicons laurel-wreath-left-01，线描风格）：
   个人最佳/特别成就的通用装饰元素，左右枝相向环抱文本，右侧加 laurel-ear-r 镜像；
   只含背景图与镜像，尺寸由使用处的类控制 */
.laurel-ear {
  background-image: url("data:image/svg+xml;base64,");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.laurel-ear-r {
  transform: scaleX(-1);
}
/* 前纪录（曾被刷新）用的降饱和灰金穗枝 */
.laurel-ear-grey {
  background-image: url("data:image/svg+xml;base64,");
}
