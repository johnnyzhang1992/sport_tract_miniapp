/**app.wxss 全局样式**/
page {
  background: #f6f7f9;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.btn-primary {
  background: #2b6cf6;
  color: #fff;
  border-radius: 999rpx;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #bbb;
  padding: 120rpx 0;
  font-size: 26rpx;
}

/* 活动卡「成员面」的头像堆叠：首页「一起运动」区块与活动列表页共用一套（改这里两页一起变）。
   结构：<view class="member-av-stack"><image class="member-av"/></view> + 一句人数文案 */
.member-av-stack {
  display: flex;
}
.member-av {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  background: #e3e8f0; /* 没有头像时就是这枚占位圆 */
  flex: none;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.14);
}
.member-av + .member-av {
  margin-left: -14rpx; /* 相邻头像咬合 */
}
/* 既没头像也没预设档：用昵称首字占位（底色沿用上面那枚占位圆） */
.member-av-char {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #5b6472;
}
.member-av-text {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #8a93a6;
}

/* 活动状态标签：详情页头部与活动列表卡片共用一份（改这里两处一起变）。
   基类＝中性灰，所以「已结束」以及后端将来新加的状态直接落回基类；只有需要跳出灰色的
   状态才加修饰类，状态→修饰类的映射在 utils/campaign.js 的 statusTagClass。
   与标题的间距不放进来：详情页靠 .head-row 的 gap、列表靠 .cp-card-head 的局部 margin，
   那是各自排版，不是标签本身的样子。 */
.campaign-tag {
  flex: none;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  color: #8a93a6;
  background: #f2f3f5;
}
.campaign-tag--active {
  color: #2b6cf6;
  background: #eaf1ff;
}
.campaign-tag--upcoming {
  color: #b26a00;
  background: #fff4e0; /* 琥珀＝还没开赛、在倒计时；与 active 蓝、ended 灰、dissolved 红都拉开 */
}
.campaign-tag--dissolved {
  color: #e5484d;
  background: #fdecec; /* 与排行榜「移出」胶囊同一套红 */
}

/* 金色月桂穗枝（hugeicons laurel-wreath-left-01，线描风格）：
   个人最佳/特别成就的通用装饰元素，左右枝相向环抱文本，右侧加 laurel-ear-r 镜像；
   只含背景图与镜像，尺寸由使用处的类控制 */
.laurel-ear {
  background-image: url("data:image/svg+xml;base64,");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.laurel-ear-r {
  transform: scaleX(-1);
}
/* 前纪录（曾被刷新）用的降饱和灰金穗枝 */
.laurel-ear-grey {
  background-image: url("data:image/svg+xml;base64,");
}
