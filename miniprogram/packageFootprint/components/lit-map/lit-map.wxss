/* 组件样式隔离：app.wxss 的 .card/.section-title 进不来，这里自带一份（与全站卡片同参） */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 20rpx;
}

/* echarts 地图容器高度 */
.map-canvas {
  height: 780rpx;
}
ec-canvas {
  width: 100%;
  height: 780rpx;
  display: block;
  background: #f4f6fa; /* 浅背景色 */
}
/* 分享预览打开期间藏画布（同层 canvas 会盖住弹窗）；容器高度保留，卡片不塌陷 */
.map-hidden {
  display: none;
}

.map-card {
  position: relative;
}
/* 分享/全屏按钮（图标 + 文案，横向成组共用阴影与中缝）：留足点击区域 */
.map-actions {
  position: absolute;
  right: 48rpx;
  bottom: 48rpx; /* 右下角，离地图内容远一点 */
  z-index: 10; /* 确保盖在 canvas 之上 */
  display: flex;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  border-radius: 12rpx;
  overflow: hidden;
}
.map-btn {
  box-sizing: border-box;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #4e5969;
  background: rgba(255, 255, 255, 0.82); /* 半透明：地图透一点出来，又不影响读字 */
  border: 1rpx solid #e5e6eb; /* 白底地图上也可见 */
  display: flex;
  align-items: center;
  justify-content: center;
}
.map-btn:first-child {
  border-right: 1rpx solid #e5e6eb;
}
.btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.close-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 全屏地图 */
.fullscreen-mask {
  position: fixed;
  inset: 0;
  background: #fff;
  z-index: 10000;
}
.fullscreen-mask ec-canvas {
  width: 100%;
  height: 100vh;
  display: block;
}
.fullscreen-close {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  left: 24rpx;
  z-index: 10001;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  padding: 14rpx;
  box-sizing: border-box;
}

/* 缩放按钮（+/-） */
.zoom-controls {
  position: absolute;
  right: 48rpx; /* 与全屏按钮距右侧一致 */
  bottom: 120rpx; /* 全屏按钮上方 */
  z-index: 10; /* 确保盖在 canvas 之上 */
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  border-radius: 12rpx;
  overflow: hidden;
}
.zoom-btn {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.82); /* 半透明：地图透一点出来，又不影响读字 */
  color: #1f2329;
  font-size: 28rpx;
  border: 1rpx solid #e5e6eb; /* 白底地图上也可见 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.zoom-btn:first-child {
  border-bottom: 1rpx solid #e5e6eb;
}
/* 全屏内缩放按钮（右下角） */
.fs-zoom {
  bottom: 48rpx;
  right: 48rpx;
}

/* 省份下钻弹窗（底部弹出，展示城市点亮情况） */
.prov-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10002;
  display: flex;
  align-items: flex-end;
}
.prov-dialog {
  width: 100%;
  height: 76vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.prov-header {
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-bottom: 1rpx solid #f2f3f5;
}
.prov-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.prov-header-actions {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.prov-save {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.save-icon {
  width: 36rpx;
  height: 36rpx;
}
.prov-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.prov-dialog ec-canvas {
  flex: 1;
  width: 100%;
  height: 0; /* 由 flex:1 撑开，覆盖上面 ec-canvas 的固定高度 */
  min-height: 0;
}

/* 省份弹窗：查看该省轨迹入口 */
.prov-track-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 12rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #eef4ff;
  color: #2b6cf6;
  font-size: 26rpx;
}
.prov-track-entry-hover {
  background: #dce7fd;
}
.prov-entry-arrow {
  font-size: 32rpx;
  line-height: 1;
}

/* 分享预览弹窗（图片 + 保存到相册） */
.share-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10003;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-dialog {
  width: 640rpx;
  max-height: 82vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.share-header {
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-bottom: 1rpx solid #f2f3f5;
}
.share-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.share-close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-img-wrap {
  flex: none; /* 高度由图片按宽高比撑开（widthFix），不参与 flex 分配 */
  width: 100%;
  background: #f4f6fa;
  overflow: hidden;
}
.share-img {
  width: 100%;
  height: auto;
  display: block;
}
.share-footer {
  flex-shrink: 0;
  padding: 24rpx;
  border-top: 1rpx solid #f2f3f5;
}
.share-save-btn {
  height: 80rpx;
  border-radius: 40rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-save-btn:active {
  opacity: 0.8;
}

/* 点亮城市（省行可展开城市子行），形态与足迹统计页的省市明细一致 */
.region-card {
  padding: 24rpx 20rpx 8rpx;
}
.region-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 12rpx;
}
.region-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.region-summary {
  font-size: 24rpx;
  color: #8a93a6;
}
.region-row {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  border-top: 1rpx solid #f2f3f5;
}
.region-row-hover {
  background: #f7f8fa;
}
.region-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #cfe0ff;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.region-dot-on {
  background: #2b6cf6;
}
.region-name {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.region-count {
  font-size: 26rpx;
  font-weight: 600;
  color: #2b6cf6;
  margin-right: 16rpx;
}
.region-city {
  padding-left: 64rpx; /* 明显缩进：省名从 28rpx（圆点+间距）起，市名再往里 36rpx */
  min-height: 68rpx;
}
.region-city .region-name {
  font-size: 26rpx;
  color: #4e5969;
  font-weight: 400;
}
.region-count-city {
  font-size: 24rpx;
  font-weight: 400;
  color: #8a93a6;
}
.region-caret {
  width: 32rpx;
  flex-shrink: 0;
}
.region-caret-icon {
  width: 28rpx;
  height: 28rpx;
  transition: transform 0.2s;
}
.region-caret-icon-up {
  transform: rotate(180deg);
}

.loading-tip {
  text-align: center;
  color: #8a93a6;
  font-size: 24rpx;
  padding: 40rpx 0;
}
