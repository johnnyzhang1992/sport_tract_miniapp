/* 足迹统计页：周期筛选 + 点亮地图 + 数据概况（三格，地图下方）+ 底部「分享图片」栏
   度量对齐 packageFootprint/pages/footprint/footprint.wxss（stats-card/share-*）与 pages/report/report.wxss（range-card/period-nav/picker） */
.stats-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.stat-block {
  flex: 1;
  text-align: center;
}
.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #2b6cf6;
}
.stat-label {
  font-size: 24rpx;
  color: #8a93a6;
  margin-top: 6rpx;
}
.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #e5e6eb;
}

/* 周期筛选 */
.filter-card {
  padding: 14rpx 16rpx;
}
.range-row {
  display: flex;
  gap: 12rpx;
}
.range-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  background: #f2f3f5;
  font-size: 26rpx;
  color: #666;
}
.range-btn-active {
  background: #eef4ff;
  color: #2b6cf6;
  border: 2rpx solid #2b6cf6;
}
.period-nav {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}
.period-arrow {
  width: 56rpx;
  height: 56rpx;
  line-height: 54rpx;
  text-align: center;
  font-size: 36rpx;
  color: #2b6cf6;
  border-radius: 50%;
  background: #f2f3f5;
}
.period-arrow-hover {
  background: #e2e6eb;
}
.period-arrow-disabled {
  color: #c0c4cc;
}
.period-label {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.period-label-hover {
  opacity: 0.7;
}
.period-label-caret {
  margin-left: 10rpx;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* 点亮地图卡 */
.map-card {
  position: relative;
  padding: 12rpx;
}
.map-canvas {
  width: 100%;
  height: 780rpx;
}
/* 弹层打开期间藏画布（同层 canvas 会盖住弹层）；藏内层组件、容器高度保留 → 下方内容不跳动 */
.map-hidden {
  display: none;
}
ec-canvas {
  width: 100%;
  height: 780rpx;
  display: block;
  background: #f4f6fa; /* 浅背景色 */
}

/* 地图控件（+/− 缩放、全屏；度量对齐足迹页 .zoom-* / .map-actions） */
.map-actions {
  position: absolute;
  right: 48rpx;
  bottom: 48rpx; /* 右下角，离地图内容远一点 */
  z-index: 10; /* 确保盖在 canvas 之上 */
  display: flex;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  border-radius: 12rpx;
  overflow: hidden;
}
.fullscreen-btn {
  box-sizing: border-box;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #4e5969;
  background: rgba(255, 255, 255, 0.82); /* 半透明：地图透一点出来，又不影响读字 */
  border: 1rpx solid #e5e6eb; /* 白底地图上也可见 */
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.close-icon {
  width: 36rpx;
  height: 36rpx;
}
.zoom-controls {
  position: absolute;
  right: 48rpx; /* 与全屏按钮距右侧一致 */
  bottom: 120rpx; /* 全屏按钮上方 */
  z-index: 10; /* 确保盖在 canvas 之上 */
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  border-radius: 12rpx;
  overflow: hidden;
}
.zoom-btn {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.82); /* 半透明：地图透一点出来，又不影响读字 */
  color: #1f2329;
  font-size: 28rpx;
  border: 1rpx solid #e5e6eb; /* 白底地图上也可见 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.zoom-btn:first-child {
  border-bottom: 1rpx solid #e5e6eb;
}
/* 全屏内缩放按钮（右下角） */
.fs-zoom {
  bottom: 48rpx;
  right: 48rpx;
}

/* 全屏地图 */
.fullscreen-mask {
  position: fixed;
  inset: 0;
  background: #fff;
  z-index: 10000;
}
.fullscreen-mask ec-canvas {
  width: 100%;
  height: 100vh;
  display: block;
}
.fullscreen-close {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  left: 24rpx;
  z-index: 10001;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  padding: 14rpx;
  box-sizing: border-box;
}

.tip {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}
.retry {
  margin-left: 8rpx;
  color: #2b6cf6;
  font-weight: 600;
}

/* 周期选择弹窗（底部抽屉） */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.picker-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.picker-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.picker-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx 8rpx 8rpx 24rpx;
}
.picker-list {
  max-height: 60vh;
}
.picker-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 24rpx;
}
.picker-card {
  width: calc(50% - 24rpx);
  box-sizing: border-box;
  margin: 12rpx;
  padding: 26rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #333;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  white-space: nowrap;
  overflow: hidden;
}
.picker-card-active {
  background: #eef4ff;
  border-color: #2b6cf6;
  color: #2b6cf6;
  font-weight: 600;
}
.picker-card-compact {
  font-size: 20rpx;
}

/* 底部固定操作栏（分享图片）：页面内容留出等高内边距，避免概况卡被压住 */
.container {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
.act-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50; /* 低于周期抽屉遮罩(100)：抽屉打开时点不到 */
  background: #fff;
  border-top: 1rpx solid #f0f1f3;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
}
.act-btn {
  height: 88rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.act-btn-hover {
  opacity: 0.85;
}

/* 分享预览弹窗（对齐足迹页 .share-* 版式，底部两个动作） */
.share-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10003;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-dialog {
  width: 640rpx;
  max-height: 82vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.share-header {
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-bottom: 1rpx solid #f2f3f5;
}
.share-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.share-close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-close-icon {
  width: 36rpx;
  height: 36rpx;
}
.share-img-wrap {
  flex: none; /* 高度由图片按宽高比撑开（widthFix），不参与 flex 分配 */
  width: 100%;
  background: #f4f6fa;
  overflow: hidden;
}
.share-img {
  width: 100%;
  height: auto;
  display: block;
}
.share-footer {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  border-top: 1rpx solid #f2f3f5;
}
.share-save-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  border: 2rpx solid #dcdfe5;
  color: #4e5969;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-save-btn-hover {
  background: #f6f7f9;
}
.share-send-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  border-radius: 40rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
}
.share-send-btn::after {
  border: none;
}
