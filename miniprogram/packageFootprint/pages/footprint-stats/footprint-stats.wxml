<view class="container">
  <!-- 周期筛选（月/年/全部 + 翻页；点中间标签弹抽屉选最近 12 个月 / 5 年） -->
  <view class="card filter-card">
    <view class="range-row">
      <view
        wx:for="{{ranges}}"
        wx:key="value"
        class="range-btn {{activeRange === item.value ? 'range-btn-active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onRangeChange"
      >{{item.label}}</view>
    </view>
    <view class="period-nav" wx:if="{{activeRange !== 'all'}}">
      <view class="period-arrow" hover-class="period-arrow-hover" bindtap="onPrevPeriod">‹</view>
      <view class="period-label" hover-class="period-label-hover" bindtap="onTapPeriodLabel">
        <text>{{periodLabel}}</text>
        <image class="period-label-caret" src="/assets/icons/lucide-chevron-down.svg" mode="aspectFit" />
      </view>
      <view
        class="period-arrow {{canGoNext ? '' : 'period-arrow-disabled'}}"
        hover-class="{{canGoNext ? 'period-arrow-hover' : ''}}"
        bindtap="onNextPeriod"
      >›</view>
    </view>
  </view>

  <!-- 点亮地图（只保留地图本身：省份下钻/城市列表不在本页）
       canvas 是独立合成层，会盖住普通 view（既有点亮地图页的省份弹窗同样如此）：
       抽屉/分享预览/全屏打开期间把画布 display:none 藏起来（visibility 实测无效，且不销毁 canvas 省去重挂重绘）。
       藏的是内层 ec-canvas 而非 .map-canvas：容器高度保留，弹层打开时下方内容不会跳动。
       全屏也要藏卡片画布：否则它会穿透全屏白底遮罩，屏上出现「两套地图」（模拟器实测，两个南海诸岛框） -->
  <view class="card map-card">
    <view class="map-canvas">
      <ec-canvas id="litMap" canvas-id="litMap" class="{{showPeriodPicker || sharePreview || fullscreen ? 'map-hidden' : ''}}" ec="{{ ec }}"></ec-canvas>
    </view>
    <view class="zoom-controls">
      <view class="zoom-btn" bindtap="zoomIn">+</view>
      <view class="zoom-btn" bindtap="zoomOut">−</view>
    </view>
    <view class="map-actions">
      <view class="fullscreen-btn" bindtap="openSharePreview"><image class="btn-icon" src="/assets/icons/lucide-share.png" mode="aspectFit" /><text>分享</text></view>
      <view class="fullscreen-btn" bindtap="openFullscreen"><image class="btn-icon" src="/assets/icons/lucide-maximize.png" mode="aspectFit" /><text>全屏</text></view>
    </view>
  </view>

  <!-- 全屏地图弹窗（另起一个 ec-canvas：进入时按当前周期数据绘制，关闭销毁重建） -->
  <view class="fullscreen-mask" wx:if="{{fullscreen}}">
    <view class="fullscreen-close" bindtap="closeFullscreen"><image class="close-icon" src="/assets/icons/lucide-x.png" mode="aspectFit" /></view>
    <ec-canvas id="fsMap" canvas-id="fsMap" class="{{sharePreview ? 'map-hidden' : ''}}" ec="{{ fsEc }}"></ec-canvas>
    <view class="zoom-controls fs-zoom">
      <view class="zoom-btn" bindtap="zoomIn">+</view>
      <view class="zoom-btn" bindtap="zoomOut">−</view>
    </view>
  </view>

  <!-- 状态行放地图下方而非浮在地图上：canvas 是独立合成层，浮层会被它盖住（模拟器实测） -->
  <view wx:if="{{error}}" class="tip">{{error}} <text class="retry" bindtap="fetch">重试</text></view>
  <view wx:elif="{{loading}}" class="tip">统计中…</view>
  <view wx:elif="{{loaded && total === 0}}" class="tip">该时间段还没有足迹，去地图页记录一个吧</view>

  <!-- 数据概况（地图下方）：当前周期内的足迹数 + 点亮省份/城市数 -->
  <view class="stats-card">
    <view class="stat-block">
      <view class="stat-value">{{loaded ? total : '—'}}</view>
      <view class="stat-label">总足迹</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-block">
      <view class="stat-value">{{loaded ? provinceCount : '—'}}</view>
      <view class="stat-label">省份</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-block">
      <view class="stat-value">{{loaded ? cityCount : '—'}}</view>
      <view class="stat-label">城市</view>
    </view>
  </view>
</view>

<!-- 周期选择弹窗（底部抽屉，对齐运动报告页） -->
<view class="picker-mask" wx:if="{{showPeriodPicker}}" bindtap="onClosePeriodPicker">
  <view class="picker-sheet" catchtap="noop">
    <view class="picker-head">
      <text>选择周期</text>
      <text class="picker-close" catchtap="onClosePeriodPicker">✕</text>
    </view>
    <scroll-view class="picker-list" scroll-y scroll-into-view="{{pickerScrollInto}}">
      <view class="picker-grid">
        <view
          wx:for="{{periodOptions}}"
          wx:key="offset"
          id="period-{{item.offset}}"
          class="picker-card {{item.selected ? 'picker-card-active' : ''}} {{item.compact ? 'picker-card-compact' : ''}}"
          data-offset="{{item.offset}}"
          bindtap="onSelectPeriod"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 底部固定操作栏（分享图出口）：z-index 低于周期抽屉遮罩，抽屉打开时点不到 -->
<view class="act-bar">
  <view class="act-btn" hover-class="act-btn-hover" bindtap="openSharePreview">分享图片</view>
</view>

<!-- 分享预览弹窗（图片 + 保存到相册 / 分享给朋友） -->
<view class="share-mask" wx:if="{{sharePreview}}" catchtouchmove="noop">
  <view class="share-dialog">
    <view class="share-header">
      <text class="share-title">分享预览</text>
      <view class="share-close" bindtap="closeSharePreview"><image class="share-close-icon" src="/assets/icons/lucide-x.png" mode="aspectFit" /></view>
    </view>
    <view class="share-img-wrap">
      <image class="share-img" src="{{shareImageSrc}}" mode="widthFix" />
    </view>
    <view class="share-footer">
      <view class="share-save-btn" hover-class="share-save-btn-hover" bindtap="saveShareImage">保存到相册</view>
      <button class="share-send-btn" open-type="share">分享给朋友</button>
    </view>
  </view>
</view>
