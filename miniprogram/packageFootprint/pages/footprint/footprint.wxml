<view class="footprint-page">
  <!-- 统计卡 -->
  <view class="stats-card">
    <view class="stat-block">
      <view class="stat-value">{{provinceCount}}</view>
      <view class="stat-label">点亮省份</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-block">
      <view class="stat-value">{{cityCount}}</view>
      <view class="stat-label">点亮城市</view>
    </view>
  </view>

  <!-- 真实中国地图（echarts）。分享预览打开期间藏画布：canvas 同层合成会盖在弹窗上（模拟器实测重影）；
       藏内层组件、外层容器高度保留 → 卡片不塌陷、页面不跳动 -->
  <view class="card map-card">
    <view class="map-canvas">
      <ec-canvas id="footprintMap" canvas-id="footprintMap" class="{{sharePreview ? 'map-hidden' : ''}}" ec="{{ ec }}"></ec-canvas>
    </view>
    <view class="zoom-controls">
      <view class="zoom-btn" bindtap="zoomIn">+</view>
      <view class="zoom-btn" bindtap="zoomOut">−</view>
    </view>
    <view class="fullscreen-btn share-btn" bindtap="openSharePreview"><image class="btn-icon" src="/assets/icons/lucide-share.png" mode="aspectFit" /><text>分享</text></view>
    <view class="fullscreen-btn" bindtap="openFullscreen"><image class="btn-icon" src="/assets/icons/lucide-maximize.png" mode="aspectFit" /><text>全屏</text></view>
  </view>

  <!-- 全屏地图弹窗 -->
  <view class="fullscreen-mask" wx:if="{{fullscreen}}">
    <view class="fullscreen-close" bindtap="closeFullscreen"><image class="close-icon" src="/assets/icons/lucide-x.png" mode="aspectFit" /></view>
    <ec-canvas id="fsMap" canvas-id="fsMap" class="{{sharePreview ? 'map-hidden' : ''}}" ec="{{ fsEc }}"></ec-canvas>
    <view class="zoom-controls fs-zoom">
      <view class="zoom-btn" bindtap="zoomIn">+</view>
      <view class="zoom-btn" bindtap="zoomOut">−</view>
    </view>
  </view>

  <!-- 省份下钻弹窗（展示该省各城市点亮情况） -->
  <view class="prov-mask" wx:if="{{provinceModal}}" catchtouchmove="noop">
    <view class="prov-dialog">
      <view class="prov-header">
        <text class="prov-title">{{provinceModalName}} · 城市点亮</text>
        <view class="prov-header-actions">
          <view class="prov-save" bindtap="saveProvinceImage"><image class="save-icon" src="/assets/icons/lucide-download.png" mode="aspectFit" /></view>
          <view class="prov-close" bindtap="closeProvinceMap"><image class="close-icon" src="/assets/icons/lucide-x.png" mode="aspectFit" /></view>
        </view>
      </view>
      <view class="prov-track-entry" hover-class="prov-track-entry-hover" bindtap="viewProvinceTracks">
        <text>查看{{provinceModalName}}的轨迹</text>
        <text class="prov-entry-arrow">›</text>
      </view>
      <ec-canvas id="provMap" canvas-id="provMap" ec="{{ provEc }}"></ec-canvas>
    </view>
  </view>

  <!-- 分享预览弹窗（图片 + 保存到相册） -->
  <view class="share-mask" wx:if="{{sharePreview}}" catchtouchmove="noop">
    <view class="share-dialog">
      <view class="share-header">
        <text class="share-title">分享预览</text>
        <view class="share-close" bindtap="closeSharePreview"><image class="close-icon" src="/assets/icons/lucide-x.png" mode="aspectFit" /></view>
      </view>
      <view class="share-img-wrap">
        <image class="share-img" src="{{shareImageSrc}}" mode="widthFix" />
      </view>
      <view class="share-footer">
        <view class="share-save-btn" bindtap="saveShareImage">保存到相册</view>
      </view>
    </view>
  </view>

  <!-- 点亮城市列表 -->
  <view class="card" wx:if="{{cities.length > 0}}">
    <view class="section-title">点亮城市（{{cities.length}}）</view>
    <view wx:for="{{cities}}" wx:key="name" class="city-row">
      <view class="city-dot"></view>
      <view class="city-info">
        <view class="city-name">{{item.name}}</view>
        <view class="city-prov">{{item.province}}</view>
      </view>
      <view class="city-count">{{item.count}} 次</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-tip">统计中…</view>
  <view wx:if="{{!loading && provinceCount === 0}}" class="loading-tip">还没有点亮的城市，去记录一次运动吧</view>
</view>
