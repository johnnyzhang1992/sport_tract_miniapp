.footprint-page {
  padding: 24rpx;
}
.stats-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.stat-block {
  flex: 1;
  text-align: center;
}
.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #2b6cf6;
}
.stat-label {
  font-size: 24rpx;
  color: #8a93a6;
  margin-top: 6rpx;
}
.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #e5e6eb;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 20rpx;
}
.prov-grid {
  display: flex;
  flex-wrap: wrap;
}
.prov-cell {
  width: 16.66%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  color: #c2c7d0;
}
.prov-lit {
  background: #e8f0ff;
  color: #2b6cf6;
}
.prov-name {
  font-size: 22rpx;
}
.prov-count {
  font-size: 18rpx;
  margin-top: 4rpx;
  color: #2b6cf6;
}
.city-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.city-row:last-child {
  border-bottom: none;
}
.city-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2b6cf6;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.city-info {
  flex: 1;
  min-width: 0;
}
.city-name {
  font-size: 28rpx;
  color: #1f2329;
}
.city-prov {
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 2rpx;
}
.city-count {
  font-size: 24rpx;
  color: #2b6cf6;
}
.loading-tip {
  text-align: center;
  color: #8a93a6;
  font-size: 24rpx;
  padding: 40rpx 0;
}

/* echarts 地图容器高度 */
ec-canvas {
  width: 100%;
  height: 780rpx;
  display: block;
  background: #f4f6fa; /* 浅背景色 */
}

/* 全屏地图 */
.map-card {
  position: relative;
}
.fullscreen-btn {
  position: absolute;
  bottom: 48rpx; /* 右下角，离地图内容远一点 */
  right: 48rpx;
  z-index: 10; /* 确保盖在 canvas 之上 */
  background: #fff;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #4e5969;
  border: 1rpx solid #e5e6eb; /* 白底地图上也可见 */
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
}
/* 分享按钮：全屏按钮左侧（全屏按钮约 128rpx 宽 + 间距） */
.share-btn {
  right: 192rpx;
}
.btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.close-icon {
  width: 36rpx;
  height: 36rpx;
}
.fullscreen-mask {
  position: fixed;
  inset: 0;
  background: #fff;
  z-index: 10000;
}
.fullscreen-mask ec-canvas {
  width: 100%;
  height: 100vh;
  display: block;
}
.fullscreen-close {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  left: 24rpx;
  z-index: 10001;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  padding: 14rpx;
  box-sizing: border-box;
}

/* 缩放按钮（+/-） */
.zoom-controls {
  position: absolute;
  right: 48rpx; /* 与全屏按钮距右侧一致 */
  bottom: 120rpx; /* 全屏按钮上方 */
  z-index: 10; /* 确保盖在 canvas 之上 */
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  border-radius: 12rpx;
  overflow: hidden;
}
.zoom-btn {
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  color: #1f2329;
  font-size: 28rpx;
  border: 1rpx solid #e5e6eb; /* 白底地图上也可见 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.zoom-btn:first-child {
  border-bottom: 1rpx solid #e5e6eb;
}
.zoom-btn-active {
  opacity: 0.7;
}
/* 全屏内缩放按钮（右下角） */
.fs-zoom {
  bottom: 48rpx;
  right: 48rpx;
}

/* 省份下钻弹窗（底部弹出，展示城市点亮情况） */
.prov-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10002;
  display: flex;
  align-items: flex-end;
}
.prov-dialog {
  width: 100%;
  height: 76vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.prov-header {
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-bottom: 1rpx solid #f2f3f5;
}
.prov-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.prov-header-actions {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.prov-save {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.save-icon {
  width: 36rpx;
  height: 36rpx;
}
.prov-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.prov-dialog ec-canvas {
  flex: 1;
  width: 100%;
  height: 0; /* 由 flex:1 撑开，覆盖全局 ec-canvas 固定高度 */
  min-height: 0;
}

/* 分享预览弹窗（图片 + 保存到相册） */
.share-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10003;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-dialog {
  width: 640rpx;
  max-height: 82vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.share-header {
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-bottom: 1rpx solid #f2f3f5;
}
.share-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.share-close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-img-wrap {
  flex: none; /* 高度由图片按宽高比撑开（widthFix），不参与 flex 分配 */
  width: 100%;
  background: #f4f6fa;
  overflow: hidden;
}
.share-img {
  width: 100%;
  height: auto;
  display: block;
}
.share-footer {
  flex-shrink: 0;
  padding: 24rpx;
  border-top: 1rpx solid #f2f3f5;
}
.share-save-btn {
  height: 80rpx;
  border-radius: 40rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-save-btn:active {
  opacity: 0.8;
}

/* 省份弹窗：查看该省轨迹入口 */
.prov-track-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 12rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #eef4ff;
  color: #2b6cf6;
  font-size: 26rpx;
}
.prov-track-entry-hover {
  background: #dce7fd;
}
.prov-entry-arrow {
  font-size: 32rpx;
  line-height: 1;
}
