/* 徽章形状 + 配色（2026-11-19 从 badge-wall.wxss 抽出公共）
 *
 * 为什么要抽：年度报告要列出「今年解锁了哪些徽章」，需要和徽章墙**长一样的章面**。
 * 形状是 clip-path / 渐变 / ::before 装饰组成的，复制一份必然走样，所以抽成公共文件：
 *   - components/badge-wall/badge-wall.wxss  @import 本文件
 *   - pages/year-report/year-report.wxss     @import 本文件
 *
 * 约定（给使用方）：
 *   - 章面容器加 `b-<shape>`（大写形状名由 utils/badge-shape.js 的 shapeClassOf 给出）
 *   - 中央数字用 class="badge-center"
 *   - 分运动类型的图标用 class="badge-type-icon"
 * 本文件只负责「长什么样」，尺寸由使用方决定（徽章墙 96rpx，年报 88rpx）。
 */

/* 形状 */
.b-plan,
.b-ring,
.b-goal {
  border-radius: 50%;
}
.b-hex {
  clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
}
.b-shield {
  clip-path: polygon(0 0, 100% 0, 100% 72%, 50% 100%, 0 72%);
}
/* 已解锁主题（饱和渐变） */
.b-plan {
  background: linear-gradient(145deg, #f6c344, #dd8f19);
}
.b-dist {
  background: linear-gradient(145deg, #4f8ef7, #1d4ed8);
}
.b-dur {
  background: linear-gradient(145deg, #14b8a6, #0f766e);
}
.b-streak {
  background: linear-gradient(145deg, #34d399, #15803d);
}
/* 圆章（合上圆环 / 分类型次数）：原纯黑 #111827 在浅色卡片上过于沉重，
   2026-11-16 改为品牌靛蓝渐变，与金边搭配（金色圆环徽章仍靠 .ringbadge 嵌套三环区分身份） */
.b-ring {
  background: linear-gradient(145deg, #6366f1, #4338ca);
  border: 5rpx solid #d4af37;
  box-sizing: border-box;
}
/* 累计里程：圆角方牌 + 底部道路虚线（「路程」意象；唯一方形徽章，一眼区分于盾/六边/圆章） */
.b-total-dist {
  background: linear-gradient(145deg, #60a5fa, #1d4ed8);
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
}
.b-total-dist::after {
  content: '';
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 13rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background-image: repeating-linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.92) 0 9rpx,
    rgba(255, 255, 255, 0) 9rpx 18rpx
  );
}
/* 数字上提，给底部道路让位 */
.b-total-dist .badge-center {
  transform: translateY(-6rpx);
}

/* 累计时长：表盘（圆形 + 12 个刻度环，conic-gradient 挖环——与月历三环同一套渲染手段） */
.b-total-dur {
  background: linear-gradient(145deg, #fdba74, #ea580c);
  border-radius: 50%;
  position: relative;
}
.b-total-dur::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: repeating-conic-gradient(
    from -0.8deg,
    rgba(255, 255, 255, 0.9) 0deg 1.6deg,
    rgba(255, 255, 255, 0) 1.6deg 30deg
  );
  -webkit-mask: radial-gradient(circle, transparent 0 33rpx, #000 33rpx 39rpx, transparent 39rpx);
  mask: radial-gradient(circle, transparent 0 33rpx, #000 33rpx 39rpx, transparent 39rpx);
}
.b-week-all {
  background: linear-gradient(145deg, #fb7185, #e11d48);
}
/* 单项完美周：距离/时长/次数各一色，形状沿用盾/六边/圆章 */
.b-week-distance {
  background: linear-gradient(145deg, #fca5a5, #dc2626);
}
.b-week-duration {
  background: linear-gradient(145deg, #86efac, #15803d);
}
.b-week-count {
  background: linear-gradient(145deg, #7dd3fc, #0284c7);
  border: none;
}
