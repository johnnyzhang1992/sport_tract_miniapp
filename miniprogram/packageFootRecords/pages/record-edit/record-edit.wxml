<view class="container">
  <!-- 地点：两个入口按钮（地图选点=自建页 Task 8 / 快速选点=wx.chooseLocation），已选显示 name/address+重选 -->
  <view class="card">
    <view class="field-label">地点</view>
    <view class="loc-picked" wx:if="{{location}}">
      <view class="loc-name">{{location.name || location.address || '已选位置'}}</view>
      <view class="text-muted loc-address" wx:if="{{location.address}}">{{location.address}}</view>
    </view>
    <view class="text-muted loc-empty-tip" wx:else>还没选地点，点下面任一按钮选一个</view>
    <view class="loc-actions">
      <view class="loc-btn" bindtap="pickBySelfMap" hover-class="loc-btn-hover">地图选点</view>
      <view class="loc-btn" bindtap="pickByWx" hover-class="loc-btn-hover">快速选点</view>
    </view>
  </view>

  <!-- 日期 -->
  <view class="card">
    <view class="field-label">日期</view>
    <picker mode="date" value="{{visitDate}}" bindchange="onDate">
      <view class="picker-value">{{visitDate || '选择日期'}}</view>
    </picker>
  </view>

  <!-- 标题 -->
  <view class="card">
    <view class="field-label">标题</view>
    <input class="field-input" placeholder="给这次足迹起个标题" value="{{title}}" bindinput="onTitle" maxlength="50" />
    <view class="text-muted field-tip">必填，最长 50 字</view>
  </view>

  <!-- 同行的人（标签可点删） -->
  <view class="card">
    <view class="field-label">同行的人</view>
    <view class="people-row">
      <input class="field-input people-input" placeholder="输入名字后点添加" value="{{peopleInput}}" bindinput="onPeopleInput" bindconfirm="addPerson" maxlength="20" />
      <view class="people-add" bindtap="addPerson" hover-class="people-add-hover">添加</view>
    </view>
    <view class="people-tags" wx:if="{{people.length}}">
      <view wx:for="{{people}}" wx:key="*this" class="people-tag" data-idx="{{index}}" bindtap="removePerson">{{item}}<text class="tag-x">×</text></view>
    </view>
    <view class="text-muted field-tip">最多 10 人，每人最长 20 字，点标签删除</view>
  </view>

  <!-- 描述 -->
  <view class="card">
    <view class="field-label">描述</view>
    <textarea class="desc-input" placeholder="记录点什么（可选）" value="{{description}}" bindinput="onDesc" maxlength="500" />
    <view class="text-muted field-tip">最长 500 字</view>
  </view>

  <!-- 图片九宫格（≤3）：+ 占位添加，x 删除 -->
  <view class="card">
    <view class="field-label">照片（最多 3 张）</view>
    <view class="photo-grid">
      <view wx:for="{{photos}}" wx:key="index" class="photo-item">
        <image class="photo-img" src="{{item.localPath || item.url}}" mode="aspectFill" />
        <view class="photo-remove" data-idx="{{index}}" bindtap="removePhoto">×</view>
      </view>
      <view class="photo-add" wx:if="{{photos.length < 3}}" bindtap="choosePhoto" hover-class="photo-add-hover">＋</view>
    </view>
  </view>

  <!-- 提交（必填项不满足 / 上传中禁用） -->
  <button
    class="btn-primary submit-btn"
    disabled="{{!canSubmit || submitting}}"
    loading="{{submitting}}"
    bindtap="submit"
  >{{id ? '保存修改' : '保存足迹'}}</button>
  <view class="submit-tip text-muted" wx:if="{{!canSubmit}}">填写标题并在上方选一个地点后可保存</view>
</view>
