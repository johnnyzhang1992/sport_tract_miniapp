/* 自建地图选点页：全屏 map + 顶部搜索/结果浮层 + 底部选点摘要（色彩对齐编辑页卡片风格） */
.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}
.map {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
}

/* 顶部搜索栏 */
.search-bar {
  position: absolute;
  top: 20rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 20;
}
.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}
.search-ph {
  color: #999;
}
.search-spin {
  font-size: 24rpx;
  color: #2b6cf6;
}

/* 搜索失败横幅：内嵌，不打断点选 */
.search-error {
  position: absolute;
  top: 116rpx;
  left: 24rpx;
  right: 24rpx;
  background: rgba(250, 81, 81, 0.92);
  color: #fff;
  font-size: 24rpx;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  z-index: 20;
}

/* 结果下拉列表：悬浮于地图之上，可滚动（高度由内联 listHeight 给定，scroll-y 需显式高度） */
.results {
  position: absolute;
  top: 116rpx;
  left: 24rpx;
  right: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
  z-index: 19;
}
.result-item {
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.result-item:last-child {
  border-bottom: none;
}
.result-hover {
  background: #eef4ff;
}
.result-name {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.result-address {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #86909c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.results-empty {
  position: absolute;
  top: 116rpx;
  left: 24rpx;
  right: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #86909c;
  font-size: 26rpx;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  z-index: 19;
}

/* 底部浮层：picked 摘要 + 确认选点 */
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 20;
}
.picked-name {
  font-size: 32rpx;
  color: #1f2329;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picked-address {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #86909c;
}
.picked-coords {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #c9cdd4;
}
.picked-empty {
  font-size: 26rpx;
  color: #86909c;
  text-align: center;
  padding: 12rpx 0;
}
.confirm-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 32rpx;
}
.confirm-btn-hover {
  background: #1e5be0;
}
