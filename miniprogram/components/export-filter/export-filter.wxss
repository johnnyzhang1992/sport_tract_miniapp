.ef-label {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #4e5969;
}

.ef-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.ef-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f5f7fb;
  color: #4e5969;
  font-size: 24rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.ef-chip-on {
  background: #2b6cf6;
  color: #fff;
  font-weight: 500;
}

.ef-dates {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.ef-dates picker {
  flex: 1;
  min-width: 0;
}

.ef-date {
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: #f7f8fa;
  border: 2rpx solid #e9ecf2;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #1f2329;
}

.ef-sep {
  flex: none;
  font-size: 22rpx;
  color: #8a93a6;
}
