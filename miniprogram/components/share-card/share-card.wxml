<view class="share-card">
  <!-- 预览弹窗：canvas 直接渲染海报（可见区域，canvasToTempFilePath 才可靠） -->
  <view class="preview-mask" wx:if="{{previewVisible}}" catchtouchmove="noop">
    <view class="preview-box">
      <view class="preview-head">
        <view class="preview-title">分享海报</view>
        <view class="preview-close" bindtap="closePreview"><image src="/assets/icons/lucide-x.png" mode="aspectFit" /></view>
      </view>
      <canvas
        type="2d"
        id="posterCanvas"
        class="poster-canvas"
        style="width: 300px; height: 400px;"
      ></canvas>
      <view class="mini-toggle">
        <text class="mini-toggle-label">海报显示小程序码</text>
        <switch checked="{{showMiniCode}}" bindchange="toggleMiniCode" color="#2b6cf6" />
      </view>
      <view class="preview-actions">
        <button class="preview-btn preview-save" loading="{{saving}}" bindtap="save">保存</button>
        <button class="preview-btn preview-share" open-type="share">分享</button>
      </view>
      <view class="preview-tip">朋友圈：保存后手动发布</view>
    </view>
  </view>

  <slot />
</view>
