.share-card {
  width: 100%;
}
/* 预览弹窗 */
.preview-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-box {
  width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.preview-title {
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}
.preview-close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f2f3f5;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.poster-canvas {
  width: 100%;
  height: auto;
  border-radius: 12rpx;
  background: #2b6cf6;
}
.preview-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}
.preview-btn {
  flex: 0 0 48%;
  width: 48%;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-save {
  background: #2b6cf6;
  color: #fff;
}
.preview-share {
  background: #07c160;
  color: #fff;
}
.preview-tip {
  text-align: center;
  color: #999;
  font-size: 22rpx;
  margin-top: 14rpx;
}
