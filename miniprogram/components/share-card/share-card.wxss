.share-card {
  width: 100%;
}
/* 预览弹窗 */
.preview-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-box {
  /* 660rpx = 330px：扣掉左右 padding 才有 302px，放得下 1:1 的 300px 宽海报 */
  width: 660rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative; /* 给离屏 canvas 当定位父级 */
}
.preview-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.preview-title {
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}
.preview-close {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f2f3f5;
  padding: 14rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.poster-scroll {
  /* 只滚导出图：标题栏、公里数开关、按钮、提示都在滚动区外 */
  width: 100%;
}
.poster-img {
  display: block;
  border-radius: 12rpx;
  background: #fff;
}
.poster-loading {
  /* 撑满滚动视口：高度由父级 scroll-view 给，这里不写死 px（原先固定 120px，视口更高时下面空一片） */
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
}
/* 只画不显示：canvas 图层既不被 scroll-view 裁剪、opacity:0 在模拟器里也压不住（实测会把整张
   海报刷到按钮上），所以 CSS 只留 2px；导出的位图取 canvas.width/height，与这里的尺寸无关 */
.poster-canvas {
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: none;
}
.preview-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}
.preview-btn {
  flex: 0 0 48%;
  width: 48%;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-save {
  background: #2b6cf6;
  color: #fff;
}
.preview-share {
  background: #07c160;
  color: #fff;
}
.preview-tip {
  text-align: center;
  color: #999;
  font-size: 22rpx;
  margin-top: 14rpx;
}

/* 海报开关（公里数标注；文案+开关成组水平居右） */
.mini-toggle {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  width: 300px;
  padding: 0 4rpx;
  margin-top: 16rpx;
}
.mini-toggle-label {
  font-size: 26rpx;
  color: #333;
}
.mini-switch {
  transform: scale(0.8);
  transform-origin: right center;
}
