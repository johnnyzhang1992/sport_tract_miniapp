.share-card {
  width: 100%;
}
.poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
}
/* 预览弹窗 */
.preview-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-box {
  width: 640rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.preview-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}
.preview-img {
  width: 100%;
  border-radius: 12rpx;
  flex: 1;
  min-height: 0;
}
.preview-actions {
  display: flex;
  margin-top: 24rpx;
}
.preview-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-cancel {
  background: #f2f3f5;
  color: #666;
  margin-right: 20rpx;
}
.preview-save {
  background: #2b6cf6;
  color: #fff;
  margin-right: 20rpx;
}
.preview-share {
  background: #07c160;
  color: #fff;
}
.preview-tip {
  text-align: center;
  color: #999;
  font-size: 22rpx;
  margin-top: 16rpx;
}
