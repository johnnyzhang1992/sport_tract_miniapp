<!-- 详情半屏（观感同 pages/footprints 既有 .mask/.sheet）；补拉期间只显示「加载中…」骨架 -->
<view wx:if="{{visible}}" class="mask" bindtap="onMaskTap">
  <view class="sheet {{safeBottom ? '' : 'sheet-no-safe'}}" catchtap="noop">
    <view class="sheet-head">
      <view class="sheet-title">{{detail.title || ''}}</view>
      <view class="sheet-close" catchtap="onClose">✕</view>
    </view>
    <block wx:if="{{detail}}">
      <view class="sheet-metarow">
        <view class="sheet-meta">{{detail.metaText}}</view>
        <view wx:if="{{detail.categoryLabel}}" class="cat-tag">
          <image class="cat-tag-icon" src="{{detail.categoryIcon}}" mode="aspectFit" />
          <text>{{detail.categoryLabel}}</text>
        </view>
      </view>
      <view wx:if="{{detail.peopleText}}" class="sheet-people">同行：{{detail.peopleText}}</view>
      <view wx:if="{{detail.description}}" class="sheet-desc">{{detail.description}}</view>
      <scroll-view wx:if="{{detail.photoThumbs.length}}" scroll-x class="sheet-photos">
        <image
          wx:for="{{detail.photoThumbs}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          class="sheet-photo"
          data-idx="{{index}}"
          bindtap="previewPhoto"
        />
      </scroll-view>
      <view class="sheet-actions">
        <button class="act-btn" size="mini" bindtap="onEdit">编辑</button>
        <button class="act-btn danger" size="mini" bindtap="onDelete">删除</button>
      </view>
    </block>
    <view wx:elif="{{loading}}" class="sheet-loading">加载中…</view>
  </view>
</view>
