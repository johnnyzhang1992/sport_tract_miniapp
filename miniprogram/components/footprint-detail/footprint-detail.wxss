/* 详情半屏：与 pages/footprints 既有的 .mask/.sheet 观感一致（组件自带样式，不依赖页面） */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
/* tab 页的弹层：底边在 tabBar 上方，不加屏幕安全区 */
.sheet-no-safe {
  padding-bottom: 24rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 8rpx;
}
.sheet-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sheet-close {
  flex: none;
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 30rpx;
  color: #999;
}
.sheet-loading {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
.sheet-meta {
  font-size: 24rpx;
  color: #8a9099;
}
.sheet-people {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #1f2329;
}
.sheet-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #4b525c;
}
.sheet-photos {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}
.sheet-photo {
  display: inline-block;
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
}
.sheet-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 28rpx;
}
.act-btn {
  margin: 0 0 0 16rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #2b6cf6;
  background: #eef4ff;
  border-radius: 16rpx;
}
.act-btn.danger {
  color: #e54d42;
  background: #fdecec;
}
