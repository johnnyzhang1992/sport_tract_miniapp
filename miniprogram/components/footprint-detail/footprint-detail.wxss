/* 详情半屏：与 pages/footprints 既有的 .mask/.sheet 观感一致（组件自带样式，不依赖页面） */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
/* tab 页的弹层：底边在 tabBar 上方，不加屏幕安全区 */
.sheet-no-safe {
  padding-bottom: 24rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 8rpx;
}
/* 标题 + 操作图标成一组靠左（原来标题 flex:1 把图标顶到行尾、贴着 ✕）；
   min-width:0 配 flex:0 1 auto 才让长标题该缩就缩、出省略号，图标不被挤掉 */
.head-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.sheet-title {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sheet-close {
  flex: none;
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 30rpx;
  color: #999;
}
.sheet-loading {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
.sheet-meta {
  font-size: 24rpx;
  color: #8a9099;
}
/* 日期·地点 一行，分类标签跟在后面（未分类时不渲染标签，行高不变） */
.sheet-metarow {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cat-tag {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #4e5969;
  font-size: 22rpx;
}
.cat-tag-icon {
  width: 26rpx;
  height: 26rpx;
}
.sheet-people {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #1f2329;
}
.sheet-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #4b525c;
}
.sheet-photos {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}
.sheet-photo {
  display: inline-block;
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
}
/* 标题行右侧的操作图标（编辑 / 删除），与 ✕ 同一档基线；
   内边距把可点区域撑到 64rpx 见方（图标本身只有 32rpx，裸图标太难点） */
.sheet-act {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 16rpx 28rpx;
}
.sheet-act-icon {
  width: 32rpx;
  height: 32rpx;
}
