/* 成员信息半屏：与 footprint-filter-sheet / track-filter-sheet 同一套 .mask/.sheet 观感（组件自带样式，不依赖页面） */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 8rpx;
}
.sheet-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.sheet-close {
  flex: none;
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 30rpx;
  color: #999;
}

.member-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0 8rpx;
}
.member-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2f3f5;
}
.member-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  background: #b8c4d9;
}
.member-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-row {
  display: flex;
  margin-top: 20rpx;
  padding: 24rpx 0;
  background: #f7f8fa;
  border-radius: 16rpx;
}
.stat-cell {
  flex: 1;
  text-align: center;
}
.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a93a6;
}
.member-tip {
  padding: 20rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a93a6;
}
