/* 成员信息半屏：与 footprint-filter-sheet / track-filter-sheet 同一套 .mask/.sheet 观感（组件自带样式，不依赖页面） */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  /* 显式高于页面 .me-card（z-index:100），不靠节点顺序压住 */
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 8rpx;
}
.sheet-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.sheet-close {
  flex: none;
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 30rpx;
  color: #999;
}

.member-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0 8rpx;
}
.member-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2f3f5;
}
.member-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  background: #b8c4d9;
}
.member-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-row {
  display: flex;
  margin-top: 20rpx;
  padding: 24rpx 0;
  background: #f7f8fa;
  border-radius: 16rpx;
}
.stat-cell {
  flex: 1;
  text-align: center;
}
.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a93a6;
}
.member-tip {
  padding: 20rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a93a6;
}

/* 发起人视角：计入的轨迹明细（分页列表 + 加载更多） */
.detail-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 24rpx;
}
.detail-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}
.detail-total {
  font-size: 22rpx;
  color: #8a93a6;
}
/* 列表本体可滚动：明细最多一页 20 条，超出由列表内部消化，不把整张半屏顶穿 */
.detail-list {
  max-height: 44vh;
}
.detail-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.detail-row:last-child {
  border-bottom: none;
}
.detail-main {
  flex: 1;
  min-width: 0;
}
.detail-name {
  font-size: 26rpx;
  color: #1f2329;
}
.detail-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a93a6;
}
.detail-right {
  flex-shrink: 0;
  text-align: right;
}
.detail-dist {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
}
.detail-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #8a93a6;
}
.detail-error {
  padding: 20rpx 0 0;
  text-align: center;
  font-size: 22rpx;
  color: #e5484d;
}
.detail-more {
  margin-top: 20rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2b6cf6;
  background: #eaf1ff;
  border-radius: 999rpx;
}
.detail-more-hover {
  opacity: 0.85;
}
