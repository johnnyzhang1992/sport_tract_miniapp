/* 成员信息半屏：与 footprint-filter-sheet / track-filter-sheet 同一套 .mask/.sheet 观感（组件自带样式，不依赖页面） */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  /* 真半屏：固定高度（不是只靠内容堆），上方留出 18% 暗区看得到底层页面。
     高度必须确定，否则里面按 flex 收缩的 scroll-view 拿不到确定高度、
     就没有可滚范围（实测：auto 基准时 scroll-top 不生效） */
  display: flex;
  flex-direction: column;
  height: 82vh;
}
.sheet-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0 8rpx;
}
.sheet-close {
  flex: none;
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 30rpx;
  color: #999;
}

.member-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2f3f5;
}
.member-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  background: #64748f;
}
.member-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 点自己（没有对照）时的一行汇总；有对照时三项在对照行里，不再重复一张卡 */
.stat-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #4e5969;
}
.stat-line-item {
  font-variant-numeric: tabular-nums;
}
.stat-line-dot {
  color: #b0b4bb;
}
/* 「我 vs TA」对照：三项同口径，胜方高亮，差距写清楚 */
.cmp {
  margin-top: 12rpx;
  padding: 8rpx 16rpx 4rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
}
.cmp-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 4rpx;
}
.cmp-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}
.cmp-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #eef0f4;
}
.cmp-row:last-child {
  border-bottom: none;
}
.cmp-label {
  width: 60rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #667080;
}
.cmp-vals {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.cmp-val {
  font-size: 26rpx;
  color: #4e5969;
  font-variant-numeric: tabular-nums;
}
/* 胜方：本人＝主色、TA＝橙色，差在颜色而不是加粗（细看更好分辨） */
.cmp-val-me.cmp-val-hi {
  color: #2b6cf6;
  font-weight: 700;
}
.cmp-val-ta.cmp-val-hi {
  color: #ff7a45;
  font-weight: 700;
}
.cmp-vs {
  font-size: 22rpx;
  color: #b0b4bb;
}
.cmp-diff {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #667080;
}
/* 计入的轨迹明细（分页列表 + 加载更多） */
.detail-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 24rpx;
}
.detail-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}
.detail-total {
  font-size: 22rpx;
  color: #667080;
}
/* 列表本体可滚动：高度必须确定才有可滚范围（flex 基准取 0，长度由父级剩余空间给出），
   明细最多一页 20 条，超出由列表内部消化，不把整张半屏顶穿 */
.detail-list {
  flex: 1 1 0;
  height: 0;
  min-height: 0;
}
.detail-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.detail-row:last-child {
  border-bottom: none;
}
.detail-main {
  flex: 1;
  min-width: 0;
}
.detail-name {
  font-size: 26rpx;
  color: #1f2329;
}
.detail-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #667080;
}
.detail-right {
  flex-shrink: 0;
  text-align: right;
}
.detail-dist {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
}
.detail-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #667080;
}
.detail-error {
  padding: 20rpx 0 0;
  text-align: center;
  font-size: 22rpx;
  color: #c02a30;
}
.detail-more {
  margin-top: 20rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2b6cf6;
  background: #eaf1ff;
  border-radius: 999rpx;
}
.detail-more-hover {
  opacity: 0.85;
}
