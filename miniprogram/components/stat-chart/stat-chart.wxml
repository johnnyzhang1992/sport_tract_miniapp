<view class="stat-chart">
  <view class="chart-legend" wx:if="{{type === 'grouped-bar' && hasData}}">
    <view class="legend-item" wx:for="{{series}}" wx:key="name">
      <view class="legend-dot" style="background: {{item.color}}"></view>
      <text>{{item.name}}</text>
    </view>
  </view>
  <canvas type="2d" id="chartCanvas" class="chart-canvas" style="height: {{height}}px" bindtap="onChartTap"></canvas>
  <view class="chart-empty" wx:if="{{!hasData}}">{{emptyText}}</view>
</view>
