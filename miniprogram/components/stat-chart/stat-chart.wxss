.stat-chart {
  position: relative;
  width: 100%;
  overflow: hidden; /* 防止绘制溢出影响布局/穿透 */
}
.chart-canvas {
  width: 100%;
  display: block;
}
.chart-empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 24rpx;
  background: #fafbfc;
  border-radius: 12rpx;
}
