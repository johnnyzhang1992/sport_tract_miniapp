.stat-chart {
  position: relative;
  z-index: 0; /* 独立合成层，防止滚动时与固定按钮组穿插 */
  width: 100%;
  overflow: hidden; /* 防止绘制溢出影响布局/穿透 */
  transform: translateZ(0); /* 强制 GPU 合成，缓解滚动抖动 */
}
.chart-canvas {
  width: 100%;
  display: block;
}
.chart-empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 24rpx;
  background: #fafbfc;
  border-radius: 12rpx;
}
.chart-legend {
  display: flex;
  gap: 24rpx;
  padding: 0 8rpx 8rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #667080;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}
