/* 半屏表单弹层（观感对齐 pages/footprints 既有的 .mask/.sheet：同色遮罩、24rpx 圆角、底部弹出） */
.fp-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.fp-sheet {
  /* 绝对定位（相对 .fp-mask）：键盘弹起时 JS 传入的 bottom/height 才会生效——
     弹层底部抬到键盘上沿、高度收缩，输入框不被键盘遮挡。非定位元素 bottom 无效（真机踩坑） */
  position: absolute;
  left: 0;
  right: 0;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.fp-head {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 8rpx;
}
.fp-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.fp-close {
  flex: none;
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 30rpx;
  color: #999;
}
.fp-body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  /* 键盘弹起压缩弹层高度后，被盖住的下半部分内容靠滚动触达 */
  overflow-y: auto;
}
/* tab 页的弹层：底边在 tabBar 上方，不加屏幕安全区 */
.fp-body-no-safe {
  padding-bottom: 24rpx;
}

/* —— 表单分组：白底发丝边框卡 + 行式布局（标签左、值右），内容与弹层标题同一条左基线 —— */
.fgroup {
  background: #fff;
  border: 1rpx solid #eef0f3;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.frow {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 12rpx 24rpx;
}
.frow-tap {
  /* 整行可点（地点/日期），点击反馈与浮层入口同色 */
}
.frow-hover {
  background: #f7f8fa;
}
.flabel {
  flex: none;
  width: 132rpx;
  font-size: 30rpx;
  color: #1f2329;
}
.fval {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #1f2329;
  word-break: break-all;
}
.fval-ph {
  color: #c2c7d0;
}
.fval-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a93a6;
}
.farrow {
  flex: none;
  margin-left: 8rpx;
  color: #c2c7d0;
  font-size: 32rpx;
  line-height: 1;
}
/* 输入行：文字右对齐，占位色与 .fval-ph 一致 */
.finput {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #1f2329;
  text-align: right;
}
.fph {
  color: #c2c7d0;
}
.fadd {
  flex: none;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #2b6cf6;
}
.fadd-hover {
  opacity: 0.6;
}
/* 组内说明行（22rpx 次级灰，与标签同一条左基线） */
.fnote {
  padding: 0 24rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8a93a6;
}

/* 同行的人：标签（可点删） */
.fpeople {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx 16rpx;
}
.people-tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #4e5969;
  font-size: 26rpx;
}
/* 分类 chips：透明底黑字形（fp-cat-<key>.png），选中态换成品牌蓝底 + 白字 */
.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.cat-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #4e5969;
  font-size: 26rpx;
}
.cat-icon {
  width: 30rpx;
  height: 30rpx;
}
.cat-chip-on {
  background: #2b6cf6;
  color: #fff;
}
.tag-x {
  margin-left: 10rpx;
  color: #999;
  font-size: 30rpx;
}

/* 非行式控件（描述/照片）：标签在上，控件占满整行 */
.flabel-block {
  padding: 24rpx 24rpx 0;
  font-size: 30rpx;
  color: #1f2329;
}
.ftextarea-wrap {
  padding: 16rpx 24rpx 8rpx;
}
.ftextarea {
  width: 100%;
  height: 180rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 图片九宫格（度量对齐 components/marker-form） */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 0;
}
.photo-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 16rpx 16rpx 0;
}
.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.photo-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
}
.photo-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 56rpx;
  box-sizing: border-box;
}
.photo-add-hover {
  background: #f7f8fa;
  color: #2b6cf6;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 32rpx;
  margin-top: 24rpx;
}
.submit-btn[disabled] {
  background: #cdd8f0;
  color: #fff;
}
.submit-tip {
  text-align: center;
  margin-top: 16rpx;
}
