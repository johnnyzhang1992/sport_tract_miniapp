<view class="mask" wx:if="{{visible}}" bindtap="cancel">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{editMode ? '编辑打点' : '打点'}}</view>

    <!-- 类型选择 -->
    <view class="type-row">
      <view
        wx:for="{{typeOptions}}"
        wx:key="type"
        class="type-pill {{selectedType === item.type ? 'type-pill-active' : ''}}"
        data-type="{{item.type}}"
        bindtap="selectType"
      >
        <image class="type-icon" src="{{item.iconImg}}" mode="aspectFit" />
        <text>{{item.label}}</text>
      </view>
    </view>

    <!-- 备注 -->
    <view class="input-wrap">
      <textarea
        class="note-input"
        placeholder="添加备注（可选）"
        maxlength="200"
        value="{{note}}"
        bindinput="onNoteInput"
      />
    </view>

    <!-- 已有照片（编辑模式，可删除） -->
    <view class="photo-section" wx:if="{{editMode && existingPhotos.length > 0}}">
      <view class="photo-label">已有照片</view>
      <view class="photo-grid">
        <view wx:for="{{existingPhotos}}" wx:key="*this" class="photo-item">
          <image class="photo-img" src="{{item}}" mode="aspectFill" />
          <view class="photo-remove" data-idx="{{index}}" bindtap="removeExistingPhoto"><image src="/assets/icons/lucide-x-white.png" mode="aspectFit" /></view>
        </view>
      </view>
    </view>

    <!-- 新选照片（未上传） -->
    <view class="photo-section" wx:if="{{photos.length > 0}}">
      <view class="photo-label">新照片（未上传）</view>
      <view class="photo-grid">
        <view wx:for="{{photos}}" wx:key="*this" class="photo-item">
          <image class="photo-img" src="{{item}}" mode="aspectFill" />
          <view class="photo-remove" data-idx="{{index}}" bindtap="removePhoto"><image src="/assets/icons/lucide-x-white.png" mode="aspectFit" /></view>
        </view>
      </view>
    </view>

    <!-- 添加照片（总量 ≤3） -->
    <view
      class="photo-add"
      wx:if="{{existingPhotos.length + photos.length < maxPhotos}}"
      bindtap="choosePhoto"
    >
      拍照 / 相册（{{existingPhotos.length + photos.length}}/{{maxPhotos}}）
    </view>

    <view class="actions">
      <button class="btn-del" wx:if="{{editMode}}" bindtap="del">删除</button>
      <button class="btn-cancel" bindtap="cancel">取消</button>
      <button class="btn-confirm" bindtap="confirm">确定</button>
    </view>
  </view>
</view>
