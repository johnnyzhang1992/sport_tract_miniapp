<view class="mask" wx:if="{{visible}}" bindtap="cancel">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">打点</view>

    <!-- 类型选择 -->
    <view class="type-row">
      <view
        wx:for="{{typeOptions}}"
        wx:key="type"
        class="type-pill {{selectedType === item.type ? 'type-pill-active' : ''}}"
        data-type="{{item.type}}"
        bindtap="selectType"
      >
        {{item.icon}} {{item.label}}
      </view>
    </view>

    <!-- 备注 -->
    <view class="input-wrap">
      <textarea
        class="note-input"
        placeholder="添加备注（可选）"
        maxlength="200"
        value="{{note}}"
        bindinput="onNoteInput"
      />
    </view>

    <!-- 多图预览 -->
    <view class="photo-grid" wx:if="{{photos.length > 0}}">
      <view wx:for="{{photos}}" wx:key="*this" class="photo-item">
        <image class="photo-img" src="{{item}}" mode="aspectFill" />
        <view class="photo-remove" data-idx="{{index}}" bindtap="removePhoto">✕</view>
      </view>
    </view>
    <!-- 添加照片（新增模式；编辑模式保留原照片不重选） -->
    <view class="photo-add" wx:if="{{!editMode && photos.length < maxPhotos}}" bindtap="choosePhoto">
      📷 拍照 / 相册（{{photos.length}}/{{maxPhotos}}）
    </view>

    <view class="actions">
      <button class="btn-del" wx:if="{{editMode}}" bindtap="del">删除</button>
      <button class="btn-cancel" bindtap="cancel">取消</button>
      <button class="btn-confirm" bindtap="confirm">确定</button>
    </view>
  </view>
</view>
