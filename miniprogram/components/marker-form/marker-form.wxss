.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}
.type-row {
  display: flex;
  flex-wrap: wrap;
}
.type-pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}
.type-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.type-pill-active {
  background: #eef4ff;
  color: #2b6cf6;
  border: 2rpx solid #2b6cf6;
}
.input-wrap {
  margin: 8rpx 0;
}
.note-input {
  width: 100%;
  height: 120rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}
/* 多图预览网格 */
.photo-section {
  margin-top: 8rpx;
}
.photo-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx 0;
}
.photo-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin: 0 16rpx 16rpx 0;
}
.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.photo-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background: rgba(0, 0, 0, 0.6);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  padding: 10rpx;
  box-sizing: border-box;
}
.photo-add {
  padding: 24rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  text-align: center;
  color: #666;
  font-size: 28rpx;
  margin: 8rpx 0 16rpx;
}
/* 移除旧的单图样式引用 */

.actions {
  display: flex;
  margin-top: 28rpx;
}
.btn-del,
.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}
/* 去掉原生 button 默认边框（::after）与圆角冲突 */
.btn-del::after,
.btn-cancel::after,
.btn-confirm::after {
  border: none;
}
.btn-del {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  margin-right: 20rpx;
}
.btn-cancel {
  background: #f2f3f5;
  color: #666;
  margin-right: 20rpx;
}
.btn-confirm {
  background: #2b6cf6;
  color: #fff;
}

/* 图标预设盘 */
.preset-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.preset-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  font-size: 24rpx;
  color: #4e5969;
  border: 2rpx solid transparent;
}
.preset-pill-active {
  background: #eef4ff;
  color: #2b6cf6;
  border-color: #2b6cf6;
}
.preset-emoji {
  font-size: 28rpx;
}
.label-wrap {
  margin-bottom: 20rpx;
}
.label-input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 27rpx;
}
