.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}
.type-row {
  display: flex;
  flex-wrap: wrap;
}
.type-pill {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
}
.type-pill-active {
  background: #eef4ff;
  color: #2b6cf6;
  border: 2rpx solid #2b6cf6;
}
.input-wrap {
  margin: 8rpx 0;
}
.note-input {
  width: 100%;
  height: 120rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}
.photo-row {
  position: relative;
  display: inline-block;
}
.photo-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}
.photo-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 22rpx;
}
.photo-add {
  padding: 24rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  text-align: center;
  color: #666;
  font-size: 28rpx;
  margin: 16rpx 0;
}
.actions {
  display: flex;
  margin-top: 28rpx;
}
.btn-del,
.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
}
.btn-del {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  margin-right: 20rpx;
}
.btn-cancel {
  background: #f2f3f5;
  color: #666;
  margin-right: 20rpx;
}
.btn-confirm {
  background: #2b6cf6;
  color: #fff;
}
