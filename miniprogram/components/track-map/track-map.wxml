<view class="map-container">
  <map
    id="trackMap"
    class="track-map"
    style="width: 100%; height: 100%; min-height: 300px;"
    latitude="{{centerLat}}"
    longitude="{{centerLng}}"
    scale="{{mapScale}}"
    rotate="{{mapRotate}}"
    markers="{{displayMarkers}}"
    polyline="{{polyline}}"
    show-location="{{false}}"
    show-scale="{{true}}"
    show-compass="{{true}}"
    enable-3D="{{false}}"
    enable-satellite="{{mapType === 'satellite'}}"
    enable-rotate="{{enableRotate}}"
    enable-poi="{{enablePoi}}"
    bindregionchange="onRegionChange"
    bindtap="onMapTap"
    bindmarkertap="onMarkerTap"
    bindcallouttap="onMapCalloutTap"
  ></map>
  <!-- 全屏关闭按钮（组件内，左上角） -->
  <view class="map-fullscreen-close" wx:if="{{showFullscreenClose}}" bindtap="closeFullscreen">
    <image class="map-fullscreen-close-icon" src="/assets/icons/lucide-x.png" mode="aspectFit" />
  </view>
  <!-- 全屏按钮（纯图标，与标注同容器，右下角最右） -->
  <view class="map-fullscreen-btn" wx:if="{{showFullscreen}}" bindtap="openFullscreen">
    <image class="map-fullscreen-icon" src="/assets/icons/lucide-maximize.png" mode="aspectFit" />
  </view>
  <!-- record 右上角按钮组：flex 容器统一排布（精度徽章 | 标注 | 图层），间距由容器 gap 控制 -->
  <view class="top-actions" wx:if="{{mode === 'record'}}">
    <view class="acc-badge {{weakSignal ? 'acc-badge-weak' : ''}}" wx:if="{{accuracy != null}}">
      <text class="acc-dot"></text> 精度 {{accuracy}}m
    </view>
    <view class="poi-btn {{enablePoi ? 'poi-btn-active' : ''}}" bindtap="togglePoi">
      <image class="poi-icon" src="{{enablePoi ? '/assets/icons/lucide-signpost-white.png' : '/assets/icons/lucide-signpost.png'}}" mode="aspectFit" />
    </view>
    <view class="layer-btn" wx:if="{{showLayerBtn}}" bindtap="switchLayer">
      <image class="btn-icon" src="{{mapType === 'standard' ? '/assets/icons/lucide-satellite.png' : '/assets/icons/lucide-map.png'}}" mode="aspectFit" />
      <text>{{mapType === 'standard' ? '卫星' : '标准'}}</text>
    </view>
  </view>
  <!-- 非 record 模式：标注按钮沿用原定位（右下角/全屏页右上角） -->
  <view wx:if="{{mode !== 'record'}}" class="poi-btn {{mode === 'overview' ? 'poi-btn-overview' : ''}} {{poiTopRight ? 'poi-btn-top-right' : ''}} {{poiBottomRight ? 'poi-btn-bottom-right' : ''}} {{enablePoi ? 'poi-btn-active' : ''}}" bindtap="togglePoi">
    <image class="poi-icon" src="{{enablePoi ? '/assets/icons/lucide-signpost-white.png' : '/assets/icons/lucide-signpost.png'}}" mode="aspectFit" />
  </view>
  <!-- 高频路线图例（四档频率配色：黑→黄→橙→红；与 POI 同容器，底部基准一致） -->
  <view class="heat-legend" wx:if="{{showHeatLegend}}">
    <view class="heat-legend-dot heat-legend-dot-0"></view>
    <view class="heat-legend-dot heat-legend-dot-1"></view>
    <view class="heat-legend-dot heat-legend-dot-2"></view>
    <view class="heat-legend-dot heat-legend-dot-3"></view>
    <text>低频 → 高频</text>
  </view>
</view>
