<map
  id="trackMap"
  class="track-map"
  style="width: 100%; height: 100%; min-height: 300px;"
  latitude="{{centerLat}}"
  longitude="{{centerLng}}"
  scale="{{15}}"
  markers="{{displayMarkers}}"
  polyline="{{polyline}}"
  circles="{{heatCircles}}"
  show-location="{{false}}"
  enable-3D="{{false}}"
  enable-satellite="{{mapType === 'satellite'}}"
  bindtap="onMapTap"
  bindmarkertap="onMarkerTap"
  bindcallouttap="onMapCalloutTap"
></map>
