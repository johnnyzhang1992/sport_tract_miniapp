.map-container {
  position: relative;
  width: 100%;
  height: 100%;
}
.track-map {
  width: 100%;
  height: 100%;
}
/* POI 切换按钮（默认：右下角，全屏按钮左边） */
.poi-btn {
  position: absolute;
  bottom: 16rpx;
  right: 180rpx; /* 全屏按钮（right 24）左边，适中间距 */
  z-index: 10;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #4e5969;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
/* record 模式：右上角（图层按钮下方），避开底部操作栏 */
.poi-btn-top {
  bottom: auto;
  top: 16rpx; /* 右上角同一行：精度|标注|卫星 */
  right: 160rpx; /* 卫星按钮（right 24）左侧 */
  left: auto !important;
}
/* 全屏关闭按钮（左上角，组件内统一） */
.map-fullscreen-close {
  position: absolute;
  top: calc(16rpx + env(safe-area-inset-top));
  left: 88rpx; /* 往左移半个按钮宽 */
  z-index: 10;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  box-sizing: border-box;
}
.map-fullscreen-close-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 全屏按钮（右下角最右，与标注同容器） */
.map-fullscreen-btn {
  position: absolute;
  bottom: 16rpx;
  right: 24rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #4e5969;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
.map-fullscreen-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

/* 右下角贴右（无全屏按钮的页面，如 summary） */
.poi-btn-bottom-right {
  right: 24rpx;
}
/* overview 模式：右下角，全屏按钮（right 24）左侧 */
.poi-btn-overview {
  right: 175rpx;
}
/* 全屏地图：右上角，图层按钮（right 24，宽约 140）左侧，留足间距 */
.poi-btn-top-right {
  bottom: auto;
  top: calc(16rpx + env(safe-area-inset-top));
  right: 185rpx; /* 右上角：卫星按钮（right 24）左侧（真机指南针在左侧） */
  left: auto !important;
  width: fit-content; /* 宽度跟随内容 */
}
.poi-btn-active {
  background: #2b6cf6;
  color: #fff;
}
.poi-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}

/* 高频路线图例（与 POI 同一容器：底部对齐，POI 左边） */
.heat-legend {
  position: absolute;
  bottom: 16rpx;
  left: 24rpx; /* 左下角（右下角让给全屏+标注按钮组） */
  z-index: 10;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx; /* 与 POI 按钮字号一致 */
  color: #4e5969;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
.heat-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff9800;
  margin-right: 10rpx;
}

