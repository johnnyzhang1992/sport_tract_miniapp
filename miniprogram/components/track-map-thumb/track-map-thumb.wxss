.thumb-root {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 12rpx;
  background: #f2f3f5;
}
.track-map-mini {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.map-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.map-placeholder-icon {
  font-size: 36rpx;
  opacity: 0.55;
}
.map-placeholder-icon-img {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.5;
}
.map-placeholder-text {
  font-size: 20rpx;
  color: #667080;
}
