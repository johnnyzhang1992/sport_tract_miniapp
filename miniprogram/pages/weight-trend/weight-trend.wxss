.container {
  padding: 24rpx;
}

/* 最新体重统计卡 */
.stat-card {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 24rpx;
}
.stat-block {
  text-align: center;
}
.stat-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 维度切换 */
.range-row {
  display: flex;
  gap: 16rpx;
}
.range-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background: #f2f3f5;
  font-size: 26rpx;
  color: #666;
}
.range-btn-active {
  background: #eef4ff;
  color: #2b6cf6;
  border: 2rpx solid #2b6cf6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.loading-tip {
  text-align: center;
  padding: 24rpx 0;
}

/* 快捷记录今日体重 */
.weight-input-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}
.weight-input {
  flex: 1;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}
.weight-save-btn {
  background: #2b6cf6;
  color: #fff;
  font-size: 26rpx;
  padding: 0 32rpx;
}
