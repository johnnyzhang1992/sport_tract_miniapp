.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f6f7fb;
}

.state {
  text-align: center;
  color: #8a93a6;
  font-size: 28rpx;
  padding: 80rpx 0;
}
.state-text { margin-bottom: 16rpx; }
.state-link { color: #2b6cf6; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 额度总览 */
.quota-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.quota-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.quota-num .used {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
}
.quota-num .limit {
  font-size: 24rpx;
  color: #8a93a6;
  margin-left: 6rpx;
}
.bar {
  height: 12rpx;
  border-radius: 8rpx;
  background: #eef0f5;
  overflow: hidden;
  margin: 16rpx 0 12rpx;
}
.bar-fill {
  height: 100%;
  border-radius: 8rpx;
  background: #2b6cf6;
}
.bar-fill.over {
  background: #e34d59;
}
.quota-foot {
  font-size: 24rpx;
  color: #8a93a6;
  line-height: 1.5;
}
.quota-foot.warn {
  color: #e34d59;
}

/* 工具行：全选 / 删除 */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 8rpx 16rpx;
}
.tool-left {
  font-size: 26rpx;
  color: #2b6cf6;
}
.tool-right {
  font-size: 26rpx;
  color: #e34d59;
  font-weight: 500;
}
.tool-right.off {
  color: #b6bcc8;
  font-weight: 400;
}

/* 分组 */
.group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}
.group-date {
  font-size: 22rpx;
  color: #8a93a6;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f2f3f5;
}
.cell.on {
  outline: 4rpx solid #2b6cf6;
}
.thumb {
  width: 100%;
  height: 100%;
  display: block;
}
/* 未选=空心圈（避免实心圆被误读为已选）；已选=蓝底对勾 */
.tick {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  background: rgba(0, 0, 0, 0.15);
  color: #fff;
  font-size: 24rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}
.cell.on .tick {
  border-color: #2b6cf6;
  background: #2b6cf6;
  line-height: 30rpx;
}
