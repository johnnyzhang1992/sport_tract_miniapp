<view class="record-page">
  <!-- 全屏地图 -->
  <view class="map-wrap">
    <track-map
      id="trackMap"
      points="{{mapPoints}}"
      markers="{{mapMarkers}}"
      currentLocation="{{currentLocation}}"
      followMode="{{followMode}}"
      mapType="{{mapType}}"
      mode="record"
    />
    <!-- 图层切换 -->
    <view class="layer-btn" bindtap="switchLayer">
      {{mapType === 'standard' ? '🛰️ 卫星' : '🗺️ 标准'}}
    </view>
    <!-- GPS 信号弱提示（室内/遮挡） -->
    <view class="weak-tip" wx:if="{{weakSignal}}">📡 GPS 信号弱，距离可能不准</view>
  </view>

  <!-- 实时数据面板 -->
  <view class="stats-wrap">
    <live-stats
      distanceKm="{{stats.distanceKm}}"
      durationText="{{stats.durationText}}"
      paceText="{{stats.paceText}}"
      altitude="{{stats.altitude}}"
      climb="{{stats.climb}}"
      calories="{{stats.calories}}"
      paused="{{paused}}"
    />
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <view class="action-item" bindtap="openMarkerForm">
      <view class="action-icon">📍</view>
      <view class="action-label">打点</view>
    </view>
    <view class="action-item" bindtap="togglePause">
      <view class="action-icon big">{{paused ? '▶️' : '⏸️'}}</view>
      <view class="action-label">{{paused ? '继续' : '暂停'}}</view>
    </view>
    <view class="action-item" bindtap="openEndConfirm">
      <view class="action-icon big danger">⏹️</view>
      <view class="action-label">结束</view>
    </view>
  </view>

  <!-- 打点弹窗 -->
  <marker-form
    visible="{{markerFormVisible}}"
    currentLocation="{{currentLocation}}"
    bindconfirm="onMarkerConfirm"
    bindcancel="onMarkerCancel"
  />

  <!-- 结束确认（t-dialog） -->
  <t-dialog
    visible="{{endConfirmVisible}}"
    title="结束本次运动？"
    content="将跳转到摘要页，保存后不可再补充轨迹点"
    confirm-btn="结束"
    cancel-btn="继续运动"
    bind:confirm="confirmEnd"
    bind:cancel="cancelEnd"
  />

  <!-- 初始化/错误状态 -->
  <view class="init-mask" wx:if="{{starting || error}}">
    <view class="init-box">
      <view wx:if="{{error}}">{{error}}</view>
      <view wx:else>{{typeIcon}} {{typeLabel}} · 定位中…</view>
    </view>
  </view>
</view>
