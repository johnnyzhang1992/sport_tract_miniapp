<view class="record-page">
  <!-- 全屏地图 -->
  <view class="map-wrap">
    <track-map
      id="trackMap"
      points="{{mapPoints}}"
      markers="{{mapMarkers}}"
      currentLocation="{{currentLocation}}"
      followMode="{{followMode}}"
      mapType="{{mapType}}"
      mode="record"
    />
    <!-- 图层切换 -->
    <view class="layer-btn" bindtap="switchLayer">
      <image class="btn-icon" src="{{mapType === 'standard' ? '/assets/icons/lucide-satellite.png' : '/assets/icons/lucide-map.png'}}" mode="aspectFit" />
      <text>{{mapType === 'standard' ? '卫星' : '标准'}}</text>
    </view>
    <!-- 实时精度徽章（常驻；弱信号时橙色） -->
    <view class="acc-badge {{weakSignal ? 'acc-badge-weak' : ''}}" wx:if="{{currentAccuracy != null}}">
      <text class="acc-dot"></text> 精度 {{currentAccuracy}}m
    </view>
  </view>

  <!-- 实时数据面板（点击贴左收齐/展开） -->
  <view class="stats-wrap {{statsCollapsed ? 'stats-collapsed' : ''}}" bindtap="toggleStats">
    <view class="stats-collapsed-bar" wx:if="{{statsCollapsed}}">
      <text class="scb-dist">{{stats.distanceKm}}</text>
      <text class="scb-unit">公里</text>
      <text class="scb-dur">{{stats.durationText}}</text>
    </view>
    <live-stats
      wx:else
      distanceKm="{{stats.distanceKm}}"
      durationText="{{stats.durationText}}"
      paceText="{{stats.paceText}}"
      altitude="{{stats.altitude}}"
      climb="{{stats.climb}}"
      calories="{{stats.calories}}"
      paused="{{paused}}"
    />
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <view class="action-item" bindtap="openMarkerForm">
      <image class="action-icon" src="/assets/icons/lucide-pin.png" mode="aspectFit" />
      <view class="action-label">打点</view>
    </view>
    <view class="action-item" bindtap="togglePause">
      <image class="action-icon big" src="{{paused ? '/assets/icons/lucide-play.png' : '/assets/icons/lucide-pause.png'}}" mode="aspectFit" />
      <view class="action-label">{{paused ? '继续' : '暂停'}}</view>
    </view>
    <view class="action-item" bindtap="openEndConfirm">
      <image class="action-icon big danger" src="/assets/icons/lucide-stop-red.png" mode="aspectFit" />
      <view class="action-label">结束</view>
    </view>
  </view>

  <!-- 打点弹窗 -->
  <marker-form
    visible="{{markerFormVisible}}"
    currentLocation="{{currentLocation}}"
    bindconfirm="onMarkerConfirm"
    bindcancel="onMarkerCancel"
  />

  <!-- 结束确认（t-dialog） -->
  <t-dialog
    visible="{{endConfirmVisible}}"
    title="结束本次运动？"
    content="将跳转到摘要页，保存后不可再补充轨迹点"
    confirm-btn="结束"
    cancel-btn="继续运动"
    bind:confirm="confirmEnd"
    bind:cancel="cancelEnd"
  />

  <!-- 初始化/错误状态 -->
  <view class="init-mask" wx:if="{{starting || error}}">
    <view class="init-box">
      <block wx:if="{{error}}">
        <view>{{error}}</view>
        <button class="auth-btn" bindtap="retryAuth">重新授权</button>
      </block>
      <view wx:else><image class="title-icon" src="{{typeIconImg}}" mode="aspectFit"></image> {{typeLabel}} · 定位中…</view>
    </view>
  </view>
</view>
