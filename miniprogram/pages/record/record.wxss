.record-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}
.map-wrap {
  position: absolute;
  inset: 0;
}
.btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.layer-btn {
  position: absolute;
  top: 16rpx;
  right: 24rpx; /* 右上角（真机指南针在左侧） */
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  padding: 10rpx 22rpx; /* 与精度/标注按钮统一高度 */
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
}
.acc-badge {
  position: absolute;
  top: 16rpx;
  right: 310rpx; /* 右上角一行：精度（最左）|标注|卫星 */
  background: rgba(44, 187, 110, 0.92);
  color: #fff;
  border-radius: 999rpx;
  padding: 10rpx 22rpx; /* 与卫星/标注按钮统一高度 */
  font-size: 22rpx;
  z-index: 5;
  display: flex;
  align-items: center;
}
.acc-badge-weak {
  background: rgba(255, 152, 0, 0.92);
}
.acc-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
  margin-right: 10rpx;
}
.stats-wrap {
  position: absolute;
  left: 24rpx;
  top: 100rpx;
  width: 430rpx; /* 缩小宽度：右侧留白，不盖住右上角指南针 */
  z-index: 10;
}
/* 贴左收齐态：窄条只显示距离+时长（宽度随内容自适应，文字不换行） */
.stats-collapsed {
  width: fit-content;
  max-width: 70vw;
}
.stats-collapsed-bar {
  display: flex;
  align-items: baseline;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
  white-space: nowrap;
}
.scb-dist {
  font-size: 34rpx;
  font-weight: 700;
  color: #2b6cf6;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.scb-unit {
  font-size: 20rpx;
  color: #999;
  margin-left: 6rpx;
  margin-right: 16rpx;
  white-space: nowrap;
}
.scb-dur {
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.action-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(transparent, rgba(255, 255, 255, 0.8) 30%);
  display: flex;
  justify-content: space-around;
  z-index: 10;
}
.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.action-icon {
  width: 96rpx;
  height: 96rpx;
  padding: 26rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}
.action-icon.big {
  padding: 22rpx;
}
.action-label {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
}
.init-mask {
  position: fixed;
  inset: 0;
  background: rgba(255, 255, 255, 0.9);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.init-box {
  font-size: 36rpx;
  color: #666;
  padding: 48rpx;
  max-width: 620rpx;
  text-align: center;
  line-height: 1.7;
}

.title-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}

/* 权限错误：重新授权按钮 */
.auth-btn {
  margin-top: 24rpx;
  background: #2b6cf6;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 12rpx 48rpx;
  line-height: 1.6;
  border: none;
}
.auth-btn::after {
  border: none;
}

/* 错误次要提示行 */
.error-hint {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #999;
}

/* 胶囊最小化引导（运动开始后弹，点击任意处关闭） */
.capsule-guide-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 500; /* 压过页面所有层（打点表单 200） */
}
.capsule-guide-card {
  position: absolute;
  /* 默认导航栏页：fixed 坐标系从导航栏下方开始，胶囊在导航栏内（视口上方约 8px 处收尾）
     top:8px → 卡片视觉上贴在胶囊正下方；right:10px → 与胶囊右缘对齐，箭头指向 ⊙ */
  top: 8px;
  right: 10px;
  max-width: 440rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx 18rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.25);
}
.capsule-guide-arrow {
  position: absolute;
  top: -12rpx;
  right: 36rpx; /* 指向导航栏内的 ⊙（胶囊右侧按钮） */
  width: 24rpx;
  height: 24rpx;
  background: #fff;
  transform: rotate(45deg);
  border-radius: 4rpx;
}
.capsule-guide-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 10rpx;
}
.capsule-guide-text {
  font-size: 26rpx;
  color: #5c6470;
  line-height: 1.5;
}
.capsule-guide-footer {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.capsule-guide-btn {
  font-size: 26rpx;
  font-weight: 500;
  color: #2b6cf6;
  padding: 6rpx 20rpx;
  margin-left: -20rpx; /* 文字视觉贴卡片左缘 */
}
.capsule-guide-hint {
  font-size: 22rpx;
  color: #9aa3ad;
}
