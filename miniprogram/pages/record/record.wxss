.record-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}
.map-wrap {
  position: absolute;
  inset: 0;
}
.btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.layer-btn {
  position: absolute;
  top: 16rpx;
  right: 24rpx; /* 右上角（真机指南针在左侧） */
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  padding: 10rpx 22rpx; /* 与精度/标注按钮统一高度 */
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
}
.acc-badge {
  position: absolute;
  top: 16rpx;
  right: 310rpx; /* 右上角一行：精度（最左）|标注|卫星 */
  background: rgba(44, 187, 110, 0.92);
  color: #fff;
  border-radius: 999rpx;
  padding: 10rpx 22rpx; /* 与卫星/标注按钮统一高度 */
  font-size: 22rpx;
  z-index: 5;
  display: flex;
  align-items: center;
}
.acc-badge-weak {
  background: rgba(255, 152, 0, 0.92);
}
.acc-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
  margin-right: 10rpx;
}
.stats-wrap {
  position: absolute;
  left: 24rpx;
  top: 100rpx;
  width: 430rpx; /* 缩小宽度：右侧留白，不盖住右上角指南针 */
  z-index: 10;
}
/* 贴左收齐态：窄条只显示距离+时长 */
.stats-collapsed {
  width: 260rpx;
}
.stats-collapsed-bar {
  display: flex;
  align-items: baseline;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}
.scb-dist {
  font-size: 34rpx;
  font-weight: 700;
  color: #2b6cf6;
  font-variant-numeric: tabular-nums;
}
.scb-unit {
  font-size: 20rpx;
  color: #999;
  margin-left: 6rpx;
  margin-right: 16rpx;
}
.scb-dur {
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.action-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(transparent, rgba(255, 255, 255, 0.8) 30%);
  display: flex;
  justify-content: space-around;
  z-index: 10;
}
.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.action-icon {
  width: 96rpx;
  height: 96rpx;
  padding: 26rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}
.action-icon.big {
  padding: 22rpx;
}
.action-label {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
}
.init-mask {
  position: fixed;
  inset: 0;
  background: rgba(255, 255, 255, 0.9);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.init-box {
  font-size: 32rpx;
  color: #666;
}

.title-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}

/* 权限错误：重新授权按钮 */
.auth-btn {
  margin-top: 24rpx;
  background: #2b6cf6;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 12rpx 48rpx;
  line-height: 1.6;
  border: none;
}
.auth-btn::after {
  border: none;
}
