<view class="container" wx:if="{{activity}}">
  <!-- 轨迹图（view 模式自动 fitView）+ 图层切换 + 动态轨迹 + 全屏 -->
  <view class="map-wrap">
    <track-map
      id="detailMap"
      points="{{mapPoints}}"
      markers="{{markers}}"
      kmMarkers="{{kmMarkers}}"
      mapType="{{mapType}}"
      mode="view"
      color-mode="{{colorMode}}"
      activity-type="{{activityType}}"
      peak-marker="{{peakMarker}}"
      showStartEnd
      bindmarkertap="onMarkerTap"
      bindreplayend="onReplayEnd"
    />
    <view class="layer-btn" bindtap="switchLayer">
      <image class="btn-icon" src="{{mapType === 'standard' ? '/assets/icons/lucide-satellite.png' : '/assets/icons/lucide-map.png'}}" mode="aspectFit" />
      <text>{{mapType === 'standard' ? '卫星' : '标准'}}</text>
    </view>
    <view class="replay-btn {{replaying ? 'replay-btn-active' : ''}}" bindtap="startReplay">
      <image class="btn-icon" src="{{replaying ? '/assets/icons/lucide-stop-white.png' : '/assets/icons/lucide-circle-play.png'}}" mode="aspectFit" />
      <text>{{replaying ? '停止' : '动态轨迹'}}</text>
    </view>
    <view class="fullscreen-btn" bindtap="openFullscreen"><image class="btn-icon fullscreen-icon" src="/assets/icons/lucide-maximize.png" mode="aspectFit" /></view>
  </view>

  <!-- 全屏地图弹窗（不拦截 touch：map 手势需要 touchmove 做缩放/拖动） -->
  <view class="fullscreen-mask" wx:if="{{fullscreen}}">
    <view class="fullscreen-layer" bindtap="fsSwitchLayer">
      <image class="btn-icon" src="{{mapType === 'standard' ? '/assets/icons/lucide-satellite.png' : '/assets/icons/lucide-map.png'}}" mode="aspectFit" />
      <text>{{mapType === 'standard' ? '卫星' : '标准'}}</text>
    </view>
    <view class="fullscreen-map-wrap">
      <track-map
        id="fullscreenMap"
        points="{{mapPoints}}"
        markers="{{markers}}"
        mapType="{{mapType}}"
        mode="view"
        color-mode="{{colorMode}}"
        activity-type="{{activityType}}"
        peak-marker="{{peakMarker}}"
        showStartEnd
        poi-top-right
        show-fullscreen-close
        bind:close-fullscreen="closeFullscreen"
      />
    </view>
  </view>

  <!-- 指标 -->
  <view class="card">
    <view class="hero-row">
      <view class="hero-left">
        <view class="hero-title">
          <image class="title-icon" src="{{activity.iconImg}}" mode="aspectFit" />
          <text>{{activity.label}}</text>
          <text class="edit-btn" wx:if="{{activity.isOwner}}" bindtap="openEdit">编辑</text>
        </view>
        <view class="hero-dist">
          <text class="hero-num">{{activity.distanceKm}}</text>
          <text class="hero-unit">公里</text>
        </view>
      </view>
      <view class="hero-user">
        <image class="hero-avatar" src="{{userAvatar}}" mode="aspectFill" />
        <text class="hero-nickname">{{userNickname}}</text>
        <view class="hero-date">{{activity.startTimeText}}</view>
      </view>
    </view>
    <view class="note-text" wx:if="{{activity.note}}">{{activity.note}}</view>
    <!-- 轨迹线颜色说明（徒步/爬山按海拔，其余按配速） -->
    <view class="legend-row">
      <text class="legend-text">{{colorMode === 'altitude' ? '海拔低' : '慢 ' + paceSlowText}}</text>
      <view class="legend-bar {{colorMode === 'altitude' ? 'legend-bar-altitude' : 'legend-bar-pace'}}"></view>
      <text class="legend-text">{{colorMode === 'altitude' ? '海拔高' : paceFastText + ' 快'}}</text>
    </view>
    <view class="md-title">运动数据</view>
    <view class="md-grid">
      <view class="md-cell" wx:for="{{metrics}}" wx:key="label">
        <view class="md-label">{{item.label}}</view>
        <view class="md-value">{{item.value}}<text class="md-unit" wx:if="{{item.unit}}">{{item.unit}}</text></view>
      </view>
    </view>
    <view class="detail-time">
      <text>开始 {{activity.startTimeText}}</text>
      <text class="time-sep">·</text>
      <text>结束 {{activity.endTimeText}}</text>
      <block wx:if="{{activity.avgAccuracy}}">
        <text class="time-sep">·</text>
        <text>精度 {{activity.avgAccuracy}}m</text>
      </block>
    </view>
  </view>

  <!-- 特别成就（本轨迹在所属运动类型中持有的个人最佳） -->
  <view class="card" wx:if="{{achievements.length}}">
    <view class="ach-head">
      <text class="ach-title">特别成就</text>
      <text class="ach-count">共 {{achievements.length}} 个</text>
    </view>
    <view class="ach-row" wx:for="{{achievements}}" wx:key="label">
      <text class="ach-medal">🏆</text>
      <text class="ach-label">{{item.label}}</text>
      <text class="ach-value">{{item.value}}<text class="ach-unit" wx:if="{{item.unit}}">{{item.unit}}</text></text>
    </view>
  </view>

  <!-- 配速区间（跑步：自锚定分档，边界 = 本次平均配速 × 比例） -->
  <view class="card" wx:if="{{runZones.hasData}}">
    <view class="pz-head">
      <text class="pz-title">配速区间</text>
      <text class="pz-anchor">{{runZones.anchorText}}</text>
    </view>
    <view wx:for="{{runZones.zones}}" wx:key="key" class="pz-row">
      <view class="pz-line">
        <view class="pz-dot" style="background: {{item.color}}"></view>
        <text class="pz-name">{{item.name}}</text>
        <text class="pz-ratio">{{item.ratioText}}</text>
        <text class="pz-pct" style="color: {{item.color}}">{{item.pctText}}%</text>
        <text class="pz-dur">{{item.durationText}}</text>
      </view>
      <view class="pz-line pz-line-bar">
        <text class="pz-range">{{item.paceText}}</text>
        <view class="pz-bar">
          <view class="pz-bar-fill" style="width: {{item.barPct}}%; background: {{item.color}}"></view>
        </view>
      </view>
    </view>
    <view class="pz-note">以本次平均配速为分档基准 · 45 秒平滑配速按移动时间加权（有效 {{runZones.totalText}}）</view>
  </view>

  <!-- 单段明细（每公里，表头 + 单行表格） -->
  <view class="card" wx:if="{{displaySegs.length > 0}}">
    <view class="seg-head">
      <view class="detail-title">单段明细 <text class="text-muted" style="font-size:22rpx">（每公里）</text></view>
      <view class="seg-more" wx:if="{{kmSegs.length > 5}}" bindtap="openAllSegs">查看全部 ›</view>
    </view>
    <view class="seg-thead">
      <text class="seg-col-no">#</text>
      <text class="seg-col-dist">公里</text>
      <text class="seg-col-time">用时</text>
      <text class="seg-col-pace">配速</text>
    </view>
    <view wx:for="{{displaySegs}}" wx:key="idx" class="seg-row">
      <text class="seg-col-no {{item.partial ? 'seg-col-partial' : ''}}">{{item.partial ? '余' : item.idx}}</text>
      <text class="seg-col-dist">{{item.distText}}</text>
      <text class="seg-col-time">{{item.durationText}}</text>
      <view class="seg-col-pace">
        <text class="seg-fast" wx:if="{{item.fastest}}">最快</text>
        <text class="seg-pace-val">{{item.paceText}}</text>
      </view>
    </view>
  </view>

  <!-- 单段全部弹窗 -->
  <t-popup visible="{{segsVisible}}" placement="bottom" bind:visible-change="onSegsVisibleChange">
    <view class="segs-panel">
      <view class="segs-title">单段明细（{{kmSegs.length}} 段）</view>
      <view class="seg-thead">
        <text class="seg-col-no">#</text>
        <text class="seg-col-dist">公里</text>
        <text class="seg-col-time">用时</text>
        <text class="seg-col-pace">配速</text>
      </view>
      <scroll-view scroll-y class="segs-scroll">
        <view class="segs-list">
          <view wx:for="{{kmSegs}}" wx:key="idx" class="seg-row">
            <text class="seg-col-no {{item.partial ? 'seg-col-partial' : ''}}">{{item.partial ? '余' : item.idx}}</text>
            <text class="seg-col-dist">{{item.distText}}</text>
            <text class="seg-col-time">{{item.durationText}}</text>
            <view class="seg-col-pace">
              <text class="seg-fast" wx:if="{{item.fastest}}">最快</text>
              <text class="seg-pace-val">{{item.paceText}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </t-popup>

  <!-- 海拔曲线（决策 F31：仅供参考） -->
  <view class="card" wx:if="{{altitudeChart.length > 1}}">
    <view class="detail-title">海拔曲线 <text class="text-muted" style="font-size:22rpx">（GPS 参考，可能有偏差）</text></view>
    <stat-chart data="{{altitudeChart}}" type="line" unit="m" height="{{150}}" empty-text="暂无海拔数据" />
  </view>

  <!-- 打点时间线（点击可编辑） -->
  <view class="card" wx:if="{{markerList.length > 0}}">
    <view class="detail-title">打点 ({{markerList.length}})</view>
    <view
      wx:for="{{markerList}}"
      wx:key="id"
      class="marker-item"
      data-marker="{{item}}"
      bindtap="onTapMarkerItem"
      hover-class="marker-hover"
    >
      <text class="marker-emoji">{{item.icon || '📍'}}</text>
      <view class="marker-body">
        <view class="marker-note">{{item.label || item.typeMeta.label || '打点'}}</view>
        <view class="text-muted" wx:if="{{item.note}}">{{item.note}}</view>
        <view class="text-muted">{{item.timeText}}{{item.address ? ' · ' + item.address : ''}}</view>
      </view>
      <t-tag size="small" variant="light" wx:if="{{item.label && item.note}}">{{item.typeMeta.label || '打点'}}</t-tag>
    </view>
  </view>

  <!-- 操作（固定底部；分享居中主色，其余描边；非本人只读：隐藏编辑类入口） -->
  <view class="fixed-actions">
    <t-button class="act-btn" t-class="act-btn-line" wx:if="{{activity.isOwner}}" variant="outline" size="medium" block bind:tap="exportGpx">导出 GPX</t-button>
    <t-button class="act-btn" theme="primary" size="medium" block bind:tap="sharePoster">分享运动</t-button>
    <t-button class="act-btn" t-class="act-btn-line" wx:if="{{activity.isOwner}}" variant="outline" size="medium" block bind:tap="reprocessTrack">纠偏</t-button>
  </view>

  <!-- 分享海报（离屏绘制，无可见 UI）；运动数据/单段明细直接复用页面算好的同一份，口径不另起炉灶 -->
  <share-card
    id="shareCard"
    activity="{{activity}}"
    mapPoints="{{mapPoints}}"
    metrics="{{metrics}}"
    kmSegs="{{kmSegs}}"
    bindposterready="onPosterReady"
  />

  <!-- 打点弹窗（编辑/新增） -->
  <marker-form
    visible="{{markerFormVisible}}"
    editMode="{{editMode}}"
    marker="{{editMarker}}"
    bindconfirm="onMarkerConfirm"
    binddelete="onMarkerDelete"
    bindcancel="onMarkerCancel"
  />

  <!-- 编辑轨迹信息（类型/备注） -->
  <t-popup visible="{{editVisible}}" placement="bottom" bind:visible-change="onEditVisibleChange">
    <view class="edit-panel">
      <view class="edit-title">编辑轨迹信息</view>
      <view class="edit-label">运动类型</view>
      <view class="edit-type-grid">
        <view
          wx:for="{{activityTypes}}"
          wx:key="type"
          class="edit-type-item {{editType === item.type ? 'edit-type-active' : ''}}"
          data-type="{{item.type}}"
          bindtap="onEditTypeChange"
        ><image class="type-icon" src="{{item.iconImg}}" mode="aspectFit"></image> {{item.label}}</view>
      </view>
      <view class="edit-label">备注</view>
      <textarea
        class="edit-note-input"
        value="{{editNote}}"
        placeholder="添加备注（如：跟朋友一起的晨跑）"
        maxlength="500"
        bindinput="onEditNoteInput"
      ></textarea>
      <t-button theme="primary" size="large" block loading="{{editSaving}}" bind:tap="saveEdit">保存</t-button>
    </view>
  </t-popup>
</view>
