<view class="container" wx:if="{{activity}}">
  <!-- 轨迹图（view 模式自动 fitView）+ 图层切换 + 回放 + 全屏 -->
  <view class="map-wrap">
    <track-map
      id="detailMap"
      points="{{mapPoints}}"
      markers="{{markers}}"
      mapType="{{mapType}}"
      mode="view"
      altitudeColor
      showStartEnd
      bindmarkertap="onMarkerTap"
      bindreplayend="onReplayEnd"
    />
    <view class="layer-btn" bindtap="switchLayer">
      {{mapType === 'standard' ? '🛰️ 卫星' : '🗺️ 标准'}}
    </view>
    <view class="replay-btn {{replaying ? 'replay-btn-active' : ''}}" bindtap="startReplay">
      {{replaying ? '⏹ 停止' : '▶️ 回放'}}
    </view>
    <view class="fullscreen-btn" bindtap="openFullscreen">⛶ 全屏</view>
  </view>

  <!-- 全屏地图弹窗（不拦截 touch：map 手势需要 touchmove 做缩放/拖动） -->
  <view class="fullscreen-mask" wx:if="{{fullscreen}}">
    <view class="fullscreen-close" bindtap="closeFullscreen">✕</view>
    <view class="fullscreen-layer" bindtap="fsSwitchLayer">
      {{mapType === 'standard' ? '🛰️ 卫星' : '🗺️ 标准'}}
    </view>
    <view class="fullscreen-map-wrap">
      <track-map
        id="fullscreenMap"
        points="{{mapPoints}}"
        markers="{{markers}}"
        mapType="{{mapType}}"
        mode="view"
        altitudeColor
        showStartEnd
      />
    </view>
  </view>

  <!-- 指标 -->
  <view class="card">
    <view class="detail-title">{{activity.icon}} {{activity.label}} <text class="edit-btn" bindtap="openEdit">✏️ 编辑</text></view>
    <view class="note-text" wx:if="{{activity.note}}">📝 {{activity.note}}</view>
    <view class="track-metrics">
      <view class="metric">
        <view class="metric-num">{{activity.distanceKm}}</view>
        <view class="metric-label">公里</view>
      </view>
      <view class="metric">
        <view class="metric-num">{{activity.durationText}}</view>
        <view class="metric-label">时长</view>
      </view>
      <view class="metric">
        <view class="metric-num">{{activity.paceValue}}<text class="pace-unit">{{activity.paceUnit}}</text></view>
        <view class="metric-label">配速</view>
      </view>
      <view class="metric">
        <view class="metric-num">{{activity.calories}}</view>
        <view class="metric-label">千卡</view>
      </view>
    </view>
    <view class="text-muted detail-sub" wx:if="{{activity.elevationGain}}">
      累计爬升 {{activity.elevationGain}}m · 最高海拔 {{activity.maxAltitude || '—'}}m · 打点 {{markerList.length}} 个{{activity.avgAccuracy ? ' · 📡 精度 ' + activity.avgAccuracy + 'm' : ''}}
    </view>
    <view class="detail-time">
      <text>开始 {{activity.startTimeText}}</text>
      <text class="time-sep">·</text>
      <text>结束 {{activity.endTimeText}}</text>
    </view>
  </view>

  <!-- 单段明细（每公里） -->
  <view class="card" wx:if="{{displaySegs.length > 0}}">
    <view class="seg-head">
      <view class="detail-title">单段明细 <text class="text-muted" style="font-size:22rpx">（每公里）</text></view>
      <view class="seg-more" wx:if="{{kmSegs.length > 5}}" bindtap="openAllSegs">查看全部 ›</view>
    </view>
    <view wx:for="{{displaySegs}}" wx:key="idx" class="seg-row">
      <view class="seg-idx {{item.partial ? 'seg-idx-partial' : ''}}">{{item.partial ? '余' : item.idx}}</view>
      <view class="seg-info">
        <view class="seg-meta">
          <text class="seg-time">{{item.durationText}}</text>
          <text class="seg-dist">{{item.distKm.toFixed(2)}} 公里{{item.partial ? '（不足 1km）' : ''}}</text>
        </view>
        <view class="seg-pace">配速 {{item.paceText}}</view>
      </view>
    </view>
  </view>

  <!-- 单段全部弹窗 -->
  <t-popup visible="{{segsVisible}}" placement="bottom" bind:visible-change="onSegsVisibleChange">
    <view class="segs-panel">
      <view class="segs-title">单段明细（{{kmSegs.length}} 段）</view>
      <scroll-view scroll-y class="segs-scroll">
        <view class="segs-list">
          <view wx:for="{{kmSegs}}" wx:key="idx" class="seg-row">
            <view class="seg-idx {{item.partial ? 'seg-idx-partial' : ''}}">{{item.partial ? '余' : item.idx}}</view>
            <view class="seg-info">
              <view class="seg-meta">
                <text class="seg-time">{{item.durationText}}</text>
                <text class="seg-dist">{{item.distKm.toFixed(2)}} 公里{{item.partial ? '（不足 1km）' : ''}}</text>
              </view>
              <view class="seg-pace">配速 {{item.paceText}}</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </t-popup>

  <!-- 海拔曲线（决策 F31：仅供参考） -->
  <view class="card" wx:if="{{altitudeChart.length > 1}}">
    <view class="detail-title">海拔曲线 <text class="text-muted" style="font-size:22rpx">（GPS 参考，可能有偏差）</text></view>
    <stat-chart data="{{altitudeChart}}" type="line" unit="m" height="{{150}}" empty-text="暂无海拔数据" />
  </view>

  <!-- 打点时间线（点击可编辑） -->
  <view class="card" wx:if="{{markerList.length > 0}}">
    <view class="detail-title">打点 ({{markerList.length}})</view>
    <view
      wx:for="{{markerList}}"
      wx:key="id"
      class="marker-item"
      data-marker="{{item}}"
      bindtap="onTapMarkerItem"
      hover-class="marker-hover"
    >
      <view class="marker-icon">{{item.typeMeta.icon || '📍'}}</view>
      <view class="marker-body">
        <view class="marker-note">{{item.note || item.typeMeta.label || '打点'}}</view>
        <view class="text-muted">{{item.timeText}}{{item.address ? ' · ' + item.address : ''}}</view>
      </view>
      <t-tag size="small" variant="light">{{item.typeMeta.label || '打点'}}</t-tag>
    </view>
  </view>

  <!-- 操作（固定底部） -->
  <view class="fixed-actions">
    <t-button class="act-btn" variant="outline" size="medium" block bind:tap="addMarker">＋ 补打点</t-button>
    <t-button class="act-btn" variant="outline" size="medium" block bind:tap="sharePoster">🎨 分享海报</t-button>
    <t-button class="act-btn" variant="outline" size="medium" block bind:tap="exportGpx">导出 GPX</t-button>
    <t-button class="act-btn" variant="outline" size="medium" block bind:tap="reprocessTrack">🧹 纠偏</t-button>
  </view>

  <!-- 分享海报（离屏绘制，无可见 UI） -->
  <share-card
    id="shareCard"
    activityId="{{id}}"
    activity="{{activity}}"
    mapPoints="{{mapPoints}}"
    bindposterready="onPosterReady"
  />

  <!-- 打点弹窗（编辑/新增） -->
  <marker-form
    visible="{{markerFormVisible}}"
    editMode="{{editMode}}"
    marker="{{editMarker}}"
    bindconfirm="onMarkerConfirm"
    binddelete="onMarkerDelete"
    bindcancel="onMarkerCancel"
  />

  <!-- 编辑轨迹信息（类型/备注） -->
  <t-popup visible="{{editVisible}}" placement="bottom" bind:visible-change="onEditVisibleChange">
    <view class="edit-panel">
      <view class="edit-title">编辑轨迹信息</view>
      <view class="edit-label">运动类型</view>
      <view class="edit-type-grid">
        <view
          wx:for="{{activityTypes}}"
          wx:key="type"
          class="edit-type-item {{editType === item.type ? 'edit-type-active' : ''}}"
          data-type="{{item.type}}"
          bindtap="onEditTypeChange"
        >{{item.icon}} {{item.label}}</view>
      </view>
      <view class="edit-label">备注</view>
      <textarea
        class="edit-note-input"
        value="{{editNote}}"
        placeholder="添加备注（如：跟朋友一起的晨跑）"
        maxlength="500"
        bindinput="onEditNoteInput"
      ></textarea>
      <t-button theme="primary" size="large" block loading="{{editSaving}}" bind:tap="saveEdit">保存</t-button>
    </view>
  </t-popup>
</view>
