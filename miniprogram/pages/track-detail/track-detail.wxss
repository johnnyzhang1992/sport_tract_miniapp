.map-wrap {
  position: relative;
  height: 620rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #eef1f5;
}
.layer-btn,
.replay-btn {
  position: absolute;
  top: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
.layer-btn {
  right: 24rpx;
}
.replay-btn {
  left: 24rpx;
}
.replay-btn-active {
  background: #2b6cf6;
  color: #fff;
}
.fullscreen-btn {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
/* 全屏地图弹窗 */
.fullscreen-mask {
  position: fixed;
  inset: 0;
  background: #000;
  z-index: 10000;
}
.fullscreen-map-wrap {
  position: absolute;
  inset: 0;
}
.fullscreen-close {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  left: 24rpx;
  z-index: 1001;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}
.fullscreen-layer {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  right: 24rpx;
  z-index: 1001;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}
.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.track-metrics {
  display: flex;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx 0;
}
.metric {
  flex: 1;
  text-align: center;
  min-width: 0;
}
.metric-num {
  font-size: 34rpx;
  font-weight: 600;
  white-space: nowrap;
}
.metric-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  white-space: nowrap;
}
.pace-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 2rpx;
}
.detail-sub {
  margin-top: 16rpx;
}
.marker-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.marker-item:last-child {
  border-bottom: none;
}
.marker-hover {
  opacity: 0.7;
}
.marker-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}
.marker-body {
  flex: 1;
}
.marker-note {
  font-size: 28rpx;
}
.container {
  padding-bottom: 180rpx;
}
/* 固定底部操作栏 */
.fixed-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 9999; /* 高于所有内容/canvas，杜绝被原生 canvas 穿透 */
}
.fixed-actions .act-btn {
  flex: 1;
  font-size: 22rpx; /* 小屏 4 按钮放不下，缩小字号 */
  padding: 0 8rpx;
}
.fixed-actions .act-btn + .act-btn {
  margin-left: 10rpx;
}

/* 开始/结束时间 */
.detail-time {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8a93a6;
  margin-top: 10rpx;
}
.time-sep {
  margin: 0 14rpx;
  color: #c2c7d0;
}

/* 编辑入口 + 备注 */
.edit-btn {
  font-size: 24rpx;
  font-weight: 400;
  color: #2b6cf6;
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  background: #e8f0ff;
  border-radius: 999rpx;
}
.note-text {
  font-size: 26rpx;
  color: #4e5969;
  background: #f6f7f9;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-top: 14rpx;
}

/* 编辑面板 */
.edit-panel {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.edit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: center;
  margin-bottom: 28rpx;
}
.edit-label {
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 14rpx;
}
.edit-type-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.edit-type-item {
  width: 33.33%;
  box-sizing: border-box;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #1f2329;
  border-radius: 12rpx;
}
.edit-type-active {
  background: #e8f0ff;
  color: #2b6cf6;
  font-weight: 600;
}
.edit-note-input {
  width: 100%;
  box-sizing: border-box;
  height: 160rpx;
  background: #f6f7f9;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  margin-bottom: 28rpx;
}

/* 单段明细 */
.seg-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.seg-row:last-child {
  border-bottom: none;
}
.seg-idx {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e8f0ff;
  color: #2b6cf6;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.seg-idx-partial {
  background: #fff3e0;
  color: #ff9800;
}
.seg-info {
  flex: 1;
  min-width: 0;
}
.seg-meta {
  display: flex;
  align-items: baseline;
}
.seg-time {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  margin-right: 16rpx;
}
.seg-dist {
  font-size: 22rpx;
  color: #8a93a6;
}
.seg-pace {
  font-size: 24rpx;
  color: #4e5969;
  margin-top: 4rpx;
}
.more-btn {
  text-align: center;
  color: #2b6cf6;
  font-size: 26rpx;
  padding: 20rpx 0 4rpx;
}

/* 全部单段弹窗 */
.segs-panel {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.segs-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: center;
  padding-bottom: 20rpx;
}
.segs-scroll {
  max-height: 56vh;
}
