.map-wrap {
  position: relative;
  height: 620rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 56rpx; /* 头像上浮 48rpx 悬浮其中，避免与地图底部按钮重叠 */
  background: #eef1f5;
}
.replay-btn {
  position: absolute;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
}
.replay-btn {
  bottom: 16rpx;
  left: 16rpx; /* 与全屏按钮距右边缘等距，左右对称 */
}
.replay-btn-active {
  background: #2b6cf6;
  color: #fff;
}
.btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.close-icon {
  width: 36rpx;
  height: 36rpx;
}
/* 全屏地图弹窗 */
.fullscreen-mask {
  position: fixed;
  inset: 0;
  background: #000;
  z-index: 10000;
}
.fullscreen-map-wrap {
  position: absolute;
  inset: 0;
}
.fullscreen-close {
  position: absolute;
  top: calc(16rpx + env(safe-area-inset-top));
  left: 24rpx;
  z-index: 1001;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}
.fullscreen-layer {
  position: absolute;
  top: calc(16rpx + env(safe-area-inset-top));
  right: 24rpx; /* 右上角（真机指南针在左侧） */
  z-index: 1001;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
}
.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
/* 运动数据网格（Keep 风：标签在上、大数值 + 小单位在下，每行 3 格） */
.md-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 8rpx 0 4rpx;
}
.md-grid {
  display: flex;
  flex-wrap: wrap;
}
.md-cell {
  width: 33.33%;
  box-sizing: border-box;
  padding: 12rpx 12rpx 12rpx 0;
}

/* ── 表现分卡 ─────────────────────────────── */
.perf-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.perf-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.perf-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.perf-note {
  font-size: 20rpx;
  color: #667080;
}
.perf-score-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.perf-score {
  font-size: 56rpx;
  font-weight: 700;
  color: #8a5f12;
  line-height: 1;
}
.perf-level {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a5f12;
}
/* 等级刻度条：分段线在 200/380/500/680（宽度 20/18/12/18/32%） */
.perf-scale {
  margin-top: 20rpx;
}
.perf-scale-bar {
  position: relative;
  display: flex;
  height: 14rpx;
  border-radius: 999rpx;
  overflow: visible;
}
.perf-seg {
  height: 100%;
}
.seg-0 { width: 20%; background: #eef0f3; border-radius: 999rpx 0 0 999rpx; }
.seg-1 { width: 18%; background: #f5e6c8; }
.seg-2 { width: 12%; background: #efd9a8; }
.seg-3 { width: 18%; background: #e6c476; }
.seg-4 { width: 32%; background: #d9a648; border-radius: 0 999rpx 999rpx 0; }
.perf-marker {
  position: absolute;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid #2b6cf6;
  transform: translate(-50%, -50%);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}
.perf-ticks {
  position: relative;
  height: 28rpx;
  margin-top: 6rpx;
}
.perf-tick {
  position: absolute;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: #667080;
}
.perf-levels {
  position: relative;
  height: 28rpx;
  margin-bottom: 6rpx;
}
.perf-level-name {
  position: absolute;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: #667080;
}
.perf-level-name-max {
  color: #8a5f12;
  font-weight: 600;
}
/* 计算逻辑说明 */
.perf-calc {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f3f5;
}
.perf-calc-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #4e5969;
  margin-bottom: 8rpx;
}
.perf-formula {
  font-size: 22rpx;
  color: #1f2329;
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  margin-bottom: 10rpx;
}
.perf-sup {
  font-size: 16rpx;
  vertical-align: super;
}
.perf-calc-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 4rpx 0;
}
.perf-calc-label {
  font-size: 22rpx;
  color: #667080;
  flex-shrink: 0;
}
.perf-calc-value {
  font-size: 22rpx;
  color: #1f2329;
}
.perf-calc-foot {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #667080;
  line-height: 1.5;
}
.md-label {
  font-size: 24rpx;
  color: #667080;
}
.md-value {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #1f2329;
  white-space: nowrap;
  overflow: hidden;
}
.md-unit {
  margin-left: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #667080;
}
.marker-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.marker-item:last-child {
  border-bottom: none;
}
.marker-hover {
  opacity: 0.7;
}
.marker-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.marker-body {
  flex: 1;
}
.marker-note {
  font-size: 28rpx;
}
.container {
  padding-bottom: 180rpx;
}
/* 固定底部操作栏（分享居中主色，左右描边） */
.fixed-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx; /* t-button 宿主不吃 class 里的 margin，间距用父级 gap */
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 9999; /* 高于所有内容/canvas，杜绝被原生 canvas 穿透 */
}
.fixed-actions .act-btn {
  flex: 1;
  font-size: 26rpx;
}
/* 描边按钮：variant=outline 的边框依赖基础库默认 button::after，这里显式补一层 */
.act-btn-line {
  border: 2rpx solid #dcdfe5;
}

/* 开始/结束时间 */
.detail-time {
  display: flex;
  align-items: center;
  flex-wrap: wrap; /* 窄屏放不下时整段换行，不挤断日期 */
  row-gap: 4rpx;
  font-size: 24rpx;
  color: #667080;
  margin-top: 10rpx;
}
.time-sep {
  margin: 0 14rpx;
  color: #667080;
}

/* 编辑入口 + 备注
   字号跟着左边同行的类型名（.hero-title 24rpx）时，胶囊里的「编辑」和类型名一样大，
   主次分不出来；收一档到 20rpx，内边距同比收，别让胶囊显得空 */
.edit-btn {
  font-size: 20rpx;
  font-weight: 400;
  color: #2b6cf6;
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  background: #e8f0ff;
  border-radius: 999rpx;
}
.note-text {
  font-size: 26rpx;
  color: #4e5969;
  background: #f6f7f9;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-top: 14rpx;
}

/* 编辑面板 */
.edit-panel {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.edit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: center;
  margin-bottom: 28rpx;
}
.edit-label {
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 14rpx;
}
.edit-type-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.edit-type-item {
  width: 25%; /* 一行 4 个 */
  box-sizing: border-box;
  padding: 10rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #1f2329;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.edit-type-active {
  background: #e8f0ff;
  color: #2b6cf6;
  font-weight: 600;
}
.edit-note-input {
  width: 100%;
  box-sizing: border-box;
  height: 160rpx;
  background: #f6f7f9;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  margin-bottom: 28rpx;
}

/* 单段明细 */
.seg-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.seg-row:last-child {
  border-bottom: none;
}
/* 单段明细：表头 + 单行表格（# 公里 用时 配速） */
.seg-thead {
  display: flex;
  align-items: center;
  padding: 0 0 10rpx;
  border-bottom: 1rpx solid #eef0f3;
  font-size: 22rpx;
  color: #667080;
}
.seg-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.seg-row:last-child {
  border-bottom: none;
}
.seg-col-no {
  width: 60rpx;
  flex-shrink: 0;
}
.seg-col-dist {
  width: 130rpx;
  flex-shrink: 0;
}
.seg-col-time {
  width: 150rpx;
  flex-shrink: 0;
}
.seg-col-pace {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.seg-row .seg-col-no {
  font-size: 24rpx;
  color: #667080;
}
.seg-col-partial {
  color: #b45309;
  font-weight: 600;
}
.seg-row .seg-col-dist {
  font-size: 24rpx;
  color: #667080;
}
.seg-row .seg-col-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}
.seg-pace-val {
  font-size: 26rpx;
  color: #1f2329;
}
.seg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.seg-more {
  color: #2b6cf6;
  font-size: 24rpx;
}

/* 配速区间（跑步） */
.pz-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.pz-title {
  font-size: 32rpx;
  font-weight: 600;
}
.pz-anchor {
  font-size: 22rpx;
  color: #667080;
}
.pz-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.pz-row:last-child {
  border-bottom: none;
}
.pz-line {
  display: flex;
  align-items: center;
}
.pz-line-bar {
  margin-top: 8rpx;
}
.pz-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.pz-name {
  width: 152rpx; /* 固定列宽：区间名对齐，比例列左侧对齐 */
  flex-shrink: 0;
  font-size: 28rpx;
  color: #1f2329;
}
.pz-ratio {
  flex: 1;
  font-size: 20rpx;
  color: #667080;
  margin-left: 12rpx;
}
.pz-pct {
  width: 84rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
}
.pz-dur {
  width: 108rpx;
  text-align: right;
  font-size: 22rpx;
  color: #667080;
}
.pz-range {
  width: 206rpx;
  padding-left: 30rpx; /* 与区间名左对齐（让开圆点） */
  flex-shrink: 0;
  font-size: 20rpx;
  color: #667080;
}
.pz-bar {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: #f2f3f5;
  overflow: hidden;
}
.pz-bar-fill {
  height: 100%;
  border-radius: 6rpx;
}
.pz-note {
  font-size: 20rpx;
  color: #667080;
  line-height: 1.5;
  margin-top: 14rpx;
}

/* 全部单段弹窗 */
.segs-panel {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx 0; /* 安全区移到滚动列表内 */
  height: 75vh; /* 弹窗撑高，列表占满标题以下 */
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.segs-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: center;
  padding-bottom: 20rpx;
}
.segs-scroll {
  flex: 1; /* 占满标题下所有区域 */
  min-height: 0;
}
.segs-list {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); /* 在滚动内容内：随列表一起滚动，不占固定位置 */
}

.title-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}
.edit-type-item image.type-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}

/* 最快配速段徽章（在配速左侧） */
.seg-fast {
  flex-shrink: 0;
  margin-right: 12rpx;
  font-size: 18rpx;
  color: #fff;
  background: #ff6b3d;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

/* 特别成就（个人最佳） */
.ach-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.ach-title {
  font-size: 32rpx;
  font-weight: 600;
}
.ach-count {
  font-size: 22rpx;
  color: #667080;
}
.ach-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.ach-row:last-child {
  border-bottom: none;
}
.ach-name {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
/* 成就名两侧的金色穗枝（公共背景图在 app.wxss 的 .laurel-ear） */
.ach-ear {
  width: 18rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.ach-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #8a5f12;
  margin: 0 6rpx;
}
/* 前纪录（曾被刷新）：灰金降调 */
.ach-label-former {
  color: #6f6857;
}
.ach-value-wrap {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}
.ach-value-former {
  color: #6f6857;
}
/* 保持天数：达成后到被刷新（或至今）的整天数 */
.ach-held {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #667080;
}
.ach-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.ach-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #667080;
}

/* 打点 emoji 图标 */
.marker-emoji {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* 轨迹线颜色说明（海拔/配速着色图例） */
/* 轨迹线颜色图例 */
.legend-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}
/* 灰线/虚线说明行：紧贴配速图例行，间距收紧 */
.legend-row-sub {
  margin-top: 10rpx;
}
/* 指标卡头部：大数字距离（左） + 用户头像昵称（右，头像悬浮压卡片顶边） */
.hero-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.hero-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #667080;
}
.hero-dist {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 12rpx;
}
.hero-num {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
  color: #1d2129;
}
.hero-unit {
  font-size: 26rpx;
  color: #4e5969;
}
.hero-user {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -72rpx; /* 头像上浮压住卡片顶边 */
  position: relative;
  z-index: 2; /* 盖过上方 position:relative 的 map-wrap，否则头像顶部会被地图遮住 */
}
.hero-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  background: #f2f3f5;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}
.hero-nickname {
  margin-top: 8rpx;
  max-width: 220rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1d2129;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-date {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #667080;
  white-space: nowrap;
}
.legend-text {
  font-size: 20rpx;
  color: #667080;
  flex-shrink: 0;
}
.legend-bar {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
}
.legend-bar-altitude {
  background: linear-gradient(90deg, #2979ff, #00c753, #ffd500, #f44336);
}
.legend-bar-pace {
  background: linear-gradient(
    90deg,
    #22c55e 0 25%,
    #facc15 25% 50%,
    #b45309 50% 75%,
    #ef4444 75% 100%
  );
}
/* 非运动段（疑似乘车）图例：与 track-map.js 的 VEHICLE_COLOR 同色 */
.legend-vehicle {
  width: 32rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #8a93a6;
  flex-shrink: 0;
}
/* 虚线图例色块：与地图上 pauseGap/gapJump 连接段同色（track-pace.js#UNRELIABLE_LINK_COLOR） */
.legend-dash {
  width: 32rpx;
  height: 0;
  border-top: 4rpx dashed #b9c2cf;
  flex-shrink: 0;
}
.legend-note {
  /* 口径说明行：文字改配速档同款橙（与后台 utils/pace.ts#VEHICLE_NOTICE_COLOR 同值）跳出来；黄底色块试过，观感怪 */
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #b45309;
}

/* 未纠偏轨迹的纠偏按钮：橙色警示系（提示距离可能含 GPS 漂移，待修正），
   与主色「分享运动」明确区分；纠偏后回到描边置灰 */
/* 未纠偏轨迹的纠偏按钮：与导出 GPX 同款描边宽度（t-class 覆盖了 variant 默认边框，需显式补），
   底色浅橙与主色「分享运动」区分；纠偏后回到描边置灰 */
.act-btn-warn {
  border: 2rpx solid #f5c34d;
}
