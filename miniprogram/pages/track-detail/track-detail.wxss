.map-wrap {
  position: relative;
  height: 620rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #eef1f5;
}
.layer-btn,
.replay-btn {
  position: absolute;
  top: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
.layer-btn {
  right: 24rpx;
}
.replay-btn {
  left: 24rpx;
}
.replay-btn-active {
  background: #2b6cf6;
  color: #fff;
}
.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.track-metrics {
  display: flex;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx 0;
}
.metric {
  flex: 1;
  text-align: center;
}
.metric-num {
  font-size: 34rpx;
  font-weight: 600;
}
.metric-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.detail-sub {
  margin-top: 16rpx;
}
.marker-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.marker-item:last-child {
  border-bottom: none;
}
.marker-hover {
  opacity: 0.7;
}
.marker-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}
.marker-body {
  flex: 1;
}
.marker-note {
  font-size: 28rpx;
}
.actions {
  display: flex;
}
.actions t-button {
  flex: 1;
}
.actions t-button:first-child {
  margin-right: 20rpx;
}
