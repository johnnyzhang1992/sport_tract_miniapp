.map-wrap {
  position: relative;
  height: 620rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #eef1f5;
}
.layer-btn,
.replay-btn {
  position: absolute;
  top: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
.layer-btn {
  right: 24rpx;
}
.replay-btn {
  left: 24rpx;
}
.replay-btn-active {
  background: #2b6cf6;
  color: #fff;
}
.fullscreen-btn {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
/* 全屏地图弹窗 */
.fullscreen-mask {
  position: fixed;
  inset: 0;
  background: #000;
  z-index: 10000;
}
.fullscreen-map-wrap {
  position: absolute;
  inset: 0;
}
.fullscreen-close {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  left: 24rpx;
  z-index: 1001;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}
.fullscreen-layer {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  right: 24rpx;
  z-index: 1001;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}
.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.track-metrics {
  display: flex;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx 0;
}
.metric {
  flex: 1;
  text-align: center;
  min-width: 0;
}
.metric-num {
  font-size: 34rpx;
  font-weight: 600;
  white-space: nowrap;
}
.metric-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  white-space: nowrap;
}
.pace-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 2rpx;
}
.detail-sub {
  margin-top: 16rpx;
}
.marker-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.marker-item:last-child {
  border-bottom: none;
}
.marker-hover {
  opacity: 0.7;
}
.marker-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}
.marker-body {
  flex: 1;
}
.marker-note {
  font-size: 28rpx;
}
.container {
  padding-bottom: 180rpx;
}
/* 固定底部操作栏 */
.fixed-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 9999; /* 高于所有内容/canvas，杜绝被原生 canvas 穿透 */
}
.fixed-actions t-button {
  flex: 1;
}
.fixed-actions t-button + t-button {
  margin-left: 16rpx;
}
