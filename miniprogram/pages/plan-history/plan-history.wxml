<!-- 计划历史（月历）：参照 Apple 健身——每天一个迷你三环，达成日带绿点；点某天看单日详情 -->
<view class="container">
  <!-- 月份栏：左右切月 + 更改计划入口 -->
  <view class="month-bar">
    <view class="month-nav" bindtap="prevMonth">‹</view>
    <view class="month-title">{{monthText}}</view>
    <view class="month-nav" bindtap="nextMonth">›</view>
    <view class="month-right" bindtap="goPlan">更改计划</view>
  </view>

  <!-- 月历：日期数字 + 三环（canvas 一次画完）+ 点按进详情 -->
  <view class="cal-card">
    <view class="cal-week">
      <view wx:for="{{weekHead}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="cal-body">
      <!-- 日期数字与三环都画在 canvas 上：同一坐标系，不会错行 -->
      <canvas type="2d" id="cal-canvas" class="cal-canvas" style="height: {{canvasH}}px"></canvas>
      <!-- 透明点击层：每格一个 view，避免 canvas 事件与坐标换算的不确定性 -->
      <view class="cal-hit">
        <view
          wx:for="{{cells}}"
          wx:key="key"
          class="hit-cell"
          style="height: {{hitRowH}}px"
          data-date="{{item.date}}"
          bindtap="onCellTap"
        ></view>
      </view>
    </view>
  </view>

  <!-- 图例 -->
  <view class="cal-legend">
    <view class="lg"><view class="lg-dot lg-red"></view>距离</view>
    <view class="lg"><view class="lg-dot lg-green"></view>时间</view>
    <view class="lg"><view class="lg-dot lg-cyan"></view>次数</view>
    <view class="lg"><view class="lg-dot lg-done"></view>三项达成</view>
  </view>

  <!-- 选中的某天：就地展开（不跳页）；再点同一天收起 -->
  <view class="card cur-card" wx:if="{{selected}}">
    <view class="cur-head">
      <text class="cur-title">{{selected.title}}</text>
      <view class="cur-head-right">
        <text class="badge {{selected.achieved ? 'badge-done' : 'badge-miss'}}">{{selected.achieved ? '已达成' : (selected.loading ? '加载中' : '未达成')}}</text>
        <text class="cur-close" bindtap="clearSelected">收起</text>
      </view>
    </view>
    <block wx:if="{{!selected.loading}}">
      <view class="cur-metric" wx:for="{{selected.metrics}}" wx:key="key">
        <view class="cur-dot cur-dot-{{item.dot}}"></view>
        <text class="cur-label">{{item.label}}</text>
        <view class="cur-bar">
          <view class="cur-bar-fill cur-bar-{{item.dot}}" style="width: {{item.pct}}%"></view>
        </view>
        <text class="cur-val">{{item.cur}}/{{item.target}}</text>
        <text class="cur-unit">{{item.unit}}</text>
      </view>
      <view class="day-tracks" wx:if="{{selected.tracks.length > 0}}">
        <view class="day-track" wx:for="{{selected.tracks}}" wx:key="id">
          <text class="day-track-icon">{{item.icon}}</text>
          <text class="day-track-label">{{item.label}}</text>
          <text class="day-track-sub">{{item.distText}} · {{item.durText}}</text>
          <text class="day-track-time">{{item.timeText}}</text>
        </view>
      </view>
      <view class="cur-remain" wx:else>当天没有运动记录</view>
    </block>
    <view class="cur-remain" wx:else>加载中…</view>
  </view>

  <!-- 当前周期概况：今天/本周的三项完成度（未选中日期时展示） -->
  <view class="card cur-card" wx:elif="{{current}}">
    <view class="cur-head">
      <text class="cur-title">当前周期 · {{current.periodText}}</text>
      <text class="badge {{current.achieved ? 'badge-done' : 'badge-miss'}}">{{current.achieved ? '已达成' : '进行中'}}</text>
    </view>
    <view class="cur-metric" wx:for="{{current.metrics}}" wx:key="key">
      <view class="cur-dot cur-dot-{{item.dot}}"></view>
      <text class="cur-label">{{item.label}}</text>
      <view class="cur-bar">
        <view class="cur-bar-fill cur-bar-{{item.dot}}" style="width: {{item.pct}}%"></view>
      </view>
      <text class="cur-val">{{item.cur}}/{{item.target}}</text>
      <text class="cur-unit">{{item.unit}}</text>
    </view>
    <view class="cur-remain">{{current.remainText}}</view>
  </view>

  <!-- 记录数据概况：已完成周期 / 达成次数 / 达成率 / 连续达成 + 累计 -->
  <view class="card sum-card" wx:if="{{summary}}">
    <view class="sum-title-row">
      <text class="sum-title">记录数据概况</text>
      <text class="sum-best">{{summary.bestStreakText}}</text>
    </view>
    <view class="sum-grid">
      <view class="sum-item" wx:for="{{summary.cards}}" wx:key="key">
        <text class="sum-num">{{item.num}}</text>
        <text class="sum-cap">{{item.cap}}</text>
      </view>
    </view>
    <view class="sum-totals">{{summary.totalsText}}</view>
  </view>

  <!-- 里程碑奖杯：固定档位，未解锁置灰（口径同统计页奖杯墙） -->
  <view class="card trophy-card" wx:if="{{summary && summary.trophies.length}}">
    <view class="sum-title-row">
      <text class="sum-title">里程碑奖杯</text>
    </view>
    <view class="trophy-grid">
      <view class="trophy-item {{item.unlocked ? '' : 'trophy-locked'}}" wx:for="{{summary.trophies}}" wx:key="key">
        <view class="trophy-badge {{item.unlocked ? 'trophy-badge-on' : 'trophy-badge-locked'}}">
          <text class="{{item.unlocked ? 'trophy-check' : 'trophy-lock'}}">{{item.unlocked ? '✓' : '—'}}</text>
        </view>
        <text class="trophy-label">{{item.label}}</text>
        <text class="trophy-desc">{{item.desc}}</text>
        <text class="trophy-progress">{{item.progressText}}</text>
      </view>
    </view>
  </view>

  <!-- 周计划记录（用「每周」计划的周期单独列，不塞进日历格子） -->
  <block wx:if="{{weeks.length > 0}}">
    <view class="card week-card">
      <view class="week-row" wx:for="{{weeks}}" wx:key="key">
        <view class="week-main">
          <text class="week-range">{{item.rangeText}}</text>
          <text class="week-sub">{{item.distText}} · {{item.pct}}%</text>
        </view>
        <text class="badge {{item.achieved ? 'badge-done' : 'badge-miss'}}">{{item.achieved ? '周计划达成' : '未达成'}}</text>
      </view>
    </view>
  </block>

  <view wx:if="{{failed}}" class="state">
    <text class="text-muted">加载失败</text>
    <view class="retry" bindtap="onRetry">重试</view>
  </view>
</view>
