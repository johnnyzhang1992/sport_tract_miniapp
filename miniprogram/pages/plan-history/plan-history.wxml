<!-- 计划历史（月历）：参照 Apple 健身——每天一个迷你三环，达成日带绿点；点某天看单日详情 -->
<view class="container">
  <!-- 月份栏：左右切月 + 更改计划入口 -->
  <view class="month-bar">
    <view class="month-nav" bindtap="prevMonth">‹</view>
    <view class="month-title">{{monthText}}</view>
    <view class="month-nav" bindtap="nextMonth">›</view>
    <view class="month-right" bindtap="openPlanSheet">{{hasPlan ? '更改计划' : '创建计划'}}</view>
  </view>

  <!-- 月历：日期数字 + 三个 CSS 环（conic-gradient + mask），点某格看当日详情 -->
  <view class="cal-card">
    <view class="cal-week">
      <view wx:for="{{weekHead}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="cal-body">
      <!-- 纯 CSS 三环：conic-gradient 画进度扇形 + mask 挖空成环；数字在上、环在下，同一格内天然对齐 -->
      <view class="cal-grid">
        <view
          wx:for="{{cells}}"
          wx:key="key"
          class="cal-cell {{item.out ? 'cal-cell-out' : ''}}"
          data-date="{{item.date}}"
          bindtap="onCellTap"
        >
          <view class="cal-num {{item.today ? 'cal-num-today' : ''}}">{{item.day}}</view>
          <view class="rings" wx:if="{{!item.out}}">
            <view class="ring ring-red" style="background: conic-gradient(#FA114F {{item.pct[0] * 100}}%, #FBD9E4 0);"></view>
            <view class="ring ring-green" style="background: conic-gradient(#92E82A {{item.pct[1] * 100}}%, #E6F7D4 0);"></view>
            <view class="ring ring-cyan" style="background: conic-gradient(#1AD4E0 {{item.pct[2] * 100}}%, #D5F6F9 0);"></view>
          </view>
          <view class="cal-done" wx:if="{{item.done}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 图例 -->
  <view class="cal-legend">
    <view class="lg"><view class="lg-dot lg-red"></view>距离</view>
    <view class="lg"><view class="lg-dot lg-green"></view>时间</view>
    <view class="lg"><view class="lg-dot lg-cyan"></view>次数</view>
    <view class="lg"><view class="lg-dot lg-done"></view>三项达成</view>
  </view>

  <!-- 选中的某天：就地展开（不跳页）；再点同一天收起 -->
  <view class="card cur-card" wx:if="{{selected}}">
    <view class="cur-head">
      <text class="cur-title">{{selected.title}}</text>
      <view class="cur-head-right">
        <!-- 未覆盖计划期的日期（计划开始之前）：既不算达成也不算未达成，只如实展示当天运动 -->
        <text wx:if="{{selected.noPlan}}" class="badge badge-none">无计划</text>
        <text wx:else class="badge {{selected.achieved ? 'badge-done' : 'badge-miss'}}">{{selected.achieved ? '已达成' : (selected.loading ? '加载中' : '未达成')}}</text>
        <text class="cur-close" bindtap="clearSelected">收起</text>
      </view>
    </view>
    <block wx:if="{{!selected.loading}}">
      <view class="cur-remain" wx:if="{{selected.noPlan}}">当天没有运动计划</view>
      <block wx:else>
        <view class="cur-metric" wx:for="{{selected.metrics}}" wx:key="key">
          <view class="cur-dot cur-dot-{{item.dot}}"></view>
          <text class="cur-label">{{item.label}}</text>
          <view class="cur-bar">
            <view class="cur-bar-fill cur-bar-{{item.dot}}" style="width: {{item.pct}}%"></view>
          </view>
          <view class="cur-vals">
            <text class="cur-val">{{item.cur}}/{{item.target}}</text>
            <text class="cur-unit">{{item.unit}}</text>
          </view>
        </view>
      </block>
      <view class="day-tracks" wx:if="{{selected.tracks.length > 0}}">
        <view class="day-track" wx:for="{{selected.tracks}}" wx:key="id">
          <text class="day-track-icon">{{item.icon}}</text>
          <text class="day-track-label">{{item.label}}</text>
          <text class="day-track-sub">{{item.distText}} · {{item.durText}}</text>
          <text class="day-track-time">{{item.timeText}}</text>
        </view>
      </view>
      <view class="cur-remain" wx:else>当天没有运动记录</view>
    </block>
    <view class="cur-remain" wx:else>加载中…</view>
  </view>

  <!-- 当前期概况：今天/本期（日期范围）的三项完成度（未选中日期时展示） -->
  <view class="card cur-card" wx:elif="{{current}}">
    <view class="cur-head">
      <text class="cur-title">当前期 · {{current.periodText}}</text>
      <text class="badge {{current.achieved ? 'badge-done' : 'badge-miss'}}">{{current.achieved ? '已达成' : '进行中'}}</text>
    </view>
    <view class="cur-metric" wx:for="{{current.metrics}}" wx:key="key">
      <view class="cur-dot cur-dot-{{item.dot}}"></view>
      <text class="cur-label">{{item.label}}</text>
      <view class="cur-bar">
        <view class="cur-bar-fill cur-bar-{{item.dot}}" style="width: {{item.pct}}%"></view>
      </view>
      <view class="cur-vals">
        <text class="cur-val">{{item.cur}}/{{item.target}}</text>
        <text class="cur-unit">{{item.unit}}</text>
      </view>
    </view>
    <view class="cur-remain">{{current.remainText}}</view>
  </view>

  <!-- 记录数据概况：已完成周期 / 达成次数 / 达成率 / 连续达成 + 累计 -->
  <view class="card sum-card" wx:if="{{summary}}">
    <view class="sum-title-row">
      <text class="sum-title">记录数据概况</text>
      <text class="sum-best">{{summary.bestStreakText}}</text>
    </view>
    <view class="sum-grid">
      <view class="sum-item" wx:for="{{summary.cards}}" wx:key="key">
        <text class="sum-num">{{item.num}}</text>
        <text class="sum-cap">{{item.cap}}</text>
      </view>
    </view>
    <view class="sum-totals">{{summary.totalsText}}</view>
  </view>

  <!-- 里程碑奖杯（docs/21 改版）：卡面=图标+名称+当前次数，分区展示；点击进详情半屏 -->
  <view class="card trophy-card" wx:if="{{summary && summary.trophyGroups.length}}">
    <view class="sum-title-row">
      <text class="sum-title">里程碑奖杯</text>
    </view>
    <block wx:for="{{summary.trophyGroups}}" wx:key="key" wx:for-item="grp">
      <view class="trophy-group-title">{{grp.title}}</view>
      <view class="trophy-grid">
        <view
          class="trophy-item {{item.unlocked ? '' : 'trophy-locked'}}"
          wx:for="{{grp.items}}"
          wx:key="key"
          data-key="{{item.key}}"
          hover-class="trophy-item-hover"
          hover-stay-time="80"
          bindtap="onTrophyTap"
        >
          <!-- 徽章：外层挂数量气泡（不被形状裁切），内层裁形状 + 档位数字印中央；
               未解锁 = 淡彩同款（形状完整可辨），不再是白线稿 -->
          <view class="trophy-badge-wrap">
            <block wx:if="{{grp.key === 'rings'}}">
              <!-- 合上圆环：嵌套三环（首页三环配色 青外/绿中/红内，深色间隔） -->
              <view class="ringbadge-o">
                <view class="ringbadge-g">
                  <view class="ringbadge-r">
                    <view class="ringbadge-core">
                      <text class="badge-center">{{item.badgeText}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </block>
            <view wx:else class="trophy-badge {{item.cls}}">
              <text class="badge-center">{{item.badgeText}}</text>
            </view>
          </view>
          <text class="trophy-label">{{item.label}}</text>
          <!-- 第三行三态：未获得=进度条；获得一次=获取日期；获得多次=次数 -->
          <view class="trophy-progress" wx:if="{{item.earnedCount === 0}}">
            <view class="trophy-progress-fill" style="width: {{item.pct}}%;"></view>
          </view>
          <text class="trophy-count" wx:elif="{{item.earnedCount === 1}}">{{item.earnDateText}}</text>
          <text class="trophy-count" wx:else>获得 {{item.earnedCount}} 次</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 奖杯详情半屏：点击奖杯卡打开 -->
  <view class="trophy-sheet-mask" wx:if="{{trophyDetail}}" bindtap="closeTrophyDetail">
    <view class="trophy-sheet" catchtap="noop">
      <view class="trophy-badge-wrap trophy-sheet-badge">
        <block wx:if="{{trophyDetail.group === 'rings'}}">
          <view class="ringbadge-o">
            <view class="ringbadge-g">
              <view class="ringbadge-r">
                <view class="ringbadge-core">
                  <text class="badge-center">{{trophyDetail.badgeText}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
        <view wx:else class="trophy-badge {{trophyDetail.cls}}">
          <text class="badge-center">{{trophyDetail.badgeText}}</text>
        </view>
      </view>
      <text class="trophy-sheet-label">{{trophyDetail.label}}</text>
      <text class="trophy-sheet-state {{trophyDetail.unlocked ? '' : 'trophy-sheet-state-off'}}">{{trophyDetail.unlocked ? '已解锁' : '未解锁'}}</text>
      <text class="trophy-sheet-desc">{{trophyDetail.desc}}</text>
      <view class="trophy-sheet-progress" wx:for="{{trophyDetail.detailLines}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <!-- 周计划记录（用「每周」计划的周期单独列，不塞进日历格子） -->
  <block wx:if="{{weeks.length > 0}}">
    <view class="card week-card">
      <view class="week-row" wx:for="{{weeks}}" wx:key="key">
        <view class="week-main">
          <text class="week-range">{{item.rangeText}}</text>
          <text class="week-sub">{{item.distText}} · {{item.pct}}%</text>
        </view>
        <text class="badge {{item.achieved ? 'badge-done' : 'badge-miss'}}">{{item.achieved ? '周计划达成' : '未达成'}}</text>
      </view>
    </view>
  </block>

  <!-- 创建/更改计划半屏 -->
  <plan-edit-sheet visible="{{sheetVisible}}" plan="{{planForSheet}}" bind:close="closePlanSheet" bind:saved="onPlanSaved" />

  <view wx:if="{{failed}}" class="state">
    <text class="text-muted">加载失败</text>
    <view class="retry" bindtap="onRetry">重试</view>
  </view>
</view>
