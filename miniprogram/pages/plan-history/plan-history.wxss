/* 计划历史（月历）：月份栏 + 日期数字层 + 三环 canvas + 图例 + 周记录 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 8rpx 0 16rpx;
  position: relative;
}
.month-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}
.month-nav {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eceef2;
  color: #4e5969;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.month-right {
  position: absolute;
  right: 0;
  font-size: 26rpx;
  color: #2b6cf6;
}

.cal-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 12rpx 10rpx;
}
.cal-week {
  display: flex;
  padding-bottom: 6rpx;
}
.cal-week view {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #86909c;
}

/* 日期数字与 canvas 叠放在同一网格上：数字在上半，环在下半 */
.cal-body {
  position: relative;
}
.cal-canvas {
  width: 100%;
  display: block; /* 高度由 inline style（JS 按行数算出的 px）给定，必须与内部像素比例一致 */
}
.cal-hit {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  display: flex;
  flex-wrap: wrap;
}
.hit-cell {
  width: 14.2857%;
}

/* 图例 */
.cal-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx 0 4rpx;
  font-size: 22rpx;
  color: #86909c;
}
.lg {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.lg-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.lg-red { background: #fa114f; }
.lg-green { background: #92e82a; }
.lg-cyan { background: #1ad4e0; }
.lg-done { background: #7cc93f; }

/* 周记录 */
.week-card {
  margin-top: 16rpx;
  padding: 4rpx 20rpx;
}
.week-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.week-row:last-child {
  border-bottom: none;
}
.week-main {
  display: flex;
  flex-direction: column;
}
.week-range {
  font-size: 28rpx;
  color: #1f2329;
}
.week-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #86909c;
}
.badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.badge-done {
  background: #eaf7e6;
  color: #3f9b1c;
}
.badge-miss {
  background: #f2f3f5;
  color: #86909c;
}

.state {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
}
.retry {
  display: inline-block;
  margin-top: 16rpx;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 26rpx;
}
