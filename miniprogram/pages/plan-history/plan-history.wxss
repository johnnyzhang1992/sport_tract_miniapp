/* 计划历史（月历）：月份栏 + 日期数字层 + 三环 canvas + 图例 + 周记录 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 8rpx 0 16rpx;
  position: relative;
}
.month-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}
.month-nav {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eceef2;
  color: #4e5969;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.month-right {
  position: absolute;
  right: 0;
  font-size: 26rpx;
  color: #2b6cf6;
}

.cal-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 12rpx 10rpx;
}
.cal-week {
  display: flex;
  padding-bottom: 6rpx;
}
.cal-week view {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #86909c;
}

/* 月历网格：每格 = 日期数字 + 三个 CSS 环（同一 flex 列，天然对齐） */
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  width: 14.2857%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0 8rpx;
  position: relative;
}
.cal-cell-out {
  opacity: 0.35;
}
.cal-num {
  font-size: 22rpx;
  line-height: 30rpx;
  color: #4e5969;
}
.cal-num-today {
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: #2b6cf6;
  color: #fff;
  font-weight: 600;
}
/* 三环：每环一个节点，conic-gradient 画扇形，mask 挖空成"环"（3rpx 线宽） */
.rings {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  margin-top: 6rpx;
}
.ring {
  position: absolute;
  border-radius: 50%;
  -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 6rpx), #000 calc(100% - 6rpx));
  mask: radial-gradient(closest-side, transparent calc(100% - 6rpx), #000 calc(100% - 6rpx));
}
.ring-red { inset: 0; }
.ring-green { inset: 8rpx; }
.ring-cyan { inset: 16rpx; }
/* 三项达成：日期右侧绿点 */
.cal-done {
  position: absolute;
  top: 6rpx;
  right: 22rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #7cc93f;
}

/* 图例 */
.cal-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx 0 4rpx;
  font-size: 22rpx;
  color: #86909c;
}
.lg {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.lg-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.lg-red { background: #fa114f; }
.lg-green { background: #92e82a; }
.lg-cyan { background: #1ad4e0; }
.lg-done { background: #7cc93f; }

/* 周记录 */
.week-card {
  margin-top: 16rpx;
  padding: 4rpx 20rpx;
}
.week-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.week-row:last-child {
  border-bottom: none;
}
.week-main {
  display: flex;
  flex-direction: column;
}
.week-range {
  font-size: 28rpx;
  color: #1f2329;
}
.week-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #86909c;
}
.badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.badge-done {
  background: #eaf7e6;
  color: #3f9b1c;
}
.badge-miss {
  background: #f2f3f5;
  color: #86909c;
}

.state {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
}
.retry {
  display: inline-block;
  margin-top: 16rpx;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 26rpx;
}

/* 当前周期概况卡 */
.cur-card {
  margin: 0 0 12rpx; /* 置于月历上方：与下方日历拉开间距 */
  padding: 18rpx 24rpx 16rpx;
}
.cur-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.cur-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2329;
}
.cur-metric {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.cur-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 10rpx;
}
.cur-dot-red { background: #fa114f; }
.cur-dot-green { background: #92e82a; }
.cur-dot-cyan { background: #1ad4e0; }
.cur-label {
  width: 64rpx;
  font-size: 22rpx;
  color: #86909c;
  flex-shrink: 0;
}
.cur-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  overflow: hidden;
  margin-right: 12rpx;
}
.cur-bar-fill {
  height: 100%;
  border-radius: 999rpx;
}
.cur-bar-red { background: #fa114f; }
.cur-bar-green { background: #92e82a; }
.cur-bar-cyan { background: #1ad4e0; }
.cur-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: left;
}
/* 数值 + 单位固定宽度、内部左对齐：三行左边缘齐平，与进度条保持固定间距；
   容器宽度固定 → 三条进度条等长（原 flex 平分会被文字宽度带偏） */
.cur-vals {
  width: 200rpx;
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
}
.cur-unit {
  width: 58rpx;
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #86909c;
  flex-shrink: 0;
}
.cur-remain {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f2f3f5;
  font-size: 22rpx;
  color: #86909c;
}

/* 选中日的详情卡：头部右侧（徽章 + 收起）与当天轨迹 */
.cur-head-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cur-close {
  font-size: 22rpx;
  color: #2b6cf6;
}
.day-tracks {
  margin-top: 14rpx;
  padding-top: 6rpx;
  border-top: 1rpx solid #f2f3f5;
}
.day-track {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0;
}
.day-track-icon {
  font-size: 26rpx;
}
.day-track-label {
  font-size: 24rpx;
  color: #1f2329;
  flex-shrink: 0;
}
.day-track-sub {
  flex: 1;
  font-size: 22rpx;
  color: #86909c;
}
.day-track-time {
  font-size: 22rpx;
  color: #86909c;
}

/* 记录数据概况 */
.sum-card {
  margin-top: 8rpx;
  padding: 18rpx 24rpx 16rpx;
}
.sum-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.sum-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2329;
}
.sum-best {
  font-size: 22rpx;
  color: #86909c;
}
.sum-grid {
  display: flex;
}
.sum-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.sum-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.15;
}
.sum-cap {
  font-size: 20rpx;
  color: #86909c;
}
.sum-totals {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f2f3f5;
  font-size: 22rpx;
  color: #86909c;
}

/* 里程碑奖杯墙（与统计页同款形态） */
.trophy-card {
  margin-top: 8rpx;
  padding: 18rpx 24rpx 20rpx;
}
.trophy-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between; /* 4 列：空格留在列间，避免 calc+rpx 混算超宽 */
}
.trophy-item {
  flex: 0 0 23.6%; /* 8 个档位按 4 列两行排 */
  min-width: 0;
  margin-bottom: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 2rpx 12rpx;
  background: #f7f8fa;
  border-radius: 14rpx;
}
.trophy-locked {
  opacity: 0.55;
}
.trophy-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.trophy-badge-on {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.trophy-badge-locked {
  background: #eceef2;
}
.trophy-check {
  font-size: 26rpx;
  font-weight: 700;
  color: #15804f;
}
.trophy-lock {
  font-size: 24rpx;
  color: #8a93a6;
  line-height: 1;
}
.trophy-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: center;
  line-height: 1.2;
}
.trophy-desc {
  margin-top: 4rpx;
  font-size: 17rpx;
  color: #667080;
  text-align: center;
  line-height: 1.2;
}
.trophy-progress {
  margin-top: 4rpx;
  font-size: 17rpx;
  color: #2b6cf6;
}
.trophy-locked .trophy-progress {
  color: #8a93a6;
}
