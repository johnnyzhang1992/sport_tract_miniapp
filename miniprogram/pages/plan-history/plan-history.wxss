/* 奖杯数字字体（docs/21）：Bebas Neue（OFL 开源）拉丁子集 woff2 内嵌 8.6KB，
   计分牌风格的高瘦数字；只覆盖数字/字母，中文标签保持系统字体不受影响 */
@font-face {
  font-family: 'TrophyDigits';
  src: url(data:font/woff2;base64,) format('woff2');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

/* 计划历史（月历）：月份栏 + 日期数字层 + 三环 canvas + 图例 + 周记录 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 8rpx 0 16rpx;
  position: relative;
}
.month-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}
.month-nav {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eceef2;
  color: #4e5969;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.month-right {
  position: absolute;
  right: 0;
  font-size: 26rpx;
  color: #2b6cf6;
}

.cal-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 12rpx 10rpx;
}
.cal-week {
  display: flex;
  padding-bottom: 6rpx;
}
.cal-week view {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #86909c;
}

/* 月历网格：每格 = 日期数字 + 三个 CSS 环（同一 flex 列，天然对齐） */
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  width: 14.2857%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0 8rpx;
  position: relative;
}
.cal-cell-out {
  opacity: 0.35;
}
.cal-num {
  font-size: 22rpx;
  line-height: 30rpx;
  color: #4e5969;
}
.cal-num-today {
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: #2b6cf6;
  color: #fff;
  font-weight: 600;
}
/* 三环：每环一个节点，conic-gradient 画扇形，mask 挖空成"环"（3rpx 线宽） */
.rings {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  margin-top: 6rpx;
}
.ring {
  position: absolute;
  border-radius: 50%;
  -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 6rpx), #000 calc(100% - 6rpx));
  mask: radial-gradient(closest-side, transparent calc(100% - 6rpx), #000 calc(100% - 6rpx));
}
.ring-red { inset: 0; }
.ring-green { inset: 8rpx; }
.ring-cyan { inset: 16rpx; }
/* 三项达成：日期右侧绿点 */
.cal-done {
  position: absolute;
  top: 6rpx;
  right: 22rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #7cc93f;
}

/* 图例 */
.cal-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx 0 4rpx;
  font-size: 22rpx;
  color: #86909c;
}
.lg {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.lg-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.lg-red { background: #fa114f; }
.lg-green { background: #92e82a; }
.lg-cyan { background: #1ad4e0; }
.lg-done { background: #7cc93f; }

/* 周记录 */
.week-card {
  margin-top: 16rpx;
  padding: 4rpx 20rpx;
}
.week-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.week-row:last-child {
  border-bottom: none;
}
.week-main {
  display: flex;
  flex-direction: column;
}
.week-range {
  font-size: 28rpx;
  color: #1f2329;
}
.week-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #86909c;
}
.badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.badge-done {
  background: #eaf7e6;
  color: #3f9b1c;
}
.badge-none {
  background: #f2f3f5;
  color: #8a919e;
}

.badge-miss {
  background: #f2f3f5;
  color: #86909c;
}

.state {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
}
.retry {
  display: inline-block;
  margin-top: 16rpx;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 26rpx;
}

/* 当前周期概况卡 */
.cur-card {
  margin: 0 0 12rpx; /* 置于月历上方：与下方日历拉开间距 */
  padding: 18rpx 24rpx 16rpx;
}
.cur-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.cur-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2329;
}
.cur-metric {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.cur-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 10rpx;
}
.cur-dot-red { background: #fa114f; }
.cur-dot-green { background: #92e82a; }
.cur-dot-cyan { background: #1ad4e0; }
.cur-label {
  /* 三行标签都是两个字：不写死盒宽，盒子直接贴住文字（原 64rpx 有 20rpx 空档挤在条前面） */
  font-size: 22rpx;
  color: #86909c;
  flex-shrink: 0;
  margin-right: 10rpx;
}
.cur-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  overflow: hidden;
  margin-right: 8rpx;
}
.cur-bar-fill {
  height: 100%;
  border-radius: 999rpx;
}
.cur-bar-red { background: #fa114f; }
.cur-bar-green { background: #92e82a; }
.cur-bar-cyan { background: #1ad4e0; }
.cur-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: left;
  white-space: nowrap;
}
/* 数值 + 单位：固定宽度保证三条进度条等长；左对齐 → 数值紧贴进度条（不再出现条与数字之间的大空档），
   富余宽度落在最右侧当空气感留白（200 → 176 → 128rpx，且每次收窄都把空间还给进度条） */
.cur-vals {
  width: 128rpx;
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
  overflow: visible;
}
.cur-unit {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: #86909c;
  flex-shrink: 0;
  white-space: nowrap;
}
.cur-remain {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f2f3f5;
  font-size: 22rpx;
  color: #86909c;
}

/* 选中日的详情卡：头部右侧（徽章 + 收起）与当天轨迹 */
.cur-head-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cur-close {
  font-size: 22rpx;
  color: #2b6cf6;
}
.day-tracks {
  margin-top: 14rpx;
  padding-top: 6rpx;
  border-top: 1rpx solid #f2f3f5;
}
.day-track {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0;
}
.day-track-icon {
  font-size: 26rpx;
}
.day-track-label {
  font-size: 24rpx;
  color: #1f2329;
  flex-shrink: 0;
}
.day-track-sub {
  flex: 1;
  font-size: 22rpx;
  color: #86909c;
}
.day-track-time {
  font-size: 22rpx;
  color: #86909c;
}

/* 记录数据概况 */
.sum-card {
  margin-top: 8rpx;
  padding: 18rpx 24rpx 16rpx;
}
.sum-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.sum-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2329;
}
.sum-grid {
  display: flex;
}
.sum-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.sum-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.15;
}
.sum-cap {
  font-size: 20rpx;
  color: #86909c;
}
.sum-totals {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f2f3f5;
  font-size: 22rpx;
  color: #86909c;
}

/* 里程碑奖杯墙（与统计页同款形态） */
.trophy-card {
  margin-top: 8rpx;
  padding: 18rpx 24rpx 20rpx;
}
.trophy-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start; /* 居左：不满一行的（如完美周两座）不拆到两端 */
}
.trophy-item:nth-child(4n) {
  margin-right: 0;
}
.trophy-item {
  flex: 0 0 23%; /* 4 列，列间 2% 间距（居左排布）；box-sizing 必须显式——内边距会把宽度顶爆导致折行 */
  box-sizing: border-box;
  margin-right: 2%;
  min-width: 0;
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 卡内纵向节奏恒定（2026-11-14 用户要求）：上内边距 = 徽章→名称 = 名称→第三行 = 12rpx */
  padding: 12rpx 4rpx;
  background: #f7f8fa;
  border-radius: 14rpx;
}
.trophy-label {
  margin-top: 0; /* 间距由 badge-wrap 的 margin-bottom 统一给，避免两处叠加 */
  max-width: 100%;
  font-size: 20rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: center;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 奖杯卡改版（docs/21）：图标+名称+次数 三行；分区标题；点击详情半屏 */
.trophy-group-title {
  margin: 8rpx 0 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #667080;
}
.trophy-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 300;
  display: flex;
  align-items: flex-end;
}
.trophy-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}
.trophy-sheet-badge {
  margin-bottom: 12rpx;
}
.trophy-sheet-label {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}
.trophy-sheet-state {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #15804f;
}
.trophy-sheet-state-off {
  color: #8a93a6;
}
.trophy-sheet-desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #4e5969;
  text-align: center;
  line-height: 1.5;
}
.trophy-sheet-progress {
  margin-top: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2b6cf6;
  font-variant-numeric: tabular-nums;
}
.trophy-sheet-record {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #667080;
}

/* ── 奖杯徽章（docs/21 v3）：外层挂数量气泡（不进 clip-path，不会被形状裁切），
   内层形状 + 中央档位数（白色粗字，可读性优先）。
   未解锁 = 淡彩同款：同形状同构图，饱和度压到 15%——「完整但一眼没拿到」，
   不再是白线稿/灰度（那会让占多数的未解锁章看起来像坏掉的占位符） */
.trophy-badge-wrap {
  position: relative; /* 尺寸由内部徽章决定（合上圆环 136rpx / 普通章 96rpx） */
  margin-bottom: 12rpx; /* 与卡内其它纵向间距同一档，不再和 label 的 margin-top 叠加 */
}
.trophy-badge {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.badge-center {
  font-family: 'TrophyDigits', 'DIN Alternate', 'Bebas Neue', sans-serif;
  font-size: 44rpx; /* Bebas 瘦高，加大才占满章面 */
  font-weight: normal; /* 字体本身粗壮，合成加粗反而发糊 */
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.35);
  line-height: 1;
  letter-spacing: 1rpx;
}
/* 形状 */
.b-plan,
.b-ring,
.b-goal {
  border-radius: 50%;
}
.b-hex {
  clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
}
.b-shield {
  clip-path: polygon(0 0, 100% 0, 100% 72%, 50% 100%, 0 72%);
}
/* 已解锁主题（饱和渐变） */
.b-plan {
  background: linear-gradient(145deg, #f6c344, #dd8f19);
}
.b-dist {
  background: linear-gradient(145deg, #4f8ef7, #1d4ed8);
}
.b-dur {
  background: linear-gradient(145deg, #14b8a6, #0f766e);
}
.b-streak {
  background: linear-gradient(145deg, #34d399, #15803d);
}
.b-ring {
  background: #111827;
  border: 5rpx solid #d4af37;
  box-sizing: border-box;
}
/* 累计里程：圆角方牌 + 底部道路虚线（「路程」意象；唯一方形徽章，一眼区分于盾/六边/圆章） */
.b-total-dist {
  background: linear-gradient(145deg, #60a5fa, #1d4ed8);
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
}
.b-total-dist::after {
  content: '';
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 13rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background-image: repeating-linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.92) 0 9rpx,
    rgba(255, 255, 255, 0) 9rpx 18rpx
  );
}
/* 数字上提，给底部道路让位 */
.b-total-dist .badge-center {
  transform: translateY(-6rpx);
}

/* 累计时长：表盘（圆形 + 12 个刻度环，conic-gradient 挖环——与月历三环同一套渲染手段） */
.b-total-dur {
  background: linear-gradient(145deg, #fdba74, #ea580c);
  border-radius: 50%;
  position: relative;
}
.b-total-dur::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: repeating-conic-gradient(
    from -0.8deg,
    rgba(255, 255, 255, 0.9) 0deg 1.6deg,
    rgba(255, 255, 255, 0) 1.6deg 30deg
  );
  -webkit-mask: radial-gradient(circle, transparent 0 33rpx, #000 33rpx 39rpx, transparent 39rpx);
  mask: radial-gradient(circle, transparent 0 33rpx, #000 33rpx 39rpx, transparent 39rpx);
}
.b-week-all {
  background: linear-gradient(145deg, #fb7185, #e11d48);
}
/* 单项完美周：距离/时长/次数各一色，形状沿用盾/六边/圆章 */
.b-week-distance {
  background: linear-gradient(145deg, #fca5a5, #dc2626);
}
.b-week-duration {
  background: linear-gradient(145deg, #86efac, #15803d);
}
.b-week-count {
  background: linear-gradient(145deg, #7dd3fc, #0284c7);
  border: none;
}
/* 未解锁：淡彩同款（完整形状 + 15% 饱和度），中央数字白色照常清晰 */
.trophy-locked .trophy-badge-wrap {
  /* 未获得＝同一套配色 + 透明度变灰（网格与弹窗一套配色，弹窗永远全彩） */
  opacity: 0.45;
}

/* 锁定的合上圆环不用滤镜降饱和（红会糊成棕、绿会糊成灰绿）——直接给干净的灰阶同心环 */


/* 合上圆环徽章：物理嵌套三环（box-shadow / radial-gradient 在该环境 WXSS 里不渲染，
   嵌套 view 是保真方案）；青外 → 绿中 → 红内，深色间隔，中心深底白字档位数 */
.ringbadge-o {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #1ad4e0; /* 次数青（外环） */
  display: flex;
  align-items: center;
  justify-content: center;
}
.ringbadge-g {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: #111827; /* 深色间隔 */
  display: flex;
  align-items: center;
  justify-content: center;
}
.ringbadge-r {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #92e82a; /* 时间绿（中环） */
  display: flex;
  align-items: center;
  justify-content: center;
}
.ringbadge-core {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #fa114f; /* 距离红（内环） */
  display: flex;
  align-items: center;
  justify-content: center;
}
.ringbadge-core .badge-center {
  color: #fff;
  font-size: 26rpx;
  text-shadow: none;
}

/* 第三行容器：三种状态（进度条 / 获取日期 / 获得次数）共用同一高度与上间距 */
.trophy-foot {
  width: 100%;
  height: 20rpx; /* = 日期/次数文案行高，进度条在其中垂直居中 */
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.trophy-count {
  font-size: 20rpx;
  font-weight: 600;
  color: #2b6cf6;
  font-variant-numeric: tabular-nums;
  line-height: 20rpx;
}
.trophy-locked .trophy-count {
  color: #8a93a6;
}

/* 第三行进度条（未获得的奖杯）：浅底轨道 + 品牌蓝填充 */
.trophy-progress {
  width: 82%; /* 不贴卡片边：左右留白并居中 */
  margin: 0;
  height: 10rpx;
  background: #e5e9f0;
  border-radius: 5rpx;
  overflow: hidden;
}
.trophy-progress-fill {
  height: 100%;
  background: #2b6cf6;
  border-radius: 5rpx;
}
