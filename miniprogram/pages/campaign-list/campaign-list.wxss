/* 一起运动活动列表页：卡片度量对齐足迹列表（白卡圆角 16rpx + 轻投影 #667080 次级文字），
   页面左右留白由全局 .container（24rpx）提供 */
.list-state {
  padding: 120rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
.retry {
  margin-left: 8rpx;
  color: #2b6cf6;
  font-weight: 600;
}

/* 我发起 / 我参与 分段控件（同运动榜的周期分段形态；不用组件，页面 .json 无需注册组件） */
.tab-row {
  display: flex;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
}
.tab-seg {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 25rpx;
  color: #4e5969;
  border-radius: 10rpx;
  transition: all 0.15s;
}
.tab-seg-active {
  background: #fff;
  color: #2b6cf6;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 登录引导（照运动榜页的 .login-hint） */
.login-hint {
  background: #fff;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  text-align: center;
}
.login-hint-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.6;
}
.login-hint-text {
  color: #4e5969;
  font-size: 26rpx;
  margin: 24rpx 0 32rpx;
  line-height: 1.6;
}
.login-hint-btn {
  background: #2b6cf6;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  width: 320rpx;
}

/* 活动卡片：标题行（标题 + 非进行中角标 + 箭头）+ 时间 + 成员面 + 我的汇总 */
.cp-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.cp-card-hover {
  opacity: 0.7;
}
.cp-card-head {
  display: flex;
  align-items: center;
}
.cp-card-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 标签本体在 app.wxss 的 .campaign-tag（与详情页共用一份）；这里只补卡片头部的间距——
   .cp-card-head 不像详情页 .head-row 那样用 gap */
.cp-card-head .campaign-tag {
  margin-left: 12rpx;
}
.cp-card-arrow {
  flex: none;
  margin-left: 8rpx;
  font-size: 36rpx;
  color: #667080;
}
.cp-card-time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #667080;
}
/* 成员面：头像堆叠是全局共享样式（.member-av-stack/.member-av/.member-av-text，见 app.wxss） */
.cp-card-members {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.cp-card-stats {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4e5969;
}

/* 右下角悬浮「＋发起」 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  height: 88rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 108, 246, 0.35);
}
.fab-hover {
  opacity: 0.85;
}

/* 非 tab 页：内容可滚到屏幕底，底部垫 Home 指示条安全区 */
.container {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
