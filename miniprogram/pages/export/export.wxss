/* 数据导出：非 tab 页，底部垫安全区；两张卡沿用全局 .card 节奏 */
.page {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.state-block {
  padding: 120rpx 0;
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
}

.state-text {
  color: #333;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.state-link {
  color: #2b6cf6;
  font-size: 26rpx;
}

.sec-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.member-tag {
  font-size: 20rpx;
  line-height: 1;
  color: #2b6cf6;
  background: #e8f0ff;
  border-radius: 999rpx;
  padding: 6rpx 12rpx;
}

.sec-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a93a6;
  line-height: 1.65;
}

.export-btn {
  margin-top: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.export-btn-hover {
  background: #245fdd;
}

.export-btn-busy {
  opacity: 0.6;
}

.member-lock {
  margin-top: 20rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.lock-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #4e5969;
  line-height: 1.5;
}

.lock-btn {
  flex: none;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.lock-btn-hover {
  background: #245fdd;
}

.member-loading {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8a93a6;
}
