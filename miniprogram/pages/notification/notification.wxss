.container { padding: 24rpx; }
.state { padding: 120rpx 0; text-align: center; color: #8a93a6; font-size: 28rpx; }
.state-text { margin-bottom: 24rpx; }
.retry-btn {
  display: inline-block;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background: #2b6cf6;
  color: #ffffff;
  font-size: 26rpx;
}
.notice-card { padding: 32rpx 28rpx; }
.notice-title { font-size: 32rpx; font-weight: 600; color: #1f2329; line-height: 1.4; }
.notice-date { margin-top: 12rpx; font-size: 24rpx; color: #8a93a6; }
.notice-content {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}
