/* 会员中心：沿用积分/榜单页的卡片节奏（24rpx 页边距、16rpx 圆角、#2b6cf6 主色） */
.page {
  padding: 24rpx;
  /* 非 tab 页：底部垫安全区，最后一张卡不贴指示条 */
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.state-block {
  padding: 120rpx 0;
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
}

.state-text {
  color: #333;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.state-link {
  color: #2b6cf6;
  font-size: 26rpx;
}

.closed-block {
  padding: 80rpx 0;
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
}

/* 页头会员卡：卡面插画做底，状态与权益行叠在上面（文字都来自接口） */
.member-hero {
  position: relative;
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #2563eb;
  box-shadow: 0 18rpx 36rpx -22rpx rgba(26, 86, 214, 0.75);
}

.member-hero-img {
  display: block;
  width: 100%;
  height: 100%;
}

.member-hero-body {
  position: absolute;
  inset: 0;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hero-badge {
  align-self: flex-start;
  background: #fff;
  color: #1a56d6;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.hero-bottom {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.hero-status {
  color: #fff;
  font-size: 24rpx;
  line-height: 1.4;
}

.hero-perks {
  display: flex;
  flex-wrap: wrap;
}

.hero-perk {
  width: 50%;
  color: #fff;
  font-size: 20rpx;
  line-height: 1.8;
}

/* 套餐选择行：整行可点，选中项决定底部开通按钮 */
.plan-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.plan-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
}

.plan-row-hover {
  background: #f7f9fc;
}

.plan-row-on {
  border-color: #2b6cf6;
  background: #f6f9ff;
}

.plan-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.plan-row-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.plan-row-duration {
  font-size: 22rpx;
  color: #8a93a6;
}

.plan-row-price {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.plan-row-price-main {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.2;
}

.plan-row-perday {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8a93a6;
}

.plan-row-tick {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #cfd6e2;
  color: transparent;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-row-on .plan-row-tick {
  background: #2b6cf6;
  border-color: #2b6cf6;
  color: #fff;
}

/* 与积分页任务按钮同形态：999rpx 胶囊，选中套餐的统一开通入口 */
.plan-btn {
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.plan-btn-busy {
  opacity: 0.6;
}

.orders-link {
  text-align: center;
  color: #5b6474;
  font-size: 26rpx;
  padding: 28rpx 0 8rpx;
}
