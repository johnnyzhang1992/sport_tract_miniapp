/* 会员中心：沿用积分/榜单页的卡片节奏（24rpx 页边距、16rpx 圆角、#2b6cf6 主色） */
.page {
  padding: 24rpx;
  /* 非 tab 页：底部垫安全区，最后一张卡不贴指示条 */
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.state-block {
  padding: 120rpx 0;
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
}

.state-text {
  color: #333;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.state-link {
  color: #2b6cf6;
  font-size: 26rpx;
}

.closed-block {
  padding: 80rpx 0;
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
}

/* 页头会员卡：浅蓝渐变 + 状态大字 + 权益图标（文案全部来自接口） */
.member-hero {
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
  color: #173a7a;
  background: linear-gradient(150deg, #eaf2ff 0%, #d3e3fc 46%, #b6cff8 100%);
  box-shadow: 0 18rpx 36rpx -24rpx rgba(43, 108, 246, 0.35);
}
.member-hero::before {
  content: "";
  position: absolute;
  width: 520rpx;
  height: 520rpx;
  right: -180rpx;
  top: -220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(43, 108, 246, 0.14), rgba(43, 108, 246, 0) 68%);
}
.member-hero::after {
  content: "";
  position: absolute;
  width: 440rpx;
  height: 440rpx;
  right: -80rpx;
  bottom: -240rpx;
  border-radius: 50%;
  border: 36rpx solid rgba(43, 108, 246, 0.12);
  box-sizing: border-box;
}
.hero-top,
.hero-title,
.hero-sub,
.hero-perks {
  position: relative;
  z-index: 1;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-badge {
  background: #fff;
  border: 2rpx solid #d9e4f7;
  color: #1a56d6;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.hero-gem {
  width: 56rpx;
  height: 56rpx;
  flex: none;
}

.hero-title {
  margin-top: 28rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 1rpx;
  color: #173a7a;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #4a5f85;
  line-height: 1.5;
}

/* 权益图标宫格：两列，每项＝半透明圆角图标 + 文案（文案来自服务端 perkLines） */
.hero-perks {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx 20rpx;
  margin-top: 32rpx;
}

.hero-perk {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.hero-perk-ico {
  width: 54rpx;
  height: 54rpx;
  flex: none;
  border-radius: 18rpx;
  background: #fff;
  border: 2rpx solid #eaf1ff;
  box-shadow: 0 4rpx 10rpx rgba(43, 108, 246, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-perk-icon {
  width: 32rpx;
  height: 32rpx;
}

.hero-perk-text {
  font-size: 22rpx;
  line-height: 1.4;
  color: #2f4a75;
}

/* 套餐卡：三档横排，选中蓝描边 + 浅蓝底；金额/日均都取服务端字段 */
.plan-cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin: 28rpx 0 24rpx;
  padding-top: 20rpx;
}

.plan-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 196rpx;
  padding: 20rpx 18rpx 18rpx;
  box-sizing: border-box;
  background: #fff;
  border: 2rpx solid #e9ecf2;
  border-radius: 20rpx;
}

.plan-card-hover {
  background: #f7f9fc;
}

.plan-card-on {
  border-color: #2b6cf6;
  background: #eef4ff;
  box-shadow: 0 10rpx 26rpx -14rpx rgba(43, 108, 246, 0.45);
}

.plan-tag {
  position: absolute;
  top: -18rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #1f2329;
  color: #f6c76a;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.plan-tick {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #cfd6e2;
  background: #fff;
  color: transparent;
  font-size: 16rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.plan-card-on .plan-tick {
  background: #2b6cf6;
  border-color: #2b6cf6;
  color: #fff;
}

.plan-name {
  font-size: 24rpx;
  color: #4e5969;
  line-height: 1.3;
}

.plan-duration {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #8a93a6;
  line-height: 1.3;
}

.plan-price {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.2;
  white-space: nowrap;
}

.plan-perday {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8a93a6;
  line-height: 1.3;
  white-space: nowrap;
}

/* 到期提醒：浅灰条，右侧一个开启按钮；已开启显示只读状态 */
.reminder-row {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.reminder-main {
  flex: 1;
  min-width: 0;
}

.reminder-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.reminder-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8a93a6;
  line-height: 1.5;
}

.reminder-btn {
  flex: none;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.reminder-btn-hover {
  background: #245fdd;
}

.reminder-btn-busy {
  opacity: 0.6;
}

.reminder-state {
  flex: none;
  font-size: 22rpx;
  color: #15804f;
  background: #e8f7ef;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

/* 与积分页任务按钮同形态：999rpx 胶囊，选中套餐的统一开通入口 */
.plan-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.plan-btn-busy {
  opacity: 0.6;
}

.plan-btn-price {
  font-size: 38rpx;
  font-weight: 700;
  margin-left: 4rpx;
}

.orders-link {
  text-align: center;
  color: #5b6474;
  font-size: 26rpx;
  padding: 28rpx 0 8rpx;
}

/* 照片额度实时用量：一行轻量读数，贴在权益卡与套餐卡之间 */
.quota-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 0 8rpx 16rpx;
}
.quota-line-label {
  font-size: 24rpx;
  color: #8a93a6;
}
.quota-line-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}
.quota-line-value.warn {
  color: #e34d59;
}
.quota-line-rest {
  font-size: 22rpx;
  color: #8a93a6;
}

.quota-line-more {
  margin-left: auto;
  font-size: 22rpx;
  color: #2b6cf6;
}
