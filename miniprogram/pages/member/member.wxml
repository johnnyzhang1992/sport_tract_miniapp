<view class="page">
  <block wx:if="{{!loggedIn}}">
    <view class="state-block" bindtap="onTapGate">
      <view class="state-text">登录后查看会员</view>
      <view class="state-link">点这里登录</view>
    </view>
  </block>

  <block wx:elif="{{loading}}">
    <view class="state-block">加载中…</view>
  </block>

  <block wx:elif="{{failed}}">
    <view class="state-block" bindtap="onRetry">
      <view class="state-text">加载失败</view>
      <view class="state-link">重试</view>
    </view>
  </block>

  <block wx:else>
    <view class="closed-block" wx:if="{{!enabled}}">{{notice}}</view>

    <block wx:if="{{enabled}}">
      <!-- 页头会员卡：深蓝渐变 + 状态大字 + 权益图标；文案全部来自接口 -->
      <view class="member-hero">
        <view class="hero-top">
          <view class="hero-badge">迹路者会员</view>
          <image class="hero-gem" src="/assets/icons/member-badge.png" mode="aspectFit" />
        </view>
        <view class="hero-title" wx:if="{{heroTitle}}">{{heroTitle}}</view>
        <view class="hero-sub" wx:if="{{heroSub}}">{{heroSub}}</view>
        <view class="hero-perks">
          <view class="hero-perk" wx:for="{{heroPerksView}}" wx:key="text">
            <view class="hero-perk-ico">
              <image class="hero-perk-icon" src="{{item.icon}}" mode="aspectFit" />
            </view>
            <text class="hero-perk-text">{{item.text}}</text>
          </view>
        </view>
      </view>

      <!-- 照片额度用量（2026-11-05）：权益区下面给一行实时读数，用户看权益时顺带知道还剩多少 -->
      <view class="quota-line" wx:if="{{photoQuota}}" bindtap="goPhotos">
        <text class="quota-line-label">照片额度</text>
        <text class="quota-line-value {{photoQuota.remaining === 0 ? 'warn' : ''}}">{{photoQuota.used}} / {{photoQuota.limit}} 张{{photoQuota.remaining === 0 ? '（已用尽）' : ''}}</text>
        <text class="quota-line-rest" wx:if="{{photoQuota.remaining > 0}}">剩余 {{photoQuota.remaining}} 张</text>
        <text class="quota-line-more">管理 ›</text>
      </view>

      <!-- 套餐选择：横排三档，选中描边；日均最低一档挂角标（金额文案仍来自接口） -->
      <view class="plan-cards">
        <view
          class="plan-card {{showPay && selectedKey === plan.key ? 'plan-card-on' : ''}}"
          hover-class="{{showPay ? 'plan-card-hover' : ''}}"
          hover-stay-time="80"
          wx:for="{{cards}}" wx:key="key" wx:for-item="plan"
          data-key="{{plan.key}}" bindtap="onSelectPlan"
        >
          <view class="plan-tag" wx:if="{{plan.key === bestValueKey}}">日均最低</view>
          <view class="plan-tick" wx:if="{{showPay}}">✓</view>
          <text class="plan-name">{{plan.name}}</text>
          <text class="plan-duration">{{plan.durationText}}</text>
          <text class="plan-price">{{plan.priceText}}</text>
          <text class="plan-perday">{{plan.perDayText}}</text>
        </view>
      </view>

      <view class="plan-btn {{paying ? 'plan-btn-busy' : ''}}"
            wx:if="{{showPay}}" data-key="{{selectedKey}}" bindtap="onBuy">
        立即支付 <text class="plan-btn-price">{{selectedPriceText}}</text>
      </view>

      <!-- 到期提醒：一次性订阅，用户点允许才有一条额度 -->
      <view class="reminder-row" wx:if="{{entitlements.memberActive && reminder.enabled}}">
        <view class="reminder-main">
          <view class="reminder-title">到期提醒</view>
          <view class="reminder-sub">{{reminder.subscribed ? '已开启 · 到期前 ' + reminder.daysBefore + ' 天提醒' : '到期前 ' + reminder.daysBefore + ' 天通过服务通知提醒你续费'}}</view>
        </view>
        <view wx:if="{{reminder.subscribed}}" class="reminder-state">已开启</view>
        <view wx:else class="reminder-btn {{reminderBusy ? 'reminder-btn-busy' : ''}}" hover-class="reminder-btn-hover" bindtap="onEnableReminder">开启</view>
      </view>
    </block>

    <view class="orders-link" bindtap="goOrders">订单与退款 ›</view>
    <view wx:if="{{operator}}" class="orders-link operator-link" bindtap="goOperator">数据概览 ›</view>
  </block>
</view>
