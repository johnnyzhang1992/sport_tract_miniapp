.container { padding: 24rpx; }
.state { padding: 120rpx 0; text-align: center; color: #667080; font-size: 28rpx; }
.state-text { margin-bottom: 24rpx; }
.retry-btn {
  display: inline-block;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background: #2b6cf6;
  color: #ffffff;
  font-size: 26rpx;
}
.msg-list { padding: 0 24rpx; }
.msg-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.msg-row:last-child { border-bottom: none; }
.msg-row-hover { opacity: 0.75; }
.msg-main { flex: 1; min-width: 0; }
.msg-title-row { display: flex; align-items: center; gap: 10rpx; }
.msg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #c02a30; flex: none; }
.msg-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 30rpx;
  color: #1f2329;
}
.msg-date { margin-top: 8rpx; font-size: 24rpx; color: #667080; }
.msg-arrow { color: #667080; font-size: 28rpx; margin-left: 16rpx; }
