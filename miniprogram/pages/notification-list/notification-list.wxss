.container {
  padding: 24rpx;
  /* 非 tab 页：底部垫 Home 指示条安全区 */
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 搜索 + 订阅入口 */
.topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e5e8ee;
  border-radius: 36rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  opacity: 0.55;
  flex: none;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 27rpx;
  color: #1f2329;
}

.search-placeholder {
  color: #8a93a6;
}

.search-clear {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  color: #8a93a6;
  font-size: 34rpx;
  flex: none;
}

.subscribe-link {
  flex: none;
  color: #2b6cf6;
  font-size: 24rpx;
  padding: 10rpx 4rpx;
}

.link-hover {
  opacity: 0.7;
}

/* 分类 chips */
.cat-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.cat-row {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 0;
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border-radius: 30rpx;
  background: #ffffff;
  color: #5b6475;
  font-size: 26rpx;
  flex: none;
}

.cat-chip.on {
  background: #e8f0ff;
  color: #2b6cf6;
  font-weight: 600;
}

.cat-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #c02a30;
}

/* 已读工具条 */
.toolbar {
  display: flex;
  align-items: center;
  padding: 6rpx 4rpx 16rpx;
}

.unread-toggle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #5b6475;
  font-size: 24rpx;
}

.toggle-check {
  width: 28rpx;
  height: 28rpx;
  line-height: 24rpx;
  text-align: center;
  border: 2rpx solid #c9ced8;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 20rpx;
  box-sizing: border-box;
}

.unread-toggle.on {
  color: #2b6cf6;
}

.unread-toggle.on .toggle-check {
  background: #2b6cf6;
  border-color: #2b6cf6;
}

.toolbar-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.readall-count {
  font-size: 22rpx;
  color: #667080;
  font-variant-numeric: tabular-nums;
}

.readall-btn {
  font-size: 24rpx;
  color: #2b6cf6;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.readall-btn.off {
  opacity: 0.5;
}

.readall-hover {
  opacity: 0.7;
}

/* 空态 / 错误态 */
.state {
  padding: 120rpx 0;
  text-align: center;
  color: #667080;
  font-size: 28rpx;
}

.state-text {
  margin-bottom: 24rpx;
}

.retry-btn {
  display: inline-block;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background: #2b6cf6;
  color: #ffffff;
  font-size: 26rpx;
}

.clear-filter {
  display: inline-block;
  color: #2b6cf6;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
}

/* 消息列表 */
.msg-list {
  padding: 0 24rpx;
  margin-top: 4rpx;
}

.msg-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f2f3f5;
}

.msg-row:last-child {
  border-bottom: none;
}

.msg-row-hover {
  opacity: 0.75;
}

.msg-main {
  flex: 1;
  min-width: 0;
}

.msg-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.msg-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c02a30;
  flex: none;
}

.msg-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 30rpx;
  color: #1f2329;
}

.msg-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.msg-tag {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #f2f4f7;
  color: #5b6475;
  font-size: 20rpx;
}

.msg-date {
  font-size: 24rpx;
  color: #667080;
}

.msg-arrow {
  color: #667080;
  font-size: 28rpx;
  margin-left: 16rpx;
}
