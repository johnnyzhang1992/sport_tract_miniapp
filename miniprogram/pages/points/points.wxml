<view class="page">
  <block wx:if="{{loading && !loggedIn}}">
    <view class="state-block">加载中…</view>
  </block>
  <block wx:elif="{{failed}}">
    <view class="state-block" bindtap="onRetry">
      <text>积分加载失败</text>
      <text class="retry-link">点击重试</text>
    </view>
  </block>
  <block wx:elif="{{loggedIn}}">
    <!-- 积分卡（紧凑版）：只放余额 + 两个入口 + 过期提醒；提醒由服务端判阈值，null 就整行不出 -->
    <view class="card points-card">
      <view class="signin-head">
        <view class="balance-box" hover-class="row-hover" hover-stay-time="80" bindtap="goRecords">
          <text class="balance-num">{{balance}}</text>
          <text class="balance-label">积分明细 ›</text>
        </view>
        <view class="rules-link" hover-class="row-hover" hover-stay-time="80" bindtap="goRules">积分规则</view>
      </view>
      <view wx:if="{{expiring}}" class="expire-note">{{expiring.points}} 积分将在 {{expiring.daysLeft}} 天后过期</view>
    </view>

    <view class="card signin-card">
      <!-- 卡头：连签天数 + 百分位（占原余额位），点整行开签到月历；箭头明说这里能进 -->
      <view class="streak-head" hover-class="row-hover" hover-stay-time="80" bindtap="openCalendar">
        <view class="streak-box">
          <text class="streak-num">连签 {{signin.streakDay}} 天</text>
          <text class="streak-sub">{{streakSub}}</text>
        </view>
        <text class="cal-link">签到日历 ›</text>
      </view>

      <view class="signin-strip">
        <!-- makeup 格直接点「补」字补签（确认弹窗带补完分值）；其余格点击无动作 -->
        <view wx:for="{{strip}}" wx:key="dateKey"
              class="signin-cell {{item.state}}"
              data-date-key="{{item.dateKey}}" bindtap="onMakeup">
          <view class="dot">{{item.dot}}</view>
          <text class="sub">{{item.sub}}</text>
        </view>
      </view>
      <view class="signin-btn" wx:if="{{!signin.todaySigned}}" bindtap="onSignIn">今日签到</view>
      <!-- 已签态：中间数字 = 今天签到实际拿到的积分（今日再点无动作，纯状态展示） -->
      <view class="signin-btn off" wx:else>
        <text>今日已签 +</text>
        <text class="signin-got">{{signin.todayReward}}</text>
        <text>分</text>
      </view>
      <view class="makeup-note" wx:if="{{hasMakeup}}">点「补」字直接补签 · 1 张补签卡补 1 格 · 补完连签重排</view>
    </view>

    <!-- 模板广告位：签到卡与每日任务之间（首屏之下第一屏可见，且不挨着「看视频赚分」按钮） -->
    <ad-template adslot="points" />

    <!-- 每日任务（0 点重置）：放新手卡前面，每日可做的离签到更近 -->
    <view class="card">
      <view class="section-title">每日任务</view>
      <view wx:for="{{taskGroups.dailyTasks}}" wx:key="key" class="task-row">
        <view>
          <view>
            <text class="task-title">{{item.title}}</text>
            <text class="task-points">+{{item.points}}</text>
          </view>
          <!-- 每日多次的任务（看视频）补一行剩余次数，按钮文案说不清「还剩几次」 -->
          <view class="task-sub" wx:if="{{item.timesText}}">{{item.timesText}}</view>
        </view>
        <view class="task-action {{item.statusClass}}" data-key="{{item.key}}" bindtap="onClaim">{{item.actionText}}</view>
      </view>
    </view>

    <!-- 新手任务（一次性）：全部完成后整卡隐藏，不再占位 -->
    <view class="card" wx:if="{{taskGroups.onceTasks.length}}">
      <view class="section-title">新手任务</view>
      <view wx:for="{{taskGroups.onceTasks}}" wx:key="key" class="task-row">
        <view>
          <text class="task-title">{{item.title}}</text>
          <text class="task-points">+{{item.points}}</text>
        </view>
        <view class="task-action {{item.statusClass}}" data-key="{{item.key}}" bindtap="onClaim">{{item.actionText}}</view>
      </view>
    </view>

    <!-- 道具区：接口下发整张商品表，一行两个竖排卡（2026-10-26 改版）；标题右「兑换记录」进兑换记录页（含我的订单） -->
    <view class="card" wx:if="{{items.length}}">
      <view class="section-head">
        <view class="section-title">积分兑换</view>
        <text class="section-link" hover-class="row-hover" hover-stay-time="80" bindtap="goExchangeRecords">兑换记录 ›</text>
      </view>
      <view class="item-grid">
        <view wx:for="{{items}}" wx:key="key" class="item-card" data-key="{{item.key}}" hover-class="row-hover" hover-stay-time="80" bindtap="goItem">
          <image wx:if="{{item.imageUrl}}" class="item-art" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
          <view wx:else class="item-glyph">{{item.glyph}}</view>
          <view class="item-name-row">
            <text class="item-name">{{item.name}}</text>
            <text class="item-owned" wx:if="{{cards > 0}}">持有{{cards}}张</text>
          </view>
          <text class="item-sub">{{item.subtitle}}</text>
          <text class="item-meta">{{item.metaText}}</text>
          <view class="item-foot">
            <view class="item-side">
              <text class="item-price">{{item.priceText}}</text>
              <text class="item-price-unit">积分</text>
            </view>
            <view class="item-go">兑换</view>
          </view>
        </view>
      </view>
    </view>
  </block>
  <view wx:else class="empty" bindtap="onLoginTap">登录后查看积分</view>

  <!-- 签到月历半屏：数据与请求都在本页，组件只渲染与发事件 -->
  <signin-calendar
    visible="{{calVisible}}"
    month="{{calMonth}}"
    days="{{calDays}}"
    streak="{{signin.streakDay}}"
    percent="{{streakPercent}}"
    cards="{{cards}}"
    loading="{{calLoading}}"
    failed="{{calFailed}}"
    bottom="{{true}}"
    bind:close="closeCalendar"
    bind:exchange="goMakeupItem"
    bind:monthchange="onCalMonthChange"
    bind:retry="onCalRetry"
    bind:makeup="onCalMakeup"
    bind:signin="onCalSignin"
  />
</view>
