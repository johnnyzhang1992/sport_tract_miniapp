.page {
  min-height: 100vh;
  background: #f5f6f8;
  /* 底部留白 + Home 指示条安全区：不垫的话最后一张卡会被压在下巴上 */
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 签到卡头（2026-10-26 布局重排）：余额并入签到卡——
   左「N 积分 ›」进明细、右「规则 ›」，七格/签到按钮在其下；页面不再有独立头部 */
.signin-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 4rpx 0;
}

.balance-box {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.balance-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.balance-label {
  font-size: 26rpx;
  color: #2b6cf6;
  padding: 12rpx 0 12rpx 4rpx; /* 加大点击热区（2026-10-26）：文字不变，热区包住上下 */
}

/* 规则入口改成胶囊：命中区大、不用眯眼找小字 */
.rules-link {
  flex: none;
  font-size: 26rpx;
  color: #404653;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
}

.row-hover {
  opacity: 0.7;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 20rpx 20rpx 8rpx; /* 底部 8rpx：task-row 自带 14rpx 上下内边距，再叠 20 会Double 出大空白 */
}

.card + .card {
  margin-top: 16rpx;
}

/* 广告卡与下方卡片之间也按 16rpx（广告宿主节点永远在，广告不展示时正好等于卡片之间的间距） */
ad-template + .card {
  margin-top: 16rpx;
}

.signin-strip {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx; /* 与卡头的余额行拉开 */
}

.signin-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.signin-cell .dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  box-sizing: border-box; /* makeup 格有 2rpx 虚线圈：不加会把 52rpx 圆撑大（wxml 格子被挤歪） */
  background: #f2f3f5;
  color: #8a93a6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

/* 七格五态由服务端 cells.state 驱动（spec §5.1）：signed＝实心品牌蓝（已完成），
   today＝浅蓝底 + 深蓝字（待签，最抢眼球但不是已完成色），
   makeup＝灰底金色虚线圈（可操作，与胶囊同色系），
   missed/future＝灰底灰字——走 .dot 默认样式，三态只靠底色区分，不用 opacity 压整格 */
.signin-cell.signed .dot {
  background: #2b6cf6;
  color: #fff;
}

.signin-cell.today .dot {
  background: #eef4ff;
  color: #1a56d6;
  font-weight: 700;
}

.signin-cell.makeup .dot {
  background: #f7f8fa;
  color: #8a5f12;
  border: 2rpx dashed #8a5f12;
  font-weight: 700;
}

.signin-cell .sub {
  font-size: 18rpx;
  color: #8a93a6;
}

.signin-btn {
  margin-top: 16rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 今天已签后的按钮＝「关掉的通栏主按钮」，用运动详情 join 按钮同款中灰＋白字；
   灰底灰字（app.wxss .campaign-tag 那套）只留给小状态胶囊，不用于 80rpx 主按钮 */
.signin-btn.off {
  background: #64748f;
  color: #fff;
}

/* 已签态中间的实得分数字：比两侧文案大一号，视觉重心 */
.signin-got {
  font-size: 36rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* 补签交互：直接点七格里的「补」字（makeup 格自带暖色虚线圈即入口），胶囊按钮已删——入口只有这一个 */
.makeup-note {
  text-align: center;
  font-size: 20rpx;
  color: #8a93a6;
  margin-top: 12rpx;
}

/* 积分卡（紧凑版）：卡内只有一行余额 + 两个入口，底部留白收掉，别撑成签到卡那么高 */
.points-card {
  padding-bottom: 20rpx;
}

/* 过期提醒：琥珀小字，只有服务端下发时才出现 */
.expire-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b45309;
}

/* 签到卡头：连签天数（点开月历）+ 百分位副题，占原来余额那一行的位置 */
.streak-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx;
}

.streak-box {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.streak-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.streak-sub {
  font-size: 22rpx;
  color: #667080;
}

/* 入口要有明确指向：整行可点，右侧给「签到日历 ›」而不是靠用户猜 */
.cal-link {
  flex: none;
  font-size: 26rpx;
  color: #2b6cf6;
  padding: 16rpx 0 16rpx 24rpx;
}

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
  padding-top: 200rpx;
}

.retry-link {
  color: #2b6cf6;
  font-size: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

/* 分区标题行：左标题右链接（兑换记录） */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-link {
  font-size: 26rpx;
  color: #2b6cf6;
  padding: 8rpx 0 8rpx 16rpx; /* 左侧留白扩热区 */
}

.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-title {
  font-size: 26rpx;
}

.task-points {
  font-size: 22rpx;
  color: #8a5f12; /* 奖励分值用本项目的「荣誉金」（里程碑奖杯/穗枝同色），不用参考稿的黄 */
  margin-left: 8rpx;
}

/* 每日多次任务的剩余次数：跟在标题下面一行，不抢主文案 */
.task-sub {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #8a93a6;
}

/* 三态按钮：透明边框常驻占位（描边态不撑高、底边不被行分隔线盖住），
   box-sizing 必须显式——不加时 1rpx 边框会把元素撑大，真机上底边渲染不全 */
.task-action {
  box-sizing: border-box;
  border: 1rpx solid transparent;
  padding: 5rpx 19rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 22rpx;
}

/* locked（待做）＝描边引导态：与「待领取」实心蓝区分 */
.task-action.off {
  background: #fff;
  color: #2b6cf6;
  border-color: #2b6cf6;
}

/* claimed（已领取）＝完成态：浅灰底灰字沉底，与待做/待领取一眼区分 */
.task-action.done {
  background: #f2f3f5;
  color: #8a93a6;
}

/* 道具卡：一行两个竖排卡（2026-10-26 改版），图位白底金字在上，价格+兑换钮压底 */
.item-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 12rpx;
}

.item-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
}

/* 道具图占满卡宽：竖排卡里 88rpx 小方块放不下带文案的道具图（字会糊），整宽才看得清 */
.item-art {
  width: 100%;
  height: 150rpx;
  border-radius: 12rpx;
  background: #fff;
}

.item-glyph {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #fff;
  color: #8a5f12;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
}

.item-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.item-owned {
  font-size: 20rpx;
  color: #2b6cf6;
  background: #eaf1ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.item-sub {
  font-size: 22rpx;
  color: #667080;
  /* 副标题锁单行：两列窄卡里长文案折行会从词中间断开（「30天有/效」），宁可省略 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 有效期 + 库存：一行灰字，跟副标题分开，不再被挤断 */
.item-meta {
  font-size: 22rpx;
  color: #8a93a6;
}

.item-side {
  flex: none;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.item-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #8a5f12;
}

.item-price-unit {
  font-size: 20rpx;
  color: #667080;
}

/* 卡底行：价格左、兑换钮右；margin-top:auto 保证多行副标题时钮仍贴底 */
.item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.item-go {
  font-size: 24rpx;
  color: #fff;
  background: #2b6cf6;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}

.empty {
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
  padding-top: 200rpx;
}
