.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 24rpx;
}

/* 余额英雄区：蓝渐变压深一档（#1a56d6→#2b6cf6，两色都是本项目已有），因为这里要放
   24rpx 的可点文字——首页那条 #2b6cf6→#5b8cff 的浅端上白字只有 3.16:1，这里最浅 4.59:1。 */
.balance-card {
  background: linear-gradient(135deg, #1a56d6, #2b6cf6);
  padding: 32rpx 32rpx 72rpx;
}

.balance {
  display: block;
  font-size: 88rpx;
  font-weight: 700;
  text-align: center;
  color: #fff;
}

.balance-actions {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #fff;
  margin-top: 8rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  margin: -44rpx 24rpx 0;
  padding: 24rpx;
}

.card + .card {
  margin-top: 20rpx;
}

.signin-strip {
  display: flex;
  justify-content: space-between;
}

.signin-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.signin-cell .dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f2f3f5;
  color: #8a93a6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

/* 七格进度：done＝实心品牌蓝（已完成），current＝今天那格用浅蓝底 + 深蓝字（待签，最抢眼球
   但不是已完成色），未来/漏签＝灰底灰字——三态只靠底色区分，不用 opacity 压整格 */
.signin-cell.done .dot {
  background: #2b6cf6;
  color: #fff;
}

.signin-cell.current .dot {
  background: #eef4ff;
  color: #1a56d6;
  font-weight: 700;
}

.signin-cell .sub {
  font-size: 18rpx;
  color: #8a93a6;
}

.signin-btn {
  margin-top: 24rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

/* 今天已签后的按钮＝「关掉的通栏主按钮」，用运动详情 join 按钮同款中灰＋白字；
   灰底灰字（app.wxss .campaign-tag 那套）只留给小状态胶囊，不用于 80rpx 主按钮 */
.signin-btn.off {
  background: #64748f;
  color: #fff;
}

.makeup-link {
  text-align: center;
  font-size: 22rpx;
  color: #2b6cf6;
  margin-top: 14rpx;
}

.streak-note {
  text-align: center;
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 16rpx;
}

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
  padding-top: 200rpx;
}

.retry-link {
  color: #2b6cf6;
  font-size: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
}

.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-title {
  font-size: 26rpx;
}

.task-points {
  font-size: 22rpx;
  color: #8a5f12; /* 奖励分值用本项目的「荣誉金」（里程碑奖杯/穗枝同色），不用参考稿的黄 */
  margin-left: 8rpx;
}

.task-action {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 22rpx;
}

.task-action.off {
  background: #f2f3f5;
  color: #8a93a6;
}

/* 道具卡：浅灰底自成一块（一道具一张），图位白底金字，与商品页头图同一套观感 */
.item-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
}

.item-glyph {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #8a5f12;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
}

.item-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.item-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.item-owned {
  font-size: 20rpx;
  color: #2b6cf6;
  background: #eaf1ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.item-sub {
  font-size: 22rpx;
  color: #667080;
}

.item-side {
  flex: none;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.item-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #8a5f12;
}

.item-price-unit {
  font-size: 20rpx;
  color: #667080;
}

.link-arrow {
  color: #8a93a6;
  font-size: 32rpx;
}

.empty {
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
  padding-top: 200rpx;
}
