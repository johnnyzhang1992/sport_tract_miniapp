.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 24rpx;
}

.balance-card {
  background: linear-gradient(160deg, #ffd633, #ffcc00);
  padding: 32rpx 32rpx 72rpx;
}

.balance {
  display: block;
  font-size: 88rpx;
  font-weight: 700;
  text-align: center;
  color: #1f2329;
}

.balance-actions {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #4e5969;
  margin-top: 8rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  margin: -44rpx 24rpx 0;
  padding: 24rpx;
}

.card + .card {
  margin-top: 20rpx;
}

.signin-strip {
  display: flex;
  justify-content: space-between;
}

.signin-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.signin-cell .dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f2f3f5;
  color: #8a93a6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.signin-cell.done .dot {
  background: #ffd633;
  color: #1f2329;
}

.signin-cell.current .dot {
  background: #ffd633;
  color: #1f2329;
  font-weight: 700;
}

.signin-cell .sub {
  font-size: 18rpx;
  color: #8a93a6;
}

.signin-btn {
  margin-top: 24rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #ffd633;
  color: #1f2329;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.signin-btn.off {
  background: #f2f3f5;
  color: #8a93a6;
}

.makeup-link {
  text-align: center;
  font-size: 22rpx;
  color: #2b6cf6;
  margin-top: 14rpx;
}

.streak-note {
  text-align: center;
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 16rpx;
}

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
  padding-top: 200rpx;
}

.retry-link {
  color: #2b6cf6;
  font-size: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
}

.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-title {
  font-size: 26rpx;
}

.task-points {
  font-size: 22rpx;
  color: #e8791e;
  margin-left: 8rpx;
}

.task-action {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #ffd633;
  font-size: 22rpx;
}

.task-action.off {
  background: #f2f3f5;
  color: #8a93a6;
}

.exchange-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  display: block;
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 6rpx;
}

.link-arrow {
  color: #8a93a6;
  font-size: 32rpx;
}

.empty {
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
  padding-top: 200rpx;
}
