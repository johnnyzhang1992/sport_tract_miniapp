.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 24rpx;
}

/* 签到卡头（2026-10-26 布局重排）：余额并入签到卡——
   左「N 积分 ›」进明细、右「规则 ›」，七格/签到按钮在其下；页面不再有独立头部 */
.signin-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 4rpx 4rpx 0;
}

.balance-box {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.balance-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.balance-label {
  font-size: 24rpx;
  color: #2b6cf6;
}

.rules-link {
  font-size: 24rpx;
  color: #8a93a6;
}

.row-hover {
  opacity: 0.7;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 20rpx 20rpx 8rpx; /* 底部 8rpx：task-row 自带 14rpx 上下内边距，再叠 20 会Double 出大空白 */
}

.card + .card {
  margin-top: 16rpx;
}

.signin-strip {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx; /* 与卡头的余额行拉开 */
}

.signin-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.signin-cell .dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  box-sizing: border-box; /* makeup 格有 2rpx 虚线圈：不加会把 52rpx 圆撑大（wxml 格子被挤歪） */
  background: #f2f3f5;
  color: #8a93a6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

/* 七格五态由服务端 cells.state 驱动（spec §5.1）：signed＝实心品牌蓝（已完成），
   today＝浅蓝底 + 深蓝字（待签，最抢眼球但不是已完成色），
   makeup＝灰底金色虚线圈（可操作，与胶囊同色系），
   missed/future＝灰底灰字——走 .dot 默认样式，三态只靠底色区分，不用 opacity 压整格 */
.signin-cell.signed .dot {
  background: #2b6cf6;
  color: #fff;
}

.signin-cell.today .dot {
  background: #eef4ff;
  color: #1a56d6;
  font-weight: 700;
}

.signin-cell.makeup .dot {
  background: #f7f8fa;
  color: #8a5f12;
  border: 2rpx dashed #8a5f12;
  font-weight: 700;
}

.signin-cell .sub {
  font-size: 18rpx;
  color: #8a93a6;
}

.signin-btn {
  margin-top: 16rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 今天已签后的按钮＝「关掉的通栏主按钮」，用运动详情 join 按钮同款中灰＋白字；
   灰底灰字（app.wxss .campaign-tag 那套）只留给小状态胶囊，不用于 80rpx 主按钮 */
.signin-btn.off {
  background: #64748f;
  color: #fff;
}

/* 已签态中间的实得分数字：比两侧文案大一号，视觉重心 */
.signin-got {
  font-size: 36rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* 补签交互：直接点七格里的「补」字（makeup 格自带暖色虚线圈即入口），胶囊按钮已删——入口只有这一个 */
.makeup-note {
  text-align: center;
  font-size: 20rpx;
  color: #8a93a6;
  margin-top: 12rpx;
}

.streak-note {
  text-align: center;
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 12rpx;
}

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
  padding-top: 200rpx;
}

.retry-link {
  color: #2b6cf6;
  font-size: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-title {
  font-size: 26rpx;
}

.task-points {
  font-size: 22rpx;
  color: #8a5f12; /* 奖励分值用本项目的「荣誉金」（里程碑奖杯/穗枝同色），不用参考稿的黄 */
  margin-left: 8rpx;
}

.task-action {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 22rpx;
}

/* locked（待做）＝描边引导态：与「待领取」实心蓝区分 */
.task-action.off {
  background: #fff;
  color: #2b6cf6;
  border: 1rpx solid #2b6cf6;
}

/* claimed（已领取）＝完成态：浅灰底灰字沉底，与待做/待领取一眼区分 */
.task-action.done {
  background: #f2f3f5;
  color: #8a93a6;
  border: none;
}

/* 道具卡：浅灰底自成一块（一道具一张），图位白底金字，与商品页头图同一套观感 */
.item-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
}

.item-glyph {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #fff;
  color: #8a5f12;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.item-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.item-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.item-owned {
  font-size: 20rpx;
  color: #2b6cf6;
  background: #eaf1ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.item-sub {
  font-size: 22rpx;
  color: #667080;
}

.item-side {
  flex: none;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.item-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #8a5f12;
}

.item-price-unit {
  font-size: 20rpx;
  color: #667080;
}

.link-arrow {
  color: #8a93a6;
  font-size: 32rpx;
}

.empty {
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
  padding-top: 200rpx;
}
