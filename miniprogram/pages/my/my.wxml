<view class="container">
  <!-- 用户卡片（未登录点开登录弹窗，已登录进资料编辑） -->
  <view class="card user-card hover-card" hover-class="card-hover" hover-stay-time="100" bindtap="onUserCardTap">
    <t-avatar
      class="user-avatar"
      image="{{user.avatarUrl || '/assets/icons/lucide-user.png'}}"
      size="96rpx"
    >
      {{user.avatarText}}
    </t-avatar>
    <view class="user-info">
      <view class="user-name">{{loggedIn ? (user.nickname || '微信用户') : '未登录'}}</view>
      <view class="text-muted">{{loggedIn ? (user.uid ? '迹路者' + user.uid + ' · 已加入 ' + user.joinDays + ' 天' : '点击编辑资料') : '点击登录，同步运动数据'}}</view>
      <view class="body-data" wx:if="{{showBodyData}}">
        <text class="body-item" wx:if="{{user.heightCm}}">身高 {{user.heightCm}}cm</text>
        <text class="body-item" wx:if="{{user.weightKg}}">体重 {{user.weightKg}}kg</text>
      </view>
    </view>
    <view class="link-arrow user-arrow">›</view>
  </view>

  <!-- 数据统计卡片（今日/本周/本月运动距离，整卡可点） -->
  <view class="card stats-card" hover-class="card-hover" hover-stay-time="100" bindtap="goStats">
    <view class="stats-head">
      <view class="stats-title-row">
        <image class="stats-icon" src="/assets/icons/lucide-chart.png" mode="aspectFit" />
        <text class="stats-title">数据统计</text>
      </view>
      <view class="stats-arrow">›</view>
    </view>
    <view class="stats-grid">
      <view class="stats-cell">
        <view class="stats-num">{{statsCards[0].distance}}</view>
        <view class="stats-label">今日</view>
      </view>
      <view class="stats-cell">
        <view class="stats-num">{{statsCards[1].distance}}</view>
        <view class="stats-label">本周</view>
      </view>
      <view class="stats-cell">
        <view class="stats-num">{{statsCards[2].distance}}</view>
        <view class="stats-label">本月</view>
      </view>
    </view>
  </view>

  <!-- 运动报告入口（周/月/年汇总 + 个人最佳 + 轨迹记录） -->
  <view class="card link-row" hover-class="card-hover" hover-stay-time="100" bindtap="goReport">
    <view class="switch-info">
      <view class="switch-title">运动报告</view>
      <view class="text-muted">周/月/年运动汇总 · 个人最佳 · 轨迹记录</view>
    </view>
    <view class="link-arrow">›</view>
  </view>

  <!-- 年度运动报告入口（仅年末 12 月展示，平时从运动报告页进入） -->
  <view class="card link-row" hover-class="card-hover" hover-stay-time="100" bindtap="goYearReport" wx:if="{{showYearReport}}">
    <view class="switch-info">
      <view class="switch-title">年度运动报告</view>
      <view class="text-muted">年度总评 · 月度分解 · 高光时刻 · 海报</view>
    </view>
    <view class="link-arrow">›</view>
  </view>

  <!-- 轨迹合集 / 点亮地图（合并大卡片，菜单式） -->
  <t-cell-group class="card menu-card">
    <t-cell title="轨迹合集" arrow bind:click="goOverview">
      <image slot="left-icon" class="cell-icon" src="/assets/icons/lucide-compass.png" mode="aspectFit" />
    </t-cell>
    <t-cell title="点亮地图" arrow bind:click="goFootprint">
      <image slot="left-icon" class="cell-icon" src="/assets/icons/lucide-globe.png" mode="aspectFit" />
    </t-cell>
  </t-cell-group>

  <!-- 菜单 -->
  <t-cell-group class="card menu-card">
    <t-cell title="数据导入" arrow bind:click="goImport">
      <image slot="left-icon" class="cell-icon" src="/assets/icons/lucide-download.png" mode="aspectFit" />
    </t-cell>
    <t-cell title="设置" arrow bind:click="goSettings">
      <image slot="left-icon" class="cell-icon" src="/assets/icons/lucide-settings.png" mode="aspectFit" />
    </t-cell>
  </t-cell-group>

  <view class="text-muted version-tip">小迹一下 v1.0 @小小梦工场</view>
</view>
