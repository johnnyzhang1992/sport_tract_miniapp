<view class="container">
  <!-- 用户卡片（未登录点开登录弹窗，已登录进资料编辑）：头部加积分资产行（原骨架 + 渐进创意） -->
  <view class="card user-card">
    <view class="user-head" hover-class="card-hover" hover-stay-time="100" bindtap="onUserCardTap">
      <view class="user-avatar-wrap">
        <t-avatar
          class="user-avatar"
          image="{{user.avatarUrl || '/assets/icons/lucide-user.png'}}"
          size="96rpx"
        >
          {{user.avatarText}}
        </t-avatar>
        <image
          wx:if="{{loggedIn && isMember}}"
          class="avatar-member-badge"
          src="/assets/icons/member-badge.png"
          mode="aspectFit"
        />
      </view>
      <view class="user-info">
        <view class="user-name">{{loggedIn ? (user.nickname || '微信用户') : '未登录'}}</view>
        <view class="text-muted">{{loggedIn ? (user.uid ? '迹路者' + user.uid + ' · 已加入 ' + user.joinDays + ' 天' : '点击编辑资料') : '点击登录，同步运动数据'}}</view>
        <view class="body-data" wx:if="{{loggedIn && showBodyData}}">
          <text class="body-item" wx:if="{{user.heightCm}}">身高 {{user.heightCm}}cm</text>
          <text class="body-item" wx:if="{{user.weightKg}}">体重 {{user.weightKg}}kg</text>
        </view>
      </view>
      <view class="link-arrow">›</view>
    </view>

    <!-- 积分资产区（仅登录后）：双格数字（积分余额/连签）+ 签到胶囊，
         与下方统计卡同一套「大数字+小标签」语言；配色黑/灰/白，无图标；
         左两格整体进积分页，右侧未签直签 -->
    <view class="asset-row" wx:if="{{loggedIn && signin.loaded}}">
      <view class="asset-cell" hover-class="row-hover" hover-stay-time="80" catchtap="onBadgeTap">
        <view class="asset-num">{{signin.balance}}</view>
        <view class="asset-label">积分</view>
      </view>
      <view class="asset-cell" hover-class="row-hover" hover-stay-time="80" catchtap="onBadgeTap">
        <view class="asset-num">{{signin.streakDay}}</view>
        <view class="asset-label">连签天数</view>
      </view>
      <view class="sign-chip {{signin.signedToday ? 'signed' : ''}}" catchtap="onSigninStripTap" hover-class="row-hover" hover-stay-time="80">
        {{signin.signedToday ? '✓ 已签' : '签到 +' + signin.nextReward}}
      </view>
    </view>
  </view>

  <!-- 快捷入口：消息 / 积分 / 会员 / 设置（四等分） -->
  <view class="card quick-card">
    <view class="quick-item" hover-class="quick-item-hover" hover-stay-time="80" bindtap="goNotifications">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/lucide-bell.png" mode="aspectFit" />
        <view class="quick-badge" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      </view>
      <view class="quick-label">消息</view>
    </view>
    <view class="quick-item" hover-class="quick-item-hover" hover-stay-time="80" bindtap="goPoints">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/lucide-coins.png" mode="aspectFit" />
      </view>
      <view class="quick-label">积分</view>
    </view>
    <view class="quick-item" hover-class="quick-item-hover" hover-stay-time="80" bindtap="goMember">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/lucide-gem.png" mode="aspectFit" />
      </view>
      <view class="quick-label">会员</view>
    </view>
    <view class="quick-item" hover-class="quick-item-hover" hover-stay-time="80" bindtap="goSettings">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/lucide-settings.png" mode="aspectFit" />
      </view>
      <view class="quick-label">设置</view>
    </view>
  </view>

  <!-- 运动报告入口（汇总 + 亮点 + 环比 + 分类型/日期明细 + 海报；个人最佳与轨迹记录已迁走） -->
  <view class="card link-row" hover-class="card-hover" hover-stay-time="100" bindtap="goReport">
    <view class="switch-info">
      <view class="switch-title">运动报告</view>
      <view class="text-muted">周/月/年汇总 · 环比与亮点 · 分类型/日期明细</view>
    </view>
    <view class="link-arrow">›</view>
  </view>

  <!-- 年度运动报告入口（仅年末 12 月展示，平时从运动报告页进入） -->
  <view class="card link-row" hover-class="card-hover" hover-stay-time="100" bindtap="goYearReport" wx:if="{{showYearReport}}">
    <view class="switch-info">
      <view class="switch-title">年度运动报告</view>
      <view class="text-muted">年度总评 · 月度分解 · 高光时刻 · 海报</view>
    </view>
    <view class="link-arrow">›</view>
  </view>

  <!-- 菜单：轨迹合集 / 足迹 / 数据导入 / 数据导出
       箭头统一用 .link-arrow（与上面三张卡同字形同色同右距），不再用组件的 arrow 图标 -->
  <t-cell-group class="card menu-card">
    <t-cell title="轨迹合集" t-class-left="cell-left" t-class-title="cell-title" bind:click="goOverview">
      <image slot="left-icon" class="cell-icon" src="/assets/icons/lucide-compass.png" mode="aspectFit" />
      <view slot="right-icon" class="link-arrow">›</view>
    </t-cell>
    <!-- 足迹地图：2026-11-04 从 tabBar 移到个人中心（原第三格换成统计页） -->
    <t-cell title="足迹" t-class-left="cell-left" t-class-title="cell-title" bind:click="goFootprints">
      <image slot="left-icon" class="cell-icon" src="/assets/icons/lucide-footprints.png" mode="aspectFit" />
      <view slot="right-icon" class="link-arrow">›</view>
    </t-cell>
    <t-cell title="数据导入" t-class-left="cell-left" t-class-title="cell-title" bind:click="goImport">
      <image slot="left-icon" class="cell-icon" src="/assets/icons/lucide-download.png" mode="aspectFit" />
      <view slot="right-icon" class="link-arrow">›</view>
    </t-cell>
    <t-cell title="数据导出" t-class-left="cell-left" t-class-title="cell-title" bind:click="goExport">
      <image slot="left-icon" class="cell-icon" src="/assets/icons/lucide-share.png" mode="aspectFit" />
      <view slot="right-icon" class="link-arrow">›</view>
    </t-cell>
  </t-cell-group>

  <view class="text-muted version-tip">小迹一下 @小小梦工场</view>

  <!-- 数据导出半屏：选范围/类型 → 生成 CSV 拉起分享。
       多条轨迹打包（GPX）走轨迹合集页的「多选」——该入口 2026-10-30 起临时关闭，恢复前这里只能导汇总 CSV -->
</view>
