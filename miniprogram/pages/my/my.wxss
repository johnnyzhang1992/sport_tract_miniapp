/* 用户卡片：原白卡骨架。内部分两层——上半身份（可点进资料编辑，箭头明示），
   下半积分资产行（浅灰底内嵌条：左积分/连签 进积分页，右签到胶囊 未签直签） */
.user-card {
  padding: 32rpx 24rpx 24rpx;
}

.user-head {
  display: flex;
  align-items: center;
}

.user-avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex: none;
  margin-right: 24rpx;
}

.user-avatar {
  margin-right: 0;
}

/* 头像右下角会员徽标：金色圆底宝石，白描边与头像分开；下缘挂出头像 8rpx（约四分之一身位） */
.avatar-member-badge {
  position: absolute;
  right: 0;
  bottom: -8rpx;
  width: 32rpx;
  height: 32rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
}

/* 积分资产区：白卡内的浅灰内嵌双格（与下方统计卡同一套「大数字+小标签」语言），
   配色黑/灰/白无图标。左格积分余额、右格连签天数，两格整体可点进积分页，
   右侧签到胶囊独立（未签直签） */
.asset-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 12rpx;
}

.asset-cell {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 8rpx 0 8rpx 16rpx;
}

.asset-num {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.asset-label {
  font-size: 20rpx;
  color: #8a93a6;
  line-height: 1;
}



/* 签到胶囊：小一号（尺寸用户确认可以）；圆角 16rpx——12 太方、全圆过圆 */
.sign-chip {
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 22rpx;
  font-weight: 400;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.sign-chip.signed {
  background: #eceff3;
  color: #8a93a6;
}

/* 身高体重展示（原样式：浅灰胶囊） */
.body-data {
  margin-top: 10rpx;
  display: flex;
  gap: 20rpx;
}

.body-item {
  font-size: 22rpx;
  color: #667080;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* 快捷入口：消息/积分/会员/设置 四等分；上下结构，尺寸取「原版」与「单行版」之间 */
.quick-card {
  display: flex;
  padding: 14rpx 8rpx;
}

.quick-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 0;
  border-radius: 12rpx;
}

.quick-item-hover {
  background: #f5f7fa;
}

.quick-icon-wrap {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-icon {
  width: 36rpx;
  height: 36rpx;
}

.quick-badge {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  min-width: 26rpx;
  height: 26rpx;
  padding: 0 5rpx;
  box-sizing: border-box;
  border-radius: 13rpx;
  background: #c02a30;
  color: #fff;
  font-size: 16rpx;
  line-height: 26rpx;
  text-align: center;
}

.quick-label {
  font-size: 24rpx;
  color: #1f2329;
}

.menu-card {
  /* 横向与页面其它卡片一致（24rpx）：卡片自己出这 24rpx，cell 的内建边距归零，
     否则 12rpx + 32rpx = 44rpx 会比上面的卡片缩进去一圈。
     自定义属性里的 rpx 不参与编译期换算，所以只能写 0px 这种 px 值。 */
  padding: 8rpx 24rpx;
  --td-cell-horizontal-padding: 0px;
  /* 行上下留白收一档：组件默认 32rpx（行距 56px）→ 12px（行距 48px）。同样只能写 px。 */
  --td-cell-vertical-padding: 12px;
  /* 图标与文案的间距：组件给 .t-cell__left 带 24rpx（≈12.5px），原先图片又叠了 8rpx，
     实测墨迹间空隙 14.4px。这里去掉图片那层重复 margin，只留这个令牌（6px）。 */
  --td-spacer-1: 6px;
}

.cell-left {
  display: flex;
  align-items: center;
}

/* 菜单文案压一档（组件默认 32rpx）。外类名落在 .t-cell__title-text 同一个元素上，
   两边都是单类选择器、组件样式排在后面，普通声明会被它的 `font:` 简写压掉；
   页面样式进不到组件内部也没法再抬权重（试过 --td-cell-title-font 令牌，值被解析掉不生效），只能 !important。
   只压字号，行高仍走组件的 48rpx，行距不受影响。 */
.cell-title {
  font-size: 28rpx !important;
}

.cell-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* 入口行卡（运动报告 / 年度报告） */
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-info {
  flex: 1;
}

.switch-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.link-arrow {
  font-size: 40rpx;
  color: #667080;
  margin-left: 12rpx;
  flex-shrink: 0;
  line-height: 1;
}

.row-hover {
  opacity: 0.7;
}

.version-tip {
  text-align: center;
  padding: 16rpx 0;
}
