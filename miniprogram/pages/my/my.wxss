.user-card {
  display: flex;
  align-items: center;
  /* 横向与页面其它卡片一致 24rpx（上下留白维持 40rpx，这张是页面头牌，不跟着压） */
  padding: 40rpx 24rpx;
}
.card-hover {
  opacity: 0.7;
  transform: scale(0.99);
}
.user-avatar {
  margin-right: 24rpx;
}
.user-info {
  flex: 1; /* 撑满中部，箭头靠右 */
}
.user-name {
  font-size: 34rpx;
  font-weight: 600;
}
.menu-card {
  /* 横向与页面其它卡片一致（24rpx）：卡片自己出这 24rpx，cell 的内建边距归零，
     否则 12rpx + 32rpx = 44rpx 会比上面的卡片缩进去一圈。
     自定义属性里的 rpx 不参与编译期换算，所以只能写 0px 这种 px 值。 */
  padding: 8rpx 24rpx;
  --td-cell-horizontal-padding: 0px;
  /* 行上下留白收一档：组件默认 32rpx（行距 56px）→ 12px（行距 48px）。同样只能写 px。 */
  --td-cell-vertical-padding: 12px;
  /* 图标与文案的间距：组件给 .t-cell__left 带 24rpx（≈12.5px），原先图片又叠了 8rpx，
     实测墨迹间空隙 14.4px。这里去掉图片那层重复 margin，只留这个令牌（6px）。 */
  --td-spacer-1: 6px;
}
.cell-left {
  display: flex;
  align-items: center;
}
/* 菜单文案压一档（组件默认 32rpx）。外类名落在 .t-cell__title-text 同一个元素上，
   两边都是单类选择器、组件样式排在后面，普通声明会被它的 `font:` 简写压掉；
   页面样式进不到组件内部也没法再抬权重（试过 --td-cell-title-font 令牌，值被解析掉不生效），只能 !important。
   只压字号，行高仍走组件的 48rpx，行距不受影响。 */
.cell-title {
  font-size: 28rpx !important;
}
.cell-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* 运动报告入口行 */
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.switch-info {
  flex: 1;
}
.switch-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.link-arrow {
  font-size: 40rpx;
  color: #8a93a6;
  margin-left: 12rpx;
  flex-shrink: 0;
  line-height: 1;
}
.version-tip {
  text-align: center;
  padding: 40rpx 0;
}

/* 概况入口卡片 */
.overview-entry {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.entry-icon {
  width: 36rpx; /* 与数据统计卡图标统一 */
  height: 36rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.entry-info {
  flex: 1;
  min-width: 0;
}
.entry-title {
  font-size: 30rpx;
  color: #1f2329;
}
.entry-sub {
  font-size: 26rpx; /* 数据文案加大 */
  margin-top: 6rpx;
  color: #2b6cf6; /* 更亮（数据醒目） */
  font-weight: 500;
}
.entry-arrow {
  font-size: 40rpx;
  color: #8a93a6;
  line-height: 1;
}

/* 身高体重展示 */
.body-data {
  margin-top: 10rpx;
  display: flex;
  gap: 20rpx;
}
.body-item {
  font-size: 22rpx;
  color: #667080;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* 数据统计卡片 */
.stats-card {
  /* 同上：横向对齐 24rpx */
  padding: 26rpx 24rpx;
}
.stats-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.stats-title-row {
  display: flex;
  align-items: center;
}
.stats-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 14rpx;
}
.stats-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.stats-grid {
  display: flex;
  margin-top: 26rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 0;
}
.stats-cell {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #ececf0;
}
.stats-cell:last-child {
  border-right: none;
}
.stats-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.2;
}
.stats-label {
  font-size: 22rpx;
  color: #667080;
  margin-top: 6rpx;
}

/* 入口卡副信息（统一结构） */
.stats-sub-row {
  margin-top: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #2b6cf6;
  font-weight: 500;
}

/* 消息中心未读角标 */
.unread-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #c02a30;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  margin-right: 8rpx;
}
