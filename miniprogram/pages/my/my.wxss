.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 28rpx;
}
.card-hover {
  opacity: 0.7;
  transform: scale(0.99);
}
.user-avatar {
  margin-right: 24rpx;
}
.user-info {
  flex: 1; /* 撑满中部，箭头靠右 */
}
.user-arrow {
  flex-shrink: 0;
}
.user-name {
  font-size: 34rpx;
  font-weight: 600;
}
.menu-card {
  padding: 8rpx 12rpx;
}
.cell-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

/* 运动报告入口行 */
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.switch-info {
  flex: 1;
}
.switch-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.link-arrow {
  font-size: 40rpx;
  color: #c2c7d0;
  margin-left: 12rpx;
}
.version-tip {
  text-align: center;
  padding: 40rpx 0;
}

/* 概况入口卡片 */
.overview-entry {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.entry-icon {
  width: 36rpx; /* 与数据统计卡图标统一 */
  height: 36rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.entry-info {
  flex: 1;
  min-width: 0;
}
.entry-title {
  font-size: 30rpx;
  color: #1f2329;
}
.entry-sub {
  font-size: 26rpx; /* 数据文案加大 */
  margin-top: 6rpx;
  color: #2b6cf6; /* 更亮（数据醒目） */
  font-weight: 500;
}
.entry-arrow {
  font-size: 40rpx;
  color: #c2c7d0;
  line-height: 1;
}

/* 身高体重展示 */
.body-data {
  margin-top: 10rpx;
  display: flex;
  gap: 20rpx;
}
.body-item {
  font-size: 22rpx;
  color: #8a93a6;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* 数据统计卡片 */
.stats-card {
  padding: 26rpx 28rpx;
}
.stats-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.stats-title-row {
  display: flex;
  align-items: center;
}
.stats-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 14rpx;
}
.stats-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.stats-arrow {
  font-size: 40rpx;
  color: #c2c7d0;
  line-height: 1;
}
.stats-grid {
  display: flex;
  margin-top: 26rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 0;
}
.stats-cell {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #ececf0;
}
.stats-cell:last-child {
  border-right: none;
}
.stats-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.2;
}
.stats-label {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 6rpx;
}

/* 入口卡副信息（统一结构） */
.stats-sub-row {
  margin-top: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #2b6cf6;
  font-weight: 500;
}
