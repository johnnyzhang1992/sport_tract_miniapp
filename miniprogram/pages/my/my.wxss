.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 28rpx;
}
.card-hover {
  opacity: 0.7;
  transform: scale(0.99);
}
.user-avatar {
  margin-right: 24rpx;
}
.user-name {
  font-size: 34rpx;
  font-weight: 600;
}
.menu-card {
  padding: 8rpx 12rpx;
}
.cell-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.version-tip {
  text-align: center;
  padding: 40rpx 0;
}

/* 概况入口卡片 */
.overview-entry {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.entry-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.entry-info {
  flex: 1;
  min-width: 0;
}
.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.entry-sub {
  font-size: 26rpx; /* 数据文案加大 */
  margin-top: 6rpx;
  color: #2b6cf6; /* 更亮（数据醒目） */
  font-weight: 500;
}
.entry-arrow {
  font-size: 40rpx;
  color: #c2c7d0;
}
