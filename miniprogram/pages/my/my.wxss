/* 用户卡片：原白卡骨架。内部分两层——上半身份（可点进资料编辑，箭头明示），
   下半积分资产行（浅灰底内嵌条：左积分/连签 进积分页，右签到胶囊 未签直签） */
.user-card {
  padding: 32rpx 24rpx 24rpx;
}

.user-head {
  display: flex;
  align-items: center;
}

.user-avatar {
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
}

/* 积分资产行：白卡内的浅灰内嵌条（原页面的灰底风格，非新配色）。
   不放图标——纯文字 + 分隔点更轻，与"已加入 N 天"那行的气质一致 */
.asset-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 4rpx 8rpx 4rpx 20rpx;
}

.asset-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 0;
}

.asset-text {
  font-size: 24rpx;
  font-weight: 400;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
}

.asset-divider {
  color: #c2c7d0;
  margin: 0 2rpx;
}

.asset-arrow {
  color: #667080;
  font-size: 32rpx;
  line-height: 1;
  margin-left: 2rpx;
}

/* 签到胶囊：小一号（26→22rpx 字号、内边距收紧），已签文案缩短为「✓ 已签」；常规字重 */
.sign-chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 22rpx;
  font-weight: 400;
  flex-shrink: 0;
}

.sign-chip.signed {
  background: #eceff3;
  color: #8a93a6;
}

/* 身高体重展示（原样式：浅灰胶囊） */
.body-data {
  margin-top: 10rpx;
  display: flex;
  gap: 20rpx;
}

.body-item {
  font-size: 22rpx;
  color: #667080;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* 数据统计卡片（简洁三格：数字带单位上标，紧凑） */
.stats-card {
  padding: 24rpx 24rpx 20rpx;
}

.stats-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stats-title-row {
  display: flex;
  align-items: center;
}

.stats-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 14rpx;
}

.stats-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.stats-grid {
  display: flex;
  margin-top: 20rpx;
}

.stats-cell {
  flex: 1;
  text-align: center;
}

.stats-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

/* km 小单位：贴着数字右上方，不占格宽 */
.stats-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #8a93a6;
  margin-left: 2rpx;
}

.stats-label {
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 4rpx;
}

/* 菜单卡 */
.menu-card {
  /* 横向与页面其它卡片一致（24rpx）：卡片自己出这 24rpx，cell 的内建边距归零，
     否则 12rpx + 32rpx = 44rpx 会比上面的卡片缩进去一圈。
     自定义属性里的 rpx 不参与编译期换算，所以只能写 0px 这种 px 值。 */
  padding: 8rpx 24rpx;
  --td-cell-horizontal-padding: 0px;
  /* 行上下留白收一档：组件默认 32rpx（行距 56px）→ 12px（行距 48px）。同样只能写 px。 */
  --td-cell-vertical-padding: 12px;
  /* 图标与文案的间距：组件给 .t-cell__left 带 24rpx（≈12.5px），原先图片又叠了 8rpx，
     实测墨迹间空隙 14.4px。这里去掉图片那层重复 margin，只留这个令牌（6px）。 */
  --td-spacer-1: 6px;
}

.cell-left {
  display: flex;
  align-items: center;
}

/* 菜单文案压一档（组件默认 32rpx）。外类名落在 .t-cell__title-text 同一个元素上，
   两边都是单类选择器、组件样式排在后面，普通声明会被它的 `font:` 简写压掉；
   页面样式进不到组件内部也没法再抬权重（试过 --td-cell-title-font 令牌，值被解析掉不生效），只能 !important。
   只压字号，行高仍走组件的 48rpx，行距不受影响。 */
.cell-title {
  font-size: 28rpx !important;
}

.cell-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* 入口行卡（运动报告 / 年度报告） */
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-info {
  flex: 1;
}

.switch-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.link-arrow {
  font-size: 40rpx;
  color: #667080;
  margin-left: 12rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 消息中心未读角标 */
.unread-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #c02a30;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  margin-right: 8rpx;
}

.row-hover {
  opacity: 0.7;
}

.version-tip {
  text-align: center;
  padding: 16rpx 0;
}
