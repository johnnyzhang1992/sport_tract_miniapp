.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f6f7fb;
}

.gate, .tip {
  text-align: center;
  color: #8a93a6;
  font-size: 28rpx;
  padding: 60rpx 0;
}
.tap { color: #2b6cf6; }
.gate-tip { margin-bottom: 32rpx; }
.gate-btn { background: #2b6cf6; color: #fff; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.stats-card { display: grid; gap: 20rpx; }
.stat-title {
  font-size: 26rpx;
  color: #5b6474;
  margin-bottom: 12rpx;
}
.stat-grid {
  display: flex;
  gap: 12rpx;
}
.stat {
  flex: 1;
  background: #f6f7fb;
  border-radius: 12rpx;
  padding: 16rpx 0;
  text-align: center;
}
.stat .n { font-size: 34rpx; font-weight: 600; }
.stat .l { font-size: 22rpx; color: #8a93a6; margin-top: 4rpx; }

.section-title {
  font-size: 26rpx;
  color: #5b6474;
  margin: 8rpx 0 16rpx;
}

.order { margin-bottom: 20rpx; }
.row1 { display: flex; justify-content: space-between; align-items: center; }
.name { font-size: 30rpx; font-weight: 600; }
.status { font-size: 24rpx; }
.s-created { color: #ff8a00; }
.s-paid { color: #2b6cf6; }
.s-delivered { color: #12b76a; }
.s-refunding { color: #ff8a00; }
.s-refunded { color: #8a93a6; }
.s-closed { color: #b6bcc8; }
.row2 { display: flex; justify-content: space-between; margin-top: 12rpx; }
.price { font-size: 32rpx; font-weight: 600; }
.time { color: #8a93a6; font-size: 24rpx; }
.meta { color: #5b6474; font-size: 24rpx; margin-top: 8rpx; }
.refunded { color: #d54941; }

.actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.act { margin: 0; }
.act.primary { background: #2b6cf6; color: #fff; }
.act.warn { background: #d54941; color: #fff; }

.panel-line.warn { color: #ad6800; }

.refund-hint {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  font-size: 24rpx;
  color: #5b6474;
  margin: 8rpx 0 4rpx;
}
.guide-toggle { color: #2b6cf6; flex-shrink: 0; }
.refund-guide {
  background: #f6f7fb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin: 8rpx 0 4rpx;
}
.guide-item {
  color: #5b6474;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}
.guide-item:last-child { margin-bottom: 0; }

.back-link {
  text-align: center;
  color: #2b6cf6;
  font-size: 26rpx;
  padding: 32rpx 0;
}
