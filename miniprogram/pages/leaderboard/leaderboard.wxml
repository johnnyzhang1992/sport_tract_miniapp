<view class="page">
  <!-- 游客提示 -->
  <view class="login-hint" wx:if="{{!loggedIn && !loading}}">
    <image class="login-hint-icon" src="/assets/icons/tab-rank-gray.png" mode="aspectFit" />
    <view class="login-hint-text">登录后查看全国运动榜，看看其他迹路者都在哪运动</view>
    <button class="login-hint-btn" bindtap="guestLogin">去登录</button>
  </view>

  <block wx:if="{{loggedIn}}">
    <!-- 全国点亮地图 -->
    <view class="card map-card">
      <view class="card-head">
        <view class="card-title">全国点亮地图</view>
        <view class="card-sub">{{provinceCount}} 个省份 · {{totalUsers}} 位迹路者</view>
      </view>
      <view class="map-loading" wx:if="{{loading}}">加载中…</view>
      <view class="map-wrap">
        <canvas
          type="2d"
          id="chinaMap"
          class="china-map"
          data-map="china"
          bindtap="onMapTap"
          bindtouchstart="onMapTouchStart"
          catchtouchmove="onMapTouchMove"
          bindtouchend="onMapTouchEnd"
          bindtouchcancel="onMapTouchEnd"
        ></canvas>
        <view class="map-ctrl-zoom">
          <view class="map-ctrl-btn" hover-class="map-ctrl-hover" catchtap="zoomMapViewIn">+</view>
          <view class="map-ctrl-btn" hover-class="map-ctrl-hover" catchtap="zoomMapViewOut">−</view>
        </view>
        <view class="map-ctrl-pill map-ctrl-share" hover-class="map-ctrl-hover" catchtap="shareMapImage">
          <image class="map-ctrl-icon" src="/assets/icons/lucide-share.png" mode="aspectFit" />
          <text>分享</text>
        </view>
        <view class="map-ctrl-pill map-ctrl-fs" hover-class="map-ctrl-hover" catchtap="openMapFullscreen">
          <image class="map-ctrl-icon" src="/assets/icons/lucide-maximize.png" mode="aspectFit" />
          <text>全屏</text>
        </view>
        <view class="map-reset" wx:if="{{mapScaled}}" catchtap="resetMapView">重置地图</view>
      </view>
      <view class="map-tip">单指拖动 · 双指缩放 · 点击省份查看{{cityCount}}个点亮城市</view>
    </view>

    <!-- 排行榜 -->
    <view class="card rank-card">
      <view class="card-head">
        <view class="card-title">运动排行</view>
        <picker
          class="province-picker"
          mode="selector"
          range="{{provinceOptions}}"
          value="{{provinceIndex}}"
          bindchange="onProvinceChange"
        >
          <view class="picker-value">{{provinceOptions[provinceIndex] || '全国'}} ▾</view>
        </picker>
      </view>

      <!-- 榜单周期：周榜/月榜/年榜/总榜 -->
      <view class="period-row">
        <view
          wx:for="{{periods}}"
          wx:key="key"
          class="period-seg {{index === periodIndex ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="onPeriodTap"
        >{{item.label}}</view>
      </view>

      <!-- 运动类型 chips（与首页同款图标） -->
      <scroll-view class="type-scroll" scroll-x enable-flex="{{false}}">
        <view class="type-row">
          <view
            wx:for="{{types}}"
            wx:key="type"
            class="type-chip {{index === typeIndex ? 'active' : ''}}"
            data-index="{{index}}"
            bindtap="onTypeTap"
          >
            <image class="type-chip-img {{index === typeIndex ? '' : 'gray'}}" src="{{item.iconImg}}" mode="aspectFit" />
            <text>{{item.label}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 本榜最佳：当前 类型/省份/周期 筛选下的单项纪录 -->
      <view class="best-row" wx:if="{{board && board.best.length > 0}}">
        <view class="best-item" wx:for="{{board.best}}" wx:key="key">
          <view class="best-label">{{item.label}}</view>
          <view class="best-value">{{item.valueText}}</view>
          <view class="best-owner">
            <image wx:if="{{item.avatarSrc}}" class="best-avatar" src="{{item.avatarSrc}}" mode="aspectFill" />
            <view wx:else class="best-avatar best-avatar-text">{{item.avatarText}}</view>
            <text class="best-name">{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- TOP10 -->
      <view class="rank-list" wx:if="{{board && board.top.length > 0}}">
        <view class="rank-row" wx:for="{{board.top}}" wx:key="rank">
          <view class="rank-no">
            <image wx:if="{{item.medalIcon}}" class="medal-img" src="{{item.medalIcon}}" mode="aspectFit" />
            <text wx:else>{{item.rank}}</text>
          </view>
          <image wx:if="{{item.avatarSrc}}" class="rank-avatar" src="{{item.avatarSrc}}" mode="aspectFill" />
          <view wx:else class="rank-avatar rank-avatar-text">{{item.avatarText}}</view>
          <view class="rank-name-wrap">
            <text class="rank-name">{{item.name}}</text>
            <image class="gender-img" src="{{item.genderIcon}}" mode="aspectFit" />
          </view>
          <view class="rank-meta">{{item.count}} 条</view>
          <view class="rank-dist">{{item.distanceKm}} km</view>
        </view>
      </view>
      <view class="rank-empty" wx:if="{{board && board.top.length === 0}}">
        {{periods[periodIndex].label}}{{provinceIndex > 0 ? ' · ' + provinceOptions[provinceIndex] : ''}}还没有{{types[typeIndex].label}}轨迹，快来抢占第一名的位置！
      </view>
    </view>

    <!-- 我的排名：固定在页面底部区域（入榜也展示；1-3 名显示奖牌图标） -->
    <view class="me-card" wx:if="{{board && board.me}}">
      <image wx:if="{{board.me.medalIcon}}" class="me-medal" src="{{board.me.medalIcon}}" mode="aspectFit" />
      <view wx:else class="me-rank-no">{{board.me.rank}}</view>
      <image wx:if="{{board.me.avatarSrc}}" class="me-avatar" src="{{board.me.avatarSrc}}" mode="aspectFill" />
      <view wx:else class="me-avatar me-avatar-text">{{board.me.avatarText}}</view>
      <view class="me-body">
        <view class="me-name-wrap">
          <text class="me-name">{{board.me.name}}</text>
          <image class="gender-img" src="{{board.me.genderIcon}}" mode="aspectFit" />
        </view>
        <view class="me-sub">我的{{types[typeIndex].label}} · {{periods[periodIndex].label}} · {{provinceOptions[provinceIndex]}}</view>
      </view>
      <view class="me-stats">
        <view class="me-dist">{{board.me.distanceKm}} km</view>
        <view class="me-count">{{board.me.count}} 条轨迹</view>
      </view>
    </view>
    <view class="me-card empty" wx:if="{{board && !board.me}}">
      <view class="me-hint">完成一条{{types[typeIndex].label}}轨迹，就能上榜啦</view>
    </view>
  </block>

  <!-- 地图全屏查看（置于省份弹窗之前：省份弹窗可叠加在其上） -->
  <view class="fs-mask" wx:if="{{mapFullscreen}}" catchtouchmove="noop">
    <canvas
      type="2d"
      id="fsMap"
      class="fs-map"
      data-map="fs"
      bindtap="onMapTap"
      bindtouchstart="onMapTouchStart"
      catchtouchmove="onMapTouchMove"
      bindtouchend="onMapTouchEnd"
      bindtouchcancel="onMapTouchEnd"
    ></canvas>
    <view class="fs-title">全国点亮地图 · {{provinceCount}} 省 · {{totalUsers}} 位迹路者</view>
    <view class="fs-close" hover-class="map-ctrl-hover" catchtap="closeMapFullscreen">
      <image class="fs-close-icon" src="/assets/icons/lucide-x.png" mode="aspectFit" />
    </view>
    <view class="map-ctrl-zoom fs-zoom">
      <view class="map-ctrl-btn" hover-class="map-ctrl-hover" catchtap="zoomMapViewIn">+</view>
      <view class="map-ctrl-btn" hover-class="map-ctrl-hover" catchtap="zoomMapViewOut">−</view>
    </view>
    <view class="map-ctrl-pill map-ctrl-share fs-share" hover-class="map-ctrl-hover" catchtap="shareMapImage">
      <image class="map-ctrl-icon" src="/assets/icons/lucide-share.png" mode="aspectFit" />
      <text>分享</text>
    </view>
    <view class="fs-tip">单指拖动 · 双指缩放 · 点击省份下钻</view>
  </view>

  <!-- 省份下钻弹窗：城市地图 + 点亮列表 -->
  <view class="modal-mask" wx:if="{{provinceModal}}" bindtap="closeProvinceModal">
    <view class="modal-box" catchtap="noop">
      <view class="modal-head">
        <view class="modal-title">{{provinceModalName}} · 城市点亮</view>
        <view class="modal-close" bindtap="closeProvinceModal">✕</view>
      </view>
      <canvas
        type="2d"
        id="provMap"
        class="prov-map"
        data-map="prov"
        bindtouchstart="onMapTouchStart"
        catchtouchmove="onMapTouchMove"
        bindtouchend="onMapTouchEnd"
        bindtouchcancel="onMapTouchEnd"
      ></canvas>
      <view class="city-scroll">
        <view class="city-row" wx:for="{{provinceCities}}" wx:key="name">
          <view class="city-name">{{item.name}}</view>
          <view class="city-meta">{{item.count}} 条 · {{item.users}} 人</view>
        </view>
        <view class="city-empty" wx:if="{{provinceCities.length === 0}}">该省还没有点亮的城市</view>
      </view>
      <button class="modal-btn" bindtap="rankThisProvince">看{{provinceModalName}}排行榜</button>
    </view>
  </view>

  <!-- 分享图预览弹窗（保存相册 / 分享好友） -->
  <view class="share-mask" wx:if="{{sharePreview}}" catchtouchmove="noop">
    <view class="share-dialog">
      <view class="share-head">
        <text class="share-title">分享预览</text>
        <view class="share-close" bindtap="closeSharePreview">✕</view>
      </view>
      <image class="share-img" src="{{shareImageSrc}}" mode="widthFix" />
      <view class="share-actions">
        <button class="share-btn share-btn-friend" open-type="share">分享给朋友</button>
        <button class="share-btn share-btn-save" bindtap="saveShareImage">保存到相册</button>
      </view>
    </view>
  </view>
</view>
