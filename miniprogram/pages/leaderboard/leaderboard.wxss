.page {
  min-height: 100vh;
  background: #f5f6f8;
  /* 底部留白 = 贴底「我的排名」栏高度，避免最后一行被遮挡 */
  padding: 20rpx 24rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}
.card-sub {
  font-size: 22rpx;
  color: #8a93a6;
}

/* 地图 */
.map-card {
  padding-bottom: 16rpx;
}
.map-wrap {
  position: relative;
}
.china-map {
  width: 100%;
  height: 640rpx;
}
.map-reset {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 8rpx 22rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid #dfe3ea;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #4b5568;
  box-shadow: 0 2rpx 8rpx rgba(30, 40, 60, 0.08);
}
.map-loading {
  position: absolute;
  text-align: center;
  width: 100%;
  color: #8a93a6;
  font-size: 24rpx;
  padding-top: 200rpx;
}
.map-tip {
  text-align: center;
  font-size: 22rpx;
  color: #8a93a6;
  padding: 12rpx 0 4rpx;
}

/* 榜单周期分段 */
.period-row {
  display: flex;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
}
.period-seg {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 25rpx;
  color: #4e5969;
  border-radius: 10rpx;
  transition: all 0.15s;
}
.period-seg.active {
  background: #fff;
  color: #2b6cf6;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 排行卡 */
.type-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.type-row {
  display: inline-flex;
  gap: 12rpx;
}
.type-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #4e5969;
  font-size: 24rpx;
  transition: all 0.15s;
}
.type-chip.active {
  background: #2b6cf6;
  color: #fff;
}
.type-chip-img {
  width: 32rpx;
  height: 32rpx;
}
.type-chip-img.gray {
  /* 未选中态：彩色图标压灰（与文字色一致） */
  filter: grayscale(1) opacity(0.62);
}

.province-picker {
  flex-shrink: 0;
}
.picker-value {
  font-size: 24rpx;
  color: #2b6cf6;
  background: #ecf2ff;
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
}

.rank-row,
.me-row {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.rank-row:last-of-type {
  border-bottom: none;
}
.rank-no {
  width: 56rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #8a93a6;
  text-align: center;
  flex-shrink: 0;
}
.medal-img {
  width: 44rpx;
  height: 44rpx;
}
.rank-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin: 0 14rpx 0 6rpx;
  flex-shrink: 0;
  background: #f2f3f5;
}
.rank-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: #b8c4d9;
}
.rank-name-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.rank-name {
  font-size: 27rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gender-img {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}
.rank-meta {
  font-size: 22rpx;
  color: #8a93a6;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.rank-dist {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

/* 本榜最佳：当前筛选下的单项纪录 */
.best-row {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 0 16rpx;
}
.best-item {
  flex: 1;
  min-width: 0;
  background: #f7f9fd;
  border-radius: 14rpx;
  padding: 16rpx;
}
.best-label {
  font-size: 20rpx;
  color: #8a93a6;
}
.best-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.best-owner {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  min-width: 0;
}
.best-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e8edf5;
}
.best-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #fff;
  background: #b8c4d9;
}
.best-name {
  font-size: 20rpx;
  color: #8a93a6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 我的排名卡：通栏贴底（边缘 0），与边的距离用内边距体现 */
.me-card {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: linear-gradient(135deg, #2b6cf6, #5b8cff);
  border-radius: 0;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 -6rpx 18rpx rgba(43, 108, 246, 0.22);
}
.me-medal {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}
.me-card.empty {
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  justify-content: center;
}
.me-rank-no {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  min-width: 64rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}
.me-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.3);
}
.me-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: rgba(255, 255, 255, 0.28);
}
.me-body {
  flex: 1;
  min-width: 0;
}
.me-name-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.me-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-card .gender-img {
  width: 30rpx;
  height: 30rpx;
}
.me-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 4rpx;
}
.me-stats {
  text-align: right;
  flex-shrink: 0;
}
.me-dist {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  font-variant-numeric: tabular-nums;
}
.me-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 4rpx;
}
.me-hint {
  font-size: 24rpx;
  color: #8a93a6;
}
/* TOP10 列表：约 5 行的最小高度，入榜人数少时不显拥挤 */
.rank-list {
  min-height: 460rpx;
}
.rank-empty {
  text-align: center;
  color: #8a93a6;
  font-size: 24rpx;
  padding: 40rpx 0;
}

/* 省份弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-box {
  width: 640rpx;
  max-height: 82vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}
.modal-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f2f3f5;
  color: #4e5969;
  text-align: center;
  line-height: 48rpx;
  font-size: 24rpx;
}
.prov-map {
  width: 100%;
  height: 480rpx;
  border-radius: 12rpx;
  background: #fafbfc;
}
.city-scroll {
  max-height: 300rpx;
  overflow-y: auto;
  margin: 12rpx 0;
}
.city-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 8rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.city-name {
  font-size: 26rpx;
  color: #1f2329;
}
.city-meta {
  font-size: 22rpx;
  color: #8a93a6;
}
.city-empty {
  text-align: center;
  color: #8a93a6;
  font-size: 24rpx;
  padding: 30rpx 0;
}
.modal-btn {
  background: #2b6cf6;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 6rpx 0;
}

/* 游客登录提示 */
.login-hint {
  background: #fff;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  text-align: center;
}
.login-hint-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.6;
}
.login-hint-text {
  color: #4e5969;
  font-size: 26rpx;
  margin: 24rpx 0 32rpx;
  line-height: 1.6;
}
.login-hint-btn {
  background: #2b6cf6;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  width: 320rpx;
}
