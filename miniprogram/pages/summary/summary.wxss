.map-card {
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #eef1f5;
}
.summary-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.metrics-grid {
  display: flex;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx 0;
}
.metric {
  flex: 1;
  text-align: center;
}
.metric-num {
  font-size: 34rpx;
  font-weight: 600;
  white-space: nowrap;
}
.metric-label {
  font-size: 22rpx;
  white-space: nowrap;
  color: #999;
  margin-top: 4rpx;
}
.sub {
  margin-top: 16rpx;
}
.marker-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.marker-item:last-child {
  border-bottom: none;
}
.marker-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}
.marker-note {
  font-size: 28rpx;
}
.actions {
  display: flex;
  padding-bottom: 40rpx;
}
.btn-discard {
  margin-right: 20rpx;
}

.title-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}
