/* 底部安全区：iPhone Home Indicator 遮挡防护 */
.container {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.map-card {
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #eef1f5;
}
.summary-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.metrics-grid {
  display: flex;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx 0;
}
.metric {
  flex: 1;
  text-align: center;
}
.metric-num {
  font-size: 34rpx;
  font-weight: 600;
  white-space: nowrap;
}
.metric-label {
  font-size: 22rpx;
  white-space: nowrap;
  color: #999;
  margin-top: 4rpx;
}
.sub {
  margin-top: 16rpx;
}
.marker-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.marker-item:last-child {
  border-bottom: none;
}
.marker-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.marker-note {
  font-size: 28rpx;
}
.actions {
  display: flex;
  padding-bottom: 40rpx;
}
.btn-discard {
  margin-right: 20rpx;
}

.title-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}

/* 轨迹无效提示（点数过少/距离过短，保存时被服务端自动作废） */
.invalid-hint {
  margin: 20rpx 32rpx 0;
  padding: 16rpx 24rpx;
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #ad6800;
  line-height: 1.5;
}
