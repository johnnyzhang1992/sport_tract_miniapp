<view class="container" wx:if="{{stats}}">
  <!-- 轨迹图（静态模式自动 fitView） -->
  <view class="map-card">
    <track-map points="{{mapPoints}}" markers="{{markers}}" mode="view" />
  </view>

  <!-- 指标 -->
  <view class="card">
    <view class="summary-title">{{typeIcon}} {{typeLabel}} 完成</view>
    <view class="metrics-grid">
      <view class="metric">
        <view class="metric-num">{{stats.distanceKm}}</view>
        <view class="metric-label">公里</view>
      </view>
      <view class="metric">
        <view class="metric-num">{{stats.durationText}}</view>
        <view class="metric-label">时长</view>
      </view>
      <view class="metric">
        <view class="metric-num">{{stats.paceText}}</view>
        <view class="metric-label">配速</view>
      </view>
      <view class="metric">
        <view class="metric-num">{{stats.calories}}</view>
        <view class="metric-label">千卡</view>
      </view>
    </view>
    <view class="text-muted sub" wx:if="{{stats.elevationGain}}">
      累计爬升 {{stats.elevationGain}}m · 最高海拔 {{stats.maxAltitude || '—'}}m
    </view>
  </view>

  <!-- 打点时间线 -->
  <view class="card" wx:if="{{markers.length > 0}}">
    <view class="summary-title">打点 ({{markers.length}})</view>
    <view wx:for="{{markers}}" wx:key="id" class="marker-item">
      <view class="marker-icon">{{item.typeMeta.icon || '📍'}}</view>
      <view class="marker-body">
        <view class="marker-note">{{item.note || item.typeMeta.label || '打点'}}</view>
        <view class="text-muted">{{item.timeText}}</view>
      </view>
    </view>
  </view>

  <!-- 操作 -->
  <view class="actions">
    <t-button
      class="btn-discard"
      variant="outline"
      size="large"
      block
      disabled="{{saving}}"
      bind:tap="discard"
    >放弃</t-button>
    <t-button
      class="btn-save"
      theme="primary"
      size="large"
      block
      loading="{{saving}}"
      bind:tap="save"
    >保存</t-button>
  </view>
</view>
