<view class="container">
  <!-- 系统通知（单行）：登录用户有未读才出现；游客看最新一条、无红点 -->
  <view
    wx:if="{{notice}}"
    class="notice-bar"
    hover-class="notice-bar-hover"
    hover-stay-time="80"
    data-id="{{notice.id}}"
    bindtap="goNotice"
  >
    <image class="notice-icon" src="/assets/icons/lucide-bell.png" mode="aspectFit" />
    <view class="notice-title">{{notice.title}}</view>
    <view wx:if="{{noticeDot}}" class="notice-dot"></view>
    <view class="notice-arrow">›</view>
  </view>

  <!-- 未登录引导条（游客态，点击去个人中心登录） -->
  <view wx:if="{{notLoggedIn}}" class="login-tip" hover-class="login-tip-hover" hover-stay-time="80" bindtap="goLogin">
    <image class="login-tip-icon" src="/assets/icons/lucide-user.png" mode="aspectFit" />
    <view class="login-tip-text">登录后同步你的运动数据</view>
    <view class="login-tip-arrow">去登录 ›</view>
  </view>

  <!-- 进行中（已暂停）运动入口 -->
  <view wx:if="{{ongoingActivity}}" class="ongoing-bar" hover-class="ongoing-bar-hover" hover-stay-time="80" bindtap="goOngoing">
    <image class="ongoing-icon" src="/assets/icons/lucide-pause-white.png" mode="aspectFit" />
    <view class="ongoing-info">
      <view class="ongoing-title">运动已暂停</view>
      <view class="ongoing-sub text-muted">点击继续上次的运动记录</view>
    </view>
    <view class="ongoing-arrow">›</view>
  </view>

  <!-- 欢迎语 -->
  <view class="welcome">
    <view class="welcome-title">记录每一次运动</view>
    <view class="welcome-sub text-muted">选择类型，记录你的轨迹与风景</view>
  </view>

  <!-- 运动日历热力图（GitHub 风格，近 365 天）；接口挂了也要留着卡片说清原因，不能整块消失 -->
  <view class="card heat-card" wx:if="{{heatData.length > 0 || heatError}}">
    <view class="section-head">
      <view class="section-title section-title-flat">运动日历</view>
      <view class="heat-legend-row" wx:if="{{heatData.length > 0}}">
        <text class="heat-legend-text">颜色越深，当天运动越多</text>
        <view class="heat-legend-colors">
          <view class="hl-cell" style="background:#ebedf0"></view>
          <view class="hl-cell" style="background:#c6dbff"></view>
          <view class="hl-cell" style="background:#7ea8ff"></view>
          <view class="hl-cell" style="background:#2b6cf6"></view>
        </view>
      </view>
    </view>
    <block wx:if="{{heatData.length > 0}}">
      <calendar-heat data="{{heatData}}" />
    </block>
    <view class="card-fail" wx:if="{{heatError}}">
      <text class="card-fail-text">{{heatError}}</text>
      <view class="card-fail-retry" hover-class="card-fail-retry-hover" catchtap="retryHeat">重试</view>
    </view>
  </view>

  <!-- 累计数据已移到「统计」tab；首页不再重复展示 -->

  <!-- 模板广告（后台「广告管理」按 home_bottom 配置 unitId，可随时下架；免广告卡生效时不渲染） -->
  <ad-template adslot="home_bottom" />

  <!-- 运动榜 + 一起运动：一行两格，各占一半 -->
  <view class="duo-row">
    <!-- 运动榜入口卡片（全国点亮 + 我的排名摘要）。半屏宽里标题行放不下 icon，
         所以标题行只留「运动榜 + ›」，icon 下移到副标题左侧与两行文字并排 -->
    <view class="card duo-cell lb-card lb-card-stacked" hover-class="card-hover" hover-stay-time="80" bindtap="goLeaderboard">
      <view class="lb-head">
        <view class="lb-title">运动榜</view>
        <view class="lb-arrow">›</view>
      </view>
      <view class="lb-foot">
        <image class="lb-icon" src="/assets/icons/tab-rank-blue.png" mode="aspectFit" />
        <view class="lb-foot-text">
          <block wx:if="{{lbSummary && lbSummary.ranks.length > 0}}">
            <view class="lb-rank-line" wx:for="{{lbSummary.ranks}}" wx:key="type">
              <text class="text-muted">{{item.label}}第</text>
              <text class="lb-rank-num">{{item.rank}}</text>
              <text class="text-muted">名</text>
            </view>
          </block>
          <view class="lb-sub text-muted">全国迹路者都在哪运动</view>
        </view>
      </view>
    </view>

    <!-- 微信步数榜入口卡片（右侧）：今日我的排名与步数；游客/无数据回落引导文案 -->
    <view class="card duo-cell lb-card lb-card-stacked" hover-class="card-hover" hover-stay-time="80" bindtap="goWerunBoard">
      <view class="lb-head">
        <view class="lb-title">步数榜</view>
        <view class="lb-arrow">›</view>
      </view>
      <view class="lb-foot">
        <image class="lb-icon" src="/assets/icons/lucide-footprints-blue.png" mode="aspectFit" />
        <view class="lb-foot-text">
          <block wx:if="{{stepsSummary && stepsSummary.rank != null}}">
            <view class="lb-rank-line">
              <text class="text-muted">今日第</text>
              <text class="lb-rank-num">{{stepsSummary.rank}}</text>
              <text class="text-muted">名</text>
            </view>
            <view class="lb-rank-line">
              <text class="text-muted">走了</text>
              <text class="lb-rank-num">{{stepsSummary.step}}</text>
              <text class="text-muted">步</text>
            </view>
          </block>
          <view class="lb-sub text-muted" wx:else>今天走了多少步？</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 官方专题入口（生效中的专题，点击查看详情） -->
  <view
    wx:for="{{topics}}"
    wx:key="id"
    class="card lb-card"
    hover-class="card-hover"
    hover-stay-time="80"
    data-id="{{item.id}}"
    bindtap="goTopic"
  >
    <image wx:if="{{item.coverUrl}}" class="lb-icon topic-cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
    <view wx:else class="lb-icon topic-emoji">🎉</view>
    <view class="lb-body">
      <view class="topic-tag">官方专题</view>
      <view class="lb-title">{{item.title}}</view>
    </view>
    <view class="lb-arrow">›</view>
  </view>

  <!-- 运动计划：标题行卡片级（与其他卡一致）；下方左三环 canvas + 右目标信息；无计划 → 引导 -->
  <view class="card plan-card" hover-class="card-hover" bindtap="goPlan">
    <view class="section-head">
      <view class="section-title">每日计划</view>
      <view class="lb-arrow">›</view>
    </view>
    <view class="plan-body">
      <block wx:if="{{planCard && planCard.plan}}">
        <canvas type="2d" id="plan-rings" class="plan-rings"></canvas>
        <view class="plan-info">
          <view class="plan-line"><view class="plan-dot plan-dot-red"></view><text>距离 {{planCard.distanceText}}</text></view>
          <view class="plan-line"><view class="plan-dot plan-dot-green"></view><text>时间 {{planCard.durationText}}</text></view>
          <view class="plan-line"><view class="plan-dot plan-dot-cyan"></view><text>次数 {{planCard.countText}}</text></view>
        </view>
      </block>
      <block wx:else>
        <view class="plan-guide">
          <view class="plan-guide-title">设定你的运动计划</view>
          <view class="plan-guide-sub text-muted">坚持每天动一下，圆环见证完成度</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 运动类型选择 -->
  <view class="card">
    <view class="section-title">运动类型</view>
    <view class="type-grid">
      <view
        wx:for="{{activityTypes}}"
        wx:key="type"
        class="type-item {{selectedType === item.type ? 'type-item-active' : ''}}"
        hover-class="type-item-hover"
        hover-stay-time="80"
        data-type="{{item.type}}"
        bindtap="selectType"
      >
        <image class="type-icon" src="{{item.iconImg}}" mode="aspectFit"></image>
        <view class="type-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 开始按钮 -->
  <t-button
    class="start-btn"
    theme="primary"
    size="large"
    block
    shape="round"
    bind:tap="startRecord"
  >开始运动</t-button>
</view>

<!-- 收藏引导浮层：气泡指向右上角胶囊；点任意处关闭，「知道了」永不再弹 -->
<view class="fav-guide-mask" wx:if="{{favGuide.visible}}" bindtap="closeFavGuide">
  <view class="fav-guide-bubble" style="top: {{favGuide.top}}px; right: {{favGuide.right}}px;" catchtap="closeFavGuide">
    <view class="fav-guide-arrow" style="right: {{favGuide.arrowRight}}px;"></view>
    <view class="fav-guide-line1">点击右上角「···」</view>
    <view class="fav-guide-line2">收藏或添加到我的小程序，下次快速找到</view>
    <view class="fav-guide-btn" catchtap="closeFavGuide">知道了</view>
  </view>
</view>
