<view class="container">
  <!-- 系统通知（单行）：登录用户有未读才出现；游客看最新一条、无红点 -->
  <view
    wx:if="{{notice}}"
    class="notice-bar"
    hover-class="notice-bar-hover"
    hover-stay-time="80"
    data-id="{{notice.id}}"
    bindtap="goNotice"
  >
    <image class="notice-icon" src="/assets/icons/lucide-bell.png" mode="aspectFit" />
    <view class="notice-title">{{notice.title}}</view>
    <view wx:if="{{noticeDot}}" class="notice-dot"></view>
    <view class="notice-arrow">›</view>
  </view>

  <!-- 活动卡（首页横滑共用）：标题 + 成员面（头像堆叠 + 人数）。
       箭头是整张卡的直接子节点，靠 .camp-card 的 align-items:center 对整卡垂直居中 -->
  <template name="campaign-card">
    <view class="camp-card" hover-class="camp-card-hover" hover-stay-time="80" data-id="{{id}}" bindtap="goCampaign">
      <view class="camp-card-main">
        <view class="camp-card-title">{{title}}</view>
        <view class="camp-card-members">
          <view class="member-av-stack">
            <block wx:for="{{avatarList}}" wx:key="key">
              <image wx:if="{{item.src}}" class="member-av" src="{{item.src}}" mode="aspectFill" />
              <view wx:else class="member-av"></view>
            </block>
          </view>
          <view class="member-av-text">{{memberText}}</view>
        </view>
      </view>
      <view class="camp-card-arrow">›</view>
    </view>
  </template>

  <!-- 未登录引导条（游客态，点击去个人中心登录） -->
  <view wx:if="{{notLoggedIn}}" class="login-tip" hover-class="login-tip-hover" hover-stay-time="80" bindtap="goLogin">
    <image class="login-tip-icon" src="/assets/icons/lucide-user.png" mode="aspectFit" />
    <view class="login-tip-text">登录后同步你的运动数据</view>
    <view class="login-tip-arrow">去登录 ›</view>
  </view>

  <!-- 进行中（已暂停）运动入口 -->
  <view wx:if="{{ongoingActivity}}" class="ongoing-bar" hover-class="ongoing-bar-hover" hover-stay-time="80" bindtap="goOngoing">
    <image class="ongoing-icon" src="/assets/icons/lucide-pause-white.png" mode="aspectFit" />
    <view class="ongoing-info">
      <view class="ongoing-title">运动已暂停</view>
      <view class="ongoing-sub text-muted">点击继续上次的运动记录</view>
    </view>
    <view class="ongoing-arrow">›</view>
  </view>

  <!-- 欢迎语 -->
  <view class="welcome">
    <view class="welcome-title">记录每一次运动</view>
    <view class="welcome-sub text-muted">选择类型，记录你的轨迹与风景</view>
  </view>

  <!-- 运动日历热力图（GitHub 风格，近 365 天）；接口挂了也要留着卡片说清原因，不能整块消失 -->
  <view class="card heat-card" wx:if="{{heatData.length > 0 || heatError}}">
    <view class="section-title">运动日历</view>
    <block wx:if="{{heatData.length > 0}}">
      <calendar-heat data="{{heatData}}" />
      <view class="heat-legend-row">
        <text class="heat-legend-text">颜色越深，当天运动越多</text>
        <view class="heat-legend-colors">
          <view class="hl-cell" style="background:#ebedf0"></view>
          <view class="hl-cell" style="background:#c6dbff"></view>
          <view class="hl-cell" style="background:#7ea8ff"></view>
          <view class="hl-cell" style="background:#2b6cf6"></view>
        </view>
      </view>
    </block>
    <view class="card-fail" wx:if="{{heatError}}">
      <text class="card-fail-text">{{heatError}}</text>
      <view class="card-fail-retry" hover-class="card-fail-retry-hover" catchtap="retryOverview">重试</view>
    </view>
  </view>

  <!-- 累计数据概览（点击进入统计页） -->
  <view class="card" wx:if="{{totalOverview || overviewError}}" hover-class="card-hover" hover-stay-time="80" bindtap="goStats">
    <view class="section-title">累计数据</view>
    <view class="stats-row" wx:if="{{totalOverview}}">
      <view class="stat-item">
        <view class="stat-num">{{totalOverview.trackCount}}</view>
        <view class="stat-label">轨迹</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{totalOverview.totalKm}}</view>
        <view class="stat-label">公里</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{totalOverview.provinceCount}}</view>
        <view class="stat-label">点亮省份</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{totalOverview.cityCount}}</view>
        <view class="stat-label">点亮城市</view>
      </view>
    </view>
    <!-- 用 catchtap：重试只该重发请求，不该顺带触发整卡的 bindtap 跳到统计页 -->
    <view class="card-fail" wx:if="{{overviewError || footprintError}}">
      <text class="card-fail-text">{{overviewError || footprintError}}</text>
      <view class="card-fail-retry" hover-class="card-fail-retry-hover" catchtap="retryOverview">重试</view>
    </view>
  </view>

  <!-- 运动榜 + 一起运动：一行两格，各占一半 -->
  <view class="duo-row">
    <!-- 运动榜入口卡片（全国点亮 + 我的排名摘要）。半屏宽里标题行放不下 icon，
         所以标题行只留「运动榜 + ›」，icon 下移到副标题左侧与两行文字并排 -->
    <view class="card duo-cell lb-card lb-card-stacked" hover-class="card-hover" hover-stay-time="80" bindtap="goLeaderboard">
      <view class="lb-head">
        <view class="lb-title">运动榜</view>
        <view class="lb-arrow">›</view>
      </view>
      <view class="lb-foot">
        <image class="lb-icon" src="/assets/icons/tab-rank-blue.png" mode="aspectFit" />
        <view class="lb-foot-text">
          <block wx:if="{{lbSummary}}">
            <view class="lb-rank-line">
              <text class="text-muted">全国</text>
              <text class="lb-rank-num">{{lbSummary.totalUsers}}</text>
              <text class="text-muted">位迹路者</text>
            </view>
            <view class="lb-rank-line" wx:for="{{lbSummary.ranks}}" wx:key="type">
              <text class="text-muted">{{item.label}}第</text>
              <text class="lb-rank-num">{{item.rank}}</text>
              <text class="text-muted">名</text>
            </view>
          </block>
          <view class="lb-sub text-muted" wx:else>全国迹路者都在哪运动</view>
        </view>
      </view>
    </view>

    <!-- 一起运动活动区块：标题行右侧「查看更多」常驻（全为已结束/已解散时它是进列表页的唯一入口）；
         有活动 → 横滑卡片（半宽容器里一屏只放得下一条，多了左右滑），无 → 发起引导 -->
    <view class="card duo-cell">
      <view class="section-head">
        <view class="section-title section-title-flat">一起运动</view>
        <view class="campaign-more" hover-class="campaign-more-hover" hover-stay-time="80" bindtap="goCampaignList">查看更多 ›</view>
      </view>

      <!-- 横向可滚动：本区块只有半屏宽，一屏一条，卡片右侧故意露出下一条的边当「可滑」提示 -->
      <scroll-view
        wx:if="{{campaigns.length > 0}}"
        class="camp-scroll"
        scroll-x
        enable-flex
        show-scrollbar="{{false}}"
      >
        <block wx:for="{{campaigns}}" wx:key="id">
          <template is="campaign-card" data="{{...item}}" />
        </block>
      </scroll-view>

      <view
        wx:else
        class="lb-card campaign-row"
        hover-class="card-hover"
        hover-stay-time="80"
        bindtap="goCampaignCreate"
      >
        <view class="lb-body">
          <view class="lb-title campaign-lead">运动竞赛，和好友来场PK</view>
        </view>
        <view class="lb-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 官方专题入口（生效中的专题，点击查看详情） -->
  <view
    wx:for="{{topics}}"
    wx:key="id"
    class="card lb-card"
    hover-class="card-hover"
    hover-stay-time="80"
    data-id="{{item.id}}"
    bindtap="goTopic"
  >
    <image wx:if="{{item.coverUrl}}" class="lb-icon topic-cover" src="{{item.coverUrl}}" mode="aspectFill" />
    <view wx:else class="lb-icon topic-emoji">🎉</view>
    <view class="lb-body">
      <view class="topic-tag">官方专题</view>
      <view class="lb-title">{{item.title}}</view>
    </view>
    <view class="lb-arrow">›</view>
  </view>

  <!-- 运动类型选择 -->
  <view class="card">
    <view class="section-title">运动类型</view>
    <view class="type-grid">
      <view
        wx:for="{{activityTypes}}"
        wx:key="type"
        class="type-item {{selectedType === item.type ? 'type-item-active' : ''}}"
        hover-class="type-item-hover"
        hover-stay-time="80"
        data-type="{{item.type}}"
        bindtap="selectType"
      >
        <image class="type-icon" src="{{item.iconImg}}" mode="aspectFit"></image>
        <view class="type-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 开始按钮 -->
  <t-button
    class="start-btn"
    theme="primary"
    size="large"
    block
    shape="round"
    bind:tap="startRecord"
  >开始运动</t-button>
</view>
