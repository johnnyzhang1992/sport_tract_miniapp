.welcome {
  padding: 0 8rpx 20rpx; /* 顶部内间距移除（页面已有内边距） */
}
/* 首页卡片紧凑化（覆盖全局 .card） */
.card {
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}
.welcome-title {
  font-size: 38rpx;
  font-weight: 600;
}
.welcome-sub {
  margin-top: 8rpx;
}
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.type-grid {
  display: flex;
  flex-wrap: wrap;
  row-gap: 8rpx; /* 上下行间距更小 */
}
.type-item {
  width: 25%; /* 每行 4 个 */
  box-sizing: border-box;
  padding: 6rpx 0; /* 按钮更紧凑 */
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}
.type-item-hover {
  background: #eef4ff;
  border-color: #2b6cf6;
}
.type-item-active {
  background: #eef4ff;
  border-color: #2b6cf6;
}
.type-icon {
  width: 44rpx;
  height: 44rpx;
}
.type-label {
  margin-top: 2rpx;
  font-size: 20rpx; /* 文字更小 */
}
.stats-row {
  display: flex;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.stat-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}
.start-btn {
  margin-top: 48rpx; /* 与上方间距加大 */
}


/* 进行中（已暂停）运动入口 */
.ongoing-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2b6cf6, #4d8bff);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(43, 108, 246, 0.25);
}
/* 未登录提示条 */
.login-tip {
  display: flex;
  align-items: center;
  background: #fffbe8;
  border: 1rpx solid #f5e6a8;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 24rpx;
}
.login-tip-hover {
  opacity: 0.85;
}
.login-tip-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.login-tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #8a6d1a;
}
.login-tip-arrow {
  font-size: 26rpx;
  color: #b8860b;
  font-weight: 600;
}
.ongoing-bar-hover {
  opacity: 0.85;
}
.ongoing-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.ongoing-info {
  flex: 1;
  min-width: 0;
}
.ongoing-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}
.ongoing-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}
.ongoing-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 运动日历卡片：底部内边距 */
.heat-card {
  padding-bottom: 16rpx;
}

/* 运动日历图例说明 */
.heat-legend-row {
  display: flex;
  align-items: center;
  justify-content: flex-end; /* 文案+色块整体靠右 */
  margin-top: 12rpx;
}
.heat-legend-text {
  font-size: 20rpx;
  color: #8a93a6;
  margin-right: 10rpx; /* 与色块间距 */
}
.heat-legend-colors {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.hl-cell {
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
}
