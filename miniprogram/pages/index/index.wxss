.welcome {
  padding: 0 8rpx 20rpx; /* 顶部内间距移除（页面已有内边距） */
}
/* 首页卡片紧凑化（覆盖全局 .card） */
.card {
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}
.card-hover {
  opacity: 0.7;
}
.welcome-title {
  font-size: 38rpx;
  font-weight: 600;
}
.welcome-sub {
  margin-top: 8rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.type-grid {
  display: flex;
  flex-wrap: wrap;
  row-gap: 8rpx; /* 上下行间距更小 */
}
.type-item {
  width: 25%; /* 每行 4 个 */
  box-sizing: border-box;
  padding: 6rpx 0; /* 按钮更紧凑 */
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}
.type-item-hover {
  background: #eef4ff;
  border-color: #2b6cf6;
}
.type-item-active {
  background: #eef4ff;
  border-color: #2b6cf6;
}
.type-icon {
  width: 44rpx;
  height: 44rpx;
}
.type-label {
  margin-top: 2rpx;
  font-size: 20rpx; /* 文字更小 */
}
.stats-row {
  display: flex;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.stat-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}
.start-btn {
  margin-top: 48rpx; /* 与上方间距加大 */
}


/* 进行中（已暂停）运动入口 */
.ongoing-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2b6cf6, #4d8bff);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(43, 108, 246, 0.25);
}
/* 未登录提示条 */
.login-tip {
  display: flex;
  align-items: center;
  background: #fffbe8;
  border: 1rpx solid #f5e6a8;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 24rpx;
}
.login-tip-hover {
  opacity: 0.85;
}
.login-tip-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.login-tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #8a6d1a;
}
.login-tip-arrow {
  font-size: 26rpx;
  color: #b8860b;
  font-weight: 600;
}
.ongoing-bar-hover {
  opacity: 0.85;
}
.ongoing-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.ongoing-info {
  flex: 1;
  min-width: 0;
}
.ongoing-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}
.ongoing-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}
.ongoing-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 卡内接口失败提示：卡片整块消失只会让人以为「功能没了」，所以留一行点名接口 + 实际原因 */
.card-fail {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fdf0ef;
}
.card-fail-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #e54d42;
}
.card-fail-retry {
  flex: none;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #fff;
  background: #e54d42;
}
.card-fail-retry-hover {
  opacity: 0.8;
}

/* 运动日历卡片：底部内边距 */
.heat-card {
  padding-bottom: 16rpx;
}

/* 运动日历图例说明 */
.heat-legend-row {
  display: flex;
  align-items: center;
  justify-content: flex-end; /* 文案+色块整体靠右 */
  margin-top: 12rpx;
}
.heat-legend-text {
  font-size: 20rpx;
  color: #8a93a6;
  margin-right: 10rpx; /* 与色块间距 */
}
.heat-legend-colors {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.hl-cell {
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
}

/* 运动榜入口卡片 */
.lb-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.lb-icon {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
}
.lb-body {
  flex: 1;
  min-width: 0;
}
.lb-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}
.lb-sub {
  font-size: 22rpx;
  margin-top: 2rpx;
}
.lb-arrow {
  font-size: 36rpx;
  color: #c8d0dc;
  flex-shrink: 0;
}

/* 半屏宽那一格（duo-row 里的运动榜）：标题行放不下 icon，改成「标题 + ›」一行、
   icon 与副标题并排在下面。只作用于 .lb-card-stacked——官方专题那圈是全宽卡、
   继续复用 .lb-card 的横排，不能跟着变。 */
.lb-card-stacked {
  display: block; /* 覆盖 .lb-card 的 flex，让标题行与下方内容各占一行 */
}
.lb-head {
  display: flex;
  align-items: center;
}
.lb-head .lb-title {
  flex: 1;
  min-width: 0; /* 标题过长时省略，不把箭头挤出去 */
}
.lb-foot {
  display: flex;
  align-items: center; /* icon 与两行副标题垂直居中 */
  gap: 12rpx;
  margin-top: 10rpx;
}
.lb-foot-text {
  flex: 1;
  min-width: 0;
}

/* 官方专题入口（复用 lb-card 布局） */
.topic-cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
}
.topic-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  background: #fff7e6;
  border-radius: 12rpx;
}
.topic-tag {
  display: inline-block;
  font-size: 18rpx;
  line-height: 1;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  color: #2b6cf6;
  background: #eef4ff;
  margin-bottom: 8rpx;
}

/* 运动榜 + 一起运动：一行两格，各占一半。
   .card 自带 margin-bottom，两格都留着会让矮的那格底部多一块、看起来不等高，
   所以底部间距交给 .duo-row 统一管。align-items 用默认 stretch：两格等高。 */
.duo-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.duo-cell {
  flex: 1;
  min-width: 0; /* 不写的话内容（长标题/长副标题）会把格子撑过 50% */
  margin-bottom: 0;
}

/* 区块标题行：标题在左、「查看更多」在最右 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.section-title-flat {
  margin-bottom: 0; /* 行距交给 .section-head 统一管 */
}
.campaign-more {
  font-size: 22rpx;
  color: #2b6cf6;
  flex-shrink: 0;
}
.campaign-more-hover {
  opacity: 0.7;
}
/* 横向滚动：区块只有半屏宽，卡片撑满容器（一屏一条），多了左右滑；滚动条藏掉 */
.camp-scroll {
  display: flex; /* 配合 scroll-view 的 enable-flex 生效 */
  align-items: flex-start; /* 卡片按内容高（stretch 会被容器拉高，底部留一片空） */
  gap: 12rpx;
  width: 100%;
}
/* 半屏宽放不下「一屏两条」，只能一屏一条——那就必须让下一条露出一点边，
   否则多条时屏上只看得到一条，完全没有「还能滑」的线索（实测过：2 条时就是全看不见）。
   36rpx 是卡片让出的宽度，其中 12rpx 被 gap 吃掉，真正露出的边 ≈ 24rpx。 */
.camp-scroll .camp-card {
  flex: 0 0 calc(100% - 36rpx);
  margin-right: 12rpx; /* 卡片间距（gap 在 scroll-view 里可能不生效） */
}
.camp-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
.campaign-row {
  padding: 14rpx 0;
}
/* 空态引导行：借用 .lb-title 的排版，但它是「一句号召」不是卡片标题，
   所以压一档字号、去掉加粗，并强制一行走完（半屏宽里换行会把卡片撑高）。
   必须声明在 .lb-title 之后——同权重靠源码顺序才能盖掉 28rpx/600。 */
.campaign-lead {
  font-size: 22rpx;
  font-weight: 400;
  white-space: nowrap;
}
.campaign-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 活动卡：浅底小块（在白卡里靠底色分块，比投影可靠）+ 标题 + 成员面。
   整卡是 flex 行：内容在左、箭头在右，align-items:center 让箭头对整张卡垂直居中 */
.camp-card {
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f5f7fb;
  display: flex;
  align-items: center;
}
.camp-card-hover {
  opacity: 0.8;
}
.camp-card-main {
  flex: 1;
  min-width: 0; /* 不写的话长标题会把箭头挤出去 */
}
.camp-card-title {
  font-size: 24rpx;
  font-weight: 400;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.camp-card-arrow {
  flex: none;
  margin-left: 8rpx;
  font-size: 32rpx;
  line-height: 1;
  color: #c8d0dc;
}
.camp-card-members {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}
/* 头像堆叠（.member-av-stack/.member-av/.member-av-text）是全局共享样式，见 app.wxss */
