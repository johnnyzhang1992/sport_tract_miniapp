.welcome {
  padding: 20rpx 8rpx 32rpx;
}
.welcome-title {
  font-size: 44rpx;
  font-weight: 600;
}
.welcome-sub {
  margin-top: 8rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.type-grid {
  display: flex;
  flex-wrap: wrap;
  row-gap: 24rpx; /* 上下行间距 */
}
.type-item {
  width: 25%; /* 每行 4 个 */
  box-sizing: border-box;
  padding: 12rpx 0; /* 更紧凑 */
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}
.type-item-hover {
  background: #eef4ff;
  border-color: #2b6cf6;
}
.type-item-active {
  background: #eef4ff;
  border-color: #2b6cf6;
}
.type-icon {
  width: 52rpx;
  height: 52rpx;
}
.type-label {
  margin-top: 4rpx;
  font-size: 22rpx; /* 文字缩小 */
}
.stats-row {
  display: flex;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.start-btn {
  margin-top: 48rpx; /* 与上方间距加大 */
}

