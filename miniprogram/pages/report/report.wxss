.container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); /* 底部安全距离 */
}

/* 维度切换 */
.range-card {
  padding: 14rpx 16rpx;
}
.range-row {
  display: flex;
  gap: 12rpx;
}
.range-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  background: #f2f3f5;
  font-size: 26rpx;
  color: #666;
}
.range-btn-active {
  background: #eef4ff;
  color: #2b6cf6;
  border: 2rpx solid #2b6cf6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* 汇总 */
.summary-grid {
  display: flex;
  flex-wrap: wrap;
}
.sum-item {
  width: 33.33%;
  box-sizing: border-box;
  text-align: center;
  padding: 14rpx 0;
}
.sum-num {
  font-size: 34rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.sum-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 个人最佳 */
.best-grid {
  display: flex;
  flex-wrap: wrap;
}
.best-item {
  width: 50%;
  box-sizing: border-box;
  padding: 14rpx 8rpx;
  text-align: center;
}
.best-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.best-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #8a93a6;
}
.best-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.best-date {
  font-size: 18rpx;
  color: #bbb;
  margin-top: 2rpx;
}

/* 轨迹列表 */
.list-title {
  margin-top: 8rpx;
}
.track-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.track-card {
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.track-hover {
  opacity: 0.7;
}
.track-thumb {
  width: 100%;
  height: 140rpx;
  display: block;
}
.track-body {
  padding: 12rpx 16rpx 16rpx;
}
.track-head-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.track-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.track-type {
  font-size: 22rpx;
  font-weight: 500;
  color: #1f2329;
  margin-right: auto;
}
.track-duration {
  font-size: 20rpx;
  color: #8a93a6;
  flex-shrink: 0;
}
.track-foot-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.track-dist {
  font-size: 26rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.track-time {
  font-size: 20rpx;
  color: #8a93a6;
}
.loading-tip {
  text-align: center;
  padding: 24rpx 0;
  color: #999;
  font-size: 24rpx;
}

/* 个人最佳按类型列表 */
.best-list {
  margin-top: 8rpx;
}
.best-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 22rpx;
}
.best-row:last-child {
  border-bottom: none;
}
.best-type-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.best-row-label {
  color: #86909c;
  flex: 1;
  text-align: left;
}
.best-row-val {
  font-weight: 600;
  color: #1f2329;
}
.best-row-unit {
  font-size: 18rpx;
  color: #86909c;
  margin-left: 2rpx;
}
.best-row-date {
  color: #c9cdd4;
  font-size: 20rpx;
  margin-left: 12rpx;
}

/* 个人最佳表格 */
.best-table { width: 100%; font-size: 22rpx; overflow-x: auto; margin-top: 8rpx; }
.bt-head, .bt-row { display: flex; align-items: center; }
.bt-head { background: #f7f8fa; border-radius: 8rpx; font-weight: 600; color: #4e5969; padding: 12rpx 0; }
.bt-row { border-bottom: 1rpx solid #f2f3f5; padding: 12rpx 0; }
.bt-th, .bt-td { flex: 1; text-align: center; min-width: 0; box-sizing: border-box; padding: 0 4rpx; }
.bt-col-type { flex: 0.85; display: flex; align-items: center; justify-content: flex-start; padding-left: 12rpx; text-align: left; }
.bt-icon { width: 28rpx; height: 28rpx; margin-right: 8rpx; flex-shrink: 0; }
.bt-type-label { overflow: hidden; white-space: nowrap; }
.bt-td { white-space: nowrap; }
