.container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); /* 底部安全距离 */
}

/* 维度切换 */
.range-card {
  padding: 14rpx 16rpx;
}
.range-row {
  display: flex;
  gap: 12rpx;
}
.range-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  background: #f2f3f5;
  font-size: 26rpx;
  color: #666;
}
.range-btn-active {
  background: #eef4ff;
  color: #2b6cf6;
  border: 2rpx solid #2b6cf6;
}
/* 历史周期翻页 */
.period-nav {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}
.period-arrow {
  width: 56rpx;
  height: 56rpx;
  line-height: 54rpx;
  text-align: center;
  font-size: 36rpx;
  color: #2b6cf6;
  border-radius: 50%;
  background: #f2f3f5;
}
.period-arrow-hover {
  background: #e2e6eb;
}
.period-arrow-disabled {
  color: #c0c4cc;
}
.period-label {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.period-label-hover {
  opacity: 0.7;
}
.period-label-caret {
  margin-left: 10rpx;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* 周期选择弹窗（底部抽屉，样式待调） */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.picker-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.picker-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.picker-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx 8rpx 8rpx 24rpx;
}
.picker-list {
  max-height: 60vh;
}
/* 周期选项卡片网格（2 列） */
.picker-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 24rpx;
}
.picker-card {
  width: calc(50% - 24rpx);
  box-sizing: border-box;
  margin: 12rpx;
  padding: 26rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #333;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  white-space: nowrap;
  overflow: hidden;
}
.picker-card-active {
  background: #eef4ff;
  border-color: #2b6cf6;
  color: #2b6cf6;
  font-weight: 600;
}
.picker-card-compact {
  font-size: 20rpx;
}

/* 周期对比 */
.cmp-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.cmp-row:last-child {
  border-bottom: none;
}
.cmp-label {
  width: 176rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #86909c;
}
.cmp-cell {
  flex: 1;
  text-align: center;
  min-width: 0;
}
.cmp-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  white-space: nowrap;
}
.cmp-diff {
  font-size: 20rpx;
  margin-top: 4rpx;
  white-space: nowrap;
}
.cmp-diff-up {
  color: #2bb673;
}
.cmp-diff-down {
  color: #e54d42;
}
.cmp-diff-flat {
  color: #c2c7d0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* 汇总 */
.summary-grid {
  display: flex;
  flex-wrap: wrap;
}
.sum-item {
  width: 33.33%;
  box-sizing: border-box;
  text-align: center;
  padding: 14rpx 0;
}
.sum-num {
  font-size: 34rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.sum-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 个人最佳 */
.best-grid {
  display: flex;
  flex-wrap: wrap;
}
.best-item {
  width: 50%;
  box-sizing: border-box;
  padding: 14rpx 8rpx;
  text-align: center;
}
.best-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.best-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #8a93a6;
}
.best-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.best-date {
  font-size: 18rpx;
  color: #bbb;
  margin-top: 2rpx;
}

/* 轨迹列表 */
.list-title {
  margin-top: 8rpx;
}
.track-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.track-card {
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.track-hover {
  opacity: 0.7;
}
.track-thumb {
  width: 100%;
  height: 140rpx;
  display: block;
}
.track-body {
  padding: 12rpx 16rpx 16rpx;
}
.track-head-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.track-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.track-type {
  font-size: 22rpx;
  font-weight: 500;
  color: #1f2329;
  margin-right: auto;
}
.track-duration {
  font-size: 20rpx;
  color: #8a93a6;
  flex-shrink: 0;
}
.track-foot-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.track-dist {
  font-size: 26rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.track-time {
  font-size: 20rpx;
  color: #8a93a6;
}
.loading-tip {
  text-align: center;
  padding: 24rpx 0;
  color: #999;
  font-size: 24rpx;
}

/* 个人最佳按类型列表 */
.best-list {
  margin-top: 8rpx;
}
.best-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 22rpx;
}
.best-row:last-child {
  border-bottom: none;
}
.best-type-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.best-row-label {
  color: #86909c;
  flex: 1;
  text-align: left;
}
.best-row-val {
  font-weight: 600;
  color: #1f2329;
}
.best-row-unit {
  font-size: 18rpx;
  color: #86909c;
  margin-left: 2rpx;
}
.best-row-date {
  color: #c9cdd4;
  font-size: 20rpx;
  margin-left: 12rpx;
}

/* 个人最佳表格 */
.best-table { width: 100%; font-size: 22rpx; overflow-x: auto; margin-top: 8rpx; }
.bt-head, .bt-row { display: flex; align-items: center; }
.bt-head { background: #f7f8fa; border-radius: 8rpx; font-weight: 600; color: #4e5969; padding: 12rpx 0; }
.bt-row { border-bottom: 1rpx solid #f2f3f5; padding: 12rpx 0; }
.bt-th, .bt-td { flex: 1; text-align: center; min-width: 0; box-sizing: border-box; padding: 0 4rpx; }
.bt-col-type { flex: 0.85; display: flex; align-items: center; justify-content: flex-start; padding-left: 12rpx; text-align: left; }
.bt-icon { width: 28rpx; height: 28rpx; margin-right: 8rpx; flex-shrink: 0; }
.bt-type-label { overflow: hidden; white-space: nowrap; }
.bt-td { white-space: nowrap; }

/* 年度报告入口（维度卡内） */
.year-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #eef4ff;
}
.year-entry-hover {
  background: #dce7fd;
}
.year-entry-text {
  font-size: 24rpx;
  color: #2b6cf6;
}
.year-entry-arrow {
  font-size: 30rpx;
  line-height: 1;
  color: #2b6cf6;
}

/* 汇总标题行 + 海报入口 */
.summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.summary-head .section-title {
  margin-bottom: 0;
}
.poster-link {
  font-size: 24rpx;
  color: #2b6cf6;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #eef4ff;
}
.poster-link-hover {
  background: #dce7fd;
}

/* 周期海报预览弹窗 */
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-box {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  width: 340px;
}
.poster-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.poster-title {
  font-size: 30rpx;
  font-weight: 600;
}
.poster-close {
  padding: 4rpx 12rpx;
  color: #999;
  font-size: 28rpx;
}
.period-poster-canvas {
  display: block;
  margin: 0 auto;
  width: 300px;
  height: 380px;
  background: #fff;
}
.poster-save {
  margin-top: 20rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
}
