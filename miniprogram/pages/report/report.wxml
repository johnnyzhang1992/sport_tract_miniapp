<view class="container" wx:if="{{summary || loading}}">
  <!-- 维度切换 -->
  <view class="card range-card">
    <view class="range-row">
      <view
        wx:for="{{ranges}}"
        wx:key="value"
        class="range-btn {{activeRange === item.value ? 'range-btn-active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onRangeChange"
      >{{item.label}}</view>
    </view>
    <!-- 历史周期翻页（周/月/年）；中间区间可点击弹出周期选择 -->
    <view class="period-nav" wx:if="{{activeRange !== 'all'}}">
      <view class="period-arrow" hover-class="period-arrow-hover" bindtap="onPrevPeriod">‹</view>
      <view class="period-label" hover-class="period-label-hover" bindtap="onTapPeriodLabel">
        <text>{{periodLabel}}</text>
        <image class="period-label-caret" src="/assets/icons/lucide-chevron-down.svg" mode="aspectFit" />
      </view>
      <view
        class="period-arrow {{canGoNext ? '' : 'period-arrow-disabled'}}"
        hover-class="{{canGoNext ? 'period-arrow-hover' : ''}}"
        bindtap="onNextPeriod"
      >›</view>
    </view>
    <!-- 年度报告入口（全年回顾） -->
    <view class="year-entry" hover-class="year-entry-hover" bindtap="goYearReport">
      <text class="year-entry-text">{{year}} 年度报告 · 全年回顾与海报</text>
      <text class="year-entry-arrow">›</text>
    </view>
  </view>

  <!-- 汇总：本期最重要的数字放最前 -->
  <view class="card">
    <view class="summary-head">
      <view class="section-title">汇总</view>
      <view class="poster-link" wx:if="{{activeRange !== 'all'}}" hover-class="poster-link-hover" bindtap="openPoster">🖼 生成海报</view>
    </view>
    <view class="avg-pace" wx:if="{{summary.avgPace}}">
      <text class="avg-pace-label">平均配速</text>
      <text class="avg-pace-value">{{summary.avgPace.value}}</text>
      <text class="avg-pace-unit">{{summary.avgPace.unit}}</text>
    </view>
    <view class="summary-grid">
      <view class="sum-item">
        <view class="sum-num">{{summary.count}}</view>
        <view class="sum-label">运动次数</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.distanceKm}}</view>
        <view class="sum-label">总距离 km</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.durationText}}</view>
        <view class="sum-label">总时长</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.calories}}</view>
        <view class="sum-label">消耗 千卡</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.elevationGain}}</view>
        <view class="sum-label">总爬升 m</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.activeDays}}</view>
        <view class="sum-label">活跃天数</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.avgDistanceKm}}</view>
        <view class="sum-label">平均每次 km</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.avgDurationText}}</view>
        <view class="sum-label">平均每次时长</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.dailyKm}}</view>
        <view class="sum-label">日均 km</view>
      </view>
    </view>
  </view>

  <!-- 本期亮点：从本期轨迹里挑出四个「最」 -->
  <view class="card" wx:if="{{highlights.length > 0}}">
    <view class="section-title">本期亮点</view>
    <view class="hl-grid">
      <view class="hl-item" wx:for="{{highlights}}" wx:key="key">
        <view class="hl-head">
          <image class="hl-icon" src="{{item.icon}}" mode="aspectFit" />
          <text class="hl-label">{{item.label}}</text>
        </view>
        <view class="hl-value">{{item.value}}</view>
        <view class="hl-sub">{{item.sub}}</view>
      </view>
    </view>
  </view>

  <!-- 周期对比（当前周期 vs 上一周期） -->
  <view class="card" wx:if="{{compare.length > 0}}">
    <view class="section-title">周期对比</view>
    <view class="cmp-row" wx:for="{{compare}}" wx:key="label">
      <view class="cmp-label">{{item.label}}</view>
      <view class="cmp-cell" wx:for="{{item.items}}" wx:for-item="it" wx:key="key">
        <view class="cmp-val">{{it.val}}</view>
        <view class="cmp-diff cmp-diff-{{it.diff.cls}}">
          <image wx:if="{{it.diff.cls === 'up'}}" class="cmp-diff-icon" src="/assets/icons/lucide-trending-up-green.png" mode="aspectFit" />
          <image wx:elif="{{it.diff.cls === 'down'}}" class="cmp-diff-icon" src="/assets/icons/lucide-trending-down-red.png" mode="aspectFit" />
          <text>{{it.diff.text}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 分类型汇总（当前查看周期：各类型总距离/总时长/次数） -->
  <view class="card" wx:if="{{typeSummary.length > 0}}">
    <view class="section-title">分类型汇总 · {{periodLabel || '全部'}}</view>
    <view class="best-table">
      <view class="bt-head">
        <view class="bt-th bt-col-type">类型</view>
        <view class="bt-th">总距离 km</view>
        <view class="bt-th">总时长</view>
        <view class="bt-th">次数</view>
      </view>
      <view class="bt-row" wx:for="{{typeSummary}}" wx:key="type">
        <view class="bt-td bt-col-type">
          <image class="bt-icon" src="{{item.typeIcon}}" mode="aspectFit" />
          <text class="bt-type-label">{{item.typeLabel}}</text>
        </view>
        <view class="bt-td">{{item.distanceKm}}</view>
        <view class="bt-td">{{item.durationText}}</view>
        <view class="bt-td">{{item.count}}</view>
      </view>
    </view>
  </view>

  <!-- 日期汇总：按当前维度切桶（周→按天 / 月→按自然周 / 年→按月 / 全部→按半年），后端聚合下发 -->
  <view class="card" wx:if="{{dateSummary.length > 0}}">
    <view class="summary-head">
      <view class="section-title">日期汇总 · {{dateSummaryTitle}}</view>
      <view class="date-view-toggle">
        <view class="dv-btn {{dateView === 'table' ? 'dv-btn-active' : ''}}" data-view="table" bindtap="onDateViewChange">表</view>
        <view class="dv-btn {{dateView === 'chart' ? 'dv-btn-active' : ''}}" data-view="chart" bindtap="onDateViewChange">图</view>
      </view>
    </view>
    <view wx:if="{{dateView === 'table'}}" class="best-table">
      <view class="bt-head">
        <view class="bt-th bt-col-type">{{dateBucketLabel}}</view>
        <view class="bt-th">次数</view>
        <view class="bt-th">距离 km</view>
        <view class="bt-th">时间</view>
        <view class="bt-th">千卡</view>
      </view>
      <view
        class="bt-row ds-row"
        hover-class="ds-row-hover"
        wx:for="{{dateSummary}}"
        wx:key="key"
        data-from="{{item.from}}"
        data-to="{{item.to}}"
        data-label="{{item.label}}"
        bindtap="onDateRowTap"
      >
        <view class="bt-td bt-col-type ds-label">{{item.label}}</view>
        <view class="bt-td">{{item.count}}</view>
        <view class="bt-td">{{item.distanceKm}}</view>
        <view class="bt-td">{{item.durationText}}</view>
        <view class="bt-td">{{item.kcal}}</view>
      </view>
      <view class="ds-hint">点任意一行可查看该时段的轨迹</view>
    </view>
    <stat-chart wx:else id="dateChart" data="{{dateChartData}}" type="bar" unit="km" height="{{230}}" empty-text="该时段暂无运动记录" />
  </view>

  <!-- 互跳：累计看板 -->
  <view class="card link-row" hover-class="card-hover" hover-stay-time="100" bindtap="goStats">
    <view class="link-info">
      <view class="link-title">数据统计</view>
      <view class="link-sub">累计看板 · 个人最佳 · 点亮地图</view>
    </view>
    <view class="link-arrow">›</view>
  </view>

  <view wx:if="{{!loading && summary && summary.count === 0}}" class="loading-tip">该时间段还没有运动记录</view>
  <view wx:if="{{loading}}" class="loading-tip">加载中…</view>
</view>

<!-- 周期选择弹窗（底部抽屉） -->
<view class="picker-mask" wx:if="{{showPeriodPicker}}" bindtap="onClosePeriodPicker">
  <view class="picker-sheet" catchtap="noop">
    <view class="picker-head">
      <text>选择周期</text>
      <text class="picker-close" catchtap="onClosePeriodPicker">✕</text>
    </view>
    <scroll-view class="picker-list" scroll-y scroll-into-view="{{pickerScrollInto}}">
      <view class="picker-grid">
        <view
          wx:for="{{periodOptions}}"
          wx:key="offset"
          id="period-{{item.offset}}"
          class="picker-card {{item.selected ? 'picker-card-active' : ''}} {{item.compact ? 'picker-card-compact' : ''}}"
          data-offset="{{item.offset}}"
          bindtap="onSelectPeriod"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 周期海报预览弹窗 -->
<view class="poster-mask" wx:if="{{posterVisible}}" catchtouchmove="noop">
  <view class="poster-box">
    <view class="poster-head">
      <text class="poster-title">周期海报</text>
      <view class="poster-close" bindtap="closePoster">✕</view>
    </view>
    <!-- 滚的是导出图：canvas 图层不被 scroll-view 裁剪，留在滚动区里会把按钮盖住（share-card 实测踩过） -->
    <scroll-view class="poster-scroll" scroll-y style="height: {{posterViewH}}px">
      <image wx:if="{{posterPath}}" class="poster-img" src="{{posterPath}}" mode="widthFix" style="width: 300px;" />
      <!-- 占位撑满视口：CSS height:100%（三张海报弹窗同口径），不写死 px -->
      <view wx:else class="poster-loading">海报生成中…</view>
    </scroll-view>
    <button class="poster-save" loading="{{saving}}" bindtap="savePoster">保存到相册</button>
    <canvas type="2d" id="periodPoster" class="poster-canvas-off"></canvas>
  </view>
</view>
