<view class="container" wx:if="{{summary}}">
  <!-- 维度切换 -->
  <view class="card range-card">
    <view class="range-row">
      <view
        wx:for="{{ranges}}"
        wx:key="value"
        class="range-btn {{activeRange === item.value ? 'range-btn-active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onRangeChange"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 汇总 -->
  <view class="card">
    <view class="section-title">汇总</view>
    <view class="summary-grid">
      <view class="sum-item">
        <view class="sum-num">{{summary.count}}</view>
        <view class="sum-label">运动次数</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.distanceKm}}</view>
        <view class="sum-label">总距离 km</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.durationText}}</view>
        <view class="sum-label">总时长</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.calories}}</view>
        <view class="sum-label">消耗 千卡</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.elevationGain}}</view>
        <view class="sum-label">总爬升 m</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.activeDays}}</view>
        <view class="sum-label">活跃天数</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.avgDistanceKm}}</view>
        <view class="sum-label">平均每次 km</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.avgDurationText}}</view>
        <view class="sum-label">平均每次时长</view>
      </view>
      <view class="sum-item">
        <view class="sum-num">{{summary.dailyKm}}</view>
        <view class="sum-label">日均 km</view>
      </view>
    </view>
  </view>

  <!-- 个人最佳（按类型分组） -->
  <view class="card" wx:if="{{best}}">
    <view class="section-title">个人最佳</view>
    <view class="best-grid">
      <view class="best-item">
        <view class="best-label">最远距离</view>
        <view class="best-list" wx:if="{{best.maxDistanceByType.length}}">
          <view class="best-row" wx:for="{{best.maxDistanceByType}}" wx:key="type">
            <image class="best-type-icon" src="{{item.typeIcon}}" mode="aspectFit" />
            <text class="best-row-label">{{item.typeLabel}}</text>
            <text class="best-row-val">{{item.value}}<text class="best-row-unit">{{item.unit}}</text></text>
            <text class="best-row-date">{{item.date}}</text>
          </view>
        </view>
        <view class="best-value" wx:else>—</view>
      </view>
      <view class="best-item">
        <view class="best-label">最快配速</view>
        <view class="best-list" wx:if="{{best.minPaceByType.length}}">
          <view class="best-row" wx:for="{{best.minPaceByType}}" wx:key="type">
            <image class="best-type-icon" src="{{item.typeIcon}}" mode="aspectFit" />
            <text class="best-row-label">{{item.typeLabel}}</text>
            <text class="best-row-val">{{item.value}}</text>
            <text class="best-row-date">{{item.date}}</text>
          </view>
        </view>
        <view class="best-value" wx:else>—</view>
      </view>
      <view class="best-item">
        <view class="best-label">最长时长</view>
        <view class="best-list" wx:if="{{best.maxDurationByType.length}}">
          <view class="best-row" wx:for="{{best.maxDurationByType}}" wx:key="type">
            <image class="best-type-icon" src="{{item.typeIcon}}" mode="aspectFit" />
            <text class="best-row-label">{{item.typeLabel}}</text>
            <text class="best-row-val">{{item.value}}</text>
            <text class="best-row-date">{{item.date}}</text>
          </view>
        </view>
        <view class="best-value" wx:else>—</view>
      </view>
      <view class="best-item">
        <view class="best-label">最大爬升</view>
        <view class="best-list" wx:if="{{best.maxElevationByType.length}}">
          <view class="best-row" wx:for="{{best.maxElevationByType}}" wx:key="type">
            <image class="best-type-icon" src="{{item.typeIcon}}" mode="aspectFit" />
            <text class="best-row-label">{{item.typeLabel}}</text>
            <text class="best-row-val">{{item.value}}<text class="best-row-unit">{{item.unit}}</text></text>
            <text class="best-row-date">{{item.date}}</text>
          </view>
        </view>
        <view class="best-value" wx:else>—</view>
      </view>
    </view>
  </view>

  <!-- 轨迹列表 -->
  <view class="section-title list-title" wx:if="{{tracks.length > 0}}">运动记录</view>
  <view class="track-grid">
    <view
      wx:for="{{tracks}}"
      wx:key="id"
      class="track-card"
      hover-class="track-hover"
      data-id="{{item.id}}"
      bindtap="onTapTrack"
    >
      <track-thumb class="track-thumb" points="{{item.previewPoints}}" color="{{item.color}}" />
      <view class="track-body">
        <view class="track-head-row">
          <image class="track-icon" src="{{item.iconImg}}" mode="aspectFit"></image>
          <text class="track-type">{{item.label}}</text>
          <text class="track-duration">{{item.durationText}}</text>
        </view>
        <view class="track-foot-row">
          <text class="track-dist">{{item.distanceKm}}公里</text>
          <text class="track-time">{{item.timeText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && summary.count === 0}}" class="loading-tip">该时间段还没有运动记录</view>
  <view wx:if="{{loading}}" class="loading-tip">加载中…</view>
</view>
