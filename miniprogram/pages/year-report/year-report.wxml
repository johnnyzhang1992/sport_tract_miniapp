<view class="container">
  <!-- 年份切换 -->
  <view class="year-nav">
    <view class="year-arrow" hover-class="year-arrow-hover" bindtap="onPrevYear">‹</view>
    <view class="year-label">{{year}} 年</view>
    <view
      class="year-arrow {{canGoNext ? '' : 'year-arrow-disabled'}}"
      hover-class="{{canGoNext ? 'year-arrow-hover' : ''}}"
      bindtap="onNextYear"
    >›</view>
  </view>

  <view wx:if="{{!loading && !hasData}}" class="text-muted empty-tip">该年度还没有运动记录</view>

  <block wx:if="{{hasData && summary}}">
    <!-- 总评 -->
    <view class="card hero-card">
      <view class="hero-num">{{summary.distanceKm}}</view>
      <view class="hero-label">全年总距离（公里）</view>
      <view class="hero-grid">
        <view class="hero-item">
          <view class="hero-item-value">{{summary.count}}</view>
          <view class="hero-item-label">运动次数</view>
        </view>
        <view class="hero-item">
          <view class="hero-item-value">{{summary.durationText}}</view>
          <view class="hero-item-label">总时长</view>
        </view>
        <view class="hero-item">
          <view class="hero-item-value">{{summary.activeDays}}</view>
          <view class="hero-item-label">活跃天数</view>
        </view>
        <view class="hero-item">
          <view class="hero-item-value">{{streakDays}}天</view>
          <view class="hero-item-label">最长连续</view>
        </view>
      </view>
    </view>

    <!-- 月度分解 -->
    <view class="card">
      <view class="section-title">月度运动距离（公里）</view>
      <stat-chart data="{{chartData}}" type="bar" unit="km" color="#2b6cf6" height="{{200}}" empty-text="" />
    </view>

    <!-- 分类型汇总（各类型总距离/总时长/次数） -->
    <view class="card" wx:if="{{typeSummary.length > 0}}">
      <view class="section-title">分类型汇总</view>
      <view class="best-table">
        <view class="bt-head">
          <view class="bt-th bt-col-type">类型</view>
          <view class="bt-th">总距离 km</view>
          <view class="bt-th">总时长</view>
          <view class="bt-th">次数</view>
        </view>
        <view class="bt-row" wx:for="{{typeSummary}}" wx:key="type">
          <view class="bt-td bt-col-type">
            <image class="bt-icon" src="{{item.typeIcon}}" mode="aspectFit" />
            <text class="bt-type-label">{{item.typeLabel}}</text>
          </view>
          <view class="bt-td">{{item.distanceKm}}</view>
          <view class="bt-td">{{item.durationText}}</view>
          <view class="bt-td">{{item.count}}</view>
        </view>
      </view>
    </view>

    <!-- 高光时刻 -->
    <view class="card" wx:if="{{highlights.length}}">
      <view class="section-title">高光时刻</view>
      <view
        class="hl-row"
        hover-class="hl-row-hover"
        wx:for="{{highlights}}"
        wx:key="key"
        data-id="{{item.id}}"
        bindtap="onTapHighlight"
      >
        <view class="hl-info">
          <view class="hl-value">{{item.value}}</view>
          <view class="hl-label">{{item.label}}</view>
        </view>
        <view class="hl-sub">{{item.sub}} ›</view>
      </view>
    </view>

    <!-- 今年新解锁 -->
    <view class="card" wx:if="{{milestones.length}}">
      <view class="section-title">今年新解锁（{{milestones.length}}）</view>
      <view class="ms-row" wx:for="{{milestones}}" wx:key="index" hover-class="ms-row-hover">
        <image class="ms-icon" src="{{item.iconImg}}" mode="aspectFit" />
        <view class="ms-info">
          <view class="ms-text">{{item.text}}</view>
        </view>
        <view class="ms-date">{{item.date}}</view>
      </view>
    </view>

    <!-- 保存海报 -->
    <button class="poster-btn" bindtap="openPoster">生成年度海报</button>
  </block>

  <view wx:if="{{loading}}" class="text-muted loading-tip">加载中…</view>

  <!-- 海报预览弹窗 -->
  <view class="poster-mask" wx:if="{{posterVisible}}" catchtouchmove="noop">
    <view class="poster-box">
      <view class="poster-head">
        <text class="poster-title">年度海报</text>
        <view class="poster-close" bindtap="closePoster">✕</view>
      </view>
      <!-- 滚的是导出图：canvas 图层不被 scroll-view 裁剪，留在滚动区里会把按钮盖住（share-card 实测踩过） -->
      <scroll-view class="poster-scroll" scroll-y style="height: {{posterViewH}}px">
        <image wx:if="{{posterPath}}" class="poster-img" src="{{posterPath}}" mode="widthFix" style="width: 300px;" />
        <view wx:else class="poster-loading">海报生成中…</view>
      </scroll-view>
      <button class="poster-save" loading="{{saving}}" bindtap="savePoster">保存到相册</button>
      <canvas type="2d" id="yearPoster" class="poster-canvas-off"></canvas>
    </view>
  </view>
</view>
