.container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 年份切换 */
.year-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 20rpx;
}
.year-arrow {
  width: 72rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 36rpx;
  color: #2b6cf6;
  border-radius: 12rpx;
  background: #f2f3f5;
}
.year-arrow-hover {
  background: #e2e6eb;
}
.year-arrow-disabled {
  color: #c0c4cc;
}
.year-label {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* 总评 */
.hero-card {
  text-align: center;
  padding: 40rpx 24rpx 32rpx;
}
.hero-num {
  font-size: 88rpx;
  font-weight: 700;
  color: #2b6cf6;
  line-height: 1.1;
}
.hero-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.hero-grid {
  display: flex;
  margin-top: 32rpx;
}
.hero-item {
  flex: 1;
}
.hero-item-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.hero-item-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 高光时刻 */
.hl-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.hl-row:last-child {
  border-bottom: none;
}
.hl-row-hover {
  background: #f7f8fa;
}
.hl-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.hl-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.hl-label {
  font-size: 24rpx;
  color: #666;
}
.hl-sub {
  font-size: 24rpx;
  color: #999;
}

/* 海报按钮 */
.poster-btn {
  margin-top: 24rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 30rpx;
  border-radius: 16rpx;
}

/* 海报预览弹窗 */
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-box {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  width: 340px;
}
.poster-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.poster-title {
  font-size: 30rpx;
  font-weight: 600;
}
.poster-close {
  padding: 4rpx 12rpx;
  color: #999;
  font-size: 28rpx;
}
.year-poster-canvas {
  display: block;
  margin: 0 auto;
  width: 300px;
  height: 420px;
  background: #fff;
}
.poster-save {
  margin-top: 20rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.empty-tip {
  text-align: center;
  padding: 120rpx 0;
}
.loading-tip {
  text-align: center;
  padding: 24rpx 0;
}

/* 今年新解锁 */
.ms-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 8rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.ms-row:last-child {
  border-bottom: none;
}
.ms-row-hover {
  background: #f7f8fa;
}
.ms-icon {
  font-size: 38rpx;
  flex-shrink: 0;
}
.ms-info {
  flex: 1;
}
.ms-text {
  font-size: 27rpx;
  color: #1f2329;
}
.ms-date {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}
