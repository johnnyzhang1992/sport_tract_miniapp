/* 徽章形状 + 配色：与徽章墙共用一份（年报要列出今年解锁的徽章，章面要和徽章页一致） */
@import '../../styles/badge-shape.wxss';

.container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 年份切换 */
.year-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 20rpx;
}
.year-arrow {
  width: 72rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 36rpx;
  color: #2b6cf6;
  border-radius: 12rpx;
  background: #f2f3f5;
}
.year-arrow-hover {
  background: #e2e6eb;
}
.year-arrow-disabled {
  color: #8a93a6;
}
.year-label {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* 总评 */
.hero-card {
  text-align: center;
  padding: 40rpx 24rpx 32rpx;
}
.hero-num {
  font-size: 88rpx;
  font-weight: 700;
  color: #2b6cf6;
  line-height: 1.1;
}
.hero-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.hero-grid {
  display: flex;
  margin-top: 32rpx;
}
.hero-item {
  flex: 1;
}
.hero-item-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.hero-item-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 微信步数汇总 */
.step-row {
  display: flex;
  margin-top: 4rpx;
}
.step-item {
  flex: 1;
  text-align: center;
}
.step-num {
  font-size: 34rpx;
  font-weight: 600;
  color: #2b6cf6;
  line-height: 1.3;
}
.step-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
}

/* 运动计划：四格达成数据 + 徽章解锁行（风格与步数卡一致） */
.plan-row {
  display: flex;
  margin-top: 4rpx;
}
.plan-item {
  flex: 1;
  text-align: center;
}
.plan-num {
  font-size: 34rpx;
  font-weight: 600;
  color: #2b6cf6;
  line-height: 1.3;
}
.plan-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
}
.plan-badge-line {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

/* 高光时刻 */
.hl-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.hl-row:last-child {
  border-bottom: none;
}
.hl-row-hover {
  background: #f7f8fa;
}
.hl-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.hl-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.hl-label {
  font-size: 24rpx;
  color: #666;
}
.hl-sub {
  font-size: 24rpx;
  color: #999;
}

/* 海报按钮 */
.poster-btn {
  margin-top: 24rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 30rpx;
  border-radius: 16rpx;
}

/* 海报预览弹窗 */
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-box {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  width: 340px;
  position: relative; /* 给离屏 canvas 当定位父级 */
}
.poster-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.poster-title {
  font-size: 30rpx;
  font-weight: 600;
}
.poster-close {
  padding: 4rpx 12rpx;
  color: #999;
  font-size: 28rpx;
}
.poster-img {
  display: block;
  margin: 0 auto;
  background: #fff;
}
.poster-loading {
  /* 撑满滚动视口：高度由父级 scroll-view 给，不写死 px（原先固定 120px，视口更高时下面空一片） */
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
}
/* 只画不显示：canvas 图层不被 scroll-view 裁剪、opacity:0 也压不住，CSS 留 2px；
   导出位图由 canvas.width/height 决定，与这里的尺寸无关 */
.poster-canvas-off {
  position: absolute;
  top: 0;
  left: 0;
  width: 2px;
  height: 2px;
  pointer-events: none;
}
/* 只滚海报：标题栏与「保存到相册」按钮固定在滚动区外 */
.poster-scroll {
  width: 100%;
}
.poster-save {
  margin-top: 20rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

/* 分类型汇总表格（与运动报告页个人最佳同款） */
.best-table {
  width: 100%;
  font-size: 22rpx;
  overflow-x: auto;
  margin-top: 8rpx;
}
.bt-head, .bt-row {
  display: flex;
  align-items: center;
}
.bt-head {
  background: #f7f8fa;
  border-radius: 8rpx;
  font-weight: 600;
  color: #4e5969;
  padding: 12rpx 0;
}
.bt-row {
  border-bottom: 1rpx solid #f2f3f5;
  padding: 12rpx 0;
}
.bt-th, .bt-td {
  flex: 1;
  text-align: center;
  min-width: 0;
  box-sizing: border-box;
  padding: 0 4rpx;
  white-space: nowrap;
}
.bt-col-type {
  flex: 0.85;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 12rpx;
  text-align: left;
}
.bt-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.bt-type-label {
  overflow: hidden;
  white-space: nowrap;
}

.empty-tip {
  text-align: center;
  padding: 120rpx 0;
}
.loading-tip {
  text-align: center;
  padding: 24rpx 0;
}

/* 今年新解锁 */
.ms-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 8rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.ms-row:last-child {
  border-bottom: none;
}
.ms-row-hover {
  background: #f7f8fa;
}
.ms-icon {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}
.ms-info {
  flex: 1;
}
.ms-text {
  font-size: 27rpx;
  color: #1f2329;
}
.ms-date {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

/* ── 今年解锁的徽章明细（2026-11-19）─────────────────────────
   年报是回顾页：只列已解锁的，不做点击/未解锁占位。
   尺寸比徽章墙小一档（88rpx vs 96rpx）——这里是"清单"，不是主展示区。 */
.year-badges {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #eee;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 0;
}
.year-badge {
  width: 25%; /* 一行 4 个，与徽章墙同节奏 */
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* 章面：尺寸由这里定，形状/配色来自 badge-shape.wxss */
.yb-face {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
/* 内部元素沿用组件类名（badge-center / badge-type-icon），
   这里只按 88rpx 章面收一档尺寸；其余（字体、颜色、阴影、图标构图）全部来自
   styles/badge-shape.wxss 与 badge-wall 的既有规则，不重复定义。 */
.yb-face .badge-center {
  font-size: 36rpx; /* 组件是 44rpx（96rpx 章面），这里小一档 */
}
.yb-face.has-type-icon .badge-center {
  font-size: 30rpx;
}
.yb-face .badge-type-icon {
  width: 24rpx;
  height: 24rpx;
  margin-bottom: 2rpx;
}
.yb-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #1f2329;
  text-align: center;
  line-height: 1.3;
  padding: 0 6rpx;
}
.yb-date {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #a8b0bd;
  font-variant-numeric: tabular-nums;
}

/* 合环组（rings）的三环在 88rpx 章面收一档（badge-shape.wxss 基准是 136rpx/96rpx 章面，
   比例 136/96 ≈ 1.42 → 88 章面下外环 124rpx，其余按原比例缩）。 */
.yb-face-ring {
  width: 124rpx;
  height: 124rpx;
  overflow: visible; /* 三环不用裁边（单章 clip-path 才需要） */
}
.yb-face-ring .ringbadge-o {
  width: 124rpx;
  height: 124rpx;
}
.yb-face-ring .ringbadge-g {
  width: 106rpx;
  height: 106rpx;
}
.yb-face-ring .ringbadge-r {
  width: 95rpx;
  height: 95rpx;
}
.yb-face-ring .ringbadge-core {
  width: 84rpx;
  height: 84rpx;
}
.yb-face-ring .ringbadge-core .badge-center {
  font-size: 24rpx;
}
