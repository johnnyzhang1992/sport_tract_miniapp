.import-page {
  padding: 24rpx;
}
.intro-card {
  margin-bottom: 24rpx;
}
.intro-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
}
.intro-text {
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 12rpx;
}
.intro-list {
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 12rpx;
}
.intro-item {
  margin-bottom: 6rpx;
}
.intro-tip {
  font-size: 24rpx;
  color: #8a93a6;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}
.file-name {
  margin-top: 16rpx;
  font-size: 26rpx;
  text-align: center;
}
.preview-card {
  margin-top: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
}
.preview-row {
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 12rpx;
}
.type-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.type-item {
  width: 33.33%;
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.type-item-active {
  background: #e8f0ff;
}
.type-icon {
  font-size: 36rpx;
  margin: 0 10rpx;
}
.type-label {
  font-size: 26rpx;
  color: #1f2329;
}
.preview-stats {
  display: flex;
  background: #f6f7f9;
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}
.pstat {
  flex: 1;
  text-align: center;
}
.pstat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}
.pstat-label {
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 6rpx;
}
