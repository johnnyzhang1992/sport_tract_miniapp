.import-page {
  padding: 24rpx;
}
.intro-card {
  margin-bottom: 24rpx;
}
.intro-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
}
.intro-text {
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 12rpx;
}
.intro-list {
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 12rpx;
}
.intro-item {
  margin-bottom: 6rpx;
}
.intro-tip {
  font-size: 24rpx;
  color: #8a93a6;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}
.file-name {
  margin-top: 16rpx;
  font-size: 26rpx;
  text-align: center;
}
.preview-card {
  margin-top: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
}
.preview-row {
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 12rpx;
}
.type-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.type-item {
  width: 33.33%;
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.type-item-active {
  background: #e8f0ff;
}
.type-icon {
  font-size: 36rpx;
  margin: 0 10rpx;
}
.type-label {
  font-size: 26rpx;
  color: #1f2329;
}
.preview-stats {
  display: flex;
  background: #f6f7f9;
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}
.pstat {
  flex: 1;
  text-align: center;
}
.pstat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}
.pstat-label {
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 6rpx;
}

/* 数据来源 */
.source-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}
.source-item {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #1f2329;
  background: #f6f7f9;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
}
.source-item-active {
  background: #2b6cf6;
  color: #fff;
}
.source-custom-input {
  background: #f6f7f9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

/* 底部固定保存按钮 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}
.save-btn {
  background: #2b6cf6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  padding: 0;
}
.save-btn[disabled] {
  background: #9db9f5;
  color: #fff;
}
.import-page {
  padding-bottom: 140rpx; /* 给固定按钮让位 */
}

.type-icon {
  width: 44rpx;
  height: 44rpx;
  margin: 0 10rpx;
}

/* 选择文件按钮内图标 */
.choose-icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  display: inline-block;
  vertical-align: middle;
}
