<view class="import-page">
  <!-- 说明 -->
  <view class="card intro-card">
    <view class="intro-title">导入运动轨迹</view>
    <view class="intro-text">支持从以下 App 导出的轨迹文件：</view>
    <view class="intro-list">
      <view class="intro-item">• 两步路：KML / GPX</view>
      <view class="intro-item">• Strava：GPX / TCX</view>
      <view class="intro-item">• 华为运动健康 / 小米：GPX</view>
      <view class="intro-item">• 佳明：TCX / GPX</view>
    </view>
    <view class="intro-tip">将文件发送到微信「文件传输助手」，然后在此选择</view>
  </view>

  <!-- 选择文件 -->
  <t-button theme="primary" size="large" block bind:tap="chooseFile" disabled="{{uploading}}">
    {{uploading ? '上传解析中…' : '📂 选择轨迹文件'}}
  </t-button>
  <view class="text-muted file-name" wx:if="{{fileName}}">已选：{{fileName}}</view>

  <!-- 解析预览 -->
  <view class="card preview-card" wx:if="{{preview}}">
    <view class="section-title">确认信息</view>
    <view class="preview-row">
      <view class="preview-label">运动类型</view>
    </view>
    <view class="type-grid">
      <view
        wx:for="{{activityTypes}}"
        wx:key="type"
        class="type-item {{preview.type === item.type ? 'type-item-active' : ''}}"
        data-type="{{item.type}}"
        bindtap="onTypeChange"
      >
        <image class="type-icon" src="{{item.iconImg}}" mode="aspectFit"></image>
        <view class="type-label">{{item.label}}</view>
      </view>
    </view>
    <view class="preview-row">
      <view class="preview-label">数据来源</view>
    </view>
    <view class="source-grid">
      <view
        wx:for="{{sourceOptions}}"
        wx:key="value"
        class="source-item {{preview.source === item.label ? 'source-item-active' : ''}}"
        data-source="{{item.label}}"
        bindtap="onSourceChange"
      >{{item.label}}</view>
      <view class="source-item {{preview.source === '自定义' ? 'source-item-active' : ''}}" data-source="自定义" bindtap="onSourceChange">自定义…</view>
    </view>
    <input
      wx:if="{{preview.source === '自定义'}}"
      class="source-custom-input"
      placeholder="输入来源名称（如：颂拓手表）"
      maxlength="50"
      value="{{customSource}}"
      bindinput="onCustomSourceInput"
    />
    <view class="preview-stats">
      <view class="pstat">
        <view class="pstat-value">{{preview.distanceKm}}</view>
        <view class="pstat-label">公里</view>
      </view>
      <view class="pstat">
        <view class="pstat-value">{{preview.durationText}}</view>
        <view class="pstat-label">时长</view>
      </view>
      <view class="pstat">
        <view class="pstat-value">{{preview.pointCount}}</view>
        <view class="pstat-label">轨迹点</view>
      </view>
    </view>
  </view>

  <!-- 底部固定保存按钮 -->
  <view class="bottom-bar" wx:if="{{preview}}">
    <button class="save-btn" loading="{{saving}}" bindtap="confirmSave" disabled="{{saving}}">
      保存到我的足迹
    </button>
  </view>
</view>
