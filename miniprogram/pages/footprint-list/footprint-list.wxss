/* 足迹列表独立页：卡片度量对齐 pages/tracks/tracks.wxss 的 .track-card / .list-row
   （白卡圆角 16rpx + box-shadow 0 2rpx 12rpx rgba(0,0,0,.04)、次级文字 #8a93a6、hover 0.7）
   页面左右留白由 app.wxss 的 .container（24rpx）提供 */
.list-state {
  padding: 160rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
.retry {
  margin-left: 8rpx;
  color: #2b6cf6;
  font-weight: 600;
}

.fp-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.fp-card-hover {
  opacity: 0.7;
}
.fp-thumb {
  flex: none;
  width: 156rpx;
  height: 156rpx;
  margin-right: 24rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
}
.fp-thumb.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #bbb;
}
.fp-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}
.fp-card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fp-card-sub {
  font-size: 24rpx;
  color: #8a93a6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fp-card-people {
  font-size: 22rpx;
  color: #8a93a6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 列表尾提示：对齐 tracks 的 .loading-tip（text-align center + padding 24rpx 0）与 .text-muted */
.list-tip {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}
