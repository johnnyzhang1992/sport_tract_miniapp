/* 足迹列表独立页：卡片度量对齐 pages/tracks/tracks.wxss 的 .track-card / .list-row
   （白卡圆角 16rpx + box-shadow 0 2rpx 12rpx rgba(0,0,0,.04)、次级文字 #8a93a6、hover 0.7）
   页面左右留白由 app.wxss 的 .container（24rpx）提供 */
.list-state {
  padding: 160rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
.retry {
  margin-left: 8rpx;
  color: #2b6cf6;
  font-weight: 600;
}

/* ------------------------------ 顶部：总览 + 形态切换 ------------------------------ */
.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 16rpx;
}
.head-summary {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #8a93a6;
}
.head-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.head-act {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}
.head-act-active {
  background: #eef4ff;
}
.head-act-hover {
  opacity: 0.7;
}
.head-icon {
  width: 36rpx;
  height: 36rpx;
}
.head-act-add {
  font-size: 40rpx;
  line-height: 1;
  color: #2b6cf6;
}

/* 分组/月份标题：竞品「2026年9月」「本月 4 条」那一行 */
.section-title {
  padding: 8rpx 4rpx 14rpx;
  font-size: 26rpx;
  color: #8a93a6;
}

/* ------------------------------ 足迹卡片 ------------------------------ */
/* 日期徽章 + 标题/地址·同行/描述/照片行；照片上限 3 张，故不出现竞片的「+N」叠层 */
.fp-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.fp-card-hover {
  opacity: 0.7;
}
.fp-date-badge {
  flex: none;
  width: 88rpx;
  margin-right: 20rpx;
  padding: 10rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 12rpx;
  background: #eef4ff;
}
.fp-date-day {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.1;
  color: #2b6cf6;
}
.fp-date-month {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #2b6cf6;
  opacity: 0.8;
}
.fp-card-main {
  flex: 1;
  min-width: 0;
}
.fp-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.fp-card-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fp-card-chevron {
  flex: none;
  margin-left: 8rpx;
  font-size: 32rpx;
  line-height: 1;
  color: #c0c4cc;
}
.fp-card-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a93a6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fp-card-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #4e5969;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.fp-photos {
  display: flex;
  margin-top: 14rpx;
}
.fp-photo {
  width: 132rpx;
  height: 132rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}

/* 列表尾提示：对齐 tracks 的 .loading-tip（text-align center + padding 24rpx 0）与 .text-muted */
.list-tip {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* ------------------------------ 搜索 + 时间筛选 ------------------------------ */
/* 筛选卡与统计页同款（.range-btn / .period-nav / .picker-* 对齐 footprint-stats.wxss），多一行搜索框 */
.filter-card {
  padding: 14rpx 16rpx;
}
.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 4rpx 12rpx;
}
/* 输入框容器：搜索图标内嵌左侧 */
.search-box {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.search-icon {
  position: absolute;
  left: 18rpx;
  width: 30rpx;
  height: 30rpx;
  pointer-events: none;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 56rpx 0 60rpx; /* 左侧避让搜索图标，右侧避让清空按钮 */
  background: #f2f3f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1f2329;
}
.search-ph {
  color: #b8bfcc;
}
.search-clear {
  position: absolute;
  right: 14rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: #c6ccd4;
}
.search-btn {
  flex: none;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 26rpx;
  border-radius: 12rpx;
  background: #eef4ff;
  color: #2b6cf6;
  font-size: 26rpx;
  font-weight: 600;
}
.search-btn-hover {
  background: #e0ebff;
}
.range-row {
  display: flex;
  gap: 12rpx;
}
.range-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  background: #f2f3f5;
  font-size: 26rpx;
  color: #666;
}
.range-btn-active {
  background: #eef4ff;
  color: #2b6cf6;
  border: 2rpx solid #2b6cf6;
}
.period-nav {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}
.period-arrow {
  width: 56rpx;
  height: 56rpx;
  line-height: 54rpx;
  text-align: center;
  font-size: 36rpx;
  color: #2b6cf6;
  border-radius: 50%;
  background: #f2f3f5;
}
.period-arrow-hover {
  background: #e2e6eb;
}
.period-arrow-disabled {
  color: #c0c4cc;
}
.period-label {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.period-label-hover {
  opacity: 0.7;
}
.period-label-caret {
  margin-left: 10rpx;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* 空态（有筛选）：文案上方收紧，下方给「清空筛选」 */
.empty-filtered {
  padding-bottom: 40rpx;
}
.empty-reset {
  display: flex;
  justify-content: center;
  padding-bottom: 80rpx;
}
.empty-reset-btn {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 44rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2b6cf6;
  font-size: 26rpx;
  font-weight: 600;
}
.empty-reset-btn-hover {
  background: #e0ebff;
}

/* 周期选择弹窗（底部抽屉，对齐统计页） */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.picker-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.picker-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.picker-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx 8rpx 8rpx 24rpx;
}
.picker-list {
  max-height: 60vh;
}
.picker-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 24rpx;
}
.picker-card {
  width: calc(50% - 24rpx);
  box-sizing: border-box;
  margin: 12rpx;
  padding: 26rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #333;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  white-space: nowrap;
  overflow: hidden;
}
.picker-card-active {
  background: #eef4ff;
  border-color: #2b6cf6;
  color: #2b6cf6;
  font-weight: 600;
}
.picker-card-compact {
  font-size: 20rpx;
}
