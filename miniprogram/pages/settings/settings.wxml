<view class="container">
  <!-- 运动类型显示与排序（纯前端，即时生效）：拖 ≡ 调整首页顺序，开关控制是否在首页展示 -->
  <view class="card">
    <view class="field-label">运动类型显示</view>
    <view class="sport-type-desc">散步/跑步/徒步/骑行默认展示，其它四个默认关闭，打开后显示在首页「运动类型」；拖动 ≡ 调整首页顺序。</view>
    <view class="sport-type-list">
      <view
        wx:for="{{sportTypeRows}}"
        wx:key="type"
        class="sport-type-row {{dragIndex === index ? 'sport-type-row-dragging' : ''}}"
        style="{{dragIndex === index ? 'transform: translateY(' + dragOffset + 'px);' : ''}}"
      >
        <!-- 拖拽热区=手柄+图标+名称整块（整行高），开关独立不触发拖拽 -->
        <view
          class="sport-type-drag"
          data-index="{{index}}"
          catchtouchstart="onDragStart"
          catchtouchmove="onDragMove"
          catchtouchend="onDragEnd"
          catchtouchcancel="onDragEnd"
        >
          <view class="sport-type-handle">≡</view>
          <image class="sport-type-icon" src="{{item.iconImg}}" mode="aspectFit" />
          <view class="sport-type-label {{item.visible ? '' : 'sport-type-label-off'}}">{{item.label}}</view>
        </view>
        <t-switch
          size="small"
          value="{{item.visible}}"
          data-type="{{item.type}}"
          bind:change="onSportTypeToggle"
        />
      </view>
    </view>
  </view>

  <!-- 高精度定位 -->
  <view class="card switch-row">
    <view class="switch-info">
      <view class="switch-title">高精度定位</view>
      <view class="text-muted">采集海拔与更准轨迹，更耗电</view>
    </view>
    <t-switch value="{{settings.highAccuracy}}" bind:change="onHighAccuracyChange" size="small" />
  </view>

  <!-- 展示身高体重 -->
  <view class="card switch-row">
    <view class="switch-info">
      <view class="switch-title">展示身高体重</view>
      <view class="text-muted">在个人中心展示您的身高与体重</view>
    </view>
    <t-switch value="{{settings.showBodyData}}" bind:change="onShowBodyDataChange" size="small" />
  </view>

  <!-- 隐私模式 -->
  <view class="card switch-row">
    <view class="switch-info">
      <view class="switch-title">隐私模式</view>
      <view class="text-muted">开启后，运动榜与步数榜不展示你的昵称和头像，资料卡不再展示你的运动数据</view>
    </view>
    <t-switch value="{{settings.privacyMode}}" bind:change="onPrivacyModeChange" size="small" />
  </view>

  <!-- 整公里播报 -->
  <view class="card switch-row">
    <view class="switch-info">
      <view class="switch-title">整公里播报</view>
      <view class="text-muted">运动中每满一公里震动并显示分段用时</view>
    </view>
    <t-switch value="{{settings.kmAnnounce}}" bind:change="onKmAnnounceChange" size="small" />
  </view>

  <!-- 同步微信步数（步数PK / 步数辅助）：关闭后只在进行中的活动页按需同步 -->
  <view class="card switch-row">
    <view class="switch-info">
      <view class="switch-title">同步微信步数</view>
      <view class="text-muted">开启后每天进入小程序自动同步</view>
    </view>
    <t-switch value="{{settings.dailyStepSync}}" bind:change="onDailyStepSyncChange" size="small" />
  </view>

  <!-- 照片额度（2026-11-05）：用户查「我还能传多少张」的自然位置；
       读数来自 /member/entitlements 的 photoQuota，与会员页同一份数据 -->
  <view class="card quota-row" wx:if="{{loggedIn && photoQuota}}" bindtap="goPhotos">
    <view class="quota-head">
      <view class="switch-info">
        <view class="switch-title">照片额度</view>
        <view class="text-muted">{{photoQuota.isMember ? '会员额度' : '基础额度'}} · 每次上传按张数计</view>
      </view>
      <view class="quota-num">
        <text class="quota-used">{{photoQuota.used}}</text>
        <text class="quota-limit">/ {{photoQuota.limit}} 张</text>
      </view>
    </view>
    <view class="quota-bar">
      <view class="quota-fill {{photoQuota.remaining === 0 ? 'full' : ''}}" style="width: {{photoQuota.percent}}%"></view>
    </view>
    <view class="quota-foot {{photoQuota.remaining === 0 ? 'warn' : ''}}">
      {{photoQuota.remaining === 0 ? '额度已用尽，点这里删除旧照片或升级会员' : '剩余 ' + photoQuota.remaining + ' 张'}}
      <text class="quota-more">管理 ›</text>
    </view>
  </view>

  <!-- 隐私政策 -->
  <view class="card link-row" bindtap="openPrivacy">
    <view class="switch-info">
      <view class="switch-title">隐私政策</view>
      <view class="text-muted">查看我们如何收集与使用您的信息</view>
    </view>
    <view class="link-arrow">›</view>
  </view>

  <!-- 退出登录（仅登录态展示） -->
  <view class="card logout-row" wx:if="{{loggedIn}}" hover-class="logout-row-hover" bindtap="logout">
    <text>退出登录</text>
  </view>

  <t-button
    theme="primary"
    size="large"
    block
    loading="{{saving}}"
    bind:tap="save"
  >保存</t-button>
</view>
