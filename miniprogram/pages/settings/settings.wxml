<view class="container">
  <!-- 默认运动类型 -->
  <view class="card">
    <view class="field-label">默认运动类型</view>
    <view class="type-grid">
      <view
        wx:for="{{activityTypes}}"
        wx:key="type"
        class="type-item {{settings.defaultType === item.type ? 'type-item-active' : ''}}"
        data-type="{{item.type}}"
        bindtap="onDefaultTypeChange"
      >
        <image class="type-icon" src="{{item.iconImg}}" mode="aspectFit"></image>
        <view class="type-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 高精度定位 -->
  <view class="card switch-row">
    <view class="switch-info">
      <view class="switch-title">高精度定位</view>
      <view class="text-muted">采集海拔与更准轨迹，更耗电</view>
    </view>
    <t-switch value="{{settings.highAccuracy}}" bind:change="onHighAccuracyChange" />
  </view>

  <!-- 展示身高体重 -->
  <view class="card switch-row">
    <view class="switch-info">
      <view class="switch-title">展示身高体重</view>
      <view class="text-muted">在个人中心展示您的身高与体重</view>
    </view>
    <t-switch value="{{settings.showBodyData}}" bind:change="onShowBodyDataChange" />
  </view>

  <!-- 展示运动数据 -->
  <view class="card switch-row">
    <view class="switch-info">
      <view class="switch-title">展示运动数据</view>
      <view class="text-muted">允许他人查看你的累计运动数据</view>
    </view>
    <t-switch value="{{settings.showSportData}}" bind:change="onShowSportDataChange" />
  </view>

  <!-- 整公里播报 -->
  <view class="card switch-row">
    <view class="switch-info">
      <view class="switch-title">整公里播报</view>
      <view class="text-muted">运动中每满一公里震动并显示分段用时</view>
    </view>
    <t-switch value="{{settings.kmAnnounce}}" bind:change="onKmAnnounceChange" />
  </view>

  <!-- 隐私政策 -->
  <view class="card link-row" bindtap="openPrivacy">
    <view class="switch-info">
      <view class="switch-title">隐私政策</view>
      <view class="text-muted">查看我们如何收集与使用您的信息</view>
    </view>
    <view class="link-arrow">›</view>
  </view>

  <!-- 退出登录（仅登录态展示） -->
  <view class="card logout-row" wx:if="{{loggedIn}}" hover-class="logout-row-hover" bindtap="logout">
    <text>退出登录</text>
  </view>

  <t-button
    theme="primary"
    size="large"
    block
    loading="{{saving}}"
    bind:tap="save"
  >保存</t-button>

  <!-- 关闭展示运动数据的提示半屏 -->
  <view class="sport-mask" wx:if="{{sportSheetVisible}}" bindtap="closeSportSheet">
    <view class="sport-sheet" catchtap="noop">
      <view class="sport-title">已关闭展示运动数据</view>
      <view class="sport-body">保存设置后生效。运动榜仍保留你的名次和距离，但他人点开资料卡时不再看到累计运动数据；你自己的统计不受影响。</view>
      <view class="sport-btn" bindtap="closeSportSheet">知道了</view>
    </view>
  </view>
</view>
