.field-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.gender-row {
  display: flex;
}
.gender-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background: #f7f8fa;
  margin-right: 16rpx;
  font-size: 28rpx;
}
.gender-item:last-child {
  margin-right: 0;
}
.gender-active {
  background: #eef4ff;
  color: #2b6cf6;
  border: 2rpx solid #2b6cf6;
}
.type-grid {
  display: flex;
  flex-wrap: wrap;
}
.type-item {
  width: 25%; /* 一行 4 个（紧凑版） */
  box-sizing: border-box;
  padding: 8rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}
.type-item-active {
  background: #eef4ff;
  border-color: #2b6cf6;
}
.type-icon {
  width: 44rpx;
  height: 44rpx;
}
.type-label {
  font-size: 20rpx;
  margin-top: 4rpx;
}
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.switch-title {
  font-size: 30rpx;
}
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}
.link-arrow {
  font-size: 40rpx;
  color: #c2c7d0;
}

.type-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 10rpx;
}
