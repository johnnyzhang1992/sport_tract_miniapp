/* 底部安全区：iPhone Home Indicator 遮挡防护 */
.container {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.field-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.gender-row {
  display: flex;
}
.gender-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background: #f7f8fa;
  margin-right: 16rpx;
  font-size: 28rpx;
}
.gender-item:last-child {
  margin-right: 0;
}
.gender-active {
  background: #eef4ff;
  color: #1a56d6;
  border: 2rpx solid #1a56d6;
}
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.switch-info {
  flex: 1;
  min-width: 0; /* 长说明文案在开关左侧的剩余空间内换行，不挤压/压到右侧开关 */
  margin-right: 16rpx;
}
.switch-title {
  font-size: 30rpx;
}
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}
.link-arrow {
  font-size: 40rpx;
  color: #667080;
}


/* 退出登录（居中红字行） */
.logout-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  color: #c02a30;
  font-size: 30rpx;
}
.logout-row-hover {
  opacity: 0.7;
}


/* 照片额度：用量 + 进度条 + 剩余句 */
.quota-row {
  display: block;
}
.quota-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.quota-num {
  flex-shrink: 0;
  margin-left: 16rpx;
}
.quota-used {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.quota-limit {
  font-size: 24rpx;
  color: #8a93a6;
}
.quota-bar {
  height: 10rpx;
  border-radius: 6rpx;
  background: #eef0f5;
  overflow: hidden;
  margin: 16rpx 0 10rpx;
}
.quota-fill {
  height: 100%;
  border-radius: 6rpx;
  background: #2b6cf6;
}
.quota-fill.full {
  background: #e34d59;
}
.quota-foot {
  font-size: 24rpx;
  color: #8a93a6;
}
.quota-foot.warn {
  color: #e34d59;
}

.quota-more {
  float: right;
  color: #2b6cf6;
}

/* 运动类型显示开关（2026-11-07）：行式布局 图标+名称+开关；复用旧 type-grid 的图标尺寸语言 */
.sport-type-desc {
  font-size: 24rpx;
  color: #8a93a6;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.sport-type-row {
  display: flex;
  align-items: center;
  height: 76rpx; /* 拖拽位移按整行计算，行高必须固定；与 settings.js ensureRowHeight 的 76 保持一致 */
  box-sizing: border-box;
  border-bottom: 1rpx solid #f2f3f5;
  background: #fff;
  position: relative;
}
.sport-type-row:last-child {
  border-bottom: none;
}
.sport-type-row-dragging {
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
  border-radius: 12rpx;
  z-index: 5;
}
/* 拖拽热区：手柄+图标+名称整块、撑满行高，抓哪里都能拖；开关在热区外 */
.sport-type-drag {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 100%;
}
.sport-type-handle {
  width: 56rpx;
  text-align: center;
  color: #c0c6d1;
  font-size: 28rpx;
  line-height: 1;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.sport-type-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.sport-type-label {
  flex: 1;
  font-size: 26rpx;
  color: #1f2329;
}
.sport-type-label-off {
  color: #c0c6d1;
}
