/* 底部安全区：iPhone Home Indicator 遮挡防护 */
.container {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.field-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.gender-row {
  display: flex;
}
.gender-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background: #f7f8fa;
  margin-right: 16rpx;
  font-size: 28rpx;
}
.gender-item:last-child {
  margin-right: 0;
}
.gender-active {
  background: #eef4ff;
  color: #1a56d6;
  border: 2rpx solid #1a56d6;
}
.type-grid {
  display: flex;
  flex-wrap: wrap;
}
.type-item {
  width: 25%; /* 一行 4 个（紧凑版） */
  box-sizing: border-box;
  padding: 8rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}
.type-item-active {
  background: #eef4ff;
  border-color: #1a56d6;
}
.type-icon {
  width: 44rpx;
  height: 44rpx;
}
.type-label {
  font-size: 20rpx;
  margin-top: 4rpx;
}
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.switch-title {
  font-size: 30rpx;
}
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}
.link-arrow {
  font-size: 40rpx;
  color: #667080;
}

.type-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 10rpx;
}

/* 退出登录（居中红字行） */
.logout-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  color: #c02a30;
  font-size: 30rpx;
}
.logout-row-hover {
  opacity: 0.7;
}

/* 关闭「展示运动数据」的提示半屏 */
.sport-mask {
  position: fixed;
  inset: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}
.sport-sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}
.sport-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.sport-body {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5b6474;
}
.sport-btn {
  margin-top: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
