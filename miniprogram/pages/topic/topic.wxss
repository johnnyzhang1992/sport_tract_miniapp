.container {
  /* 底部 64rpx + Home 指示条安全区 */
  padding: 32rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
}

.cover {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.4;
}

.date {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #667080;
}

.content {
  margin-top: 28rpx;
}

.tip {
  text-align: center;
  color: #667080;
  font-size: 26rpx;
  padding: 120rpx 0;
}

.retry-btn {
  margin-top: 24rpx;
}
