<view class="page">
  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{failed}}" class="state state-tap" bindtap="onRetry">加载失败，点击重试</view>
  <!-- 商品由 ?key= 决定，游客态拿不到商品时按老口径（补签卡）出文案 -->
  <view wx:elif="{{!loggedIn}}" class="state state-tap" bindtap="onLoginTap">{{isMakeup ? '登录后兑换补签卡' : '登录后兑换'}}</view>
  <block wx:elif="{{item}}">
    <!-- 商品头（2026-10-28）：白底 hero 带，名称/副题在左、道具图放大在右；缺图回落首字方块 -->
    <view class="hero">
      <view class="hero-main">
        <text class="hero-name">{{item.name}}</text>
        <text class="hero-sub">{{item.subtitle}}</text>
      </view>
      <image wx:if="{{heroImage}}" class="hero-img" src="{{heroImage}}" mode="aspectFit" />
      <view wx:else class="hero-icon">{{heroChar}}</view>
    </view>

    <view class="card">
      <!-- 价格行：价格从原来名称右侧的小字提成独立大字，右侧带库存状态（口径与积分页同一份 stockTextOf） -->
      <view class="price-row">
        <view class="price">
          <text class="price-num">{{priceNumberText}}</text>
          <text class="price-unit">积分</text>
        </view>
        <text wx:if="{{stockText}}" class="stock-pill">{{stockText}}</text>
      </view>

      <!-- 实物详情图：后台最多传 6 张，整宽竖排、按原比例自适应高度（服务端下发 medium 档）；虚拟道具没有这一组 -->
      <view wx:if="{{detailImages.length}}" class="detail-list">
        <image
          wx:for="{{detailImages}}"
          wx:key="*this"
          class="detail-img"
          src="{{item}}"
          mode="widthFix"
          lazy-load="{{true}}"
        />
      </view>

      <view class="section-title">商品介绍</view>
      <text class="desc">{{item.description}}</text>
      <!-- 有效期只对「发卡」有意义：实物落的是订单，卡片不发、也就没有兑换后 N 天这一说 -->
      <view class="meta-row" wx:if="{{!isPhysical}}">
        <text class="meta-label">有效期</text>
        <text class="meta-value">兑换后 {{item.validDays}} 天</text>
      </view>
      <view class="meta-row" wx:if="{{isPhysical && item.perUserLimit > 0}}">
        <text class="meta-label">每人限购</text>
        <text class="meta-value">{{item.perUserLimit}} 件</text>
      </view>
      <!-- 持卡数只有补签卡有「我的补签卡」这一栏（免广告卡没有同类持有物） -->
      <view class="meta-row" wx:if="{{isMakeup && cards > 0}}">
        <text class="meta-label">我的补签卡</text>
        <text class="meta-value">{{cards}} 张</text>
      </view>
    </view>

    <!-- 兑换说明由服务端 notes 下发（每件商品一套），没有就整块不出现 -->
    <view class="card" wx:if="{{item.notes && item.notes.length}}">
      <view class="section-title">兑换说明</view>
      <view class="note" wx:for="{{item.notes}}" wx:key="*this">· {{item}}</view>
    </view>

    <!-- 实物必填收货地址：常驻显示（不做"点兑换才弹出来"，那样人会因为看不见才点得下去） -->
    <view class="card" wx:if="{{isPhysical}}">
      <view class="section-title">收货地址</view>
      <view class="addr-row">
        <text class="addr-label">收货人</text>
        <input
          class="addr-input"
          placeholder="姓名（1–20 字）"
          value="{{addr.receiver}}"
          data-field="receiver"
          bindinput="onAddrInput"
        />
      </view>
      <view class="addr-row">
        <text class="addr-label">手机号</text>
        <input
          class="addr-input"
          type="number"
          maxlength="11"
          placeholder="11 位大陆手机号"
          value="{{addr.phone}}"
          data-field="phone"
          bindinput="onAddrInput"
        />
      </view>
      <view class="addr-row addr-row-top">
        <text class="addr-label">详细地址</text>
        <textarea
          class="addr-textarea"
          placeholder="省 / 市 / 区 + 街道门牌（5–120 字）"
          value="{{addr.detail}}"
          data-field="detail"
          bindinput="onAddrInput"
          auto-height
          maxlength="120"
        />
      </view>
      <view class="addr-err" wx:if="{{addrErr}}">{{addrErr}}</view>
      <view class="addr-tip">下单后由客服发货，物流单号在「兑换记录」里查看</view>
    </view>

    <view class="links">
      <text class="link" bindtap="goExchanges">兑换记录 ›</text>
      <!-- 入口判据来自 summary 的 cells（有 makeup 格才显示），不再看持卡数：能补的不止昨天 -->
      <text class="link" wx:if="{{isMakeup && canMakeup}}" bindtap="goMakeup">去补签 ›</text>
    </view>

    <view class="buy-space"></view>
    <view class="buy-bar">
      <view class="buy-hint" wx:if="{{balance < item.price}}">还差 {{item.price - balance}} 积分，去签到或做任务赚积分</view>
      <view class="buy-btn {{balance >= item.price && !busy ? '' : 'off'}}" bindtap="onExchange">
        <text wx:if="{{busy}}">兑换中…</text>
        <text wx:else>{{priceText}}</text>
      </view>
    </view>
  </block>
</view>
