.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 24rpx;
}

.state {
  padding: 160rpx 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a93a6;
}

.state-tap {
  color: #2b6cf6;
}

/* 商品头图：与积分页/明细页同一套压深蓝渐变；白底方块里放金色「签」字（荣誉金，同任务分值） */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #1a56d6, #2b6cf6);
  padding: 48rpx 32rpx 76rpx;
}

.hero-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #8a5f12;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 700;
}

.hero-name {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.hero-sub {
  font-size: 24rpx;
  color: #fff;
}

.hero-price {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 8rpx;
}

.price {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
}

.price-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.card {
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
}

.card-first {
  margin-top: -52rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.7;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 26rpx;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-label {
  color: #8a93a6;
}

.meta-value {
  color: #1f2329;
}

.note {
  font-size: 24rpx;
  color: #4e5969;
  line-height: 1.9;
}

.links {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  padding: 28rpx 0 8rpx;
  font-size: 24rpx;
  color: #2b6cf6;
}

.buy-space {
  height: 140rpx;
}

.buy-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx 32rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(31, 35, 41, 0.06);
}

.buy-hint {
  text-align: center;
  font-size: 22rpx;
  color: #b45309; /* 积分不够的提醒＝详情页车速段/暂停提示那套警示橙（对白底约 6.4:1） */
  padding-bottom: 12rpx;
}

.buy-btn {
  height: 88rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

/* 兑换按钮关掉时＝中灰＋白字（同活动详情 join 按钮），别用灰底灰字压成不可读 */
.buy-btn.off {
  background: #64748f;
  color: #fff;
}
