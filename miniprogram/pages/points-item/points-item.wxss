.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 24rpx;
}

.state {
  padding: 160rpx 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a93a6;
}

.state-tap {
  color: #2b6cf6;
}

/* 商品头（2026-10-28）：白底 hero 带，与下面几张卡同一节奏。
   文字用页面主文字色/次级灰（对白底分别 14.6:1、5.0:1） */
.hero {
  margin: 24rpx 24rpx 0;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
}

.hero-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

/* 缺图回落：浅灰底 + 荣誉金首字（与积分页道具卡的占位同一套） */
.hero-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #f7f8fa;
  color: #8a5f12;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}

.hero-sub {
  font-size: 24rpx;
  color: #667080;
}

/* 价格行：价格独立成大字，右侧库存胶囊（不限量/剩余 N 件，口径来自 utils/points-view#stockTextOf） */
.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f3f5;
  margin-bottom: 20rpx;
}

.price {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.price-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #8a5f12; /* 荣誉金：与积分页商品卡价格同色，对白底 5.6:1 */
}

.price-unit {
  font-size: 24rpx;
  color: #667080;
}

.stock-pill {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8a5f12;
  background: #fdf3e7;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.7;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 26rpx;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-label {
  color: #8a93a6;
}

.meta-value {
  color: #1f2329;
}

.note {
  font-size: 24rpx;
  color: #4e5969;
  line-height: 1.9;
}

.links {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  padding: 28rpx 0 8rpx;
  font-size: 24rpx;
  color: #2b6cf6;
}

/* 滚动区尾部留白：要盖住「提示行 + 按钮 + 内边距」整条购买栏（约 179rpx），再叠安全区 */
.buy-space {
  height: calc(184rpx + env(safe-area-inset-bottom));
}

.buy-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 底部垫安全区：不垫的话按钮压在 iPhone 的 Home 条上 */
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(31, 35, 41, 0.06);
}

.buy-hint {
  text-align: center;
  font-size: 22rpx;
  color: #b45309; /* 积分不够的提醒＝详情页车速段/暂停提示那套警示橙（对白底约 6.4:1） */
  padding-bottom: 12rpx;
}

.buy-btn {
  height: 88rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

/* 兑换按钮关掉时＝中灰＋白字（同活动详情 join 按钮），别用灰底灰字压成不可读 */
.buy-btn.off {
  background: #64748f;
  color: #fff;
}

/* ===== 实物商品（2026-10-27 实物批次）===== */
/* 头图位：道具图是 2.1:1 的横卡，方框 + aspectFill 会把上下裁掉只剩中间一条
   （2026-10-28 用户点名「顶部道具图片会被裁切」）。图位按同比例给横框 + aspectFit，
   整张卡完整落进来；hero 改版后放大到 210×100rpx，仍然贴着 2.1:1。 */
.hero-img {
  width: 210rpx;
  height: 100rpx;
  flex-shrink: 0;
}

/* 商品详情图：整宽竖排，高度随原图比例走（服务端下发 medium 档 w_800，够整宽用） */
.detail-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.detail-img {
  width: 100%;
  border-radius: 16rpx;
  background: #f7f8fa;
}

/* 收货地址：标签左 / 控件右，输入框带可见底框（没底框看不出这一格能填） */
.addr-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.addr-row-top {
  align-items: flex-start;
}
.addr-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #8a93a6;
}
.addr-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #1f2329;
  background: #f7f8fa;
  border: 1rpx solid #e6e8eb;
  border-radius: 12rpx;
}
.addr-textarea {
  flex: 1;
  min-width: 0;
  width: auto;
  box-sizing: border-box;
  padding: 12rpx 16rpx;
  height: 64rpx;
  font-size: 26rpx;
  color: #1f2329;
  background: #f7f8fa;
  border: 1rpx solid #e6e8eb;
  border-radius: 12rpx;
}
/* 校验错误只在点过兑换之后出现（边输边报很吵），文案由 utils/points-item-view 给 */
.addr-err {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #e34d59;
}
.addr-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a93a6;
  line-height: 1.6;
}
