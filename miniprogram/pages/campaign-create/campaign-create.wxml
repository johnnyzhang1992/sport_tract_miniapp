<!-- 创建活动页：标题自动生成 / PK 类型 / 自动加入 / 运动类型 / 人数上限 / 起止日期 → 发起 -->
<view class="container">
  <view class="fgroup">
    <!-- 标题：按所选类型与活动天数自动生成，不可编辑（类型/日期变化即重算） -->
    <view class="frow">
      <view class="flabel">标题</view>
      <view class="fval">{{title}}</view>
    </view>
    <view class="fnote">自动生成：所选运动类型 + 活动天数；多类型仅展示前三个，超出以「等」带过</view>

    <!-- PK 类型：运动PK 按轨迹；步数PK 只统计活动周期内微信步数。创建后不可改 -->
    <view class="frow">
      <view class="flabel">PK 类型</view>
      <view class="vis-row {{isEdit ? 'vis-row-off' : ''}}">
        <view
          wx:for="{{kindOptions}}"
          wx:key="key"
          class="vis-seg {{kind === item.key ? 'vis-seg-active' : ''}}"
          data-value="{{item.key}}"
          bindtap="onKind"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="fnote">{{kind === 'steps' ? '步数PK是独立类型，整个活动只按步数排名，不区分运动类型' : '运动PK按活动周期内的轨迹统计距离'}}{{isEdit ? '；PK 类型创建后不能再改' : ''}}</view>

    <!-- 自动加入：开＝公开活动被邀请人自动加入；关＝需发起人同意（行式布局与相邻字段同列） -->
    <view class="frow">
      <view class="flabel">自动加入</view>
      <view class="aux-switch">
        <t-switch value="{{autoJoin}}" bind:change="onAutoJoin" />
      </view>
    </view>
    <view class="fnote">{{autoJoin ? '开启：公开活动，被邀请人自动加入' : '关闭：需发起人同意后才能加入'}}</view>

    <!-- 运动类型 / 步数辅助：仅普通运动PK 可见 -->
    <block wx:if="{{kind === 'activity'}}">
      <!-- 运动类型：多选 chips（空选＝不限制，必须在 UI 上写明） -->
      <view class="flabel-block">运动类型</view>
      <view class="cat-grid">
        <view
          wx:for="{{types}}"
          wx:key="type"
          class="cat-chip {{item.active ? 'cat-chip-on' : ''}}"
          data-type="{{item.type}}"
          bindtap="onTypeToggle"
        >
          <image class="cat-icon {{item.active ? '' : 'cat-icon-gray'}}" src="{{item.iconImg}}" mode="aspectFit" />
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="fnote">不选＝全部类型都算；点已选中的可取消</view>

      <!-- 微信步数辅助：开启后在成员半屏按天对比轨迹距离与当日步数，不影响排名 -->
      <view class="frow">
        <view class="flabel">步数辅助</view>
        <view class="aux-switch">
          <t-switch value="{{stepAuxEnabled}}" bind:change="onStepAuxChange" />
        </view>
      </view>
      <view class="fnote">开启后可在成员半屏按天对比轨迹距离与微信步数；只做展示，不影响排名与积分</view>
    </block>

    <!-- 人数上限：可选，1–500，不填＝不限制。
         注意：不要在这里加 maxlength —— 实测 maxlength=3 会把 type="number" 的输入静默截断
         （输入 1000 得到 100），用户意图被悄悄改掉且 ≤500 的校验永远看不到原值；改为原样保留、
         由 onSubmit 明确拒绝（提示含对象+实际值+上限）。 -->
    <view class="frow">
      <view class="flabel">人数上限</view>
      <input
        class="finput finput-num"
        type="number"
        placeholder="不填＝不限制"
        placeholder-class="fph"
        value="{{memberLimit}}"
        bindinput="onMemberLimit"
      />
    </view>
    <view class="fnote">可选，1–{{maxMembers}} 的整数，默认 {{defaultMembers}}，清空＝不限制；当前 {{memberLimit || '不限制'}}</view>

    <!-- 起止日期：picker 直接给 YYYY-MM-DD 字符串，原样上送（服务端转东八区）。
         编辑态下开始日期只读：服务端 UpdateCampaignSchema 是 .strict()，上送 startDate 会整请求 400。
         只读只靠置灰表达，右侧箭头不摘（两行日期版式保持一致）。 -->
    <picker mode="date" value="{{startDate}}" disabled="{{isEdit}}" bindchange="onStartDate">
      <view class="frow frow-tap" hover-class="{{isEdit ? 'none' : 'frow-hover'}}">
        <view class="flabel">开始日期</view>
        <view class="fval {{isEdit ? 'fval-off' : (startDateText ? '' : 'fval-ph')}}">{{startDateText || '选择日期'}}</view>
        <view class="farrow">›</view>
      </view>
    </picker>
    <picker mode="date" value="{{endDate}}" start="{{startDate}}" end="{{maxEndDate}}" bindchange="onEndDate">
      <view class="frow frow-tap" hover-class="frow-hover">
        <view class="flabel">结束日期</view>
        <view class="fval {{endDateText ? '' : 'fval-ph'}}">{{endDateText || '选择日期'}}</view>
        <view class="farrow">›</view>
      </view>
    </picker>
    <view class="fnote {{dateError ? 'fnote-error' : ''}}">{{dateError || '结束日期不早于开始日期，均按东八区计算'}}</view>
  </view>

  <button
    class="btn-primary submit-btn"
    disabled="{{submitting || !canSubmit}}"
    loading="{{submitting}}"
    bindtap="onSubmit"
  >{{submitting ? (isEdit ? '保存中…' : '创建中…') : (isEdit ? '保存修改' : '发起活动')}}</button>
</view>
