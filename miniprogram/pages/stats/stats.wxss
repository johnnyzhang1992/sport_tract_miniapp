.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.overview-grid {
  display: flex;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx 0;
}
.ov-item {
  flex: 1;
  text-align: center;
}
.ov-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #2b6cf6;
}
.ov-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.period-row {
  display: flex;
}
.period-item {
  flex: 1;
  text-align: center;
}
.period-num {
  font-size: 30rpx;
  font-weight: 600;
}
.period-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.days-toggle {
  display: flex;
  flex: 1; /* 占满剩余宽度，4 个按钮均分不挤 */
  margin-left: 16rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 4rpx;
}
.day-btn {
  flex: 1; /* 4 个按钮均分 */
  text-align: center;
  padding: 8rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
}
.day-btn-active {
  background: #fff;
  color: #2b6cf6;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 个人最佳 */
.best-grid {
  display: flex;
  flex-wrap: wrap;
}
.best-item {
  width: 50%;
  box-sizing: border-box;
  padding: 16rpx 8rpx;
  text-align: center;
}
.best-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.best-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.best-date {
  font-size: 18rpx;
  color: #bbb;
  margin-top: 2rpx;
}

/* 运动报告 */
.report-row {
  display: flex;
  margin-top: 8rpx;
}
.report-item {
  flex: 1;
  text-align: center;
}
.report-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.report-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 运动报告入口 */
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}
.switch-info {
  flex: 1;
}
.switch-title {
  font-size: 28rpx;
  color: #1f2329;
}
.link-arrow {
  font-size: 40rpx;
  color: #c2c7d0;
}
.report-hover {
  opacity: 0.8;
}

/* 最快配速（按类型列表） */
.best-item-pace {
  width: 100% !important; /* 独占一行，放各类型配速 */
}
.best-list {
  margin-top: 8rpx;
}
.best-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 24rpx;
}
.best-row:last-child {
  border-bottom: none;
}
.best-row-label {
  color: #86909c;
}
.best-row-val {
  font-weight: 600;
  color: #1f2329;
}
.best-row-date {
  color: #c9cdd4;
  font-size: 20rpx;
}

.best-type-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.best-row-unit {
  font-size: 20rpx;
  color: #86909c;
  margin-left: 2rpx;
}
