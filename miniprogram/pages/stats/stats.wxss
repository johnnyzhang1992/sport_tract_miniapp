/* 底部安全区：iPhone Home Indicator 遮挡防护 */
.container {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
/* 最佳记录：横滑卡片（穗枝环住类型图标），距离PB在前；
   外壳与「里程碑奖杯」一样用全局 .card，里面的小卡也跟着改成灰底，两块长得一致 */
.best-scroll {
  width: 100%;
}
.best-cards {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0 8rpx;
}
.best-card {
  width: 220rpx;
  flex-shrink: 0;
  /* 与 .trophy-item 同一套：灰底 16rpx 圆角、不加投影 */
  background: #f7f8fa;
  border-radius: 16rpx;
  /* 与上面「里程碑奖杯」同档的观感：纵向留白与徽章高度各收一档，宽度不动
     （180rpx 会让「1000 精英级」这类值折行，white-space:nowrap 会直接裁掉） */
  padding: 22rpx 20rpx 18rpx;
  box-sizing: border-box;
}
.bc-badge {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-bottom: 12rpx;
}
.bc-ear {
  width: 16rpx;
  height: 30rpx;
}
.bc-icon {
  width: 32rpx;
  height: 32rpx;
  margin: 0 3rpx;
}
.bc-label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #1f2329;
  white-space: nowrap;
}
.bc-value {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  white-space: nowrap;
}
.overview-grid {
  display: flex;
  flex-wrap: wrap;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 12rpx 0;
}
.ov-item {
  width: 25%;
  text-align: center;
  padding: 12rpx 0;
}
.ov-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #2b6cf6;
}
.ov-label {
  font-size: 22rpx;
  color: #667080;
  margin-top: 4rpx;
}
.period-row {
  display: flex;
  gap: 16rpx;
  /* 合进「运动趋势」卡后，与下面五张变化卡之间留一档（原来是两张卡，靠卡底/卡头留白） */
  margin-bottom: 16rpx;
}
.period-item {
  /* 盒子直接复用 .metric-card（底色/圆角/内边距/高度全同），这里只负责在行内等分 */
  flex: 1;
  min-width: 0;
}
/* 运动日历卡内：月切换 + 周标题 + 7 列格子，有运动的天绿底白勾 */
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f3f5;
}
.cal-arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #4e5969;
}
.cal-arrow-hover {
  background: #f2f3f5;
  border-radius: 50%;
}
.cal-arrow-off {
  color: #d4d8e0;
}
.cal-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}
.cal-week {
  display: flex;
}
.cal-week-head {
  margin-top: 8rpx;
}
.cal-weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #8a93a6;
}
.cal-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0;
}
.cal-day {
  font-size: 24rpx;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
}
.cal-day-out {
  color: #c8cdd6;
}
.cal-day-today {
  font-weight: 700;
  color: #2b6cf6;
}
.cal-check {
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
}
.cal-check-on {
  background: #2bb673;
}
/* 补位格（上/下月的日子）打勾也淡一档，别抢当月的视线 */
.cal-check-out {
  opacity: 0.35;
}
.cal-caption {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a93a6;
}
/* 运动趋势：五张变化卡（2 列，第 5 张占左列，右下自然留白）；卡内两行＝名目行 + 数值行 */
.trend-sub {
  font-size: 22rpx;
  color: #8a93a6;
}
.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}
/* 卡内结构：左列圆圈图标（垂直居中）+ 右侧三行左对齐（名目 / 数值+单位 / 涨跌） */
.metric-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.metric-card-hover {
  background: #eef1f6;
}
/* 圆圈底与 .trophy-badge 同口径：白底 + 有向色图标，方向语义只靠图标颜色 */
.metric-badge {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.metric-badge-icon {
  width: 34rpx;
  height: 34rpx;
}
.metric-body {
  flex: 1;
  min-width: 0;
}
.metric-label {
  display: block;
  font-size: 22rpx;
  color: #4e5969;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.metric-value-line {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-top: 2rpx;
}
.metric-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
}
.metric-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #8a93a6;
}
.metric-foot {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #8a93a6;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.metric-diff-up {
  color: #15804f;
}
.metric-diff-down {
  color: #c02a30;
}
.metric-diff-flat {
  color: #8a93a6;
}
/* 半屏内：维度条与配速注脚 */
.sheet-days {
  margin-left: 0;
  margin-bottom: 14rpx;
}
.sheet-trend-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a93a6;
  text-align: right;
}
.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.days-toggle {
  display: flex;
  flex: 1; /* 占满剩余宽度，4 个按钮均分不挤 */
  margin-left: 16rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 4rpx;
}
.day-btn {
  flex: 1; /* 4 个按钮均分 */
  text-align: center;
  padding: 8rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
}
.day-btn-active {
  background: #fff;
  color: #2b6cf6;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
/* 趋势运动类型筛选：横滑胶囊 */
.type-chips {
  width: 100%;
  margin: 4rpx 0 8rpx;
}
.type-chip-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx 0;
}
.type-chip {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #4e5969;
  background: #f2f3f5;
}
.type-chip-active {
  background: #eef4ff;
  color: #1a56d6;
  font-weight: 600;
}
/* 运动日历卡：连续/最长/分位三格 */
.streak-row {
  display: flex;
  gap: 16rpx;
}
.streak-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  /* 与 .period-item / .metric-card 同一套灰底小卡：整页的统计小组都长一个样 */
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 16rpx 8rpx 14rpx;
}
.streak-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #2b6cf6;
}
.streak-label {
  font-size: 22rpx;
  color: #667080;
  margin-top: 4rpx;
}
/* 里程碑奖杯墙：五项等分，未达成置灰 */
.trophy-grid {
  display: flex;
  gap: 10rpx;
}
.trophy-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0 16rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
}
.trophy-hover {
  opacity: 0.75;
}
.trophy-locked {
  opacity: 0.55;
}
.trophy-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.trophy-badge-locked {
  background: #eceef2;
  box-shadow: none;
}
.trophy-icon {
  width: 38rpx;
  height: 38rpx;
}
.trophy-check {
  font-size: 28rpx;
  font-weight: 700;
  color: #15804f;
}
.trophy-lock {
  font-size: 28rpx;
  color: #8a93a6;
  line-height: 1;
}
.trophy-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #1f2329;
  margin-top: 10rpx;
}
.trophy-value {
  font-size: 20rpx;
  color: #667080;
  margin-top: 4rpx;
  white-space: nowrap;
}
.best-card-hover {
  opacity: 0.75;
}

/* 个人最佳表格 */
.best-table {
  width: 100%;
  font-size: 22rpx;
  overflow-x: auto;
  margin-top: 8rpx;
}
.bt-head, .bt-row {
  display: flex;
  align-items: center;
}
.bt-head {
  background: #f7f8fa;
  border-radius: 8rpx;
  font-weight: 600;
  color: #4e5969;
  padding: 12rpx 0;
}
.bt-row {
  border-bottom: 1rpx solid #f2f3f5;
  padding: 12rpx 0;
}
.bt-th, .bt-td {
  flex: 1;
  text-align: center;
  min-width: 0;
  box-sizing: border-box;
  padding: 0 4rpx;
}
.bt-col-type {
  flex: 0.85;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 12rpx;
  text-align: left;
}
.bt-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.bt-type-label {
  overflow: hidden;
  white-space: nowrap;
}
.bt-td {
  white-space: nowrap;
}

/* 互跳入口：与「我的」页同款行卡 */
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.link-info {
  flex: 1;
}
.link-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.link-sub {
  font-size: 24rpx;
  color: #667080;
  margin-top: 6rpx;
}
.link-arrow {
  font-size: 40rpx;
  color: #667080;
  margin-left: 12rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 标题栏右侧「查看更多」：点击区 ≥76rpx，箭头与文字同组 */
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.section-title-row .section-title {
  margin-bottom: 0;
}
.more-link {
  display: flex;
  align-items: center;
  gap: 2rpx;
  min-height: 76rpx;
  padding-left: 20rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  color: #667080;
}
.more-link-hover {
  opacity: 0.7;
}
.more-arrow {
  font-size: 28rpx;
  line-height: 1;
  color: #8a93a6;
}

/* 半屏弹窗：与成员明细宫格同一套 mask/sheet 观感 */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 12rpx;
}
.sheet-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.sheet-close {
  flex: none;
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 30rpx;
  color: #666;
}
.sheet-body {
  max-height: 60vh;
}
/* 全部纪录：两列宫格（紧凑） */
.record-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  padding: 4rpx 0 16rpx;
}
.trophy-sheet-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 8rpx 0 24rpx;
}
.record-cell {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  box-sizing: border-box;
  padding: 12rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
}
.record-cell-hover {
  opacity: 0.75;
}
.record-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.record-info {
  flex: 1;
  min-width: 0;
}
.record-label {
  font-size: 20rpx;
  color: #667080;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.record-value {
  margin-top: 2rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.record-type {
  margin-top: 0;
  font-size: 18rpx;
  color: #8a93a6;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 奖杯详情卡 */
.trophy-sheet-card {
  min-width: 0;
  box-sizing: border-box;
  padding: 20rpx 18rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
}
/* 未解锁别用整卡 opacity：0.6 会把里面的灰字压到 1.8:1（实测「完成 42.2 km」几乎看不见），
   层级改用底色 + 文字色两档表达 */
.trophy-sheet-locked {
  background: #f4f5f7; /* 比已解锁深一档即可：#667080 在其上仍有 4.56:1 */
}
.trophy-sheet-locked .ts-value {
  color: #667080;
}
.ts-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ts-badge {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  box-shadow: none;
}
.ts-icon {
  width: 34rpx;
  height: 34rpx;
}
.ts-info {
  flex: 1;
  min-width: 0;
}
.ts-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2329;
}
.ts-value {
  margin-top: 2rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #2b6cf6;
  font-variant-numeric: tabular-nums;
}
.ts-meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  /* 20rpx 的小字在 #f7f8fa 上用 #667080 只有 4.7:1，实测偏淡；压深一档到 6.7:1 */
  color: #4e5969;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ts-lock {
  color: #667080; /* 未解锁比已解锁再浅一档，但仍在 4.5 以上 */
}

/* 游客态登录引导（与轨迹列表同款 .login-hint） */
.login-hint {
  background: #fff;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  margin: 24rpx;
}
.login-hint-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.6;
}
.login-hint-text {
  color: #4e5969;
  font-size: 26rpx;
  margin: 24rpx 0 32rpx;
  line-height: 1.6;
}
.login-hint-btn {
  background: #2b6cf6;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  width: 320rpx;
}
