.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.overview-grid {
  display: flex;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx 0;
}
.ov-item {
  flex: 1;
  text-align: center;
}
.ov-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #2b6cf6;
}
.ov-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.period-row {
  display: flex;
}
.period-item {
  flex: 1;
  text-align: center;
}
.period-num {
  font-size: 30rpx;
  font-weight: 600;
}
.period-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.days-toggle {
  display: flex;
  flex: 1; /* 占满剩余宽度，4 个按钮均分不挤 */
  margin-left: 16rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 4rpx;
}
.day-btn {
  flex: 1; /* 4 个按钮均分 */
  text-align: center;
  padding: 8rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
}
.day-btn-active {
  background: #fff;
  color: #2b6cf6;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 个人最佳表格 */
.best-table {
  width: 100%;
  font-size: 22rpx;
  overflow-x: auto;
  margin-top: 8rpx;
}
.bt-head, .bt-row {
  display: flex;
  align-items: center;
}
.bt-head {
  background: #f7f8fa;
  border-radius: 8rpx;
  font-weight: 600;
  color: #4e5969;
  padding: 12rpx 0;
}
.bt-row {
  border-bottom: 1rpx solid #f2f3f5;
  padding: 12rpx 0;
}
.bt-th, .bt-td {
  flex: 1;
  text-align: center;
  min-width: 0;
  box-sizing: border-box;
  padding: 0 4rpx;
}
.bt-col-type {
  flex: 0.85;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 12rpx;
  text-align: left;
}
.bt-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.bt-type-label {
  overflow: hidden;
  white-space: nowrap;
}
.bt-td {
  white-space: nowrap;
}

/* 周期对比 */
.cmp-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.cmp-row:last-child {
  border-bottom: none;
}
.cmp-label {
  width: 176rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #86909c;
}
.cmp-cell {
  flex: 1;
  text-align: center;
  min-width: 0;
}
.cmp-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  white-space: nowrap;
}
.cmp-diff {
  font-size: 20rpx;
  margin-top: 4rpx;
  white-space: nowrap;
}
.cmp-diff-up {
  color: #2bb673;
}
.cmp-diff-down {
  color: #e54d42;
}
.cmp-diff-flat {
  color: #c2c7d0;
}
