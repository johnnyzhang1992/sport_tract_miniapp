.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.overview-grid {
  display: flex;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx 0;
}
.ov-item {
  flex: 1;
  text-align: center;
}
.ov-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #2b6cf6;
}
.ov-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.period-row {
  display: flex;
}
.period-item {
  flex: 1;
  text-align: center;
}
.period-num {
  font-size: 30rpx;
  font-weight: 600;
}
.period-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.days-toggle {
  display: flex;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 4rpx;
}
.day-btn {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
}
.day-btn-active {
  background: #fff;
  color: #2b6cf6;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
