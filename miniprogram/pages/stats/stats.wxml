<view class="container" wx:if="{{overview}}">
  <!-- 累计概览 -->
  <view class="card">
    <view class="section-title">累计</view>
    <view class="overview-grid">
      <view class="ov-item">
        <view class="ov-num">{{overview.total.distanceKm}}</view>
        <view class="ov-label">公里</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{overview.total.durationText}}</view>
        <view class="ov-label">时长</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{overview.total.count}}</view>
        <view class="ov-label">次数</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{overview.total.elevationGain}}</view>
        <view class="ov-label">爬升 m</view>
      </view>
    </view>
  </view>

  <!-- 周期明细 -->
  <view class="card">
    <view class="period-row">
      <view class="period-item">
        <view class="period-num">{{overview.today.distanceKm}}</view>
        <view class="period-label">今日 km</view>
      </view>
      <view class="period-item">
        <view class="period-num">{{overview.week.distanceKm}}</view>
        <view class="period-label">本周 km</view>
      </view>
      <view class="period-item">
        <view class="period-num">{{overview.month.distanceKm}}</view>
        <view class="period-label">本月 km</view>
      </view>
    </view>
  </view>

  <!-- 周期对比（本周vs上周 / 本月vs上月） -->
  <view class="card" wx:if="{{compare.length > 0}}">
    <view class="section-title">周期对比</view>
    <view class="cmp-row" wx:for="{{compare}}" wx:key="label">
      <view class="cmp-label">{{item.label}}</view>
      <view class="cmp-cell" wx:for="{{item.items}}" wx:for-item="it" wx:key="key">
        <view class="cmp-val">{{it.val}}</view>
        <view class="cmp-diff cmp-diff-{{it.diff.cls}}">{{it.diff.text}}</view>
      </view>
    </view>
  </view>

  <!-- 个人最佳纪录（表格：行=类型，列=4 项指标） -->
  <view class="card" wx:if="{{best}}">
    <view class="section-title">个人最佳</view>
    <view class="best-table">
      <view class="bt-head">
        <view class="bt-th bt-col-type">类型</view>
        <view class="bt-th">最远距离</view>
        <view class="bt-th">最快配速</view>
        <view class="bt-th">最长时长</view>
        <view class="bt-th">最大爬升</view>
      </view>
      <view class="bt-row" wx:for="{{best.bestTable}}" wx:key="type">
        <view class="bt-td bt-col-type">
          <image class="bt-icon" src="{{item.typeIcon}}" mode="aspectFit" />
          <text class="bt-type-label">{{item.typeLabel}}</text>
        </view>
        <view class="bt-td">{{item.maxDistance}}</view>
        <view class="bt-td">{{item.minPace}}</view>
        <view class="bt-td">{{item.maxDuration}}</view>
        <view class="bt-td">{{item.maxElevation}}</view>
      </view>
    </view>
  </view>

  <!-- 趋势柱状图 -->
  <view class="card">
    <view class="chart-head">
      <view class="section-title">距离趋势（公里）</view>
      <view class="days-toggle">
        <view
          wx:for="{{trendTypes}}"
          wx:key="value"
          class="day-btn {{trendType === item.value ? 'day-btn-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onTrendTypeChange"
        >{{item.label}}</view>
      </view>
    </view>
    <stat-chart data="{{chartData}}" type="bar" unit="km" height="{{230}}" empty-text="暂无运动数据" />
  </view>
</view>
