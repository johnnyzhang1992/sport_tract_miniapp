<!-- 游客态缺省：登录引导卡（不发请求，登录后自动重拉） -->
<view class="login-hint" wx:if="{{notLoggedIn}}">
  <image class="login-hint-icon" src="/assets/icons/lucide-chart.png" mode="aspectFit" />
  <view class="login-hint-text">登录后查看你的运动统计</view>
  <button class="login-hint-btn" bindtap="guestLogin">去登录</button>
</view>

<view class="container" wx:if="{{overview}}">
  <!-- 累计概览 -->
  <view class="card">
    <view class="section-title">累计</view>
    <view class="overview-grid">
      <view class="ov-item">
        <view class="ov-num">{{overview.total.distanceKm}}</view>
        <view class="ov-label">公里</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{overview.total.durationText}}</view>
        <view class="ov-label">时长</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{overview.total.count}}</view>
        <view class="ov-label">次数</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{overview.total.elevationGainText}}</view>
        <view class="ov-label">爬升 m</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{overview.total.caloriesText}}</view>
        <view class="ov-label">千卡</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{overview.total.activeDays}}</view>
        <view class="ov-label">活跃天数</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{typeCount}}</view>
        <view class="ov-label">运动类型</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{provinceCount === null ? '—' : provinceCount}}</view>
        <view class="ov-label">点亮省份</view>
      </view>
    </view>
  </view>

  <!-- 运动日历：连续天数 + 全站分位 + 月历（原「坚持与排名」卡） -->
  <view class="card">
    <view class="section-title">运动日历</view>
    <view class="streak-row">
      <view class="streak-item">
        <view class="streak-num">{{overview.total.streakCurrent}}</view>
        <view class="streak-label">当前连续天数</view>
      </view>
      <view class="streak-item">
        <view class="streak-num">{{overview.total.streakLongest}}</view>
        <view class="streak-label">最长连续天数</view>
      </view>
      <view class="streak-item" wx:if="{{percentile}}">
        <view class="streak-num">{{percentile.percentile}}%</view>
        <view class="streak-label">累计距离超越迹路者</view>
      </view>
    </view>

    <!-- 运动日历：近 365 天数据摊成月历，有运动的天打勾；只换月份不重新请求 -->
    <view class="cal-head">
      <view
        class="cal-arrow {{calPrevDisabled ? 'cal-arrow-off' : ''}}"
        hover-class="cal-arrow-hover"
        hover-stay-time="80"
        bindtap="onCalPrev"
      >‹</view>
      <view class="cal-title">{{calTitle}}</view>
      <view
        class="cal-arrow {{calNextDisabled ? 'cal-arrow-off' : ''}}"
        hover-class="cal-arrow-hover"
        hover-stay-time="80"
        bindtap="onCalNext"
      >›</view>
    </view>
    <view class="cal-week cal-week-head">
      <text class="cal-weekday" wx:for="{{calWeekdays}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="cal-week" wx:for="{{calWeeks}}" wx:key="index" wx:for-item="week">
      <view class="cal-cell" wx:for="{{week}}" wx:key="index" wx:for-item="cell">
        <view class="cal-day {{cell.inMonth ? '' : 'cal-day-out'}} {{cell.isToday ? 'cal-day-today' : ''}}">{{cell.day}}</view>
        <view wx:if="{{cell.hasActivity}}" class="cal-check cal-check-on {{cell.inMonth ? '' : 'cal-check-out'}}">✓</view>
        <view wx:else class="cal-check"></view>
      </view>
    </view>
    <view class="cal-caption">{{calCaption}}</view>
  </view>

  <!-- 模板广告位（后台「广告管理」可开关；持免广告卡时不渲染） -->
  <ad-template adslot="stats" />

  <!-- 运动趋势：五张变化卡（近 30 天 vs 前 30 天），点卡开半屏看柱状图 -->
  <view class="card" wx:if="{{metricCards.length}}">
    <view class="section-title-row">
      <view class="section-title">运动趋势</view>
      <view class="trend-sub">近 30 天 vs 前 30 天</view>
    </view>
    <!-- 今日/本周/本月快照：原来是独立一张卡，占一整行高度，合进趋势卡省一块留白 -->
    <view class="period-row">
      <view class="period-item metric-card">
        <view class="metric-badge">
          <image wx:if="{{compare.week.arrowIcon}}" class="metric-badge-icon" src="{{compare.week.arrowIcon}}" mode="aspectFit" />
        </view>
        <view class="metric-body">
          <text class="metric-label">本周</text>
          <view class="metric-value-line">
            <text class="metric-value">{{overview.week.distanceKm}}</text><text class="metric-unit">km</text>
          </view>
          <view class="metric-foot metric-diff-{{compare.week.cls}}" wx:if="{{compare.week}}">{{compare.week.diffText}}</view>
        </view>
      </view>
      <view class="period-item metric-card">
        <view class="metric-badge">
          <image wx:if="{{compare.month.arrowIcon}}" class="metric-badge-icon" src="{{compare.month.arrowIcon}}" mode="aspectFit" />
        </view>
        <view class="metric-body">
          <text class="metric-label">本月</text>
          <view class="metric-value-line">
            <text class="metric-value">{{overview.month.distanceKm}}</text><text class="metric-unit">km</text>
          </view>
          <view class="metric-foot metric-diff-{{compare.month.cls}}" wx:if="{{compare.month}}">{{compare.month.diffText}}</view>
        </view>
      </view>
    </view>

    <view class="metric-grid">
      <view
        class="metric-card"
        hover-class="metric-card-hover"
        hover-stay-time="80"
        wx:for="{{metricCards}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="openTrendSheet"
      >
        <!-- 左列＝圆圈图标（垂直居中），右侧三行左对齐：名目 / 数值+单位 / 涨跌 -->
        <view class="metric-badge">
          <image wx:if="{{item.arrowIcon}}" class="metric-badge-icon" src="{{item.arrowIcon}}" mode="aspectFit" />
        </view>
        <view class="metric-body">
          <text class="metric-label">{{item.label}}</text>
          <view class="metric-value-line">
            <text class="metric-value">{{item.value}}</text><text class="metric-unit">{{item.unit}}</text>
          </view>
          <view class="metric-foot metric-diff-{{item.dir}}">{{item.diffText ? '较前 30 天 ' + item.diffText : '暂无对比'}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 里程碑奖杯墙：1K/5K/10K/半马/全马，未达成置灰 -->
  <view class="card" wx:if="{{trophies.length}}">
    <view class="section-title-row">
      <view class="section-title">里程碑奖杯</view>
      <view class="more-link" hover-class="more-link-hover" hover-stay-time="80" data-type="trophy" bindtap="openSheet">
        <text>查看更多</text>
        <text class="more-arrow">›</text>
      </view>
    </view>
    <view class="trophy-grid">
      <view
        class="trophy-item {{item.unlocked ? '' : 'trophy-locked'}}"
        hover-class="{{item.unlocked ? 'trophy-hover' : ''}}"
        hover-stay-time="80"
        wx:for="{{trophies}}"
        wx:key="key"
        data-id="{{item.id}}"
        bindtap="goTrack"
      >
        <view class="trophy-badge" wx:if="{{item.unlocked}}">
          <image wx:if="{{item.icon}}" class="trophy-icon" src="{{item.icon}}" mode="aspectFit" />
          <text wx:else class="trophy-check">✓</text>
        </view>
        <view class="trophy-badge trophy-badge-locked" wx:else>
          <text class="trophy-lock">—</text>
        </view>
        <text class="trophy-label">{{item.label}}</text>
        <text class="trophy-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- 最佳记录：横滑卡片（穗枝环住类型图标 + 名称 + 数值），距离PB在前、其后按类型列指标 -->
  <view class="card" wx:if="{{best && best.bestCards.length}}">
    <view class="section-title-row">
      <view class="section-title">最佳记录</view>
      <view class="more-link" hover-class="more-link-hover" hover-stay-time="80" data-type="best" bindtap="openSheet">
        <text>查看更多</text>
        <text class="more-arrow">›</text>
      </view>
    </view>
    <scroll-view class="best-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="best-cards">
        <view class="best-card" hover-class="best-card-hover" hover-stay-time="80" data-id="{{item.id}}" bindtap="goTrack" wx:for="{{best.bestCards}}" wx:key="key">
          <view class="bc-badge">
            <view class="laurel-ear bc-ear"></view>
            <image class="bc-icon" src="{{item.icon}}" mode="aspectFit" />
            <view class="laurel-ear bc-ear laurel-ear-r"></view>
          </view>
          <text class="bc-label">{{item.label}}</text>
          <text class="bc-value">{{item.value}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 分类型汇总（全站累计：各类型总距离/总时长/次数） -->
  <view class="card" wx:if="{{typeSummary.length > 0}}">
    <view class="section-title">累计分类型汇总</view>
    <view class="best-table">
      <view class="bt-head">
        <view class="bt-th bt-col-type">类型</view>
        <view class="bt-th">总距离 km</view>
        <view class="bt-th">总时长</view>
        <view class="bt-th">次数</view>
      </view>
      <view class="bt-row" wx:for="{{typeSummary}}" wx:key="type">
        <view class="bt-td bt-col-type">
          <image class="bt-icon" src="{{item.typeIcon}}" mode="aspectFit" />
          <text class="bt-type-label">{{item.typeLabel}}</text>
        </view>
        <view class="bt-td">{{item.distanceKm}}</view>
        <view class="bt-td">{{item.durationText}}</view>
        <view class="bt-td">{{item.count}}</view>
      </view>
    </view>
  </view>

  <!-- 点亮地图 + 点亮城市（分包组件，主包页面按异步化引用） -->
  <lit-map id="litMap" bind:loaded="onLitMapLoaded" />

  <!-- 互跳：轨迹热图（全年分布） -->
  <view class="card link-row" hover-class="card-hover" hover-stay-time="100" bindtap="goHeatmap">
    <view class="link-info">
      <view class="link-title">轨迹热图</view>
      <view class="link-sub">全年运动分布 · 聚合轨迹图</view>
    </view>
    <view class="link-arrow">›</view>
  </view>

  <!-- 互跳：运动报告（单周期深挖 + 海报） -->
  <view class="card link-row" hover-class="card-hover" hover-stay-time="100" bindtap="goReport">
    <view class="link-info">
      <view class="link-title">运动报告</view>
      <view class="link-sub">周/月/年周期汇总 · 环比 · 海报</view>
    </view>
    <view class="link-arrow">›</view>
  </view>

  <!-- 半屏弹窗：全部纪录 / 奖杯详情（宫格） -->
  <view wx:if="{{sheetVisible}}" class="sheet-mask" catchtouchmove="noop" bindtap="closeSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">{{sheetType === 'trend' ? sheetTrend.title : (sheetType === 'trophy' ? '里程碑奖杯' : '全部纪录')}}</view>
        <view class="sheet-close" catchtap="closeSheet">✕</view>
      </view>

      <scroll-view scroll-y class="sheet-body" enhanced show-scrollbar="{{false}}">
        <!-- 运动趋势详情：维度 + 运动类型筛选 + 柱状图（配速低于 5km 的空桶已被跳过） -->
        <view wx:if="{{sheetType === 'trend'}}">
          <view class="days-toggle sheet-days">
            <view
              wx:for="{{trendTypes}}"
              wx:key="value"
              class="day-btn {{trendType === item.value ? 'day-btn-active' : ''}}"
              data-value="{{item.value}}"
              bindtap="onTrendTypeChange"
            >{{item.label}}</view>
          </view>
          <scroll-view class="type-chips" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{trendActivityTypes.length > 1}}">
            <view class="type-chip-list">
              <view
                wx:for="{{trendActivityTypes}}"
                wx:key="value"
                class="type-chip {{trendActivityType === item.value ? 'type-chip-active' : ''}}"
                data-value="{{item.value}}"
                bindtap="onTrendActivityChange"
              >{{item.label}}</view>
            </view>
          </scroll-view>
          <stat-chart data="{{sheetTrend.data}}" type="bar" unit="{{sheetTrend.unit}}" height="{{240}}" empty-text="暂无运动数据" />
          <view class="sheet-trend-note" wx:if="{{sheetTrend.note}}">{{sheetTrend.note}}</view>
        </view>

        <!-- 最佳记录：全部卡片两列宫格（图标 + 名称 + 数值 + 运动类型） -->
        <view wx:if="{{sheetType === 'best'}}" class="record-grid">
          <view
            class="record-cell"
            hover-class="record-cell-hover"
            hover-stay-time="80"
            wx:for="{{best.bestCards}}"
            wx:key="key"
            data-id="{{item.id}}"
            bindtap="onSheetTrack"
          >
            <image wx:if="{{item.icon}}" class="record-icon" src="{{item.icon}}" mode="aspectFit" />
            <view class="record-info">
              <view class="record-label">{{item.label}}</view>
              <view class="record-value">{{item.value}}</view>
              <view class="record-type" wx:if="{{item.typeLabel || item.heldText}}">{{item.typeLabel}}<text wx:if="{{item.heldText}}"> · {{item.heldText}}</text></view>
            </view>
          </view>
        </view>

        <!-- 奖杯：达成详情（类型 / 日期 / 保持天数）+ 未解锁要求 -->
        <view wx:if="{{sheetType === 'trophy'}}" class="trophy-sheet-grid">
          <view
            class="trophy-sheet-card {{item.unlocked ? '' : 'trophy-sheet-locked'}}"
            hover-class="{{item.unlocked ? 'record-cell-hover' : ''}}"
            hover-stay-time="80"
            wx:for="{{trophies}}"
            wx:key="key"
            data-id="{{item.id}}"
            bindtap="onSheetTrack"
          >
            <view class="ts-head">
              <view class="trophy-badge ts-badge" wx:if="{{item.unlocked}}">
                <image wx:if="{{item.icon}}" class="ts-icon" src="{{item.icon}}" mode="aspectFit" />
                <text wx:else class="trophy-check">✓</text>
              </view>
              <view class="trophy-badge trophy-badge-locked ts-badge" wx:else>
                <text class="trophy-lock">—</text>
              </view>
              <view class="ts-info">
                <view class="ts-title">{{item.label}}</view>
                <view class="ts-value">{{item.value}}</view>
              </view>
            </view>
            <block wx:if="{{item.unlocked}}">
              <view class="ts-meta">{{item.typeLabel}} · {{item.dateText}}</view>
              <view class="ts-meta">{{item.heldText}}</view>
            </block>
            <view class="ts-meta ts-lock" wx:else>{{item.requirementText}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
