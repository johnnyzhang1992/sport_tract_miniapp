<view class="container" wx:if="{{overview}}">
  <!-- 累计概览 -->
  <view class="card">
    <view class="section-title">累计</view>
    <view class="overview-grid">
      <view class="ov-item">
        <view class="ov-num">{{overview.total.distanceKm}}</view>
        <view class="ov-label">公里</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{overview.total.durationText}}</view>
        <view class="ov-label">时长</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{overview.total.count}}</view>
        <view class="ov-label">次数</view>
      </view>
      <view class="ov-item">
        <view class="ov-num">{{overview.total.elevationGain}}</view>
        <view class="ov-label">爬升 m</view>
      </view>
    </view>
  </view>

  <!-- 周期明细 -->
  <view class="card">
    <view class="period-row">
      <view class="period-item">
        <view class="period-num">{{overview.today.distanceKm}}</view>
        <view class="period-label">今日 km</view>
      </view>
      <view class="period-item">
        <view class="period-num">{{overview.week.distanceKm}}</view>
        <view class="period-label">本周 km</view>
      </view>
      <view class="period-item">
        <view class="period-num">{{overview.month.distanceKm}}</view>
        <view class="period-label">本月 km</view>
      </view>
    </view>
  </view>

  <!-- 个人最佳纪录 -->
  <view class="card" wx:if="{{best}}">
    <view class="section-title">个人最佳</view>
    <view class="best-grid">
      <view class="best-item">
        <view class="best-value">{{best.maxDistance.value}}</view>
        <view class="best-label">最远距离 km</view>
        <view class="best-date" wx:if="{{best.maxDistance.date}}">{{best.maxDistance.date}}</view>
      </view>
      <view class="best-item">
        <view class="best-value">{{best.minPace.value}}</view>
        <view class="best-label">最快配速</view>
        <view class="best-date" wx:if="{{best.minPace.date}}">{{best.minPace.date}}</view>
      </view>
      <view class="best-item">
        <view class="best-value">{{best.maxDuration.value}}</view>
        <view class="best-label">最长时长</view>
        <view class="best-date" wx:if="{{best.maxDuration.date}}">{{best.maxDuration.date}}</view>
      </view>
      <view class="best-item">
        <view class="best-value">{{best.maxElevation.value}}</view>
        <view class="best-label">最大爬升</view>
        <view class="best-date" wx:if="{{best.maxElevation.date}}">{{best.maxElevation.date}}</view>
      </view>
    </view>
  </view>

  <!-- 运动报告入口（独立报告页） -->
  <view class="card link-row" bindtap="goReport" hover-class="report-hover">
    <view class="switch-info">
      <view class="switch-title">运动报告</view>
      <view class="text-muted">周/月/年运动汇总 · 个人最佳 · 轨迹记录</view>
    </view>
    <view class="link-arrow">›</view>
  </view>

  <!-- 趋势柱状图 -->
  <view class="card">
    <view class="chart-head">
      <view class="section-title">距离趋势（公里）</view>
      <view class="days-toggle">
        <view class="day-btn {{days === 7 ? 'day-btn-active' : ''}}" data-days="7" bindtap="onDaysChange">7天</view>
        <view class="day-btn {{days === 30 ? 'day-btn-active' : ''}}" data-days="30" bindtap="onDaysChange">30天</view>
      </view>
    </view>
    <stat-chart data="{{chartData}}" type="bar" unit="km" height="{{230}}" empty-text="暂无运动数据" />
  </view>
</view>
