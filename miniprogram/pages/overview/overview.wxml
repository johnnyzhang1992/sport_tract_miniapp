<view class="overview-page">
  <!-- 地图铺满整屏；浮层按钮都挂在地图宿主之上 -->
  <view class="map-wrap">
    <track-map
      id="overviewMap"
      class="overview-map"
      mode="overview"
      overviewTracks="{{tracks}}"
      heat="{{heat}}"
      mapType="{{mapType}}"
      showHeatLegend
    />
    <!-- 右上角一排：筛选 + 图层（有筛选时蓝环点亮 + 显示条件摘要，与足迹页筛选按钮同一套口径） -->
    <view class="top-tools">
      <view class="filter-btn {{filtered ? 'filter-btn-on' : ''}}" bindtap="openFilter">
        <image class="btn-icon" src="/assets/icons/lucide-sliders-horizontal.png" mode="aspectFit" />
        <text>{{filtered ? filterText : '筛选'}}</text>
      </view>
      <view class="layer-btn" bindtap="switchLayer">
        <image class="btn-icon" src="{{mapType === 'standard' ? '/assets/icons/lucide-satellite.png' : '/assets/icons/lucide-map.png'}}" mode="aspectFit" />
        <text>{{mapType === 'standard' ? '卫星' : '标准'}}</text>
      </view>
    </view>
    <!-- 分享：右下角，组件内「标注」按钮左侧（与标注同款纯图标胶囊） -->
    <view class="share-btn" bindtap="openShare">
      <image class="share-btn-icon" src="/assets/icons/lucide-share.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 提示做成居中浮层（白底衬）：地图没有页内留白，直接压在底图上会糊成一片 -->
  <view wx:if="{{loading}}" class="page-tip">加载中…</view>
  <view wx:elif="{{tracks.length === 0}}" class="page-tip">{{filtered ? '该条件下还没有运动记录' : '该时间段还没有运动记录'}}</view>

  <!-- 筛选半屏（时间 / 省份） -->
  <track-filter-sheet
    id="trackFilterSheet"
    visible="{{filterVisible}}"
    value="{{filter}}"
    options="{{filterOptions}}"
    bind:confirm="onFilterConfirm"
    bind:close="closeFilter"
  />

  <!-- 分享弹窗 -->
  <view class="share-mask" wx:if="{{shareVisible}}">
    <view class="share-box">
      <view class="share-head">
        <text class="share-title">{{shareTitle}}</text>
        <view class="share-close" bindtap="closeShare"><image class="close-icon" src="/assets/icons/lucide-x.png" mode="aspectFit" /></view>
      </view>
      <scroll-view scroll-y class="share-scroll" enhanced show-scrollbar="{{false}}">
        <canvas type="2d" id="sharePoster" class="share-canvas" style="width: 300px; height: {{shareCanvasH}}px;"></canvas>
      </scroll-view>
      <view class="share-foot">
        <view class="share-foot-row">
          <view class="share-mode-row">
            <view class="share-mode-btn {{shareMode === 'grid' ? 'share-mode-active' : ''}}" bindtap="toggleShareMode" data-mode="grid">网格</view>
            <view class="share-mode-btn {{shareMode === 'aggregate' ? 'share-mode-active' : ''}}" bindtap="toggleShareMode" data-mode="aggregate">聚合</view>
          </view>
          <view class="share-toggle" wx:if="{{shareMode === 'grid'}}" bindtap="toggleShareTime">{{shareShowTime ? '隐藏时间' : '显示时间'}}</view>
        </view>
        <button class="share-save" bindtap="saveShare">保存图片</button>
      </view>
    </view>
  </view>
</view>
