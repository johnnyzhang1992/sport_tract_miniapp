<view class="overview-page">
  <!-- 范围切换 -->
  <view class="range-tabs">
    <view
      wx:for="{{ranges}}"
      wx:key="value"
      class="range-item {{activeRange === item.value ? 'range-item-active' : ''}}"
      data-value="{{item.value}}"
      bindtap="onRangeChange"
    >{{item.label}}</view>
  </view>

  <!-- 聚合统计 -->
  <view class="stats-card">
    <view class="stat-block">
      <view class="stat-value">{{data.count}}</view>
      <view class="stat-label">次数</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-block">
      <view class="stat-value">{{data.totalDistanceKm}}</view>
      <view class="stat-label">公里</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-block">
      <view class="stat-value">{{data.durationNum}}</view>
      <view class="stat-label">{{data.durationUnit}}</view>
    </view>
  </view>

  <!-- 地图（多轨迹 + 热力） -->
  <view class="map-wrap">
    <track-map
      id="overviewMap"
      class="overview-map"
      style="width: 100%; height: 600rpx;"
      mode="overview"
      overviewTracks="{{tracks}}"
      heat="{{heat}}"
      mapType="{{mapType}}"
      showHeatLegend
    />
    <view class="layer-btn" bindtap="switchLayer">
      <image class="btn-icon" src="{{mapType === 'standard' ? '/assets/icons/lucide-satellite.png' : '/assets/icons/lucide-map.png'}}" mode="aspectFit" />
      <text>{{mapType === 'standard' ? '卫星' : '标准'}}</text>
    </view>
    <view class="fullscreen-btn" bindtap="openFullscreen"><image class="btn-icon" src="/assets/icons/lucide-maximize.png" mode="aspectFit" /><text>全屏</text></view>
  </view>

  <!-- 全屏地图弹窗（不拦截 touch：map 手势需要 touchmove） -->
  <view class="fullscreen-mask" wx:if="{{fullscreen}}">
    <view class="fullscreen-close" bindtap="closeFullscreen"><image class="close-icon" src="/assets/icons/lucide-x.png" mode="aspectFit" /></view>
    <view class="fullscreen-layer" bindtap="fsSwitchLayer">
      <image class="btn-icon" src="{{mapType === 'standard' ? '/assets/icons/lucide-satellite.png' : '/assets/icons/lucide-map.png'}}" mode="aspectFit" />
      <text>{{mapType === 'standard' ? '卫星' : '标准'}}</text>
    </view>
    <view class="fullscreen-map-wrap">
      <track-map
        id="fsOverviewMap"
        class="overview-map"
        mode="overview"
        overviewTracks="{{tracks}}"
        heat="{{heat}}"
        mapType="{{mapType}}"
        poi-top-right
        />
    </view>
  </view>

  <!-- 最近轨迹 -->
  <view class="recent-title" wx:if="{{recentTracks.length > 0}}">最近轨迹</view>
  <view
    wx:for="{{recentTracks}}"
    wx:key="id"
    class="recent-item"
    hover-class="recent-hover"
    data-id="{{item.id}}"
    bindtap="onTapTrack"
  >
    <image class="recent-icon" src="{{item.iconImg}}" mode="aspectFit"></image>
    <view class="recent-info">
      <view class="recent-name">{{item.label}} · {{item.timeText}}</view>
      <view class="recent-meta">{{item.distanceKm}} 公里 · {{item.durationText}}</view>
    </view>
    <view class="recent-arrow">›</view>
  </view>

  <view wx:if="{{loading}}" class="loading-tip">加载中…</view>
  <view wx:if="{{!loading && data.count === 0}}" class="loading-tip">该时间段还没有运动记录</view>
</view>
