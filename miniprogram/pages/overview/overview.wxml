<view class="overview-page">
  <!-- 范围切换 -->
  <view class="range-tabs">
    <view
      wx:for="{{ranges}}"
      wx:key="value"
      class="range-item {{activeRange === item.value ? 'range-item-active' : ''}}"
      data-value="{{item.value}}"
      bindtap="onRangeChange"
    >{{item.label}}</view>
  </view>

  <!-- 聚合统计 -->
  <view class="stats-card">
    <view class="stat-block">
      <view class="stat-value">{{data.count}}</view>
      <view class="stat-label">次数</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-block">
      <view class="stat-value">{{data.totalDistanceKm}}</view>
      <view class="stat-label">公里</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-block">
      <view class="stat-value">{{data.durationNum}}</view>
      <view class="stat-label">{{data.durationUnit}}</view>
    </view>
  </view>

  <!-- 地图（多轨迹 + 热力） -->
  <view class="map-wrap">
    <track-map
      id="overviewMap"
      class="overview-map"
      style="width: 100%; height: 600rpx;"
      mode="overview"
      overviewTracks="{{tracks}}"
      heat="{{heat}}"
      mapType="{{mapType}}"
      showHeatLegend
      show-fullscreen
      bindfullscreen="openFullscreen"
    />
    <view class="layer-btn" bindtap="switchLayer">
      <image class="btn-icon" src="{{mapType === 'standard' ? '/assets/icons/lucide-satellite.png' : '/assets/icons/lucide-map.png'}}" mode="aspectFit" />
      <text>{{mapType === 'standard' ? '卫星' : '标准'}}</text>
    </view>
  </view>

  <!-- 全屏地图弹窗（不拦截 touch：map 手势需要 touchmove） -->
  <view class="fullscreen-mask" wx:if="{{fullscreen}}">
    <view class="fullscreen-layer" bindtap="fsSwitchLayer">
      <image class="btn-icon" src="{{mapType === 'standard' ? '/assets/icons/lucide-satellite.png' : '/assets/icons/lucide-map.png'}}" mode="aspectFit" />
      <text>{{mapType === 'standard' ? '卫星' : '标准'}}</text>
    </view>
    <view class="fullscreen-map-wrap">
      <track-map
        id="fsOverviewMap"
        class="overview-map"
        mode="overview"
        overviewTracks="{{tracks}}"
        heat="{{heat}}"
        mapType="{{mapType}}"
        poi-top-right
        show-fullscreen-close
        bind:close-fullscreen="closeFullscreen"
        />
    </view>
  </view>

  <!-- 最近轨迹（轨迹卡片样式，参照我的轨迹列表） -->
  <view class="recent-head" wx:if="{{recentTracks.length > 0}}">
    <view class="recent-title">最近轨迹</view>
    <view class="share-btn" bindtap="openShare">
      <image class="share-btn-icon" src="/assets/icons/lucide-share.png" mode="aspectFit" />
      <text>分享</text>
    </view>
  </view>
  <view class="recent-grid">
    <view
      wx:for="{{visibleRecent}}"
      wx:key="id"
      class="recent-card"
      hover-class="recent-hover"
      data-id="{{item.id}}"
      bindtap="onTapTrack"
    >
      <track-thumb class="recent-thumb" points="{{item.previewPoints}}" color="{{item.color}}" />
      <view class="recent-body">
        <view class="recent-head-row">
          <image class="recent-icon" src="{{item.iconImg}}" mode="aspectFit"></image>
          <text class="recent-type">{{item.label}}</text>
          <text class="recent-duration">{{item.durationText}}</text>
        </view>
        <view class="recent-foot-row">
          <text class="recent-dist">{{item.distanceKm}}公里</text>
          <text class="recent-time">{{item.timeText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && visibleRecent.length < recentTracks.length}}" class="loading-tip">上拉加载更多</view>
  <view wx:if="{{loading}}" class="loading-tip">加载中…</view>
  <view wx:if="{{!loading && data.count === 0}}" class="loading-tip">该时间段还没有运动记录</view>

  <!-- 分享弹窗 -->
  <view class="share-mask" wx:if="{{shareVisible}}" catchtouchmove="noop">
    <view class="share-box">
      <view class="share-head">
        <text class="share-title">{{shareTitle}}</text>
        <view class="share-close" bindtap="closeShare"><image class="close-icon" src="/assets/icons/lucide-x.png" mode="aspectFit" /></view>
      </view>
      <scroll-view scroll-y class="share-scroll" enhanced show-scrollbar="{{false}}">
        <canvas type="2d" id="sharePoster" class="share-canvas" style="width: 300px; height: {{shareCanvasH}}px;"></canvas>
      </scroll-view>
      <view class="share-foot">
        <view class="share-foot-row">
          <view class="share-mode-row">
            <view class="share-mode-btn {{shareMode === 'grid' ? 'share-mode-active' : ''}}" bindtap="toggleShareMode" data-mode="grid">网格</view>
            <view class="share-mode-btn {{shareMode === 'aggregate' ? 'share-mode-active' : ''}}" bindtap="toggleShareMode" data-mode="aggregate">聚合</view>
          </view>
          <view class="share-toggle" wx:if="{{shareMode === 'grid'}}" bindtap="toggleShareTime">{{shareShowTime ? '隐藏时间' : '显示时间'}}</view>
        </view>
        <button class="share-save" bindtap="saveShare">保存图片</button>
      </view>
    </view>
  </view>
</view>
