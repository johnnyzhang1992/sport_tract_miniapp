/* 整屏地图：页面本身不留白，浮层按钮与提示都挂在地图上（改版前上下还有时间档与数据概况两块） */
.overview-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
}
.map-wrap {
  position: absolute;
  inset: 0;
}
/* 地图宿主：绝对定位铺满 map-wrap（组件宿主的百分比高度在 flex 项里不生效，只能靠定位撑满） */
.overview-map {
  position: absolute;
  inset: 0;
}
.btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.close-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 左上角筛选：白底胶囊（页面右列同款规格）；点亮沿用足迹页「蓝环 + 蓝字」口径，
   图标是黑色字形资产，蓝底会把字吃没，所以只加环不换底 */
.filter-btn {
  position: absolute;
  top: 16rpx;
  left: 24rpx;
  max-width: 60%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  z-index: 2;
  display: flex;
  align-items: center;
}
.filter-btn text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.filter-btn-on {
  color: #2b6cf6;
  font-weight: 600;
  box-shadow: 0 0 0 3rpx #2b6cf6, 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
.layer-btn {
  position: absolute;
  top: 16rpx;
  right: 24rpx; /* 右上角（真机指南针在左侧） */
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  z-index: 2;
  display: flex;
  align-items: center;
}

/* 地图浮层提示：居中 + 白底衬，压在底图上也能看清 */
.page-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  color: #4e5969;
  font-size: 26rpx;
  z-index: 2;
}

/* 地图浮层：分享（纯图标胶囊，与组件内标注按钮同款；位于「标注」左侧，right 24 + 宽 48 + 间距 16） */
.share-btn {
  position: absolute;
  bottom: calc(64rpx + env(safe-area-inset-bottom)); /* 抬到地图自带比例尺（左下）之上，并避开 Home 指示条 */
  right: 88rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
.share-btn-icon {
  width: 26rpx;
  height: 26rpx;
}

/* 分享弹窗 */
.share-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-box {
  width: 86%;
  max-height: 92vh; /* 仅做安全上限，不写死高度：高度随内容自适应 */
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.share-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}
.share-title {
  font-size: 30rpx;
  font-weight: 600;
}
.share-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
}
.close-icon {
  width: 28rpx;
  height: 28rpx;
}
.share-scroll {
  height: 400px; /* 固定高度：内容超出时在滚动容器内滚动 */
  min-height: 0;
}
.share-canvas {
  display: block;
  margin: 0 auto;
}
.share-foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #f0f2f5;
}
.share-foot-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
}
.share-toggle {
  font-size: 26rpx;
  color: #2b6cf6;
  padding: 12rpx 24rpx;
  background: #eef4ff;
  border-radius: 999rpx;
}
.share-mode-row {
  display: flex;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 4rpx;
}
.share-mode-btn {
  font-size: 24rpx;
  color: #8a93a6;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  transition: all 0.2s;
}
.share-mode-active {
  background: #fff;
  color: #2b6cf6;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
.share-save {
  font-size: 26rpx;
  background: #2b6cf6;
  color: #fff;
  border-radius: 999rpx;
  padding: 12rpx 40rpx;
  line-height: 1.6;
  border: none;
}
.share-save::after {
  border: none;
}
