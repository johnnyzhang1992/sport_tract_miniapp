.overview-page {
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
}
.range-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}
.range-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #4e5969;
  border-radius: 12rpx;
}
.range-item-active {
  background: #2b6cf6;
  color: #fff;
  font-weight: 600;
}

.stats-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.stat-block {
  flex: 1;
  text-align: center;
}
.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
}
.stat-label {
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 6rpx;
}
.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #e5e6eb;
}

.map-wrap {
  position: relative;
  height: 640rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 0; /* 去掉底部间距 */
}
.overview-map {
  width: 100%;
  height: 100%;
  display: block;
}
.btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.close-icon {
  width: 36rpx;
  height: 36rpx;
}
.layer-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  z-index: 2;
  display: flex;
  align-items: center;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 14rpx;
}
/* 最近轨迹卡片（2 列网格，参照我的轨迹列表） */
.recent-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.recent-card {
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.recent-thumb {
  width: 100%;
  height: 150rpx;
  display: block;
}
.recent-body {
  padding: 14rpx 18rpx 18rpx;
}
.recent-head-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.recent-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.recent-type {
  font-size: 24rpx;
  font-weight: 500;
  color: #1f2329;
  margin-right: auto;
}
.recent-duration {
  font-size: 22rpx;
  color: #8a93a6;
  flex-shrink: 0;
}
.recent-foot-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.recent-dist {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.recent-time {
  font-size: 22rpx;
  color: #8a93a6;
}
.recent-hover {
  opacity: 0.7;
}
.recent-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}
.recent-info {
  flex: 1;
  min-width: 0;
}
.recent-name {
  font-size: 28rpx;
  color: #1f2329;
  margin-bottom: 6rpx;
}
.recent-meta {
  font-size: 24rpx;
  color: #8a93a6;
}
.recent-arrow {
  font-size: 36rpx;
  color: #c2c7d0;
}
.loading-tip {
  text-align: center;
  padding: 32rpx 0;
  color: #8a93a6;
  font-size: 24rpx;
}

/* 全屏地图弹窗 */
.fullscreen-btn {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  z-index: 2;
  display: flex;
  align-items: center;
}
.fullscreen-mask {
  position: fixed;
  inset: 0;
  background: #000;
  z-index: 10000;
}
.fullscreen-map-wrap {
  position: absolute;
  inset: 0;
}
.fullscreen-map-wrap .overview-map {
  width: 100%;
  height: 100%;
  display: block;
}
.fullscreen-close {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  left: 24rpx;
  z-index: 1001;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: #1f2329;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.fullscreen-layer {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  right: 24rpx;
  z-index: 1001;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}
.traffic-btn {
  position: absolute;
  top: 96rpx;
  right: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
  z-index: 2;
  color: #4e5969;
}
.traffic-btn-active {
  background: #2b6cf6;
  color: #fff;
}

.recent-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

/* 最近轨迹行 + 分享按钮 */
.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.share-btn {
  display: flex;
  align-items: center;
  background: #eef4ff;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  color: #2b6cf6;
  font-size: 24rpx;
}
.share-btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

/* 分享弹窗 */
.share-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-box {
  width: 86%;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.share-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}
.share-title {
  font-size: 30rpx;
  font-weight: 600;
}
.share-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
}
.close-icon {
  width: 28rpx;
  height: 28rpx;
}
.share-scroll {
  flex: 1;
  min-height: 0;
  max-height: 58vh; /* 限制滚动区高度，海报超高时在组件内纵向滚动 */
}
.share-canvas {
  display: block;
  margin: 0 auto;
}
.share-foot {
  display: flex;
  align-items: center;
  justify-content: center; /* 两个按钮水平居中 */
  gap: 24rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #f0f2f5;
}
.share-toggle {
  font-size: 26rpx;
  color: #2b6cf6;
  padding: 12rpx 24rpx;
  background: #eef4ff;
  border-radius: 999rpx;
}
.share-save {
  font-size: 26rpx;
  background: #2b6cf6;
  color: #fff;
  border-radius: 999rpx;
  padding: 12rpx 40rpx;
  line-height: 1.6;
  border: none;
}
.share-save::after {
  border: none;
}
