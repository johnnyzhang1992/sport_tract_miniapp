.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f6f7fb;
}

.gate {
  padding: 120rpx 40rpx;
  text-align: center;
}
.gate-tip {
  color: #8a93a6;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}
.gate-btn {
  background: #2b6cf6;
  color: #fff;
}

.tip {
  text-align: center;
  color: #8a93a6;
  font-size: 28rpx;
  padding: 80rpx 0;
}
.tap {
  color: #2b6cf6;
}

.notice {
  background: #fff7e6;
  border: 1rpx solid #ffe7ba;
  color: #ad6800;
  font-size: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.card.order {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.row1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.name {
  font-size: 30rpx;
  font-weight: 600;
}
.status {
  font-size: 24rpx;
}
.s-created { color: #ff8a00; }
.s-paid { color: #2b6cf6; }
.s-delivered { color: #12b76a; }
.s-refunding { color: #ff8a00; }
.s-refunded { color: #8a93a6; }
.s-closed { color: #b6bcc8; }

.row2 {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}
.price {
  font-size: 32rpx;
  font-weight: 600;
}
.time {
  color: #8a93a6;
  font-size: 24rpx;
}
.period, .refunded {
  color: #5b6474;
  font-size: 24rpx;
  margin-top: 8rpx;
}
.refunded {
  color: #d54941;
}

.actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}
.act {
  margin: 0;
}
.act.primary {
  background: #2b6cf6;
  color: #fff;
}
.act.warn {
  background: #d54941;
  color: #fff;
}

.refund-panel {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef0f5;
}
.picker {
  background: #f6f7fb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #333;
}
.note {
  background: #f6f7fb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  margin: 16rpx 0;
}

.back-link {
  text-align: center;
  color: #2b6cf6;
  font-size: 26rpx;
  padding: 32rpx 0;
}
