/**
 * 微信步数排行榜：样式对齐运动榜（pages/leaderboard），只保留榜单部分
 * （无类型 chips / 本榜最佳 / 点亮地图）。行值列与「我的排名」沿用同一套骨架类。
 */
.page {
  min-height: 100vh;
  background: #f5f6f8;
  /* 底部留白 = 贴底「我的排名」栏高度，避免最后一行被遮挡 */
  padding: 20rpx 24rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.period-row {
  display: flex;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
}
.period-seg {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 25rpx;
  color: #4e5969;
  border-radius: 10rpx;
  transition: all 0.15s;
}
.period-seg.active {
  background: #fff;
  color: #2b6cf6;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 历史周期翻页 */
.period-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
}
.nav-btn {
  font-size: 26rpx;
  color: #2b6cf6;
  padding: 8rpx 12rpx;
}
.nav-btn.off {
  color: #c8ccd4;
}
.nav-text {
  font-size: 26rpx;
  color: #5b6474;
  font-weight: 500;
}

.province-picker {
  flex-shrink: 0;
}
/* 卡片头右侧：统计入口 + 省份选择 */
.head-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.stats-entry {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #2b6cf6;
  padding: 8rpx 4rpx;
}
.stats-entry-hover {
  opacity: 0.7;
}
.picker-value {
  font-size: 24rpx;
  color: #2b6cf6;
  background: #ecf2ff;
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
}

/* TOP50 列表：入榜人数少时不显拥挤留的下限。空态就在同一个容器里，共用这一条 */
.rank-list {
  min-height: 250rpx;
}
.rank-row {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.rank-row:last-of-type {
  border-bottom: none;
}
/* 榜单行可点开资料：轻灰反馈（与运动榜一致） */
.rank-row-hover {
  background: #fafbfc;
}
.rank-no {
  width: 56rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #667080;
  text-align: center;
  flex-shrink: 0;
}
.medal-img {
  width: 44rpx;
  height: 44rpx;
}
.rank-avatar-wrap {
  position: relative;
  flex: none;
  margin: 0 14rpx 0 6rpx;
}
.rank-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin: 0;
  flex-shrink: 0;
  background: #f2f3f5;
}
.rank-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: #64748f;
}
.rank-badge {
  width: 24rpx;
  height: 24rpx;
}
.rank-name-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.rank-name {
  font-size: 27rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gender-img {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}
.rank-dist {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}
.rank-empty {
  min-height: inherit;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #667080;
  font-size: 24rpx;
}
.players-line {
  padding: 12rpx 8rpx 0;
  font-size: 22rpx;
  color: #667080;
  text-align: right;
}

/* 游客轻提示条（榜单可看，仅提示登录后有"我的排名"） */
.guest-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #eaf1ff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}
.guest-tip-hover {
  opacity: 0.7;
}
.guest-tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #1a56d6;
}
.guest-tip-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a56d6;
}

/* 我的排名卡：通栏贴底（边缘 0），与边的距离用内边距体现 */
.me-card {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: linear-gradient(135deg, #2b6cf6, #5b8cff);
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 -6rpx 18rpx rgba(43, 108, 246, 0.22);
}
.me-medal {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}
.me-rank-no {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  min-width: 64rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}
.me-avatar-wrap {
  position: relative;
  flex: none;
}
.me-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.3);
}
.me-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: rgba(255, 255, 255, 0.28);
}
.me-badge {
  width: 28rpx;
  height: 28rpx;
}
.me-body {
  flex: 1;
  min-width: 0;
}
.me-name-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.me-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-card .gender-img {
  width: 30rpx;
  height: 30rpx;
}
.me-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 4rpx;
}
.me-stats {
  text-align: right;
  flex-shrink: 0;
}
.me-dist {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  font-variant-numeric: tabular-nums;
}
.me-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 4rpx;
}

/* 微信运动授权提示条：与游客提示同位置同形态，点击即引导 */
.auth-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 0 20rpx;
  padding: 20rpx 24rpx;
  background: #fff7e6;
  border: 1rpx solid #ffe7ba;
  border-radius: 16rpx;
}
.auth-tip-hover {
  background: #fff1d6;
}
.auth-tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #ad6800;
  line-height: 1.4;
}
.auth-tip-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #2b6cf6;
  font-weight: 500;
}
