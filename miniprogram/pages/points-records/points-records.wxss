.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 24rpx;
}

.state {
  padding: 160rpx 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a93a6;
}

.state-tap {
  color: #2b6cf6;
}

/* 顶部余额区与积分页同一套蓝渐变英雄区（points.wxss .balance-card），白字最浅处 4.59:1 */
.summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #1a56d6, #2b6cf6);
  padding: 40rpx 32rpx 72rpx;
}

.summary-label {
  font-size: 24rpx;
  color: #fff;
}

.summary-balance {
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  margin: -44rpx 24rpx 0;
  padding: 8rpx 24rpx;
}

/* 列表包裹层：让 .record-row:last-child 的末行去分隔线真正命中（底栏 .more/.empty 在包裹层外） */
.record-list {
  display: block;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.record-row:last-child {
  border-bottom: none;
}

.record-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.record-title {
  font-size: 28rpx;
  color: #1f2329;
}

.record-date {
  font-size: 22rpx;
  color: #8a93a6;
}

.record-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.record-delta {
  font-size: 30rpx;
  font-weight: 700;
}

.record-delta.positive {
  color: #8a5f12; /* 得分＝荣誉金（与积分页任务分值同色）；支出保留中性灰，不抢红的语义 */
}

.record-delta.negative {
  color: #667080;
}

.record-after {
  font-size: 22rpx;
  color: #8a93a6;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8a93a6;
}

.more {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #8a93a6;
}

.more-retry {
  color: #2b6cf6;
}
