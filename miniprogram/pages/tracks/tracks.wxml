<view class="container">
  <!-- 类型筛选（t-tabs） -->
  <t-tabs
    class="filter-tabs"
    sticky
    value="{{activeFilter}}"
    bind:change="onTabChange"
  >
    <t-tab-panel
      wx:for="{{filters}}"
      wx:key="type"
      label="{{item.label}}"
      value="{{item.type}}"
    />
  </t-tabs>

  <!-- 轨迹列表 -->
  <view wx:if="{{items.length === 0 && !loading}}">
    <view class="empty" wx:if="{{initialized}}">还没有运动记录，去开始第一次吧 🏃</view>
    <view class="empty" wx:else>加载中…</view>
  </view>

  <t-swipe-cell
    wx:for="{{items}}"
    wx:key="id"
    right="{{[{ text: '删除', className: 'del-action' }]}}"
    data-id="{{item.id}}"
    bind:click="onDeleteTap"
  >
    <view
      class="track-card"
      hover-class="track-card-hover"
      hover-stay-time="80"
      data-id="{{item.id}}"
      bindtap="onTapItem"
    >
      <image class="cell-icon" src="{{item.iconImg}}" mode="aspectFit"></image>
      <view class="track-info">
        <view class="track-type">{{item.label}}</view>
        <view class="track-meta">
          <text class="track-dist">{{item.distanceKm}} 公里</text>
          <text class="track-time">{{item.timeText}}</text>
        </view>
      </view>
      <track-thumb class="track-thumb" points="{{item.previewPoints}}" color="{{item.color}}" />
    </view>
  </t-swipe-cell>

  <view wx:if="{{loading}}" class="text-muted loading-tip">加载中…</view>
  <view wx:if="{{!hasMore && items.length > 0}}" class="text-muted loading-tip">没有更多了</view>
</view>
