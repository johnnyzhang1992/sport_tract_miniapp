<view class="container">
  <!-- 类型筛选（t-tabs） -->
  <t-tabs
    class="filter-tabs"
    sticky
    value="{{activeFilter}}"
    bind:change="onTabChange"
  >
    <t-tab-panel
      wx:for="{{filters}}"
      wx:key="type"
      label="{{item.label}}"
      value="{{item.type}}"
    />
  </t-tabs>

  <!-- 省份筛选条（足迹地图跳转带入） -->
  <view class="province-bar" wx:if="{{provinceFilter}}">
    <text class="province-bar-text">📍 {{provinceFilter}}</text>
    <view class="province-bar-close" hover-class="province-bar-close-hover" bindtap="clearProvince">✕</view>
  </view>

  <!-- 展示模式切换：列表（text-align-justify）/ 图片（layout-grid） -->
  <view class="mode-bar">
    <text class="mode-bar-title">轨迹列表</text>
    <view class="mode-btns">
    <view
      class="mode-btn {{viewMode === 'list' ? 'mode-btn-active' : 'mode-btn-dim'}}"
      hover-class="mode-btn-hover"
      data-mode="list"
      bindtap="onToggleMode"
    >
      <image class="mode-icon" src="/assets/icons/lucide-text-align-justify.png" mode="aspectFit" />
    </view>
    <view
      class="mode-btn {{viewMode === 'grid' ? 'mode-btn-active' : 'mode-btn-dim'}}"
      hover-class="mode-btn-hover"
      data-mode="grid"
      bindtap="onToggleMode"
    >
      <image class="mode-icon" src="/assets/icons/lucide-layout-grid.png" mode="aspectFit" />
    </view>
    </view>
  </view>

  <!-- 轨迹列表 -->
  <view wx:if="{{items.length === 0 && !loading}}">
    <view class="empty" wx:if="{{initialized}}">还没有运动记录，去开始第一次吧</view>
    <view class="empty" wx:else>加载中…</view>
  </view>

  <!-- 列表模式：按月分组的单行卡片 -->
  <block wx:if="{{viewMode === 'list'}}">
    <view class="month-group" wx:for="{{groups}}" wx:for-item="group" wx:key="key">
      <view class="month-title">{{group.label}}</view>
      <view class="list-item" wx:for="{{group.items}}" wx:key="id">
        <t-swipe-cell
          right="{{[{ text: '删除', className: 'del-action' }]}}"
          data-id="{{item.id}}"
          bind:click="onDeleteTap"
        >
          <view
            class="track-card"
            hover-class="track-card-hover"
            hover-stay-time="80"
            data-id="{{item.id}}"
            bindtap="onTapItem"
          >
            <view class="list-row">
              <view class="list-icon-wrap">
                <image class="list-icon" src="{{item.iconImg}}" mode="aspectFit" />
              </view>
              <view class="list-main">
                <text class="list-type">{{item.label}}</text>
                <text class="list-dist">{{item.distanceKm}}公里</text>
              </view>
              <text class="list-time">{{item.timeText}}</text>
            </view>
          </view>
        </t-swipe-cell>
      </view>
    </view>
  </block>

  <!-- 图片模式：2 列网格（轨迹缩略图卡片） -->
  <view class="track-grid" wx:else>
    <view class="grid-item" wx:for="{{items}}" wx:key="id">
      <t-swipe-cell
        right="{{[{ text: '删除', className: 'del-action' }]}}"
        data-id="{{item.id}}"
        bind:click="onDeleteTap"
      >
        <view
          class="track-card"
          hover-class="track-card-hover"
          hover-stay-time="80"
          data-id="{{item.id}}"
          bindtap="onTapItem"
        >
          <track-thumb class="track-thumb" points="{{item.previewPoints}}" color="{{item.color}}" />
          <view class="track-body">
            <view class="track-head">
              <image class="cell-icon" src="{{item.iconImg}}" mode="aspectFit"></image>
              <text class="track-type">{{item.label}}</text>
              <text class="track-duration">{{item.durationText}}</text>
            </view>
            <view class="track-foot">
              <text class="track-dist">{{item.distanceKm}}公里</text>
              <text class="track-time">{{item.timeText}}</text>
            </view>
          </view>
        </view>
      </t-swipe-cell>
    </view>
  </view>

  <view wx:if="{{loading}}" class="text-muted loading-tip">加载中…</view>
  <view wx:if="{{!hasMore && items.length > 0}}" class="text-muted loading-tip">没有更多了</view>
</view>
