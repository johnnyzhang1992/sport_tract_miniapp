<view class="container">
  <!-- 类型筛选（t-tabs） -->
  <t-tabs
    class="filter-tabs"
    value="{{activeFilter}}"
    bind:change="onTabChange"
  >
    <t-tab-panel
      wx:for="{{filters}}"
      wx:key="type"
      label="{{item.label}}"
      value="{{item.type}}"
    />
  </t-tabs>

  <!-- 轨迹列表 -->
  <view wx:if="{{items.length === 0 && !loading}}">
    <view class="empty" wx:if="{{initialized}}">还没有运动记录，去开始第一次吧 🏃</view>
    <view class="empty" wx:else>加载中…</view>
  </view>

  <t-swipe-cell
    wx:for="{{items}}"
    wx:key="id"
    right="{{[{ text: '删除', className: 'del-action' }]}}"
    data-id="{{item.id}}"
    bind:click="onDeleteTap"
  >
    <view
      class="track-cell-wrap"
      hover-class="track-cell-hover"
      hover-stay-time="80"
      data-id="{{item.id}}"
      bindtap="onTapItem"
    >
      <t-cell
        class="track-cell"
        hover
        title="{{item.label}} · {{item.startTimeText}}"
        description="{{item.distanceKm}}km · {{item.durationText}} · 配速 {{item.paceText}} · {{item.calories}}kcal{{item.markerCount > 0 ? ' · 📍' + item.markerCount : ''}}"
        arrow
      >
        <view slot="left-icon" class="cell-icon">{{item.icon}}</view>
      </t-cell>
    </view>
  </t-swipe-cell>

  <view wx:if="{{loading}}" class="text-muted loading-tip">加载中…</view>
  <view wx:if="{{!hasMore && items.length > 0}}" class="text-muted loading-tip">没有更多了</view>
</view>
