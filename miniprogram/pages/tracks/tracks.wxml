<view class="container">
  <!-- 类型筛选（t-tabs） -->
  <t-tabs
    class="filter-tabs"
    sticky
    value="{{activeFilter}}"
    bind:change="onTabChange"
  >
    <t-tab-panel
      wx:for="{{filters}}"
      wx:key="type"
      label="{{item.label}}"
      value="{{item.type}}"
    />
  </t-tabs>

  <!-- 省份筛选条（足迹地图跳转带入） -->
  <view class="province-bar" wx:if="{{provinceFilter}}">
    <view class="province-bar-text">
      <image class="bar-icon" src="/assets/icons/lucide-pin-blue.png" mode="aspectFit" />
      <text>{{provinceFilter}}</text>
    </view>
    <view class="province-bar-close" hover-class="province-bar-close-hover" bindtap="clearProvince">✕</view>
  </view>

  <!-- 精确时间范围条（报告页「日期汇总」点行下钻带入） -->
  <view class="range-bar" wx:if="{{rangeFilter}}">
    <view class="province-bar-text">
      <image class="bar-icon" src="/assets/icons/lucide-calendar-blue.png" mode="aspectFit" />
      <text>{{rangeFilter.label}}</text>
    </view>
    <view class="province-bar-close" hover-class="province-bar-close-hover" bindtap="clearRange">✕</view>
  </view>

  <!-- 展示模式切换：列表（text-align-justify）/ 图片（layout-grid） -->
  <view class="mode-bar">
    <text class="mode-bar-title">{{totalCount}} 条轨迹</text>
    <view class="mode-btns">
    <view
      class="mode-btn {{viewMode === 'list' ? '' : 'mode-btn-dim'}}"
      hover-class="mode-btn-hover"
      data-mode="list"
      bindtap="onToggleMode"
    >
      <image class="mode-icon" src="/assets/icons/lucide-text-align-justify{{viewMode === 'list' ? '-blue' : ''}}.png" mode="aspectFit" />
    </view>
    <view
      class="mode-btn {{viewMode === 'grid' ? '' : 'mode-btn-dim'}}"
      hover-class="mode-btn-hover"
      data-mode="grid"
      bindtap="onToggleMode"
    >
      <image class="mode-icon" src="/assets/icons/lucide-layout-grid{{viewMode === 'grid' ? '-blue' : ''}}.png" mode="aspectFit" />
    </view>
    </view>
  </view>

  <!-- 轨迹列表 -->
  <view wx:if="{{items.length === 0 && !loading && !loadError}}">
    <view class="empty" wx:if="{{initialized}}">还没有运动记录，去开始第一次吧</view>
  </view>

  <!-- 首屏加载失败：错误提示 + 重试 -->
  <view class="load-error" wx:if="{{loadError && !loading && items.length === 0}}">
    <view class="load-error-text">加载失败，请检查网络后重试</view>
    <view class="load-error-btn" hover-class="load-error-btn-hover" bindtap="onRetryLoad">重新加载</view>
  </view>

  <!-- 骨架屏：列表模式首次加载，模拟卡片结构 -->
  <view class="sk-wrap" wx:if="{{loading && !initialized && viewMode === 'list'}}">
    <view class="sk-title"></view>
    <view class="sk-card" wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this">
      <view class="sk-icon"></view>
      <view class="sk-main">
        <view class="sk-line sk-line-type"></view>
        <view class="sk-line sk-line-dist"></view>
      </view>
      <view class="sk-line sk-line-time"></view>
    </view>
  </view>
  <!-- 非列表模式首次加载：文字占位 -->
  <view class="empty" wx:if="{{loading && !initialized && viewMode !== 'list'}}">加载中…</view>

  <!-- 列表模式：按月分组的单行卡片 -->
  <block wx:if="{{viewMode === 'list'}}">
    <view class="month-group" wx:for="{{groups}}" wx:for-item="group" wx:key="key">
      <view class="month-title">{{group.label}}</view>

      <!-- 当月统计（选中具体运动类型时展示）：累计 / 平均 -->
      <view class="month-stats" wx:if="{{activeFilter}}">
        <view class="ms-row ms-head">
          <text class="ms-label"></text>
          <text class="ms-col">累计</text>
          <text class="ms-col">平均</text>
        </view>
        <view class="ms-row">
          <text class="ms-label">次数</text>
          <text class="ms-col">{{group.stats.count}}</text>
          <text class="ms-col"></text>
        </view>
        <view class="ms-row">
          <text class="ms-label">时间</text>
          <text class="ms-col">{{group.stats.timeText}}</text>
          <text class="ms-col">{{group.stats.avgTimeText}}</text>
        </view>
        <view class="ms-row">
          <text class="ms-label">千卡</text>
          <text class="ms-col">{{group.stats.kcalText}}</text>
          <text class="ms-col">{{group.stats.avgKcalText}}</text>
        </view>
        <view class="ms-row">
          <text class="ms-label">距离</text>
          <text class="ms-col">{{group.stats.distanceKm}} 公里</text>
          <text class="ms-col">{{group.stats.avgDistanceKm}} 公里</text>
        </view>
      </view>

      <view class="list-item" wx:for="{{group.items}}" wx:key="id">
        <t-swipe-cell
          right="{{[{ text: '删除', className: 'del-action' }]}}"
          data-id="{{item.id}}"
          bind:click="onDeleteTap"
        >
          <view
            class="track-card"
            hover-class="track-card-hover"
            hover-stay-time="80"
            data-id="{{item.id}}"
            bindtap="onTapItem"
          >
            <view class="list-row">
              <view class="list-icon-wrap">
                <image class="list-icon" src="{{item.iconImg}}" mode="aspectFit" />
              </view>
              <view class="list-main">
                <text class="list-type">{{item.label}}</text>
                <view class="list-dist">
                  <text class="list-dist-num">{{item.distanceKm}}</text>
                  <text class="list-dist-unit">公里</text>
                </view>
              </view>
              <view class="list-right">
                <view class="list-best {{item.bestFormer ? 'list-best-former' : ''}}" wx:if="{{item.bestText}}">
                  <view class="laurel-ear list-best-ear {{item.bestFormer ? 'laurel-ear-grey' : ''}}"></view>
                  <text class="list-best-text">{{item.bestText}}</text>
                  <view class="laurel-ear list-best-ear laurel-ear-r {{item.bestFormer ? 'laurel-ear-grey' : ''}}"></view>
                </view>
                <text class="list-time">{{item.timeText}}</text>
              </view>
            </view>
          </view>
        </t-swipe-cell>
      </view>
    </view>
  </block>

  <!-- 地图模式：一行一条（左侧真实地图，右侧数据概况）；地图点按视口懒加载 -->
  <view class="map-list" wx:else>
    <view class="map-item" id="map-item-{{item.id}}" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}">
      <t-swipe-cell
        right="{{[{ text: '删除', className: 'del-action' }]}}"
        data-id="{{item.id}}"
        bind:click="onDeleteTap"
      >
        <view
          class="track-card map-card"
          hover-class="track-card-hover"
          hover-stay-time="80"
          data-id="{{item.id}}"
          bindtap="onTapItem"
        >
          <view class="map-wrap">
            <map
              wx:if="{{item.mapReady && item.mapCenter}}"
              id="track-map-{{item.id}}"
              class="track-map-mini"
              latitude="{{item.mapCenter.latitude}}"
              longitude="{{item.mapCenter.longitude}}"
              scale="15"
              polyline="{{item.mapPolyline}}"
              include-points="{{item.mapIncludePoints}}"
              data-id="{{item.id}}"
              bindtap="onTapItem"
              enable-zoom="{{false}}"
              enable-scroll="{{false}}"
              enable-rotate="{{false}}"
              enable-overlooking="{{false}}"
              enable-satellite="{{false}}"
              show-location="{{false}}"
              enable-traffic="{{false}}"
              enable-poi="{{false}}"
            />
            <view wx:else class="map-placeholder">
              <image wx:if="{{item.iconImg}}" class="map-placeholder-icon-img" src="{{item.iconImg}}" mode="aspectFit" />
              <text wx:else class="map-placeholder-icon">—</text>
              <text class="map-placeholder-text">{{item.mapEmpty ? '暂无轨迹' : item.mapFailed ? '地图加载失败' : '地图加载中…'}}</text>
            </view>
          </view>
          <view class="map-info">
            <view class="map-info-head">
              <text class="map-date">{{item.dateText}}</text>
              <view class="map-type-wrap">
                <image class="map-icon" src="{{item.iconImg}}" mode="aspectFit" />
                <text class="map-type">{{item.label}}</text>
              </view>
            </view>
            <view class="map-sub">{{item.timeRangeText}}<text wx:if="{{item.cityText}}" class="map-city"> · {{item.cityText}}</text></view>
            <view class="map-dist-row">
              <text class="map-dist">{{item.distanceKm}}</text>
              <text class="map-dist-unit">公里</text>
              <view class="map-best {{item.bestFormer ? 'map-best-former' : ''}}" wx:if="{{item.bestText}}">
                <view class="laurel-ear map-best-ear {{item.bestFormer ? 'laurel-ear-grey' : ''}}"></view>
                <text class="map-best-text">{{item.bestText}}</text>
                <view class="laurel-ear map-best-ear laurel-ear-r {{item.bestFormer ? 'laurel-ear-grey' : ''}}"></view>
              </view>
            </view>
            <view class="map-meta">
              <view class="map-meta-item">
                <image class="map-meta-icon" src="/assets/icons/lucide-clock.png" mode="aspectFit" aria-label="时长" />
                <text class="map-meta-value">{{item.durationText}}</text>
              </view>
              <view class="map-meta-item">
                <image class="map-meta-icon" src="/assets/icons/lucide-mountain.png" mode="aspectFit" aria-label="爬升" />
                <text class="map-meta-value">{{item.elevationGain}}m</text>
              </view>
              <view class="map-meta-item">
                <image class="map-meta-icon" src="/assets/icons/lucide-flame.png" mode="aspectFit" aria-label="千卡" />
                <text class="map-meta-value">{{item.caloriesText}}</text>
              </view>
            </view>
          </view>
          <view class="map-arrow">›</view>
        </view>
      </t-swipe-cell>
    </view>
  </view>

  <view wx:if="{{loading && items.length > 0}}" class="text-muted loading-tip">加载中…</view>
  <view wx:if="{{!hasMore && items.length > 0}}" class="text-muted loading-tip">没有更多了</view>
</view>
