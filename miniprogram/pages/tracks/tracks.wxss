.filter-tabs {
  margin-bottom: 8rpx;
}
.cell-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}
.track-card {
  display: flex;
  align-items: center; /* 图标垂直居中 */
  background: #fff;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  padding: 46rpx 28rpx; /* 高度再加高 */
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.track-card-hover {
  opacity: 0.7;
}
.cell-icon {
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.track-info {
  flex: 1;
  min-width: 0;
}
.track-type {
  font-size: 22rpx; /* 类型字号缩小 */
  color: #1f2329;
  margin-bottom: 12rpx;
}
.track-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.track-dist {
  font-size: 30rpx; /* 距离字号缩小 */
  font-weight: 600;
  color: #2b6cf6;
}
.track-time {
  font-size: 24rpx;
  color: #8a93a6;
}
.loading-tip {
  text-align: center;
  padding: 24rpx 0;
}

/* 左滑删除按钮 */
.del-action {
  background: #e34d59;
  color: #fff;
  height: 100%; /* 撑满滑动容器高度，与左侧卡片同高 */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}
