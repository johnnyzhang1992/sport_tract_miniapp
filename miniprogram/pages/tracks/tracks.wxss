.filter-tabs {
  margin-bottom: 8rpx;
}

/* 2 列网格 */
.track-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-item {
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
}

/* 卡片（缩略图在上，信息在下） */
.track-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.track-card-hover {
  opacity: 0.7;
}

/* 轨迹缩略图 */
.track-thumb {
  width: 100%;
  height: 156rpx;
  display: block;
  background: #f6f8fb;
}

/* 卡片信息区 */
.track-body {
  padding: 16rpx 20rpx 20rpx;
}
.track-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.cell-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.track-type {
  font-size: 24rpx;
  font-weight: 500;
  color: #1f2329;
  margin-right: auto; /* 把时长推到行右侧 */
}
.track-duration {
  font-size: 22rpx;
  color: #8a93a6;
  flex-shrink: 0;
}
.track-foot {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.track-dist {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.track-time {
  font-size: 22rpx;
  color: #8a93a6;
}

.loading-tip {
  text-align: center;
  padding: 24rpx 0;
}

/* 左滑删除按钮 */
.del-action {
  background: #e34d59;
  color: #fff;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}
