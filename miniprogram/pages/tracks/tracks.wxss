.filter-tabs {
  margin-bottom: 8rpx;
}

/* 展示模式切换（列表 / 图片） */
.mode-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 24rpx 12rpx;
}
.mode-bar-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.mode-btns {
  display: flex;
  gap: 12rpx;
}
.mode-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2f3f5;
}
.mode-btn-active {
  background: #eef4ff;
}
.mode-btn-dim {
  opacity: 0.45;
}
.mode-btn-hover {
  opacity: 0.7;
}
.mode-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 2 列网格（图片模式） */
.track-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-item {
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
}

/* 列表模式：按月分组 */
.month-title {
  margin: 24rpx 4rpx 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}

/* 当月统计（选中运动类型时）：累计 / 平均 */
.month-stats {
  margin: 0 4rpx 12rpx;
  padding: 8rpx 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}
.ms-row {
  display: flex;
  align-items: baseline;
  padding: 2rpx 0;
  font-size: 24rpx;
  color: #1f2329;
}
.ms-head {
  font-size: 22rpx;
  color: #8a93a6;
}
.ms-label {
  width: 100rpx;
  flex-shrink: 0;
  color: #8a93a6;
}
.ms-col {
  flex: 1;
  min-width: 0;
}

/* 列表模式：单行卡片占满 */
.list-item {
  width: 100%;
  margin-bottom: 16rpx;
}
.list-row {
  display: flex;
  align-items: stretch;
  padding: 24rpx 28rpx;
}
.list-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #eef4ff;
}
.list-icon {
  width: 48rpx;
  height: 48rpx;
}
.list-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}
.list-type {
  font-size: 26rpx;
  color: #1f2329;
}
.list-dist {
  font-size: 34rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.list-time {
  align-self: flex-end;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8a93a6;
  flex-shrink: 0;
}

/* 卡片（缩略图在上，信息在下） */
.track-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.track-card-hover {
  opacity: 0.7;
}

/* 轨迹缩略图 */
.track-thumb {
  width: 100%;
  height: 156rpx;
  display: block;
}

/* 卡片信息区 */
.track-body {
  padding: 16rpx 20rpx 20rpx;
}
.track-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.cell-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.track-type {
  font-size: 24rpx;
  font-weight: 500;
  color: #1f2329;
  margin-right: auto; /* 把时长推到行右侧 */
}
.track-duration {
  font-size: 22rpx;
  color: #8a93a6;
  flex-shrink: 0;
}
.track-foot {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.track-dist {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.track-time {
  font-size: 22rpx;
  color: #8a93a6;
}

.loading-tip {
  text-align: center;
  padding: 24rpx 0;
}

/* 左滑删除按钮 */
.del-action {
  background: #e34d59;
  color: #fff;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

/* 省份筛选条 */
.province-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #eef4ff;
}
.province-bar-text {
  font-size: 26rpx;
  color: #2b6cf6;
}
.province-bar-close {
  padding: 4rpx 12rpx;
  font-size: 26rpx;
  color: #2b6cf6;
}
.province-bar-close-hover {
  opacity: 0.6;
}
