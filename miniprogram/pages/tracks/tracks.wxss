.filter-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.filter-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666;
}
.filter-active {
  background: #2b6cf6;
  color: #fff;
}
.track-card {
  padding: 28rpx;
}
.track-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.track-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}
.track-label {
  font-size: 30rpx;
  font-weight: 600;
}
.track-metrics {
  display: flex;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 0;
}
.metric {
  flex: 1;
  text-align: center;
}
.metric-num {
  font-size: 32rpx;
  font-weight: 600;
}
.metric-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.track-foot {
  margin-top: 16rpx;
}
.loading-tip {
  text-align: center;
  padding: 24rpx 0;
}
