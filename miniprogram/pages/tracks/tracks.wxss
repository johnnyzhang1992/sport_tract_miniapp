.filter-tabs {
  margin-bottom: 8rpx;
  /* 顶边与白色导航齐平，只圆下面两角；白底在组件内层，靠 overflow 裁出弧 */
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
}

/* 展示模式切换（列表 / 图片） */
.mode-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0 12rpx;
}
.mode-bar-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.mode-btns {
  display: flex;
  gap: 12rpx;
}
.mode-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2f3f5;
}
/* 选中态不加底色：只把图标换成蓝色版（-blue 资产），未选中降透明度 */
.mode-btn-dim {
  opacity: 0.45;
}
.mode-btn-hover {
  opacity: 0.7;
}
.mode-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 2 列网格（图片模式） */
.track-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-item {
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
}

/* 列表模式：按月分组 */
.month-title {
  margin: 24rpx 4rpx 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}

/* 首次加载骨架屏（列表模式）：模拟「月份标题 + 卡片行」结构，呼吸闪烁 */
.sk-wrap {
  padding-top: 8rpx;
}
.sk-title {
  width: 180rpx;
  height: 34rpx;
  border-radius: 8rpx;
  margin: 24rpx 4rpx 16rpx;
}
.sk-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}
.sk-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.sk-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.sk-line {
  border-radius: 8rpx;
}
.sk-line-type {
  width: 160rpx;
  height: 26rpx;
}
.sk-line-dist {
  width: 220rpx;
  height: 34rpx;
}
.sk-line-time {
  width: 96rpx;
  height: 24rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.sk-title,
.sk-icon,
.sk-line {
  background: #eef0f3;
  animation: sk-pulse 1.2s ease-in-out infinite;
}
@keyframes sk-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.45;
  }
}

/* 当月统计（选中运动类型时）：累计 / 平均 */
.month-stats {
  margin: 0 4rpx 12rpx;
  padding: 8rpx 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}
.ms-row {
  display: flex;
  align-items: baseline;
  padding: 2rpx 0;
  font-size: 24rpx;
  color: #1f2329;
}
.ms-head {
  font-size: 22rpx;
  color: #667080;
}
.ms-label {
  width: 100rpx;
  flex-shrink: 0;
  color: #667080;
}
.ms-col {
  flex: 1;
  min-width: 0;
}

/* 列表模式：单行卡片占满 */
.list-item {
  width: 100%;
  margin-bottom: 16rpx;
}
.list-row {
  display: flex;
  align-items: stretch;
  padding: 24rpx 28rpx;
}
.list-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #eef4ff;
  /* 行是 stretch（右侧列要靠它贴底），固定高的图标会被留在行首，单独拉回中线 */
  align-self: center;
}
.list-icon {
  width: 48rpx;
  height: 48rpx;
}
.list-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}
.list-type {
  font-size: 26rpx;
  color: #1f2329;
}
.list-dist {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.list-dist-num {
  font-size: 38rpx;
}
.list-dist-unit {
  font-size: 24rpx;
}
.list-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-end;
  gap: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.list-time {
  font-size: 24rpx;
  color: #667080;
}
/* 个人最佳角标：金色月桂穗枝（公共背景图在 app.wxss 的 .laurel-ear），左右枝环抱文本 */
.list-best {
  display: flex;
  align-items: center;
  max-width: 300rpx;
}
.list-best-ear {
  width: 18rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.list-best-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #8a5f12;
  letter-spacing: 1rpx;
  margin: 0 3rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 前纪录（已被刷新）：文字灰金降调（穗枝灰显走全局 .laurel-ear-grey） */
.list-best-former .list-best-text {
  color: #6f6857;
}

/* 卡片（缩略图在上，信息在下） */
.track-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.track-card-hover {
  opacity: 0.7;
}

/* 轨迹缩略图 */
.track-thumb {
  width: 100%;
  height: 156rpx;
  display: block;
}

/* 卡片信息区 */
.track-body {
  padding: 16rpx 20rpx 20rpx;
}
.track-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.cell-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.track-type {
  font-size: 24rpx;
  font-weight: 500;
  color: #1f2329;
  margin-right: auto; /* 把时长推到行右侧 */
}
.track-duration {
  font-size: 22rpx;
  color: #667080;
  flex-shrink: 0;
}
.track-foot {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.track-dist {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b6cf6;
}
.track-time {
  font-size: 22rpx;
  color: #667080;
}

.loading-tip {
  text-align: center;
  padding: 24rpx 0;
}

/* 左滑删除按钮 */
.del-action {
  background: #c02a30;
  color: #fff;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

/* 省份筛选条 */
.province-bar,
.range-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #eef4ff;
}
.province-bar-text {
  font-size: 26rpx;
  color: #2b6cf6;
}
.province-bar-close {
  padding: 4rpx 12rpx;
  font-size: 26rpx;
  color: #2b6cf6;
}
.province-bar-close-hover {
  opacity: 0.6;
}

/* 首屏加载失败：提示 + 重试按钮 */
.load-error {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.load-error-text {
  font-size: 26rpx;
  color: #667080;
}
.load-error-btn {
  font-size: 28rpx;
  color: #2b6cf6;
  border: 1rpx solid #2b6cf6;
  border-radius: 999rpx;
  padding: 12rpx 48rpx;
}
.load-error-btn-hover {
  opacity: 0.7;
}
