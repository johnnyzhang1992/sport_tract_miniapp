<!-- 单日计划详情：本周条 + 中央大环 + 三项当前/目标 + 当天轨迹摘要 -->
<view class="container">
  <view class="head">
    <view class="head-title">{{dateText}}</view>
    <text wx:if="{{allAchieved}}" class="head-badge">已达成</text>
  </view>

  <!-- 本周七天：点某天切换 -->
  <view class="week-strip">
    <view
      wx:for="{{weekStrip}}"
      wx:key="date"
      class="strip-day {{item.sel ? 'strip-sel' : ''}}"
      data-date="{{item.date}}"
      bindtap="onPickDay"
    >
      <text class="strip-wd">{{item.wd}}</text>
      <text class="strip-num">{{item.day}}</text>
    </view>
  </view>

  <!-- 中央大环 -->
  <view class="big-wrap">
    <canvas type="2d" id="big-ring" class="big-ring"></canvas>
  </view>

  <!-- 三项：当前/目标大数字（彩色），右侧进计划页调整 -->
  <view class="card metrics">
    <view class="metric" wx:for="{{metrics}}" wx:key="key">
      <view class="metric-info">
        <view class="metric-name">{{item.name}}</view>
        <view class="metric-line">
          <text class="metric-cur metric-{{item.cls}}">{{item.value}}</text>
          <text class="metric-sep metric-{{item.cls}}">/{{item.target}}</text>
          <text class="metric-unit">{{item.unit}}</text>
        </view>
      </view>
      <view class="metric-pct metric-{{item.cls}}">{{item.pct}}%</view>
    </view>
    <view class="metric-edit" bindtap="goPlan">调整计划目标 ›</view>
  </view>

  <!-- 当天轨迹摘要 -->
  <view class="card tracks" wx:if="{{tracks.length > 0}}">
    <view class="tracks-title">当天轨迹（{{tracks.length}}）</view>
    <view class="track-row" wx:for="{{tracks}}" wx:key="id">
      <text class="track-icon">{{item.icon}}</text>
      <view class="track-main">
        <text class="track-label">{{item.label}}</text>
        <text class="track-sub">{{item.distText}} · {{item.durText}}</text>
      </view>
      <text class="track-time">{{item.timeText}}</text>
    </view>
  </view>
  <view class="card empty" wx:elif="{{!loading}}">当天没有运动记录</view>

  <view wx:if="{{failed}}" class="state">
    <text class="text-muted">加载失败</text>
    <view class="retry" bindtap="onRetry">重试</view>
  </view>
</view>
