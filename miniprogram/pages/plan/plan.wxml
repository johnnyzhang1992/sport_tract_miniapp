<!-- 运动计划设置：当期进度 + 周期（每天/每周）+ 三项目标（距离/时间/次数，步进器 + 直接输入） -->
<view class="container">
  <!-- 当期进度：一行摘要 -->
  <view class="card progress-card">
    <view class="progress-label">{{progressText}}</view>
    <view class="progress-detail">{{progressDetail || '—'}}</view>
  </view>

  <!-- 计划周期 -->
  <view class="card">
    <view class="card-title">计划周期</view>
    <view class="period-row">
      <view
        wx:for="{{periods}}"
        wx:key="key"
        class="period-seg {{period === item.key ? 'period-seg-active' : ''}}"
        data-value="{{item.key}}"
        bindtap="onPeriod"
      >{{item.label}}</view>
    </view>
    <view class="fnote">每天＝当天 0 点起统计；每周＝本周一 0 点起统计</view>
  </view>

  <!-- 三项目标：圆点 + 标签 + 步进器（− 输入 +） + 单位 -->
  <view class="card">
    <view class="card-title">目标</view>

    <view class="goal-row">
      <view class="goal-dot goal-dot-red"></view>
      <text class="goal-label">运动距离</text>
      <view class="stepper">
        <view class="step-btn" hover-class="step-btn-hover" data-key="distance" data-delta="-1" bindtap="onStep">−</view>
        <input
          class="step-input"
          type="digit"
          placeholder="0"
          placeholder-class="step-ph"
          value="{{distanceKm}}"
          bindinput="onDistance"
        />
        <view class="step-btn" hover-class="step-btn-hover" data-key="distance" data-delta="1" bindtap="onStep">+</view>
      </view>
      <text class="goal-unit">km</text>
    </view>

    <view class="goal-row">
      <view class="goal-dot goal-dot-green"></view>
      <text class="goal-label">运动时间</text>
      <view class="stepper">
        <view class="step-btn" hover-class="step-btn-hover" data-key="duration" data-delta="-1" bindtap="onStep">−</view>
        <input
          class="step-input"
          type="number"
          placeholder="0"
          placeholder-class="step-ph"
          value="{{durationMin}}"
          bindinput="onDuration"
        />
        <view class="step-btn" hover-class="step-btn-hover" data-key="duration" data-delta="1" bindtap="onStep">+</view>
      </view>
      <text class="goal-unit">分钟</text>
    </view>

    <view class="goal-row">
      <view class="goal-dot goal-dot-cyan"></view>
      <text class="goal-label">运动次数</text>
      <view class="stepper">
        <view class="step-btn" hover-class="step-btn-hover" data-key="count" data-delta="-1" bindtap="onStep">−</view>
        <input
          class="step-input"
          type="number"
          placeholder="0"
          placeholder-class="step-ph"
          value="{{count}}"
          bindinput="onCount"
        />
        <view class="step-btn" hover-class="step-btn-hover" data-key="count" data-delta="1" bindtap="onStep">+</view>
      </view>
      <text class="goal-unit">次</text>
    </view>

    <view class="fnote">点 − / + 快速调整（距离 0.5、时间 5、次数 1），也可直接输入；三项都需大于 0</view>
  </view>

  <!-- 保存：固定底部，随时可点（内容不多时不必滚动到底） -->
  <view class="bottom-bar">
    <button class="btn-primary" disabled="{{saving || loading}}" loading="{{saving}}" bindtap="onSave">{{saving ? '保存中…' : '保存计划'}}</button>
  </view>
</view>
