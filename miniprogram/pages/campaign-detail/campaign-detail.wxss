/* 活动详情页 .page（照 leaderboard.wxss:1-7）：底部留白 = 贴底「我的贡献」栏高度，避免最后一行被遮挡 */
.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 20rpx 24rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 三态占位（不存在 / 失败重试 / 加载中） */
.state-box {
  padding: 200rpx 40rpx;
  text-align: center;
}
.state-text {
  font-size: 26rpx;
  color: #8a93a6;
  line-height: 1.7;
}
.state-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 48rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 26rpx;
}
.state-btn-hover {
  opacity: 0.85;
}

/* 游客登录引导（照 campaign-list.wxss 的 .login-hint 同套观感；页面样式隔离，需在本页复刻） */
.login-hint {
  background: #fff;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  text-align: center;
}
.login-hint-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.6;
}
.login-hint-text {
  color: #4e5969;
  font-size: 26rpx;
  margin: 24rpx 0 32rpx;
  line-height: 1.6;
}
.login-hint-btn {
  background: #2b6cf6;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  width: 320rpx;
}

/* 卡片（照 leaderboard.wxss 的 .card） */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}
.card-sub {
  font-size: 22rpx;
  color: #8a93a6;
}

/* 顶部信息 */
.head-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.head-title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.head-range {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4e5969;
}
.head-meta {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.head-meta-item {
  font-size: 22rpx;
  color: #8a93a6;
  background: #f2f3f5;
  border-radius: 6rpx;
  padding: 6rpx 12rpx;
}
.head-desc {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f3f5;
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.6;
}

/* 发起人专属区 / 邀请（Task 11）：成员行的动作胶囊 */
.act-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f3f5;
}
.act-pill {
  font-size: 24rpx;
  color: #2b6cf6;
  background: #eaf1ff;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}
.act-pill-badge {
  color: #fff;
  background: #ff7a45;
  font-weight: 600;
}
.act-pill-danger {
  color: #e5484d;
  background: #fdecec;
}
.act-pill-hover {
  opacity: 0.8;
}

/* 非成员：身份说明行 + 加入入口 */
.note-row {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}
.note-text {
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.6;
}
.join-btn {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.join-btn-hover {
  opacity: 0.85;
}
.join-btn-off {
  background: #b8c4d9;
}
.join-tip {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a93a6;
}

/* 全队汇总三格 */
.sum-row {
  display: flex;
  gap: 20px;
  padding: 8rpx 0 4rpx;
}
/* 格内横排：文案居左，三格按内容宽排（不再等分 1/3） */
.sum-cell {
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  height: 20px;
}
/* 28rpx 不是随手定的：横排后数值要与标签共用 114px 一格。
   实测「次数 1234 / 距离 (km) 12345.67 / 时长 123h45m」这组极端值时，
   36rpx 会让「距离 (km)」折成两行、数值还压进右格；28rpx 单行放得下。 */
.sum-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
}
.sum-label {
  font-size: 22rpx;
  color: #8a93a6;
}

/* 成员列表＝排行榜（照 leaderboard.wxss 的 .rank-*） */
.rank-row {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.rank-row:last-of-type {
  border-bottom: none;
}
.rank-row-hover {
  background: #f7f8fa;
}
.rank-no {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #8a93a6;
  text-align: center;
  flex-shrink: 0;
}
.medal-img {
  width: 44rpx;
  height: 44rpx;
}
.rank-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin: 0 14rpx 0 6rpx;
  flex-shrink: 0;
  background: #f2f3f5;
}
.rank-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: #b8c4d9;
}
.rank-name-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.rank-name {
  font-size: 24rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-meta {
  font-size: 22rpx;
  color: #8a93a6;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.rank-dist {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}
/* 移出（仅发起人、非自己）：紧跟昵称的胶囊，间距由 .rank-name-wrap 的 gap 给；
   catchtap 不触发整行的 openMember */
.rank-kick {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #e5484d;
  background: #fdecec;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}
.rank-kick-hover {
  opacity: 0.8;
}
.rank-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #8a93a6;
}

/* 成员排行「加载更多」：整行可点（不是右下角一个小字），文案里带「已显示 x / 总数」，
   用户点之前就知道还差多少。触控高度 88rpx(=44px) 取最小档，再小就点不准。 */
.rank-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid #eef0f4;
  font-size: 24rpx;
  color: #2b6cf6;
}
.rank-more-hover {
  background: #f2f6ff;
}

/* 我的贡献：通栏贴底（照 leaderboard.wxss:451-546 的 .me-card 一整套） */
.me-card {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: linear-gradient(135deg, #2b6cf6, #5b8cff);
  border-radius: 0;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 -6rpx 18rpx rgba(43, 108, 246, 0.22);
}
.me-body {
  flex: 1;
  min-width: 0;
}
.me-name-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.me-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 4rpx;
}
.me-stats {
  text-align: right;
  flex-shrink: 0;
}
.me-dist {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  font-variant-numeric: tabular-nums;
}
.me-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 4rpx;
}

/* 审核抽屉 / 小程序码弹窗：与 campaign-member-sheet 同一套 .mask/.sheet 观感
   （页内样式天然隔离，组件那份到不了这里，故按同一口径复刻；z-index 显式高于 .me-card） */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 210;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  max-height: 84vh;
  overflow-y: auto;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 8rpx;
}
.sheet-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.sheet-close {
  flex: none;
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 30rpx;
  color: #999;
}

/* 审核抽屉：待审批行（昵称 / 申请时间 / 同意 / 拒绝） */
.pend-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.pend-row:last-of-type {
  border-bottom: none;
}
.pend-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: #f2f3f5;
}
.pend-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: #b8c4d9;
}
.pend-main {
  flex: 1;
  min-width: 0;
}
.pend-name {
  font-size: 28rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pend-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a93a6;
}
.pend-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
}
.pend-ok {
  color: #fff;
  background: #2b6cf6;
}
.pend-no {
  color: #4e5969;
  background: #f2f3f5;
}
.pend-btn-hover {
  opacity: 0.8;
}
.pend-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #8a93a6;
}

/* 小程序码弹窗 */
.code-sheet {
  text-align: center;
}
.code-img {
  display: block;
  width: 440rpx;
  height: 440rpx;
  margin: 16rpx auto 0;
  background: #f7f8fa;
  border-radius: 16rpx;
}
.code-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8a93a6;
  line-height: 1.6;
}
.code-btn {
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 28rpx;
}
.code-btn-ghost {
  margin-top: 16rpx;
  background: #f2f3f5;
  color: #1f2329;
}
.code-btn-hover {
  opacity: 0.85;
}
