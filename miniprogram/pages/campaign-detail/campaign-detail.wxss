/* 活动详情页 .page（照 leaderboard.wxss:1-7）：底部留白 = 贴底「我的贡献」栏高度，避免最后一行被遮挡 */
.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 20rpx 24rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 三态占位（不存在 / 失败重试 / 加载中） */
.state-box {
  padding: 200rpx 40rpx;
  text-align: center;
}
.state-text {
  font-size: 26rpx;
  color: #8a93a6;
  line-height: 1.7;
}
.state-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 48rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 26rpx;
}
.state-btn-hover {
  opacity: 0.85;
}

/* 卡片（照 leaderboard.wxss 的 .card） */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}
.card-sub {
  font-size: 22rpx;
  color: #8a93a6;
}

/* 顶部信息 */
.head-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.head-title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.head-tag {
  flex: none;
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  color: #2b6cf6;
  background: #eaf1ff;
}
.head-range {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4e5969;
}
.head-meta {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.head-meta-item {
  font-size: 22rpx;
  color: #8a93a6;
  background: #f2f3f5;
  border-radius: 6rpx;
  padding: 6rpx 12rpx;
}
.head-desc {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f3f5;
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.6;
}

/* 非成员：身份说明行 + 加入入口 */
.note-row {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}
.note-text {
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.6;
}
.join-btn {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #2b6cf6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.join-btn-hover {
  opacity: 0.85;
}
.join-btn-off {
  background: #b8c4d9;
}
.join-tip {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a93a6;
}

/* 全队汇总三格 */
.sum-row {
  display: flex;
  padding: 8rpx 0 4rpx;
}
.sum-cell {
  flex: 1;
  text-align: center;
}
.sum-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
}
.sum-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a93a6;
}

/* 成员列表＝排行榜（照 leaderboard.wxss 的 .rank-*） */
.rank-row {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.rank-row:last-of-type {
  border-bottom: none;
}
.rank-row-hover {
  background: #f7f8fa;
}
.rank-no {
  width: 56rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #8a93a6;
  text-align: center;
  flex-shrink: 0;
}
.medal-img {
  width: 44rpx;
  height: 44rpx;
}
.rank-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin: 0 14rpx 0 6rpx;
  flex-shrink: 0;
  background: #f2f3f5;
}
.rank-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: #b8c4d9;
}
.rank-name-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.rank-name {
  font-size: 27rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-meta {
  font-size: 22rpx;
  color: #8a93a6;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.rank-dist {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}
.rank-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #8a93a6;
}

/* 我的贡献：通栏贴底（照 leaderboard.wxss:451-546 的 .me-card 一整套） */
.me-card {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: linear-gradient(135deg, #2b6cf6, #5b8cff);
  border-radius: 0;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 -6rpx 18rpx rgba(43, 108, 246, 0.22);
}
.me-body {
  flex: 1;
  min-width: 0;
}
.me-name-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.me-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 4rpx;
}
.me-stats {
  text-align: right;
  flex-shrink: 0;
}
.me-dist {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  font-variant-numeric: tabular-nums;
}
.me-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 4rpx;
}
