<view class="page">
  <!-- 活动不存在 / 首屏失败 / 首屏加载中（三态互斥，避免白屏） -->
  <view wx:if="{{notFound}}" class="state-box">
    <view class="state-text">活动不存在或已被删除</view>
  </view>
  <view wx:elif="{{error}}" class="state-box">
    <view class="state-text">{{error}}</view>
    <view class="state-btn" hover-class="state-btn-hover" bindtap="retry">重试</view>
  </view>
  <view wx:elif="{{loading}}" class="state-box">
    <view class="state-text">加载中…</view>
  </view>

  <!-- 游客态（扫码 / 分享卡落地的新用户）：未登录时一个请求都不发（GET /campaigns/:id 必 401）——
       给专门的登录引导（不是错误态）；登录弹窗只由「登录后查看」触点拉起，进页不自动弹 -->
  <view wx:elif="{{!loggedIn}}" class="login-hint">
    <image class="login-hint-icon" src="/assets/icons/lucide-user.png" mode="aspectFit" />
    <view class="login-hint-text">登录后即可查看并加入该活动</view>
    <button class="login-hint-btn" bindtap="guestLogin">登录后查看</button>
  </view>

  <block wx:else>
    <!-- 顶部：标题 / 时间 / 状态 / 可见性（所有身份都看得到） -->
    <view class="card">
      <view class="head-row">
        <text class="head-title">{{head.title}}</text>
        <text class="campaign-tag {{head.statusTag}}">{{head.statusText}}</text>
      </view>
      <!-- 时间居左、进度文案居右共用一行（进度文案原来单独占一行，白吃一段高度） -->
      <view class="head-line">
        <text class="head-range">{{head.rangeText}}</text>
        <text class="head-progress-text" wx:if="{{progress}}">{{progress.text}}</text>
      </view>
      <!-- 赛程进度条：只在进行中 / 未开始显示（已结束的时间范围本身已说清） -->
      <view class="head-progress" wx:if="{{progress}}">
        <view class="head-progress-track">
          <view class="head-progress-fill" style="width: {{progress.pct}}%"></view>
        </view>
      </view>
      <view class="head-meta">
        <text class="head-meta-item">{{head.visibilityText}}</text>
        <text class="head-meta-item">{{head.limitText}}</text>
        <text class="head-meta-item">{{head.typesText}}</text>
      </view>

      <!-- 发起人专属区 / 邀请 / 退出（Task 11 + 终审 M2）：发起人＝待审批徽标 + 解散；成员＝邀请好友；
           退出活动仅「非发起人成员」（canLeave）渲染——发起人的出路是解散 -->
      <view class="act-row" wx:if="{{isMember && (pendingCount > 0 || canEdit || canInvite || canLeave || canDissolve)}}">
        <view
          class="act-pill act-pill-badge"
          wx:if="{{isCreator && pendingCount > 0}}"
          hover-class="act-pill-hover"
          hover-stay-time="80"
          bindtap="openReview"
        >待审批 {{pendingCount}}</view>
        <!-- 编辑：仅发起人、且活动进行中（已结束 / 已解散都收回入口）。表单复用创建页，带 ?id= 进编辑态 -->
        <view
          class="act-pill"
          wx:if="{{canEdit}}"
          hover-class="act-pill-hover"
          hover-stay-time="80"
          bindtap="goEdit"
        >编辑</view>
        <view class="act-pill" wx:if="{{canInvite}}" hover-class="act-pill-hover" hover-stay-time="80" bindtap="onInvite">邀请好友</view>
        <view
          class="act-pill act-pill-danger"
          wx:if="{{canLeave}}"
          hover-class="act-pill-hover"
          hover-stay-time="80"
          bindtap="onLeave"
        >退出活动</view>
        <view
          class="act-pill act-pill-danger"
          wx:if="{{canDissolve}}"
          hover-class="act-pill-hover"
          hover-stay-time="80"
          bindtap="onDissolve"
        >解散活动</view>
      </view>
    </view>

    <!-- 非成员（未加入 / 待审批 / 已退出 / 已被移出）：身份说明行 + 加入入口 -->
    <view class="card" wx:if="{{!isMember}}">
      <view class="note-row" wx:if="{{stateNote}}">
        <text class="note-text">{{stateNote}}</text>
      </view>
      <view
        class="join-btn {{cta.disabled ? 'join-btn-off' : ''}}"
        hover-class="{{cta.disabled ? 'none' : 'join-btn-hover'}}"
        hover-stay-time="80"
        bindtap="onJoin"
      >{{cta.text}}</view>
      <view class="join-tip">{{ctaHint}}</view>
    </view>

    <!-- 成员：全队汇总三格 -->
    <view class="card" wx:if="{{isMember}}">
      <view class="card-head">
        <view class="card-title">全队汇总</view>
        <view class="card-sub">活动期间全队累计</view>
      </view>
      <view class="sum-row">
        <view class="sum-cell">
          <view class="sum-label">运动次数</view>
          <view class="sum-value">{{totals.countText}}</view>
        </view>
        <view class="sum-cell">
          <view class="sum-label">运动距离 (km)</view>
          <view class="sum-value">{{totals.distanceText}}</view>
        </view>
        <view class="sum-cell">
          <view class="sum-label">运动时长</view>
          <view class="sum-value">{{totals.durationText}}</view>
        </view>
      </view>
    </view>

    <!-- 成员：运动趋势（两档共用一张图：成员＝我 vs 前三 / 类型＝全队分线）
         档位 chip 在卡头右侧，副标题只报桶粒度（按日 / 按周），页面不长高 -->
    <view class="card" wx:if="{{isMember && trend}}">
      <view class="card-head card-head-trend">
        <view class="card-title">运动趋势</view>
        <view class="trend-tools">
          <text class="card-sub">{{trend.subText}}</text>
          <view
            class="filter-chip filter-chip-sm {{trendBy === 'person' ? 'filter-chip-on' : ''}}"
            data-by="person"
            bindtap="onTrendByTap"
          >成员</view>
          <view
            class="filter-chip filter-chip-sm {{trendBy === 'type' ? 'filter-chip-on' : ''}}"
            data-by="type"
            bindtap="onTrendByTap"
          >类型</view>
        </view>
      </view>
      <view class="trend-legend">
        <view class="trend-item" wx:for="{{trend.legend}}" wx:key="key">
          <view class="trend-dot" style="background: {{item.color}}"></view>
          <text class="trend-name {{item.isMe ? 'trend-name-me' : ''}}">{{item.name}}</text>
        </view>
      </view>
      <!-- canvas 是原生层，压不住任何浮层（半屏/弹窗都会被图表穿出去）：
           浮层打开时撤掉图表，用同高占位保住版式，关掉再画回来 -->
      <view wx:if="{{sheetVisible || reviewVisible || codeVisible}}" class="trend-blank"></view>
      <stat-chart
        wx:else
        type="multi-line"
        series="{{trend.series}}"
        labels="{{trend.labels}}"
        unit="km"
        height="{{190}}"
      />
    </view>

    <!-- 模板广告位（后台「广告管理」可开关；免广告卡生效时不渲染） -->
    <ad-template adslot="campaign_detail" radius="{{20}}" />

    <!-- 成员：成员列表＝活动内排行榜（按当前指标降序，点行看该成员汇总与「我 vs TA」） -->
    <view class="card" wx:if="{{isMember}}">
      <view class="card-head">
        <view class="card-title">成员排行</view>
        <view class="card-sub">点成员看明细与对比</view>
      </view>
      <!-- 指标：服务端按所选指标重排（端上不重排）；类型 chip 只在白名单 ≥2 类时出现 -->
      <view class="filter-row">
        <view
          class="filter-chip {{metric === item.key ? 'filter-chip-on' : ''}}"
          wx:for="{{metricOptions}}"
          wx:key="key"
          data-metric="{{item.key}}"
          bindtap="onMetricTap"
        >{{item.label}}</view>
      </view>
      <view class="filter-row filter-row-type" wx:if="{{typeOptions.length}}">
        <view
          class="filter-chip filter-chip-sm {{type === item.key ? 'filter-chip-on' : ''}}"
          wx:for="{{typeOptions}}"
          wx:key="key"
          data-type="{{item.key}}"
          bindtap="onTypeTap"
        >{{item.label}}</view>
      </view>
      <view
        class="rank-row {{item.isMe ? 'rank-row-me' : ''}}"
        wx:for="{{members}}"
        wx:key="userId"
        hover-class="rank-row-hover"
        hover-stay-time="80"
        data-idx="{{index}}"
        bindtap="openMember"
      >
        <view class="rank-no">
          <image wx:if="{{item.medalIcon}}" class="medal-img" src="{{item.medalIcon}}" mode="aspectFit" />
          <text wx:else>{{item.rank}}</text>
        </view>
        <image wx:if="{{item.avatarSrc}}" class="rank-avatar" src="{{item.avatarSrc}}" mode="aspectFill" lazy-load />
        <view wx:else class="rank-avatar rank-avatar-text">{{item.avatarText}}</view>
        <view class="rank-main">
          <view class="rank-top">
            <view class="rank-name-wrap">
              <text class="rank-name">{{item.name}}</text>
              <text class="rank-me" wx:if="{{item.isMe}}">我</text>
              <!-- 移出：紧跟在昵称后（不放行尾——行尾留给主指标）；仅发起人、且非自己（canKick）；
                   catchtap 不冒泡到整行的 openMember -->
              <view
                class="rank-kick"
                wx:if="{{item.canKick}}"
                hover-class="rank-kick-hover"
                hover-stay-time="80"
                data-idx="{{index}}"
                catchtap="onKickTap"
              >移出</view>
            </view>
            <view class="rank-dist">{{item.valueText}}</view>
          </view>
          <view class="rank-meta">{{item.metaText}}</view>
        </view>
      </view>
      <view class="rank-empty" wx:if="{{members.length === 0}}">暂无成员数据</view>
      <!-- 分页是服务端切的，这里只做追加；判据用 total（本页满 20 不代表后面没人）。
           显式一行可点的「加载更多」，不做触底自动加载——整页还要响应下拉刷新，抢滚动会打架。 -->
      <view
        class="rank-more"
        wx:if="{{members.length < memberTotal}}"
        hover-class="rank-more-hover"
        hover-stay-time="80"
        bindtap="loadMoreMembers"
      >{{memberLoadingMore ? '加载中…' : '加载更多'}}（已显示 {{members.length}} / {{memberTotal}}）</view>
    </view>
  </block>

  <!-- 底部悬浮：我的贡献 + 我的位置（照运动榜 .me-card 形态；数据＝详情 myPanel）
       挂在 !notFound && !error 之下：错误态不得残留上一场的成员视图 -->
  <view class="me-card" wx:if="{{!notFound && !error && isMember && panel}}">
    <view class="me-body">
      <view class="me-name-wrap">
        <text class="me-name">我的运动</text>
        <text class="me-rank" wx:if="{{panel.rankText}}">{{panel.rankText}}</text>
      </view>
      <view class="me-sub" wx:if="{{panel.gapText}}">{{panel.gapText}}</view>
      <view class="me-sub" wx:else>{{head.rangeText}} · 本活动内</view>
    </view>
    <view class="me-stats">
      <view class="me-dist">{{panel.distanceText}} km</view>
      <view class="me-count">{{panel.countText}} 次 · 连续 {{panel.streakText}} 天 · {{panel.durationText}}</view>
    </view>
    <view class="me-excluded" wx:if="{{panel.excludedText}}">{{panel.excludedText}}</view>
  </view>

  <!-- 成员信息半屏：标题行是头像+昵称 +「我 vs TA」对照 + 该成员明细（分页，加载更多由页面拉）。
       明细对活动内成员一律开放，页面不再按身份传参。
       同样挂在 !notFound && !error 之下，错误态不得残留成员抽屉 -->
  <campaign-member-sheet
    class="member-sheet-host"
    wx:if="{{!notFound && !error}}"
    visible="{{sheetVisible}}"
    member="{{sheetMember}}"
    detail="{{sheetDetail}}"
    compare="{{sheetCompare}}"
    bind:close="closeMemberSheet"
    bind:loadmore="onSheetLoadMore"
  />

  <!-- 审核抽屉（仅发起人；内联 .mask/.sheet，照 footprints.wxml:112-130 的成员列表半屏形态） -->
  <view wx:if="{{!notFound && !error && reviewVisible}}" class="mask" catchtouchmove="noop" bindtap="closeReview">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">待审批 {{pendingRows.length}}</view>
        <view class="sheet-close" catchtap="closeReview">✕</view>
      </view>
      <view class="pend-row" wx:for="{{pendingRows}}" wx:key="userId">
        <image wx:if="{{item.avatarSrc}}" class="pend-avatar" src="{{item.avatarSrc}}" mode="aspectFill" lazy-load />
        <view wx:else class="pend-avatar pend-avatar-text">{{item.avatarText}}</view>
        <view class="pend-main">
          <view class="pend-name">{{item.name}}</view>
          <view class="pend-sub">申请于 {{item.appliedAtText}}</view>
        </view>
        <view class="pend-btn pend-ok" hover-class="pend-btn-hover" hover-stay-time="80" data-idx="{{index}}" bindtap="onApprove">同意</view>
        <view class="pend-btn pend-no" hover-class="pend-btn-hover" hover-stay-time="80" data-idx="{{index}}" bindtap="onReject">拒绝</view>
      </view>
      <view class="pend-empty" wx:if="{{pendingRows.length === 0}}">没有待审批的申请</view>
    </view>
  </view>

  <!-- 小程序码弹窗（仅 joined 生成）：点图放大 → 预览页长按识别 / 保存 -->
  <view wx:if="{{!notFound && !error && codeVisible}}" class="mask" catchtouchmove="noop" bindtap="closeCode">
    <view class="sheet code-sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">邀请好友</view>
        <view class="sheet-close" catchtap="closeCode">✕</view>
      </view>
      <image class="code-img" src="{{codeSrc}}" mode="aspectFit" bindtap="previewCode" />
      <view class="code-tip">分享给好友扫码一起运动；点击图片放大，长按可识别小程序码 / 保存</view>
      <view class="code-btn" hover-class="code-btn-hover" hover-stay-time="80" bindtap="previewCode">放大查看</view>
      <view class="code-btn code-btn-ghost" hover-class="code-btn-hover" hover-stay-time="80" bindtap="saveCode">保存到相册</view>
    </view>
  </view>
</view>
