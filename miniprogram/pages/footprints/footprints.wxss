/* 足迹 tab 主页壳（Task 4）。分段条配色对齐 pages/tracks/tracks.wxss 的 mode-btn：
   槽底 #f2f3f5 / 激活底 #eef4ff / 圆角 16rpx / 主文字 #1f2329 / 品牌蓝 #2b6cf6 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #f6f7f9;
}

/* 地图 / 列表 切换条 */
.seg {
  flex: none;
  display: flex;
  gap: 8rpx;
  margin: 16rpx 24rpx;
  padding: 8rpx;
  background: #f2f3f5;
  border-radius: 16rpx;
}
.seg-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1f2329;
  border-radius: 12rpx;
}
.seg-item.active {
  background: #eef4ff;
  color: #2b6cf6;
  font-weight: 600;
}

/* 内容区 = 视口高 - 分段条高（64+8*2+16*2=112rpx） */
.body {
  position: relative;
  flex: 1;
  height: calc(100vh - 112rpx);
  overflow: hidden;
}

.center-tip {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}
.center-tip.empty {
  /* 空态盖在地图区之上（.body 已 position:relative）：
     两个 height:100% 兄弟节点会叠成 200% 高，改绝对定位后地图仍可挂载在下方 */
  position: absolute;
  inset: 0;
  height: auto;
  z-index: 1;
  pointer-events: none; /* 不拦截地图拖拽/缩放，也不挡 FAB（FAB z-index 更高） */
  padding: 0 64rpx;
  color: #bbb;
}
.retry {
  margin-left: 8rpx;
  color: #2b6cf6;
  font-weight: 600;
}

.map-wrap,
.list-wrap {
  height: 100%;
}

/* 新增足迹 FAB */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 80rpx;
  z-index: 10;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #2b6cf6;
  color: #fff;
  font-size: 56rpx;
  line-height: 1;
  box-shadow: 0 8rpx 24rpx rgba(43, 108, 246, 0.35);
}
