/* 足迹 tab 主页壳（Task 4）。分段条配色对齐 pages/tracks/tracks.wxss 的 mode-btn：
   槽底 #f2f3f5 / 激活底 #eef4ff / 圆角 16rpx / 主文字 #1f2329 / 品牌蓝 #2b6cf6 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #f6f7f9;
}

/* 地图 / 列表 切换条 */
.seg {
  flex: none;
  display: flex;
  gap: 8rpx;
  margin: 16rpx 24rpx;
  padding: 8rpx;
  background: #f2f3f5;
  border-radius: 16rpx;
}
.seg-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1f2329;
  border-radius: 12rpx;
}
.seg-item.active {
  background: #eef4ff;
  color: #2b6cf6;
  font-weight: 600;
}

/* 内容区 = 视口高 - 分段条高（64+8*2+16*2=112rpx） */
.body {
  position: relative;
  flex: 1;
  height: calc(100vh - 112rpx);
  overflow: hidden;
}

.center-tip {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}
.center-tip.empty {
  /* 空态盖在地图区之上（.body 已 position:relative）：
     两个 height:100% 兄弟节点会叠成 200% 高，改绝对定位后地图仍可挂载在下方 */
  position: absolute;
  inset: 0;
  height: auto;
  z-index: 1;
  pointer-events: none; /* 不拦截地图拖拽/缩放，也不挡 FAB（FAB z-index 更高） */
  padding: 0 64rpx;
  color: #bbb;
}
.retry {
  margin-left: 8rpx;
  color: #2b6cf6;
  font-weight: 600;
}

.map-wrap,
.list-wrap {
  height: 100%;
}

.fp-map {
  width: 100%;
  height: 100%;
}

/* 地图内刷新按钮（替代已禁用的页面下拉刷新） */
.map-refresh {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 5;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  color: #2b6cf6;
  font-size: 44rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
.map-refresh.spinning {
  animation: fp-refresh-spin 0.9s linear infinite;
}
@keyframes fp-refresh-spin {
  to {
    transform: rotate(360deg);
  }
}

/* ===== 列表形态（Task 6）=====
   卡片度量对齐 pages/tracks/tracks.wxss：.track-card 白卡（圆角 16rpx + box-shadow 0 2rpx 12rpx rgba(0,0,0,.04)）、
   .list-row 内边距 24rpx 28rpx、缩略图 156rpx（= .track-thumb 高）、次要文字 #8a93a6、hover 0.7 */
.list-scroll {
  height: 100%;
  box-sizing: border-box;
  padding: 0 24rpx; /* 卡片左右留白同 tracks 页 .container（app.wxss）的 24rpx */
}
.fp-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.fp-card-hover {
  opacity: 0.7;
}
.fp-thumb {
  flex: none;
  width: 156rpx;
  height: 156rpx;
  margin-right: 24rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
}
.fp-thumb.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #bbb;
}
.fp-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}
.fp-card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fp-card-sub {
  font-size: 24rpx;
  color: #8a93a6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fp-card-people {
  font-size: 22rpx;
  color: #8a93a6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 列表尾提示：对齐 tracks 的 .loading-tip（text-align center + padding 24rpx 0）与 .text-muted */
.list-tip {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}
/* 末条卡片不被 FAB（bottom 80rpx + 104rpx）压住 */
.list-pad {
  height: 184rpx;
}

/* 详情弹窗：底部白色圆角浮层，观感对齐 pages/report 的周期选择弹窗（.picker-mask/.picker-sheet） */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 8rpx;
}
.sheet-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sheet-close {
  flex: none;
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 30rpx;
  color: #999;
}
.sheet-meta {
  font-size: 24rpx;
  color: #8a9099;
}
.sheet-people {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #1f2329;
}
.sheet-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #4b525c;
}
.sheet-photos {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}
.sheet-photo {
  display: inline-block;
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
}
.sheet-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 28rpx;
}
.act-btn {
  margin: 0 0 0 16rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #2b6cf6;
  background: #eef4ff;
  border-radius: 16rpx;
}
.act-btn.danger {
  color: #e54d42;
  background: #fdecec;
}

/* 成员列表半屏（最大缩放仍并簇的兜底） */
.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.member-title {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member-date {
  flex: none;
  font-size: 24rpx;
  color: #8a9099;
}

/* 新增足迹 FAB */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 80rpx;
  z-index: 10;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #2b6cf6;
  color: #fff;
  font-size: 56rpx;
  line-height: 1;
  box-shadow: 0 8rpx 24rpx rgba(43, 108, 246, 0.35);
}
