/* 足迹 tab 主页：整页即地图（全屏地图 + 浮层入口）。
   浮层配色对齐页面既有风格：白底 pill / 品牌蓝 #2b6cf6 / 圆角 16rpx / hover #eef4ff */
.page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #f6f7f9;
}

.fp-map {
  width: 100%;
  height: 100%;
}

/* 加载/错误/空态浮层（盖在整屏地图上） */
.center-tip {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}
.center-tip.veil {
  background: rgba(255, 255, 255, 0.72);
}
.center-tip.empty {
  color: #bbb;
  pointer-events: none; /* 不拦截地图拖拽/缩放，也不挡 FAB（FAB z-index 更高） */
}
.retry {
  margin-left: 8rpx;
  color: #2b6cf6;
  font-weight: 600;
}

/* —— 浮层按钮统一规格：88rpx 白圆底 + 40rpx 黑色 lucide 字形 + 同一档投影 ——
   五组按钮（左上竖排、右上搜索、右下图层/列表/新增）共用 .tool-btn，风格差异只用修饰类表达 */
.tool-col {
  position: absolute;
  z-index: 5;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  transition: opacity 0.2s ease;
}
.tool-col-left {
  top: 24rpx;
  left: 24rpx;
}
.tool-col-right {
  right: 24rpx;
  bottom: 40rpx;
}
/* 左下：标志（POI 标注）开关，与右列同一条底边基准 */
.tool-col-left-bottom {
  left: 24rpx;
  bottom: 40rpx;
}
/* 搜索展开时左上整列淡出（输入框要占满这一行） */
.tool-fade {
  opacity: 0;
  pointer-events: none;
}
.tool-btn {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.14);
}
.tool-btn-hover {
  background: #f2f3f5;
}
.tool-icon {
  width: 40rpx;
  height: 40rpx;
}
/* 有筛选生效时给个蓝环，收起状态下也看得出来"当前不是全量" */
.tool-btn-on {
  box-shadow: 0 0 0 3rpx #2b6cf6, 0 2rpx 12rpx rgba(0, 0, 0, 0.14);
}
/* 标志（POI 标注）开关的选中态：轨迹页那枚是蓝底白字形（.poi-btn-active），
   白图标配蓝环会白成一片看不见，故这里也走蓝底，不套用 .tool-btn-on */
.tool-btn-poi-on {
  background: #2b6cf6;
}
.tool-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: #2b6cf6;
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  border: 2rpx solid #fff;
}
/* 右下三个入口（图层 / 列表 / 新增）与左上筛选、右上搜索同一套度量：88rpx 白圆 + 40rpx 黑色图标 */

/* 右上搜索：收起时是一个圆钮，展开时向左长成整行输入框 */
.search-dock {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 6;
  width: 88rpx;
  height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.14);
  transition: width 0.22s ease;
}
.search-dock-open {
  width: calc(100% - 48rpx);
}
.dock-icon {
  flex: none;
}
.dock-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #1f2329;
}
.dock-placeholder {
  color: #b6bcc6;
  font-size: 26rpx;
}
.dock-clear {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f2f3f5;
  color: #8a9099;
  font-size: 22rpx;
}
.search-dock .tool-badge {
  top: 2rpx;
  right: 2rpx;
}

/* 半屏容器（成员列表兜底用；详情/表单各自是组件自带样式） */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  /* tab 页：弹层底边在 tabBar 上方，不需要再加屏幕底部安全区 */
  padding: 0 32rpx 24rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 8rpx;
}
.sheet-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sheet-close {
  flex: none;
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 30rpx;
  color: #999;
}

/* 成员列表半屏（最大缩放仍并簇的兜底） */
.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.member-title {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member-date {
  flex: none;
  font-size: 24rpx;
  color: #8a9099;
}

/* 新增足迹按钮已并入右下 .tool-col-right（原 .fab 蓝底白字与四个按钮风格不统一，删除） */

/* 有图单点的照片卡气泡（customCallout 内容）：图上标题下，圆角卡片 */
.fp-callout {
  width: 108px;
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
}
.fp-callout-img {
  width: 108px;
  height: 64px;
}
.fp-callout-title {
  height: 20px;
  line-height: 20px;
  padding: 0 6px;
  font-size: 12px;
  color: #1f2329;
  overflow: hidden;
}
/* 无图变体：标题胶囊（白底圆角小标签，宽度随文字自适应） */
.fp-callout-pill {
  width: auto;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 999px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
}
.fp-callout-title-pill {
  height: 24px;
  line-height: 24px;
  padding: 0 12px;
  text-align: center;
  font-size: 11px;
  color: #1f2329;
}
