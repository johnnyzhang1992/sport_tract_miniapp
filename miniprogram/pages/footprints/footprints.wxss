/* 足迹 tab 主页：整页即地图（全屏地图 + 浮层入口）。
   浮层配色对齐页面既有风格：白底 pill / 品牌蓝 #2b6cf6 / 圆角 16rpx / hover #eef4ff */
.page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #f6f7f9;
}

.fp-map {
  width: 100%;
  height: 100%;
}

/* 加载/错误/空态浮层（盖在整屏地图上） */
.center-tip {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}
.center-tip.veil {
  background: rgba(255, 255, 255, 0.72);
}
.center-tip.empty {
  color: #bbb;
  pointer-events: none; /* 不拦截地图拖拽/缩放，也不挡 FAB（FAB z-index 更高） */
}
.retry {
  margin-left: 8rpx;
  color: #2b6cf6;
  font-weight: 600;
}

/* 左上浮层入口：列表 / 统计 */
.map-entries {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 5;
  display: flex;
  gap: 16rpx;
}
.entry-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx; /* 不设固定高度，由内边距随内容撑起 */
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #2b6cf6;
  font-size: 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
/* 图标用 lucide 蓝色版（#2b6cf6，与胶囊文案同色；深色原版留给轨迹页/我的页） */
.entry-icon {
  flex: none;
  width: 26rpx;
  height: 26rpx;
}
.entry-btn-hover {
  background: #eef4ff;
}

/* 右上刷新按钮（替代已禁用的页面下拉刷新）：⟳ + 文案的胶囊，与左侧入口同族 */
.map-refresh {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #2b6cf6;
  font-size: 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}
.refresh-icon {
  flex: none;
  width: 24rpx;
  height: 24rpx;
}
/* 点一下转三圈（一次性 1080°，缓入缓出）：由页面置 refreshSpin 触发，转完即复位 */
.refresh-icon.spin-once {
  animation: fp-refresh-spin 1.5s cubic-bezier(0.4, 0, 0.2, 1);
}
@keyframes fp-refresh-spin {
  to {
    transform: rotate(1080deg);
  }
}

/* 半屏容器（成员列表兜底用；详情/表单各自是组件自带样式） */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  /* tab 页：弹层底边在 tabBar 上方，不需要再加屏幕底部安全区 */
  padding: 0 32rpx 24rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 8rpx;
}
.sheet-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sheet-close {
  flex: none;
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 30rpx;
  color: #999;
}

/* 成员列表半屏（最大缩放仍并簇的兜底） */
.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.member-title {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member-date {
  flex: none;
  font-size: 24rpx;
  color: #8a9099;
}

/* 新增足迹 FAB */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 80rpx;
  z-index: 10;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #2b6cf6;
  color: #fff;
  font-size: 56rpx;
  line-height: 1;
  box-shadow: 0 8rpx 24rpx rgba(43, 108, 246, 0.35);
}

/* 有图单点的照片卡气泡（customCallout 内容）：图上标题下，圆角卡片 */
.fp-callout {
  width: 108px;
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
}
.fp-callout-img {
  width: 108px;
  height: 64px;
}
.fp-callout-title {
  height: 20px;
  line-height: 20px;
  padding: 0 6px;
  font-size: 12px;
  color: #1f2329;
  overflow: hidden;
}
/* 无图变体：标题胶囊（白底圆角小标签，宽度随文字自适应） */
.fp-callout-pill {
  width: auto;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 999px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
}
.fp-callout-title-pill {
  height: 24px;
  line-height: 24px;
  padding: 0 12px;
  text-align: center;
  font-size: 11px;
  color: #1f2329;
}
