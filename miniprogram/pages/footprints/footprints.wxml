<view class="page">
  <!-- 全屏地图 + 浮层入口（左上：列表/统计；右上：刷新；右下：＋） -->
  <map
    id="footprintMap"
    class="fp-map"
    longitude="{{center.longitude}}" latitude="{{center.latitude}}" scale="{{scale}}"
    markers="{{markers}}"
    show-location
    bindload="onMapLoad"
    bindmarkertap="onMarkerTap"
    bindcallouttap="onMarkerTap"
    bindregionchange="onRegionChange"
    bindpoitap="onPoiTap"
  />

  <view wx:if="{{loading}}" class="center-tip veil">加载中…</view>
  <view wx:elif="{{error}}" class="center-tip veil">{{error}} <text class="retry" bindtap="loadAll">重试</text></view>
  <view wx:elif="{{records.length === 0}}" class="center-tip empty">还没有足迹，点右下角 ＋ 记录第一个去过的地方</view>

  <view class="map-entries">
    <view class="entry-btn" hover-class="entry-btn-hover" bindtap="goList">
      <image class="entry-icon" src="/assets/icons/lucide-text-align-justify.png" mode="aspectFit" />
      <text>列表</text>
    </view>
    <view class="entry-btn" hover-class="entry-btn-hover" bindtap="goStats">
      <image class="entry-icon" src="/assets/icons/lucide-chart.png" mode="aspectFit" />
      <text>统计</text>
    </view>
  </view>
  <!-- 刷新：lucide 图标 + 文案；点一下图标转一圈（文案不跟着转） -->
  <view class="map-refresh" hover-class="entry-btn-hover" bindtap="onRefreshTap">
    <image
      class="refresh-icon {{refreshSpin ? 'spin-once' : ''}}"
      src="/assets/icons/lucide-refresh-cw.png"
      mode="aspectFit"
    />
    <text>刷新</text>
  </view>

  <!-- 详情半屏（地图/列表页共用组件；「编辑」转表单、删除后刷新地图） -->
  <footprint-detail
    visible="{{detailVisible}}"
    record="{{detailRecord}}"
    bind:close="closeDetail"
    bind:edit="onDetailEdit"
    bind:deleted="onDetailDeleted"
  />

  <!-- 最大缩放簇仍并在一起的兜底：成员列表半屏（标题+日期，点行 → 详情） -->
  <view wx:if="{{clusterSheet.visible}}" class="mask" bindtap="closeClusterSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">此处共 {{clusterSheet.records.length}} 条足迹</view>
        <view class="sheet-close" catchtap="closeClusterSheet">✕</view>
      </view>
      <view
        class="member-row"
        wx:for="{{clusterSheet.records}}"
        wx:key="id"
        data-idx="{{index}}"
        catchtap="pickClusterMember"
      >
        <view class="member-title">{{item.title}}</view>
        <view class="member-date">{{item.visitDate}}</view>
      </view>
    </view>
  </view>

  <!-- 新增/编辑半屏表单（组件内完成 编辑→检测→上传→保存；保存成功后由页面刷新地图） -->
  <footprint-form
    visible="{{formVisible}}"
    record="{{formRecord}}"
    bind:saved="onFormSaved"
    bind:close="closeForm"
  />

  <view class="fab" bindtap="openAdd">＋</view>
</view>
