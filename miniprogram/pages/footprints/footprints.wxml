<view class="page">
  <view class="seg">
    <view class="seg-item {{mode === 'map' ? 'active' : ''}}" data-mode="map" bindtap="switchMode">地图</view>
    <view class="seg-item {{mode === 'list' ? 'active' : ''}}" data-mode="list" bindtap="switchMode">列表</view>
  </view>

  <view class="body">
    <view wx:if="{{loading}}" class="center-tip">加载中…</view>
    <view wx:elif="{{error}}" class="center-tip">{{error}} <text class="retry" bindtap="loadAll">重试</text></view>
    <block wx:else>
      <!-- 空态浮层：地图/列表两种形态共用（.center-tip.empty 绝对定位 + pointer-events:none，
           列表模式下不挡滚动），故不放进 .list-scroll 内部 -->
      <view
        wx:if="{{(mode === 'map' && records.length === 0) || (mode === 'list' && items.length === 0)}}"
        class="center-tip empty"
      >还没有足迹，点右下角 ＋ 记录第一个去过的地方</view>
      <view wx:if="{{mode === 'map'}}" class="map-wrap">
        <!-- 本地网格聚合 + 自绘小圆气泡（原生默认簇尺寸/配色不可改，3104c7c 实测参数被忽略，见 docs/11 §4.2）：
             markers 由 buildMarkers 生成后声明式绑定，节点重建（loading 闸门/模式切换）时自动重挂；
             点簇 → onMarkerTap 按 id 分段：叶 marker 开详情，簇气泡放大展开，封顶后走成员半屏；
             bindcallouttap 只在离屏 canvas 不可用的退化形态下起作用（那时簇是 marker-dot + ALWAYS callout
             数字，点数字命中的是 callout 而非 marker），e.detail.markerId 与 bindmarkertap 同形，共用一个处理函数 -->
        <map
          id="footprintMap"
          class="fp-map"
          longitude="{{center.longitude}}" latitude="{{center.latitude}}" scale="{{scale}}"
          markers="{{markers}}"
          show-location
          bindload="onMapLoad"
          bindmarkertap="onMarkerTap"
          bindcallouttap="onMarkerTap"
          bindregionchange="onRegionChange"
          bindpoitap="onPoiTap"
        />
        <!-- 页面下拉刷新已禁用（拖动地图会误触发），地图内提供刷新按钮 -->
        <view class="map-refresh {{loading || loadingList ? 'spinning' : ''}}" bindtap="loadAll">⟳</view>
      </view>
      <view wx:if="{{mode === 'list'}}" class="list-wrap">
        <!-- 分页列表：触底翻页闸门在 JS 侧（hasMore && loadingList），卡片字段见 toCard() -->
        <scroll-view
          scroll-y
          lower-threshold="80"
          class="list-scroll"
          bindscrolltolower="onListReachBottom"
        >
          <view
            wx:for="{{items}}"
            wx:key="id"
            class="fp-card"
            hover-class="fp-card-hover"
            hover-stay-time="80"
            data-idx="{{index}}"
            bindtap="onCardTap"
          >
            <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" lazy-load class="fp-thumb"/>
            <view wx:else class="fp-thumb placeholder">图</view>
            <view class="fp-card-main">
              <view class="fp-card-title">{{item.title}}</view>
              <view class="fp-card-sub">{{item.subText}}</view>
              <view wx:if="{{item.peopleText}}" class="fp-card-people">同行：{{item.peopleText}}</view>
            </view>
          </view>
          <view wx:if="{{loadingList}}" class="list-tip">加载中…</view>
          <view wx:elif="{{!hasMore && items.length}}" class="list-tip">没有更多了</view>
          <view class="list-pad"></view>
        </scroll-view>
      </view>
    </block>
  </view>

  <!-- 足迹详情弹窗（marker/列表卡共用；map 同层渲染后普通 view 可盖住地图） -->
  <view wx:if="{{popup.visible}}" class="mask" bindtap="closePopup">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">{{popup.record.title}}</view>
        <view class="sheet-close" catchtap="closePopup">✕</view>
      </view>
      <view class="sheet-meta">{{popup.record.metaText}}</view>
      <view wx:if="{{popup.record.peopleText}}" class="sheet-people">同行：{{popup.record.peopleText}}</view>
      <view wx:if="{{popup.record.description}}" class="sheet-desc">{{popup.record.description}}</view>
      <scroll-view wx:if="{{popup.record.photos.length}}" scroll-x class="sheet-photos">
        <image
          wx:for="{{popup.record.photos}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          class="sheet-photo"
          data-urls="{{popup.record.photos}}"
          data-idx="{{index}}"
          bindtap="previewPhoto"
        />
      </scroll-view>
      <view class="sheet-actions">
        <button class="act-btn" size="mini" bindtap="editRecord">编辑</button>
        <button class="act-btn danger" size="mini" bindtap="removeRecord">删除</button>
      </view>
    </view>
  </view>

  <!-- 最大缩放簇仍并在一起的兜底：成员列表半屏（标题+日期，点行 → 详情弹窗） -->
  <view wx:if="{{clusterSheet.visible}}" class="mask" bindtap="closeClusterSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">此处共 {{clusterSheet.records.length}} 条足迹</view>
        <view class="sheet-close" catchtap="closeClusterSheet">✕</view>
      </view>
      <view
        class="member-row"
        wx:for="{{clusterSheet.records}}"
        wx:key="id"
        data-idx="{{index}}"
        catchtap="pickClusterMember"
      >
        <view class="member-title">{{item.title}}</view>
        <view class="member-date">{{item.visitDate}}</view>
      </view>
    </view>
  </view>

  <!-- 新增/编辑半屏表单（组件内完成 编辑→检测→上传→保存；保存成功后由页面刷新地图/列表） -->
  <footprint-form
    visible="{{formVisible}}"
    record="{{formRecord}}"
    bind:saved="onFormSaved"
    bind:close="closeForm"
  />

  <view class="fab" bindtap="openAdd">＋</view>
</view>
