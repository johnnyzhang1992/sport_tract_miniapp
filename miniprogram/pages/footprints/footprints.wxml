<view class="page">
  <!-- 全屏地图 + 浮层入口（左上：筛选；右上：搜索；右下：图层 / 列表 / ＋） -->
  <map
    id="footprintMap"
    class="fp-map"
    longitude="{{center.longitude}}" latitude="{{center.latitude}}" scale="{{scale}}"
    markers="{{markers}}"
    show-location
    enable-satellite="{{mapType === 'satellite'}}"
    enable-poi="{{enablePoi}}"
    bindload="onMapLoad"
    bindmarkertap="onMarkerTap"
    bindcallouttap="onMarkerTap"
    bindregionchange="onRegionChange"
    bindpoitap="onPoiTap"
  >
    <!-- 无图单点的标题胶囊气泡（常显）；有图单点走离屏合成的照片卡 marker 图标 -->
    <cover-view slot="callout">
      <cover-view
        wx:for="{{callouts}}"
        wx:key="id"
        marker-id="{{item.id}}"
        class="fp-callout fp-callout-pill"
      >
        <cover-view class="fp-callout-title fp-callout-title-pill">{{item.title}}</cover-view>
      </cover-view>
    </cover-view>
  </map>

  <view wx:if="{{loading}}" class="center-tip veil">加载中…</view>
  <view wx:elif="{{error}}" class="center-tip veil">{{error}} <text class="retry" bindtap="loadAll">重试</text></view>
  <!-- 游客态：一个请求都不发（/geo 必 401），空地图上给可点的登录引导；与 ＋ 同一道闸门。
       与下面的空账号引导共用 .fp-tip 白胶囊外观（底图上裸文字读不清）。 -->
  <view
    wx:elif="{{notLoggedIn}}"
    class="fp-tip fp-tip-login"
    hover-class="fp-tip-hover"
    hover-stay-time="80"
    bindtap="onLoginTap"
  >
    <text>登录后记录你去过的每个地方</text>
    <text class="fp-tip-link">去登录 ›</text>
  </view>
  <!-- 筛选/搜索无命中不再摆这里：地图上不盖浮层文本，改由页面 toast（见 footprints.js noMatchToast）。
       条件必须带「无筛选且无关键词」，否则查不到东西时这条引导会漏出来盖在地图上（模拟器实测踩过）。 -->
  <view wx:elif="{{records.length === 0 && !filterCount && !keyword}}" class="fp-tip">还没有足迹，点右下角 ＋ 记录第一个去过的地方</view>

  <!-- 浮层按钮统一规格：白底圆形 + 黑色 lucide 字形（对标参考图，不再是白底蓝字胶囊） -->
  <!-- 左上：只有筛选（带生效角标）；搜索展开时整列淡出。统计入口在列表页顶部栏 -->
  <view class="tool-col tool-col-left {{searchOpen ? 'tool-fade' : ''}}">
    <view class="tool-btn {{filterCount ? 'tool-btn-on' : ''}}" hover-class="tool-btn-hover" bindtap="openFilter">
      <image class="tool-icon" src="/assets/icons/lucide-sliders-horizontal.png" mode="aspectFit" />
      <view wx:if="{{filterCount}}" class="tool-badge">{{filterCount}}</view>
    </view>
  </view>

  <!-- 左下：标志（底图 POI 标注 地名/道路名）开关，图标与行为同轨迹页的 track-map
       （选中＝蓝底白字形，同 .poi-btn-active）；单独一列，不跟搜索展开的左上列一起淡出 -->
  <view class="tool-col tool-col-left-bottom">
    <view class="tool-btn {{enablePoi ? 'tool-btn-poi-on' : ''}}" hover-class="tool-btn-hover" bindtap="togglePoi">
      <image class="tool-icon" src="{{enablePoi ? '/assets/icons/lucide-signpost-white.png' : '/assets/icons/lucide-signpost.png'}}" mode="aspectFit" />
    </view>
  </view>

  <!-- 右上：搜索按钮，点一下向左展开成整行输入框（✕ 清空、回车生效、再点图标收起） -->
  <view class="search-dock {{searchOpen ? 'search-dock-open' : ''}}">
    <image
      class="tool-icon dock-icon"
      src="/assets/icons/lucide-search.png"
      mode="aspectFit"
      bindtap="toggleSearch"
    />
    <input
      wx:if="{{searchOpen}}"
      class="dock-input"
      placeholder="搜索标题 / 描述 / 同行人 / 省市 / 位置"
      placeholder-class="dock-placeholder"
      value="{{keywordInput}}"
      focus="{{searchFocus}}"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onSearchConfirm"
    />
    <view wx:if="{{searchOpen}}" class="dock-clear" catchtap="onClearKeyword">✕</view>
    <view wx:if="{{!searchOpen && keyword}}" class="tool-badge">1</view>
  </view>

  <!-- 右下竖排：图层 / 列表 / 新增。图层只一个字形不表达「当前是哪张底图」，
       卫星档沿用筛选那圈蓝环（.tool-btn-on）来表达，不另造样式 -->
  <view class="tool-col tool-col-right">
    <view class="tool-btn {{mapType === 'satellite' ? 'tool-btn-on' : ''}}" hover-class="tool-btn-hover" bindtap="toggleLayer">
      <image class="tool-icon" src="/assets/icons/lucide-layers.png" mode="aspectFit" />
    </view>
    <view class="tool-btn" hover-class="tool-btn-hover" bindtap="goList">
      <image class="tool-icon" src="/assets/icons/lucide-text-align-justify.png" mode="aspectFit" />
    </view>
    <view class="tool-btn" hover-class="tool-btn-hover" bindtap="openAdd">
      <image class="tool-icon" src="/assets/icons/lucide-plus.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 详情半屏（地图/列表页共用组件；「编辑」转表单、删除后刷新地图） -->
  <footprint-detail
    visible="{{detailVisible}}"
    record="{{detailRecord}}"
    safe-bottom="{{false}}"
    bind:close="closeDetail"
    bind:edit="onDetailEdit"
    bind:deleted="onDetailDeleted"
  />

  <!-- 最大缩放簇仍并在一起的兜底：成员列表半屏（标题+日期，点行 → 详情） -->
  <view wx:if="{{clusterSheet.visible}}" class="mask" bindtap="closeClusterSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">此处共 {{clusterSheet.records.length}} 条足迹</view>
        <view class="sheet-close" catchtap="closeClusterSheet">✕</view>
      </view>
      <view
        class="member-row"
        wx:for="{{clusterSheet.records}}"
        wx:key="id"
        data-idx="{{index}}"
        catchtap="pickClusterMember"
      >
        <view class="member-title">{{item.title}}</view>
        <view class="member-date">{{item.visitDate}}</view>
      </view>
    </view>
  </view>

  <!-- 新增/编辑半屏表单（组件内完成 编辑→检测→上传→保存；保存成功后由页面刷新地图） -->
  <footprint-form
    visible="{{formVisible}}"
    record="{{formRecord}}"
    safe-bottom="{{false}}"
    on-tab="{{true}}"
    bind:saved="onFormSaved"
    bind:close="closeForm"
  />

  <!-- 筛选半屏：省份/年份/分类，草稿态，点确定才回传 -->
  <footprint-filter-sheet
    visible="{{filterVisible}}"
    value="{{filter}}"
    options="{{options}}"
    safe-bottom="{{false}}"
    bind:close="closeFilter"
    bind:confirm="onFilterConfirm"
  />
</view>
