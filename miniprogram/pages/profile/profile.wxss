.avatar-card {
  display: flex;
  justify-content: center;
  padding: 48rpx 0;
}
.avatar-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #eef4ff;
}
.avatar-hover {
  opacity: 0.8;
}
.avatar-img {
  width: 100%;
  height: 100%;
}
.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}
.avatar-edit {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 8rpx 0;
}
.field-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.field-input {
  font-size: 32rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #eee;
}
.field-tip {
  margin-top: 12rpx;
}
.gender-row {
  display: flex;
}
.gender-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background: #f7f8fa;
  margin-right: 16rpx;
  font-size: 28rpx;
}
.gender-item:last-child {
  margin-right: 0;
}
.gender-active {
  background: #eef4ff;
  color: #2b6cf6;
  border: 2rpx solid #2b6cf6;
}
