/* 页面根容器覆盖全局 .container：底部留出 iPhone Home Indicator 安全区 */
.container {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.avatar-card {
  display: flex;
  justify-content: center;
  padding: 48rpx 0;
}
.avatar-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #eef4ff;
}
.avatar-hover {
  opacity: 0.8;
}
.avatar-img {
  width: 100%;
  height: 100%;
}
.avatar-placeholder {
  width: 100%;
  height: 100%;
  padding: 56rpx;
  box-sizing: border-box;
}
.avatar-edit {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 8rpx 0;
}
.field-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.field-input {
  font-size: 32rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #eee;
}
.field-tip {
  margin-top: 12rpx;
}
.gender-row {
  display: flex;
}
.gender-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background: #f7f8fa;
  margin-right: 16rpx;
  font-size: 28rpx;
}
.gender-item:last-child {
  margin-right: 0;
}
.gender-active {
  background: #eef4ff;
  color: #2b6cf6;
  border: 2rpx solid #2b6cf6;
}

/* 身体数据提示 */
.body-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
}

/* 体重趋势入口卡片 */
.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}
.switch-info {
  flex: 1;
}
.switch-title {
  font-size: 28rpx;
  color: #1f2329;
}
.link-arrow {
  font-size: 40rpx;
  color: #c2c7d0;
}
.card-hover {
  opacity: 0.8;
}

/* 首次注册引导说明 */
.guide-tip {
  background: #eef4ff;
  color: #2b6cf6;
  font-size: 26rpx;
  padding: 20rpx 28rpx;
  border-radius: 14rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

/* 默认头像预设网格（DEFAULT_AVATARS 非空时展示） */
.avatar-presets {
  margin-top: 20rpx;
}
.presets-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 14rpx;
}
.presets-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr); /* 每行 5 等分，图标居中占满行宽 */
  row-gap: 20rpx;
  justify-items: center;
}
.preset-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid transparent;
}
.preset-avatar-active {
  border-color: #2b6cf6;
}
.preset-avatar image {
  width: 100%;
  height: 100%;
}

/* 选择头像弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}
.upload-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #eef4ff;
  margin-bottom: 28rpx;
}
.upload-entry-hover {
  background: #dce7fd;
}
.upload-entry-icon {
  font-size: 40rpx;
}
.upload-entry-text {
  flex: 1;
}
.upload-entry-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2329;
}
.upload-entry-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.upload-entry-arrow {
  font-size: 34rpx;
  color: #c2c7d0;
}
.presets-empty {
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
  padding: 20rpx 0 8rpx;
}
