<view class="container">
  <!-- 头像 -->
  <view class="card avatar-card">
    <view class="avatar-wrap" bindtap="chooseAvatar" hover-class="avatar-hover">
      <image wx:if="{{avatarTemp || avatarUrl}}" class="avatar-img" src="{{avatarTemp || avatarUrl}}" mode="aspectFill" />
      <image wx:else class="avatar-placeholder" src="/assets/icons/lucide-user.png" mode="aspectFit" />
      <view class="avatar-edit">更换头像</view>
    </view>
  </view>

  <!-- 昵称 -->
  <view class="card">
    <view class="field-label">昵称</view>
    <input
      class="field-input"
      type="nickname"
      placeholder="请输入昵称"
      value="{{nickname}}"
      bindinput="onNicknameInput"
      maxlength="30"
    />
    <view class="text-muted field-tip">昵称将经过微信内容安全检测</view>
  </view>

  <!-- 性别 -->
  <view class="card">
    <view class="field-label">性别</view>
    <view class="gender-row">
      <view class="gender-item {{gender === 0 ? 'gender-active' : ''}}" data-gender="0" bindtap="onGenderTap">保密</view>
      <view class="gender-item {{gender === 1 ? 'gender-active' : ''}}" data-gender="1" bindtap="onGenderTap">男</view>
      <view class="gender-item {{gender === 2 ? 'gender-active' : ''}}" data-gender="2" bindtap="onGenderTap">女</view>
    </view>
  </view>

  <!-- 身体数据（卡路里/运动数据计算用） -->
  <view class="card">
    <view class="field-label">身高（cm）</view>
    <input class="field-input" type="number" value="{{heightCm}}" bindinput="onHeightInput" placeholder="请输入身高" />
    <view class="field-label">体重（kg）</view>
    <input class="field-input" type="number" value="{{weightKg}}" bindinput="onWeightInput" placeholder="请输入体重" />
    <view class="text-muted body-tip">身高体重用于更准确地估算运动卡路里消耗</view>
  </view>

  <!-- 体重趋势入口 -->
  <view class="card link-card" bindtap="goWeightTrend" hover-class="card-hover">
    <view class="switch-info">
      <view class="switch-title">体重趋势</view>
      <view class="text-muted">查看体重变化记录（天/周/月/年）</view>
    </view>
    <view class="link-arrow">›</view>
  </view>

  <t-button
    theme="primary"
    size="large"
    block
    loading="{{saving}}"
    bind:tap="save"
  >保存</t-button>
</view>
