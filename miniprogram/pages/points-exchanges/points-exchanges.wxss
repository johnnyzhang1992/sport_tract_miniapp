.page {
  min-height: 100vh;
  background: #f5f6f8;
  /* 底部 96rpx + Home 指示条安全区（2026-10-29 用户反馈：列表下方空白偏小） */
  padding: 24rpx 24rpx calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.state {
  padding: 160rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a93a6;
}

.state-tap {
  color: #2b6cf6;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}

/* 列表包裹层：让 .exchange-row:last-child 真正命中末行去分隔线 */
.exchange-list {
  display: block;
}

.exchange-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.exchange-row:last-child {
  border-bottom: none;
}

.exchange-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.exchange-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.exchange-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.exchange-status {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: #f2f3f5;
  color: #8a93a6;
}

/* 状态胶囊按 app.wxss .campaign-tag 的约定：基类＝中性灰，所以「已使用」「已过期」都落回基类，
   只有还能用的「未使用」才加修饰类（用全局的 active 蓝，不是参考稿的黄） */
.exchange-status.status-unused {
  background: #eaf1ff;
  color: #2b6cf6;
}

.exchange-time,
.exchange-expire,
.exchange-used {
  font-size: 22rpx;
  color: #8a93a6;
}

/* 物流单号行：整行可点复制，右侧显式「复制」胶囊（不靠用户猜；灰底是为了不跟确认收货抢蓝色） */
.meta-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}


.exchange-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.exchange-cost {
  font-size: 28rpx;
  font-weight: 700;
  color: #667080; /* 与积分明细页的支出行同色，别在两个页给出两种「花掉」的深浅 */
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 180rpx 0;
}

.empty-title {
  font-size: 26rpx;
  color: #8a93a6;
}

.empty-link {
  font-size: 24rpx;
  color: #2b6cf6;
}
/* ===== 我的卡（三来源可见 + 行内激活） ===== */

/* ===== 我的卡：统一卡结构（三来源一张列表） =====
   设计口径：白卡容器 + 浅灰卡块；徽章右上角；元信息 label 定宽对齐；
   积分用本项目的荣誉金；唯一彩色动作是「立即激活」，其余全部黑白灰 */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card-item {
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  min-width: 0;
}

/* 徽章：右上角、胶囊、细分状态配色 */
.card-badge {
  flex: none;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #667080;
  background: #eceef1;
}

.card-badge.status-unused {
  color: #2b6cf6;
  background: #eaf1ff;
}

.card-badge.card-status-active {
  color: #1f9d61;
  background: #e6f7ef;
}

.card-badge.card-status-queued {
  color: #b26a00;
  background: #fff3e0;
}

.card-meta {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

/* 卡内元信息行两端贴边：label 顶左、值顶右（定宽 label 是订单区寄往/物流的排法，卡内不用） */
.meta-row {
  display: flex;
  align-items: baseline;
}

.card-meta .meta-row {
  justify-content: space-between;
}

.card-meta .meta-label {
  width: auto;
}

.meta-label {
  flex: none;
  width: 128rpx;
  font-size: 22rpx;
  color: #8a93a6;
}

.meta-value {
  font-size: 22rpx;
  color: #404653;
  font-variant-numeric: tabular-nums;
}

/* 底行：积分左、激活钮右，细分隔线与元信息区隔开 */
.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #eceef1;
}

.foot-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cost-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #8a5f12;
  font-variant-numeric: tabular-nums;
}

.activate-btn {
  flex: none;
  font-size: 24rpx;
  color: #fff;
  background: #2b6cf6;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.activate-btn.off {
  opacity: 0.5;
}
