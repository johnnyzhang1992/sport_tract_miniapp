.page {
  min-height: 100vh;
  background: #f5f6f8;
  /* 底部 96rpx + Home 指示条安全区（2026-10-29 用户反馈：列表下方空白偏小） */
  padding: 24rpx 24rpx calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.state {
  padding: 160rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a93a6;
}

.state-tap {
  color: #2b6cf6;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}

/* 列表包裹层：让 .exchange-row:last-child 真正命中末行去分隔线 */
.exchange-list {
  display: block;
}

.exchange-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.exchange-row:last-child {
  border-bottom: none;
}

.exchange-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.exchange-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.exchange-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.exchange-status {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: #f2f3f5;
  color: #8a93a6;
}

/* 状态胶囊按 app.wxss .campaign-tag 的约定：基类＝中性灰，所以「已使用」「已过期」都落回基类，
   只有还能用的「未使用」才加修饰类（用全局的 active 蓝，不是参考稿的黄） */
.exchange-status.status-unused {
  background: #eaf1ff;
  color: #2b6cf6;
}

.exchange-time,
.exchange-expire,
.exchange-used {
  font-size: 22rpx;
  color: #8a93a6;
}

/* 物流单号行：整行可点复制，右侧显式「复制」胶囊（不靠用户猜；灰底是为了不跟确认收货抢蓝色） */
.meta-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.track-copy {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #4e5969;
  font-size: 20rpx;
}

.exchange-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.exchange-cost {
  font-size: 28rpx;
  font-weight: 700;
  color: #667080; /* 与积分明细页的支出行同色，别在两个页给出两种「花掉」的深浅 */
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 180rpx 0;
}

.empty-title {
  font-size: 26rpx;
  color: #8a93a6;
}

.empty-link {
  font-size: 24rpx;
  color: #2b6cf6;
}

/* ===== 我的订单（2026-10-27 实物批次）===== */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  padding: 24rpx 0 4rpx;
}

/* 行结构与兑换记录一致（左信息右操作），只是右侧多一枚「确认收货」 */
/* 订单卡三段式：头行（标题+状态+金额）/ 信息组 / 时间行 / 操作行（贴底右对齐）
   不再用左右两列——右列只有两行时 align-items:center 会把金额和按钮都吊在卡片中部 */
.order-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.order-row:last-child {
  border-bottom: none;
}

.order-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 金额靠右与标题同基线：跟头行一起排，不再单独成一列 */
.order-head .exchange-cost {
  margin-left: auto;
  flex-shrink: 0;
}

.order-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

/* 两字标签当列：寄往/物流自然等宽，值再往右对齐成一列 */
.meta-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #a8adb8;
}

.meta-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #5c6472;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-time {
  font-size: 22rpx;
  color: #8a93a6;
}

/* 操作行单独一条分隔线，按钮贴右下；没有可点的操作时整行不渲染 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 6rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f5f6f8;
}

/* 状态胶囊沿用兑换记录的约定：基类中性灰 = 已完成，还没走完的两档才给蓝 */
.exchange-status.order-status-pending_ship,
.exchange-status.order-status-shipped {
  background: #eaf1ff;
  color: #2b6cf6;
}

.confirm-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #eaf1ff;
  color: #2b6cf6;
  font-size: 24rpx;
  line-height: 1.4;
}
/* 提交中：整页禁用态用观感一致的浅灰，不透明度只压这一枚按钮（别整卡 opacity 压对比度） */
.confirm-btn.off {
  background: #f2f3f5;
  color: #a8adb8;
}

.order-fail {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #8a93a6;
}

/* ===== 我的卡（三来源可见 + 行内激活） ===== */

/* ===== 我的卡：统一卡结构（三来源一张列表） =====
   设计口径：白卡容器 + 浅灰卡块；徽章右上角；元信息 label 定宽对齐；
   积分用本项目的荣誉金；唯一彩色动作是「立即激活」，其余全部黑白灰 */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card-item {
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  min-width: 0;
}

/* 徽章：右上角、胶囊、细分状态配色 */
.card-badge {
  flex: none;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #667080;
  background: #eceef1;
}

.card-badge.status-unused {
  color: #2b6cf6;
  background: #eaf1ff;
}

.card-badge.card-status-active {
  color: #1f9d61;
  background: #e6f7ef;
}

.card-badge.card-status-queued {
  color: #b26a00;
  background: #fff3e0;
}

.card-meta {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.meta-row {
  display: flex;
  align-items: baseline;
}

.meta-label {
  flex: none;
  width: 128rpx;
  font-size: 22rpx;
  color: #8a93a6;
}

.meta-value {
  font-size: 22rpx;
  color: #404653;
  font-variant-numeric: tabular-nums;
}

/* 底行：积分左、激活钮右，细分隔线与元信息区隔开 */
.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #eceef1;
}

.cost-row {
  display: flex;
  align-items: baseline;
}

.cost-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #8a5f12;
  font-variant-numeric: tabular-nums;
}

.activate-btn {
  flex: none;
  font-size: 24rpx;
  color: #fff;
  background: #2b6cf6;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.activate-btn.off {
  opacity: 0.5;
}
