<view class="page">
  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{failed}}" class="state state-tap" bindtap="onRetry">加载失败，点击重试</view>
  <view wx:elif="{{!loggedIn}}" class="state state-tap" bindtap="onLoginTap">登录后查看兑换记录</view>
  <block wx:else>
    <!-- 我的卡（2026-10-29 统一卡结构）：兑换/后台发放/系统赠送三来源一张列表——
         名称+右上角状态徽章；获得方式/时间/有效期/积分四行元信息；未激活免广告卡行内激活 -->
    <view class="card" wx:if="{{cards.length}}">
      <view class="card-list">
        <view wx:for="{{cards}}" wx:key="id" class="card-item">
          <view class="card-head">
            <text class="card-name">{{item.name}}</text>
            <text class="card-badge {{item.statusClass}}">{{item.statusText}}</text>
          </view>
          <view class="card-meta">
            <view class="meta-row">
              <text class="meta-label">获得方式</text>
              <text class="meta-value">{{item.sourceText}}</text>
            </view>
            <view class="meta-row">
              <text class="meta-label">{{item.timeLabel}}</text>
              <text class="meta-value">{{item.timeText}}</text>
            </view>
            <view class="meta-row">
              <text class="meta-label">有效期</text>
              <text class="meta-value">{{item.validText}}</text>
            </view>
            <view class="meta-row" wx:if="{{item.usedForDateText}}">
              <text class="meta-label">已补签</text>
              <text class="meta-value">{{item.usedForDateText}}</text>
            </view>
          </view>
          <view class="card-foot">
            <text class="meta-label">积分</text>
            <view class="foot-right">
              <text class="cost-value">{{item.costText}}</text>
              <view
                wx:if="{{item.canActivate}}"
                class="activate-btn {{activating === item.id ? 'off' : ''}}"
                data-id="{{item.id}}"
                bindtap="onActivateCard"
              >{{activating === item.id ? '激活中…' : '立即激活'}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 没有卡才出空态；接口挂了走失败提示，不与「还没有」同屏 -->
    <view wx:if="{{!cards.length}}" class="empty">
      <text class="empty-title">还没有卡券记录</text>
      <text class="empty-link" bindtap="goItem">去兑换 ›</text>
    </view>
  </block>
</view>
