.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.intro {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx 8rpx 28rpx;
}

.intro-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2329;
}

.intro-sub {
  font-size: 26rpx;
  color: #8a93a6;
  line-height: 1.6;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 8rpx;
}

.card + .card {
  margin-top: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 8rpx;
}

.qa {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.qa:last-child {
  border-bottom: none;
}

.q {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.a {
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.7;
}

.footer {
  padding: 36rpx 8rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #8a93a6;
}
